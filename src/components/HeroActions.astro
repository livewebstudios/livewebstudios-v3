---
/**
 * HeroActions — the standard hero button pair, plus the optional bottom link
 * row that sits on the same baseline at the right.
 *
 * Jon 2026-08-27: every Live Web Studios hero carries "Let's Talk | See The
 * Work" under the body copy, and See The Work goes to /work. NOT used on the
 * Live Band Web Studios or Namesake pages, which run their own CTAs.
 *
 * The wrapper is a flex row with align-items:flex-end, which is what makes the
 * link row's bottom edge land exactly level with the buttons' bottom edge.
 */
import { relPrefix } from "../lib/relPrefix";
import CrookedSign from "./CrookedSign.astro";

export interface Props {
  /** Render the bottom-right link row (home hero). */
  links?: boolean;
  /** Lighter link row, so a busy video behind it shows through
      (Jon 2026-09-26: the town-hologram heroes, Industries + Construction). */
  clear?: boolean;
}
const { links = false, clear = false } = Astro.props;
const rel = relPrefix(Astro.url.pathname);
---

<div class:list={["hero-foot", links && "hero-foot--split"]}>
  <div class="hero-btns">
    <a href={`${rel}contact.html`} class="btn btn-primary">Let's Talk →</a>
    <a href={`${rel}work.html`} class="btn btn-ghost">See The Work ↓</a>
  </div>

  {links && (
    <nav class:list={["hero-links", clear && "hero-links--clear"]} aria-label="More from Live Web Studios">
      <span class="hero-links-item">
        <a href={`${rel}live-band-web-studios.html`}>Live Band Web Studios</a>
        <CrookedSign href={`${rel}live-band-web-studios.html`} compact />
      </span>
      <span class="hero-links-sep" aria-hidden="true">/</span>
      <a href={`${rel}namesake.html`}>Namesake Personal Sites</a>
      <span class="hero-links-sep" aria-hidden="true">/</span>
      <a href={`${rel}faq.html`}>FAQ</a>
    </nav>
  )}
</div>

<style>
  .hero-foot {
    display: flex;
    align-items: flex-end;
    gap: 2rem;
    width: 100%;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }
  .hero-foot--split {
    justify-content: space-between;
  }
  /* The pair already carries its own top margin from the system; the wrapper
     owns the spacing now so both children share one baseline. */
  .hero-foot .hero-btns {
    margin-top: 0;
  }

  /* Boxed (Jon 2026-09-02). The hero scrim was lightened to stop the video
     banding, which left this row sitting on bright water and hard to read.
     It carries its own panel now rather than putting the darkness back over
     the whole hero: near-opaque, so only a little of the video reads
     through, with the blur keeping it legible over the busiest frames. */
  .hero-links {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-left: auto;
    width: fit-content;
    max-width: 100%;
    text-align: right;
    /* Three points under the hero body copy, which is clamp(1.05rem,1.6vw,1.3rem). */
    font-size: calc(clamp(1.05rem, 1.6vw, 1.3rem) - 3px);
    line-height: 1.2;
    padding: 0.62rem 1rem;
    background: rgba(5, 7, 11, 0.82);
    backdrop-filter: blur(12px) saturate(130%);
    -webkit-backdrop-filter: blur(12px) saturate(130%);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 10px;
  }
  /* Light touch: a heavier blur smeared the town's lines into a flat dark
     slab that read as opaque, and no tint at all went too far (Jon
     2026-09-26: "meet me in the middle"). A 2px blur and 24% tint soften the
     linework without hiding it; the text shadow carries legibility. */
  .hero-links--clear {
    background: rgba(5, 7, 11, 0.24);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    border-color: rgba(255, 255, 255, 0.2);
  }
  .hero-links--clear a,
  .hero-links--clear .hero-links-sep {
    text-shadow: 0 0 6px #000, 0 0 14px #000;
  }
  .hero-links-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero-links a {
    color: #fff;
    transition: opacity 0.2s var(--ease);
  }
  .hero-links a:hover {
    opacity: 0.7;
  }
  .hero-links-sep {
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 900px) {
    .hero-foot {
      gap: 1.4rem;
    }
    .hero-links {
      margin-left: 0;
      text-align: left;
    }
  }
</style>
