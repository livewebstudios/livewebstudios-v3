---
/**
 * HeroActions — the standard hero button pair, plus an optional plain FAQ
 * link beside it.
 *
 * Jon 2026-08-27: every Live Web Studios hero carries "Let's Talk | See The
 * Work" under the body copy, and See The Work goes to /work. NOT used on the
 * Live Band Web Studios or Namesake pages, which run their own CTAs.
 *
 * Jon 2026-11-16: the boxed link row that sat at the bottom right (Live Band
 * Web Studios / crooked sign / LiveAiStudios / FAQ) is gone. The studio strip
 * across the top of every page does that job now, and on the home page the
 * four studio cards (StudioCards.astro) sit under the hero copy. What is left
 * of the row is the one link the strip does not carry: FAQ, as plain text
 * beside the buttons.
 */
import { relPrefix } from "../lib/relPrefix";

export interface Props {
  /** Render the FAQ text link beside the buttons. */
  links?: boolean;
  /** Swap the ghost button for "Our Story" → /about (Jon 2026-10-01: /work
      only, since "See The Work" would point at the page you're already on). */
  story?: boolean;
}
const { links = false, story = false } = Astro.props;
const path = Astro.url.pathname;
const rel = relPrefix(path);
/* No FAQ link on the FAQ page itself: it would point at the page you are on. */
const onFaq = /^\/faq(\.html|\/|$)/.test(path);
---

<div class="hero-foot">
  <div class="hero-btns">
    <a href={`${rel}contact.html`} class="btn btn-primary">Let's Talk →</a>
    {story
      ? <a href={`${rel}about.html`} class="btn btn-ghost">Our Story →</a>
      : <a href={`${rel}work.html`} class="btn btn-ghost">See The Work ↓</a>}
  </div>

  {links && !onFaq && <a class="hero-faq" href={`${rel}faq.html`}>FAQ</a>}
</div>

<style>
  .hero-foot {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    margin-top: 2.5rem;
    flex-wrap: wrap;
  }
  /* The pair already carries its own top margin from the system; the wrapper
     owns the spacing now so both children share one centre line. */
  .hero-foot .hero-btns {
    margin-top: 0;
  }
  /* Plain text, no box. The shadow keeps it readable over the brightest
     frames of a hero video without putting a panel back behind it. */
  .hero-faq {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Three letters of 13px type is a small thing to hit: the box is a full
       44px target even though the text is not. */
    min-width: 44px;
    min-height: 44px;
    padding-inline: 0.25rem;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    color: #fff;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-shadow: 0 0 6px rgb(0 0 0 / 0.7), 0 0 14px rgb(0 0 0 / 0.7);
    transition: color 0.2s var(--ease);
  }
  .hero-faq:hover {
    color: var(--cyan-soft);
  }
  .hero-faq:focus-visible {
    outline: 2px solid var(--cyan-soft);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @media (max-width: 900px) {
    .hero-foot {
      gap: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-faq {
      transition: none;
    }
  }
</style>
