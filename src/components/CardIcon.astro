const norm = String(title).trim().toLowerCase();
const concept = MAP[norm] ?? "brand";
const glyph = ICONS[concept] ?? ICONS.brand;
---

<span class={`ico-anim ik--${concept}`} aria-hidden="true">
  <svg viewBox="0 0 96 96" xmlns="http://www.w3.org/2000/svg" fill="none">
    <rect class="ik-tile" x="2" y="2" width="92" height="92" rx="20"></rect>
    <g set:html={glyph}></g>
  </svg>
</span>

<style is:global>
  /* ---- CardIcon layout: 2x tile, centered, anchored above the card foot ---- */
  .ico-anim {
    width: 144px;
    height: 144px;
    display: block;
    margin: auto auto 1.4rem; /* top auto = pushes to card foot; l/r auto = centered */
    padding-top: 0.4rem;
    filter: drop-shadow(0 12px 26px rgba(0, 0, 0, 0.35));
  }
  .ico-anim svg { width: 100%; height: 100%; display: block; }
  @media (max-width: 640px) {
    .ico-anim { width: 116px; height: 116px; }
  }

  /* ---- palette ---- */
  .ik-tile { fill: #0c1424; stroke: rgba(125, 170, 210, 0.16); stroke-width: 1.5; }
  .ik-s  { stroke: #e9f2fa; stroke-width: 4; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .ik-sb { stroke: #00a8d0; stroke-width: 4; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .ik-sl { stroke: #5bcfea; stroke-width: 4; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .ik-thin { stroke-width: 2.5; }
  .ik-f  { fill: #e9f2fa; }
  .ik-fb { fill: #00a8d0; }
  .ik-fl { fill: #5bcfea; }
  .ikm { transform-box: fill-box; transform-origin: center; }

  /* ---- shared keyframes ---- */
  @keyframes ikf-spin   { to { transform: rotate(360deg); } }
  @keyframes ikf-pulse  { 0%, 100% { transform: scale(1); opacity: 0.85; } 50% { transform: scale(1.25); opacity: 1; } }
  @keyframes ikf-twinkle{ 0%, 100% { transform: scale(0.55); opacity: 0.25; } 50% { transform: scale(1.15); opacity: 1; } }
  @keyframes ikf-bob    { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
  @keyframes ikf-sway   { 0%, 100% { transform: rotate(-5deg); } 50% { transform: rotate(5deg); } }
  @keyframes ikf-blink  { 0%, 100% { opacity: 0.15; } 50% { opacity: 1; } }
  @keyframes ikf-ring   { 0% { transform: scale(0.7); opacity: 0.7; } 75%, 100% { transform: scale(1.22); opacity: 0; } }
  @keyframes ikf-bar    { 0%, 100% { transform: scaleY(0.5); } 50% { transform: scaleY(1); } }
  @keyframes ikf-scan   { 0%, 100% { transform: translateY(0); opacity: 0.15; } 15% { opacity: 0.6; } 50% { transform: translateY(34px); opacity: 0.6; } 65% { opacity: 0.15; } }
  @keyframes ikf-tilt   { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(4deg); } }
  @keyframes ikf-pop    { 0% { transform: scale(0.2); opacity: 0; } 12% { transform: scale(1.15); opacity: 1; } 20% { transform: scale(1); } 72% { transform: scale(1); opacity: 1; } 88%, 100% { transform: scale(0.5); opacity: 0; } }
  @keyframes ikf-chk    { 0% { transform: scale(0.2); opacity: 0; } 8% { transform: scale(1.15); opacity: 1; } 14% { transform: scale(1); } 78% { transform: scale(1); opacity: 1; } 92%, 100% { opacity: 0; } }
  @keyframes ikf-dash   { to { stroke-dashoffset: -20; } }
  @keyframes ikf-risefade { 0%, 100% { transform: translateY(4px); opacity: 0; } 30% { opacity: 1; } 70% { transform: translateY(-6px); opacity: 0.9; } 95% { opacity: 0; } }

  /* browser: content lines type in, hold, clear */
  @keyframes ikf-grow { 0% { transform: scaleX(0); } 30% { transform: scaleX(1); } 78% { transform: scaleX(1); } 95%, 100% { transform: scaleX(0); } }
  .ik--browser .ik-line1 { animation: ikf-grow 4.2s ease-in-out infinite; }
  .ik--browser .ik-line2 { animation: ikf-grow 4.2s ease-in-out 0.35s infinite; transform: scaleX(0); }
  .ik--browser .ik-line3 { animation: ikf-grow 4.2s ease-in-out 0.7s infinite; transform: scaleX(0); }

  /* ai-chip: core pulses, node orbits */
  .ik--ai-chip .ik-pulse { animation: ikf-pulse 2.2s ease-in-out infinite; }
  .ik-orbit { animation: ikf-spin 5s linear infinite; }

  /* server: LEDs blink at odd intervals, data line streams */
  .ik-led1 { animation: ikf-blink 1.3s ease-in-out infinite; }
  .ik-led2 { animation: ikf-blink 1.9s ease-in-out 0.4s infinite; }
  .ik-led3 { animation: ikf-blink 1.6s ease-in-out 0.8s infinite; }
  .ik-led4 { animation: ikf-blink 1.1s ease-in-out 0.2s infinite; }
  .ik-dataline { animation: ikf-dash 1.1s linear infinite; }

  /* gears: counter-rotation */
  .ik-gearA { animation: ikf-spin 8s linear infinite; }
  .ik-gearB { animation: ikf-spin 5.5s linear infinite reverse; }

  /* seo: magnifier sweeps, bars breathe */
  @keyframes ikf-sweep { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(-16px, 5px); } }
  .ik-sweep { animation: ikf-sweep 4s ease-in-out infinite; }
  .ik-bar1 { animation: ikf-bar 2.6s ease-in-out infinite; }
  .ik-bar2 { animation: ikf-bar 3.1s ease-in-out 0.3s infinite; }
  .ik-bar3 { animation: ikf-bar 2.3s ease-in-out 0.6s infinite; }
  .ik-bar4 { animation: ikf-bar 3.4s ease-in-out 0.15s infinite; }

  /* checklist: checks land one after another */
  .ik-chk1 { animation: ikf-chk 4.5s ease-in-out infinite; }
  .ik-chk2 { animation: ikf-chk 4.5s ease-in-out 0.6s infinite; opacity: 0; }
  .ik-chk3 { animation: ikf-chk 4.5s ease-in-out 1.2s infinite; opacity: 0; }

  /* generic reused bits */
  .ik-pulse { animation: ikf-pulse 2.4s ease-in-out infinite; }
  .ik-twinkle { animation: ikf-twinkle 2.6s ease-in-out infinite; }
  .ik-twinkle2 { animation: ikf-twinkle 2.6s ease-in-out 1.3s infinite; }
  .ik-bob1 { animation: ikf-bob 3s ease-in-out infinite; }
  .ik-bob2 { animation: ikf-bob 3s ease-in-out 0.5s infinite; }
  .ik-bob3 { animation: ikf-bob 3s ease-in-out 1s infinite; }
  .ik-sway { animation: ikf-sway 4.5s ease-in-out infinite; }
  .ik-ring { animation: ikf-ring 3s ease-out infinite; }
  .ik-tilt { animation: ikf-tilt 4s ease-in-out infinite; }
  .ik-pop { animation: ikf-pop 3.6s ease-in-out infinite; }
  .ik-scan { animation: ikf-scan 3.2s ease-in-out infinite; }
  .ik-risefade { animation: ikf-risefade 3s ease-in-out infinite; }

  /* logo: occasional wiggle burst + accent arc spins */
  @keyframes ikf-wiggle { 0% { transform: rotate(0); } 6% { transform: rotate(-12deg); } 13% { transform: rotate(9deg); } 20% { transform: rotate(-5deg); } 26% { transform: rotate(0); } 100% { transform: rotate(0); } }
  .ik-wiggle { animation: ikf-wiggle 4.5s ease-in-out infinite; }
  .ik-arcspin { animation: ikf-spin 4s linear infinite; }

  /* cart: item drops in, cart rocks */
  @keyframes ikf-drop { 0% { transform: translateY(-8px); opacity: 0; } 18% { transform: translateY(2px); opacity: 1; } 38% { transform: translateY(18px); opacity: 1; } 52%, 100% { transform: translateY(18px); opacity: 0; } }
  .ik-drop { animation: ikf-drop 3s ease-in infinite; }
  @keyframes ikf-rock { 0%, 20%, 100% { transform: rotate(0); } 40% { transform: rotate(-3deg); } 60% { transform: rotate(2deg); } 75% { transform: rotate(0); } }
  .ik-rock { animation: ikf-rock 3s ease-in-out infinite; }

  /* carousel: front card cycles out and back */
