/**
 * CardIcon — animated SVG illustration tiles for service/industry cards.
 * Replaces the static AI-generated PNG icon set (Jon 2026-08-15: "make them
 * move"). Each concept is a hand-built two-tone glyph (white + logo blue
 * #00A8D0 on dark navy) with a subject-matched animation: gears spin, the
 * pencil writes, bar columns rise and fall, report pages turn, the logo mark
 * wiggles, workflow boxes pass a dot around, etc.
 *
 * Usage: <CardIcon title={card.title} /> — the title is normalized and mapped
 * to a concept below. Unknown titles fall back to the "brand" mark.
 *
 * Styles are is:global (glyphs are injected via set:html, so scoped styles
 * would not match); everything is namespaced ik-/ikf- to avoid collisions.
 * prefers-reduced-motion disables all CSS animation.
 */
export interface Props {
  title: string;
}
const { title = "" } = Astro.props;

