---
/**
 * Social — the Live Web Studios social accounts, as a row of icon links.
 * Jon 2026-09-15: wanted on the footer and the contact page.
 *
 * One component rather than two copies so the account list has a single home.
 * When a third account lands (or a handle changes), it changes here and both
 * placements follow.
 *
 * Brand glyphs are filled paths, not the stroked 24x24 set NavIcon carries, so
 * they are inline here instead of going through ICONS. They are also the
 * official marks: redrawing them thinner to match the nav set is exactly how a
 * brand mark stops being recognisable at 18px.
 *
 * Both links leave the site, so both get target="_blank" and rel="noopener
 * noreferrer", matching how Footer.astro already treats livewebphotos.com.
 * The visible element is an icon, so the accessible name comes from
 * visually-hidden text inside the link rather than an aria-label: it survives
 * translation, and it is what a screen reader reads out.
 */
interface Props {
  /** Extra class for placement, e.g. "foot-social". */
  class?: string;
  /** Icon edge length in px. 18 matches the nav glyph size. */
  size?: number;
}
const { class: klass, size = 18 } = Astro.props;

const ACCOUNTS = [
  {
    name: "Facebook",
    href: "https://www.facebook.com/livewebstudios",
    /* f mark, Facebook brand guidelines glyph */
    path: "M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z",
  },
  {
    name: "Instagram",
    href: "https://www.instagram.com/jonwolf_livewebstudios/",
    /* Rounded square + lens + flash dot, drawn as one path with even-odd fill */
    path: "M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.9 5.9 0 0 0-2.13 1.38A5.9 5.9 0 0 0 .63 4.14c-.3.76-.5 1.64-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91a5.9 5.9 0 0 0 1.38 2.13 5.9 5.9 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.38 5.9 5.9 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.13A5.9 5.9 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm7.85-10.4a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0z",
  },
];
---

<ul class:list={["social", klass]}>
  {ACCOUNTS.map((a) => (
    <li>
      <a href={a.href} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true" focusable="false">
          <path d={a.path} />
        </svg>
        <span class="visually-hidden">{a.name}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .social {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* The link is the hit target, so it carries the padding: an 18px glyph on
     its own is well under the 24px minimum a touch target wants. */
  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem;
    margin: -0.35rem;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }
  .social a:hover,
  .social a:focus-visible {
    color: var(--cyan-soft);
  }
  .social svg {
    display: block;
  }
</style>
