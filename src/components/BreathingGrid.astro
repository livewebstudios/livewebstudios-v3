---
/**
 * BreathingGrid: the "breathing grid" section background.
 *
 * An equilateral triangle lattice of dots that swells and fades in a slow
 * wave. Every few seconds an accent pulse ripples out and traces three
 * forward chevrons (the >>> mark) one after another, then dissolves. Dots
 * near the cursor lift and warm up. Canvas 2D, no library, no video file.
 *
 * Usage (the section only needs the has-bgrid class):
 *
 *   <section class="sec-pad has-bgrid">
 *     <BreathingGrid />
 *     <div class="wrap">...</div>
 *   </section>
 *
 * The accent follows the page: --bgrid-accent if set, else the Live AI
 * orange (--ai) inside .theme-live-ai, else the sitewide --cyan.
 *
 * Behaviour rules:
 *   - prefers-reduced-motion: one still frame, mid-pulse, never animates.
 *   - pauses when its section is off screen and when the tab is hidden.
 *   - devicePixelRatio capped at 1.5 so big screens stay cheap.
 *   - decorative only: aria-hidden, pointer-events none, zero layout shift.
 */
interface Props {
  /** Where the >>> pulse sits. "none" keeps only the breathing wave. */
  chevrons?: "right" | "center" | "none";
  /** Which side stays quiet for copy. Dots fade toward this side. */
  quiet?: "left" | "right" | "none";
  /** Dot spacing. */
  density?: "sparse" | "normal" | "dense";
  /** Cursor glow. */
  interactive?: boolean;
  /** Dark wash over the grid for text-heavy sections. */
  scrim?: "none" | "soft" | "strong";
  /** Seconds between pulses. */
  cycle?: number;
}
const {
  chevrons = "right",
  quiet = "left",
  density = "normal",
  interactive = true,
  scrim = "soft",
  cycle = 6.5,
} = Astro.props;
---

<div
  class:list={["bgrid", `bgrid--scrim-${scrim}`]}
  aria-hidden="true"
  data-bgrid
  data-chevrons={chevrons}
  data-quiet={quiet}
  data-density={density}
  data-interactive={interactive ? "1" : "0"}
  data-cycle={String(cycle)}
>
  <canvas class="bgrid__c"></canvas>
  <div class="bgrid__scrim"></div>
</div>

<style is:global>
  .has-bgrid{position:relative;overflow:hidden;isolation:isolate}
  .has-bgrid > .wrap{position:relative;z-index:1}
  .bgrid{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden}
  .bgrid__c{position:absolute;inset:0;width:100%;height:100%;display:block}
  .bgrid__scrim{position:absolute;inset:0}
  .bgrid--scrim-soft .bgrid__scrim{background:linear-gradient(90deg,rgba(0,0,0,.55) 0%,rgba(0,0,0,.25) 45%,rgba(0,0,0,0) 75%)}
  .bgrid--scrim-strong .bgrid__scrim{background:rgba(0,0,0,.5)}
  @media (max-width:900px){
    .bgrid--scrim-soft .bgrid__scrim{background:linear-gradient(180deg,rgba(0,0,0,.35) 0%,rgba(0,0,0,.55) 100%)}
  }
</style>

<script>
  // One controller for every BreathingGrid on the page (Astro bundles this
  // once). Each instance gets its own canvas loop, paused when off screen.
  type Dot = { x: number; y: number; ch: [number, number, number]; fade: number };

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
  const lerp = (a: number, b: number, u: number) => a + (b - a) * u;
  const smooth = (a: number, b: number, x: number) => {
    const u = clamp((x - a) / (b - a), 0, 1);
    return u * u * (3 - 2 * u);
  };
  const segDist = (px: number, py: number, ax: number, ay: number, bx: number, by: number) => {
    const dx = bx - ax, dy = by - ay;
    const u = clamp(((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy), 0, 1);
    const x = ax + u * dx - px, y = ay + u * dy - py;
    return Math.sqrt(x * x + y * y);
  };

  // Resolve any CSS colour (var, hex, rgb) to [r,g,b].
  const probe = document.createElement("canvas").getContext("2d")!;
  function toRGB(css: string): [number, number, number] {
    probe.fillStyle = "#000";
    probe.fillStyle = css.trim() || "#E8650A";
    const v = probe.fillStyle as string;
    if (v.startsWith("#")) {
      return [parseInt(v.slice(1, 3), 16), parseInt(v.slice(3, 5), 16), parseInt(v.slice(5, 7), 16)];
    }
    const m = v.match(/[\d.]+/g) || ["232", "101", "10"];
    return [+m[0], +m[1], +m[2]];
  }
  function accentFor(el: HTMLElement): [number, number, number] {
    const cs = getComputedStyle(el);
    const own = cs.getPropertyValue("--bgrid-accent");
    if (own.trim()) return toRGB(own);
    if (el.closest(".theme-live-ai")) return toRGB(cs.getPropertyValue("--ai") || "#E8650A");
    return toRGB(cs.getPropertyValue("--cyan") || "#38BDF8");
  }

  function mount(host: HTMLElement) {
    const canvas = host.querySelector<HTMLCanvasElement>(".bgrid__c")!;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const section = (host.parentElement as HTMLElement) || host;
    const opt = {
      chevrons: host.dataset.chevrons || "right",
      quiet: host.dataset.quiet || "left",
      spacing: host.dataset.density === "dense" ? 26 : host.dataset.density === "sparse" ? 44 : 34,
      interactive: host.dataset.interactive === "1",
      cycle: Math.max(3, parseFloat(host.dataset.cycle || "6.5")),
    };
    let accent = accentFor(host);
    let W = 0, H = 0, dots: Dot[] = [], cx = 0, cy = 0;
    let raf = 0, visible = false, last = 0;
    const t0 = performance.now();
    const ptr = { x: -9999, y: -9999, on: false };

    function layout() {
      const r = host.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      W = r.width; H = r.height;
      if (!W || !H) return;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      accent = accentFor(host);

      const narrow = W < 700;
      const s = narrow ? Math.round(opt.spacing * 0.8) : opt.spacing;
      const rh = (s * Math.sqrt(3)) / 2;
      dots = [];
      let row = 0;
      for (let y = rh * 0.5; y < H + rh; y += rh, row++) {
        for (let x = row % 2 ? s / 2 : 0; x < W + s; x += s) dots.push({ x, y, ch: [0, 0, 0], fade: 1 });
      }

      const a = Math.min(H * 0.15, 105);
      const gap = a * 0.8;
      cy = H * 0.5;
      const firstX =
        opt.chevrons === "center" ? W * 0.5 - gap : narrow ? W * 0.55 : W * 0.7;
      cx = firstX + gap;
      const chev = [0, 1, 2].map((j) => ({ x: firstX + j * gap, y: cy }));
      const sig = s * 0.42;
      for (const d of dots) {
        if (opt.chevrons !== "none") {
          d.ch = chev.map((c) => {
            const dd = Math.min(
              segDist(d.x, d.y, c.x - a, c.y - a, c.x, c.y),
              segDist(d.x, d.y, c.x, c.y, c.x - a, c.y + a),
            );
            return Math.exp(-(dd * dd) / (2 * sig * sig));
          }) as [number, number, number];
        }
        const u = d.x / W;
        d.fade =
          opt.quiet === "left" ? 0.22 + 0.78 * smooth(0.1, 0.75, u)
          : opt.quiet === "right" ? 0.22 + 0.78 * smooth(0.1, 0.75, 1 - u)
          : 0.8;
      }
    }

    function draw(t: number) {
      const c = ctx!;
      c.clearRect(0, 0, W, H);
      const ph = (t % opt.cycle) / opt.cycle;
      const env = (k: number) => Math.exp(-((ph - k) * (ph - k)) / (2 * 0.045 * 0.045));
      const e = opt.chevrons === "none" ? [0, 0, 0] : [env(0.16), env(0.25), env(0.34)];
      const rr = ph * Math.max(W, H) * 1.1;
      const ripA = opt.chevrons === "none" ? 0 : 1 - ph;
      const [ar, ag, ab] = accent;
      for (const d of dots) {
        const breath = 0.5 + 0.5 * Math.sin(t * 0.9 - (d.x * 0.006 + d.y * 0.004));
        const chev = Math.min(1, d.ch[0] * e[0] + d.ch[1] * e[1] + d.ch[2] * e[2]);
        const rx = d.x - cx, ry = d.y - cy;
        const dist = Math.sqrt(rx * rx + ry * ry);
        const rip = Math.exp(-((dist - rr) * (dist - rr)) / (2 * 45 * 45)) * ripA * 0.6;
        let h = 0;
        if (ptr.on) {
          const hx = d.x - ptr.x, hy = d.y - ptr.y;
          h = Math.exp(-(hx * hx + hy * hy) / (2 * 85 * 85));
        }
        const warm = clamp(chev * 1.2 + h + rip * 0.7, 0, 1);
        const r = 0.9 + 0.8 * breath + 2.3 * chev + 1.5 * h + 0.7 * rip;
        const a = clamp((0.22 + 0.3 * breath) * d.fade + warm * 0.75, 0, 1);
        if (warm > 0.25) {
          c.fillStyle = `rgba(${ar},${ag},${ab},${0.12 * warm})`;
          c.beginPath(); c.arc(d.x, d.y, r * 3.2, 0, 6.283); c.fill();
        }
        c.fillStyle = `rgba(${Math.round(lerp(110, ar, warm))},${Math.round(lerp(118, ag, warm))},${Math.round(lerp(132, ab, warm))},${a})`;
        c.beginPath(); c.arc(d.x, d.y, r, 0, 6.283); c.fill();
      }
    }

    const frame = (now: number) => {
      draw((now - t0) / 1000);
      raf = requestAnimationFrame(frame);
    };
    const still = () => draw(opt.cycle * 0.25);
    const start = () => {
      if (raf || reduce.matches || !visible || document.hidden) return;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    };
    const stop = () => { if (raf) cancelAnimationFrame(raf); raf = 0; };

    new ResizeObserver(() => { layout(); if (!raf) still(); }).observe(host);
    new IntersectionObserver((es) => {
      visible = es[0].isIntersecting;
      visible ? start() : stop();
    }, { rootMargin: "100px" }).observe(host);
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
    reduce.addEventListener?.("change", () => { if (reduce.matches) { stop(); still(); } else start(); });

    if (opt.interactive) {
      section.addEventListener("pointermove", (ev) => {
        if (ev.pointerType !== "mouse") return;
        const r = host.getBoundingClientRect();
        ptr.x = ev.clientX - r.left; ptr.y = ev.clientY - r.top; ptr.on = true;
      });
      section.addEventListener("pointerleave", () => { ptr.on = false; });
    }

    layout();
    still();
    void last;
  }

  document.querySelectorAll<HTMLElement>("[data-bgrid]").forEach(mount);
</script>
