---
/**
 * SeoRack: the "SEO Is Baked Into Every Build" block every Live Band page
 * carries. Built once. Three photo MiniCards, and the AI Platform line as a
 * raised plate with an amber LED. Copy is the repo's; the Forms page passes
 * its shorter lede.
 *
 * Background (Jon 2026-11-15: "even the colored mp4 waves... do something
 * else. high end."): the colored wave video is gone. In its place, an amp
 * grille: a fine perforated metal mesh with warm tube glow drifting slowly
 * behind it, between two brass rails. Pure CSS, transform-only motion, so it
 * stops with the hold button and under reduced motion like everything else.
 */
import SectionHead from "./SectionHead.astro";
import MiniCard from "./MiniCard.astro";
import Plate from "./Plate.astro";
import Led from "./Led.astro";
import { BAND_SEO } from "../../lib/bandSeo";
import { relPrefix } from "../../lib/relPrefix";
interface Props { lede?: string; id?: string }
const {
  lede = "A website nobody finds is a poster in a locked room. Getting you found is a core part of what we do, every site is engineered to rank, and we keep working it after launch.",
  id = "seo",
} = Astro.props;
const rel = relPrefix(Astro.url.pathname);
---
<section class="lb-section lb-seo" id={id} aria-labelledby={`${id}-h`}>
  <div class="lb-seo__bay" aria-hidden="true">
    <div class="lb-seo__tubes"><i></i><i></i><i></i></div>
    <div class="lb-seo__grille"></div>
  </div>
  <div class="lb-container">
    <SectionHead nameplate="FOUND ON GOOGLE, NOT JUST BUILT" id={`${id}-h`}>
      SEO Is Baked Into <span class="lb-gold">Every Build</span>
      <p class="lb-lead" slot="lede" data-reveal>{lede}</p>
    </SectionHead>
    <ul role="list" class="lb-grid-3">
      {BAND_SEO.map((s, i) => (
        <MiniCard
          stack
          num={String(i + 1).padStart(2, "0")}
          title={s.title}
          line={s.body}
          image={{ src: `${rel}images/band/${s.art}`, alt: s.alt }}
        />
      ))}
    </ul>
    <Plate variant="raised" class="lb-seo__platform" data-reveal>
      <Led />
      <p><strong>Built on the Live Web Studios AI Platform.</strong> Google didn't tweak the rules, it rewrote them. The old SEO playbook doesn't work anymore. We build for how search works now, and adjust the moment it changes again.</p>
    </Plate>
  </div>
</section>

<style>
  .lb-seo { isolation: isolate; overflow: hidden; }
  .lb-seo .lb-container { position: relative; z-index: 1; }

  /* The bay: a recessed opening in the rack, brass rail top and bottom. */
  .lb-seo__bay {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: var(--lb-metal-1);
    isolation: isolate;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--lb-brass) 55%, transparent),
      inset 0 -1px 0 color-mix(in srgb, var(--lb-brass) 55%, transparent),
      inset 0 24px 48px -24px #000,
      inset 0 -24px 48px -24px #000;
  }
  /* Tube glow, behind the mesh. Three soft lamps that drift. */
  .lb-seo__tubes { position: absolute; inset: 0; overflow: hidden; }
  .lb-seo__tubes i {
    position: absolute;
    width: 46vmax;
    height: 46vmax;
    border-radius: 50%;
    will-change: transform;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--lb-amber) 62%, transparent), color-mix(in srgb, var(--lb-amber) 18%, transparent) 55%, transparent 100%);
  }
  .lb-seo__tubes i:nth-child(1) { top: -12vmax; left: -8vmax; }
  .lb-seo__tubes i:nth-child(2) { bottom: -18vmax; right: -6vmax; background: radial-gradient(closest-side, color-mix(in srgb, var(--lb-brass-bright) 55%, transparent), color-mix(in srgb, var(--lb-brass) 16%, transparent) 55%, transparent 100%); }
  .lb-seo__tubes i:nth-child(3) { top: 30%; left: 38%; width: 34vmax; height: 34vmax; background: radial-gradient(closest-side, color-mix(in srgb, #ff7a2a 40%, transparent), transparent 100%); }
  /* The mesh: the glow layer is masked to a staggered grid of round holes, so
     light only shows through the perforations and the rest stays metal. */
  .lb-seo__tubes {
    --hole: radial-gradient(circle at center, #000 0 2px, transparent 2.8px);
    -webkit-mask-image: var(--hole), var(--hole);
    mask-image: var(--hole), var(--hole);
    -webkit-mask-size: 9px 9px;
    mask-size: 9px 9px;
    -webkit-mask-position: 0 0, 4.5px 4.5px;
    mask-position: 0 0, 4.5px 4.5px;
  }
  /* Unlit holes still read as holes: a faint dark dot grid on the metal. */
  .lb-seo__grille {
    position: absolute;
    inset: 0;
    z-index: -1;
    --pit: radial-gradient(circle at center, #000 0 2px, transparent 2.8px);
    background-image: var(--pit), var(--pit);
    background-size: 9px 9px;
    background-position: 0 0, 4.5px 4.5px;
  }
  /* A soft sheen across the mesh and a vignette so the copy sits on calm. */
  .lb-seo__bay::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, transparent 30%, color-mix(in srgb, var(--lb-cream) 4%, transparent) 48%, transparent 62%),
      radial-gradient(ellipse 95% 80% at 50% 50%, color-mix(in srgb, var(--lb-ink) 12%, transparent), color-mix(in srgb, var(--lb-ink) 58%, transparent) 100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lb-seo__tubes i:nth-child(1) { animation: lb-tube-a 38s ease-in-out infinite alternate; }
    .lb-seo__tubes i:nth-child(2) { animation: lb-tube-b 47s ease-in-out infinite alternate; }
    .lb-seo__tubes i:nth-child(3) { animation: lb-tube-c 29s ease-in-out infinite alternate; }
  }
  @keyframes lb-tube-a { to { transform: translate(34vw, 10vh) scale(1.15); } }
  @keyframes lb-tube-b { to { transform: translate(-30vw, -8vh) scale(0.9); } }
  @keyframes lb-tube-c { to { transform: translate(-18vw, 6vh) scale(1.25); } }

  .lb-seo__platform {
    display: flex;
    align-items: baseline;
    gap: var(--lb-s-4);
    margin-top: var(--lb-s-10);
    padding: var(--lb-s-6) var(--lb-s-8);
  }
  .lb-seo__platform p { color: var(--lb-parchment); max-width: none; }
  .lb-seo__platform strong { color: var(--lb-cream); font-weight: 500; }
  @media (max-width: 599px) { .lb-seo__platform { padding: var(--lb-s-6) var(--lb-s-5); } }
</style>
