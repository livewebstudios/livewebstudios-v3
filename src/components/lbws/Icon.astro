---
/** Line icons, 24px grid, 1.5 stroke, currentColor. Decorative. */
interface Props {
  name: "screen" | "doc" | "person" | "search" | "pen" | "phone" | "camera" | "bulb";
  size?: number;
}
const { name, size = 22 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "screen" && <Fragment><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" /></Fragment>}
  {name === "doc" && <Fragment><path d="M7 3h7l4 4v14H7z" /><path d="M14 3v4h4M10 12h5M10 16h5" /></Fragment>}
  {name === "person" && <Fragment><circle cx="12" cy="8" r="3.5" /><path d="M5 20a7 7 0 0 1 14 0" /></Fragment>}
  {name === "search" && <Fragment><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.5-4.5" /></Fragment>}
  {name === "pen" && <Fragment><path d="M4 20l1-4L16.5 4.5a2 2 0 0 1 3 3L8 19z" /><path d="M14.5 6.5l3 3" /></Fragment>}
  {name === "phone" && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" />}
  {name === "camera" && <Fragment><path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></Fragment>}
  {name === "bulb" && <Fragment><path d="M9 18h6M10 21h4" /><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z" /></Fragment>}
</svg>
