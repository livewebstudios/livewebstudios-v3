---
/** Pause and play for every looping animation and the videos (WCAG 2.2.2).
    Hidden without JS and under reduced motion, where nothing loops. */
---
<button type="button" class="lb-hold" data-motion-toggle aria-pressed="false" aria-label="Pause motion">
  <svg data-ico="pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
  <svg data-ico="play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" /></svg>
</button>
