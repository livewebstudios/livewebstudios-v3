---
/**
 * StudiosPanel — the STUDIOS mega-panel, built as a directory.
 *
 * Jon 2026-09-14: "I want that Live Band and Namesake drop down menu on all
 * pages, not just the Live Band and Namesake pages. Make the mega menu look
 * kind of like [a four-column icon directory]. Sentence under each page
 * explaining the page. Color icon can work there."
 *
 * So every sub-brand page is reachable from the main nav on EVERY page, laid
 * out as four headed columns of icon + title + one-line explainer. The whole
 * thing is static HTML: every link is in page source for each visitor and
 * each crawler, and CSS :hover / :focus-within keeps it usable with JS off.
 * The JS in Nav.astro only enhances the toggle.
 *
 * Icons are inline SVG rather than the PNG set in public/images/icons: these
 * render at 20px against a dark panel, where a bitmap goes to mush.
 *
 * Jon 2026-09-15: "make the colored icons more uniform. one color family for
 * live band... one color for namesake (3 gold shades)." So each column is now
 * a single hue walked from light to deep down the rows, and the column reads
 * as one family at a glance instead of a bag of loose colors:
 *
 * Jon 2026-09-15, second pass: "go from dark (top) to light (bottom)", so each
 * ramp runs deepest on the first row and lightest on the last:
 *
 *   Live Band    sky      #0EA5E9 -> #38BDF8 -> #7DD3FC -> #BAE6FD
 *   Namesake     brass    #C9A55A -> #D9B872 -> #EBD4A0  (--brass is the ceiling)
 *   More Studios violet   #A78BFA -> #C4B5FD  (the hue Services already gives AI)
 *
 * Shades stay in the light half of each ramp on purpose: below roughly #0EA5E9
 * a 1.6px stroke at 20px stops holding up against this near-black panel, which
 * is why the dark end starts there rather than going properly deep.
 *
 * Heads up if these get revisited: --amber (#FCD34D) is still tokenised in
 * global.css as the Live Band Web Studios colour, and it is what .mega-card--band
 * and the band subnav use. This column is deliberately blue per the note above,
 * so the two no longer agree. Flip the four sky values back to the amber ramp
 * if the brand token should win.
 */
import Glass from "./Glass.astro";
import { ICONS } from "../lib/navIcons";
import { relPrefix } from "../lib/relPrefix";

interface Props {
  /** Normalised key for the current page, for aria-current. */
  here?: string;
}
const { here = "" } = Astro.props;
const rel = relPrefix(Astro.url.pathname);

const navKey = (href: string) => {
  const s = href.replace(/^\/+/, "").replace(/\/+$/, "").replace(/\.html$/, "");
  return s === "" ? "index" : s;
};

type Item = {
  icon: string;
  color: string;
  title: string;
  desc: string;
  href: string;
  external?: boolean;
};

/* Three columns: Live Band, Namesake, and the outboard studios.
   The band intake forms are deliberately NOT here (Jon 2026-09-14) - they are
   client paperwork, not a shopfront, and the Live Band sub-nav bar already
   carries them. Personal Sites is gone for the same reason Namesake exists:
   it is the same offer, so the Namesake column is the one entry point.
   Links are relative per the LWS path rule; `rel` supplies the depth. */
const columns: { label: string; items: Item[] }[] = [
  {
    label: "LIVE BAND WEB STUDIOS",
    items: [
      { icon: "home", color: "#0EA5E9", title: "Live Band Home", desc: "What a band site includes and how it gets built.", href: "live-band-web-studios.html" },
      { icon: "tag", color: "#38BDF8", title: "Pricing", desc: "Two tiers, what each covers, what it costs.", href: "live-band-web-studios/pricing.html" },
      { icon: "grid", color: "#7DD3FC", title: "Portfolio", desc: "Band sites we have built, live and in the wild.", href: "live-band-web-studios/portfolio.html" },
      /* Jon 2026-09-15: the musician blog nests here cleanly, as its own row
         under Live Band. The ↗ sits in the title the same way Live Web Photos
         carries one below: it marks a door to somewhere else, and this panel
         already speaks that language. */
      { icon: "pen", color: "#BAE6FD", title: "Live Band Blog ↗", desc: "Booking, EPKs, social, email, and AI for working musicians.", href: "live-band-web-studios/blog.html" },
    ],
  },
  {
    label: "NAMESAKE",
    items: [
      { icon: "star", color: "#C9A55A", title: "Namesake Overview", desc: "A sharp personal site for solo professionals.", href: "namesake.html" },
      { icon: "route", color: "#D9B872", title: "How It Works", desc: "What you send, what you get, how long it takes.", href: "namesake/how-it-works.html" },
      { icon: "play", color: "#EBD4A0", title: "Start Yours", desc: "Kick off your Namesake site today.", href: "namesake/start.html" },
    ],
  },
  {
    label: "MORE STUDIOS",
    items: [
      { icon: "photos", color: "#A78BFA", title: "Live Web Photos ↗", desc: "AI image enhancement, on its own domain.", href: "https://livewebphotos.com", external: true },
      { icon: "chip", color: "#C4B5FD", title: "Live AI Studios", desc: "AI builds and automation for larger businesses.", href: "ecosystem/live-ai-studios.html" },
    ],
  },
];
---

<div class="mega mega--studios" id="studios-panel" role="region" aria-label="Studios">
  <Glass variant="plain" innerClass="mega-inner">
    <div class="mega-truss" aria-hidden="true"></div>

    <div class="dir">
      {columns.map((col) => (
        <div class="dir-col">
          <span class="dir-col__label">{col.label}</span>
          <ul class="dir-list">
            {col.items.map((it) => (
              <li>
                <a
                  class="dir-item"
                  href={it.external ? it.href : `${rel}${it.href}`}
                  target={it.external ? "_blank" : undefined}
                  rel={it.external ? "noopener noreferrer" : undefined}
                  aria-current={!it.external && navKey(it.href) === here ? "page" : undefined}
                >
                  <span class="dir-item__ico" style={`color:${it.color}`} aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <Fragment set:html={ICONS[it.icon]} />
                    </svg>
                  </span>
                  <span class="dir-item__txt">
                    <span class="dir-item__title">{it.title}</span>
                    <span class="dir-item__desc">{it.desc}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Glass>
</div>
