---
/**
 * Footer — restructured 2026-08-15 per Jon (MOSA AI reference screenshot):
 * left brand block (logo, tagline, newsletter subscribe) + link columns
 * (Pages / Services / Industries / Studios / Legal) + clean bottom
 * bar (copyright · badge · credit). Newsletter form posts to the same
 * Mailchimp endpoint as /newsletter. Town pages stay held for a later phase.
 *
 * Background: bg-blue-fog looping video (strong scrim for dense-link
 * legibility). Link text Title Case per Jon's nav-case decision.
 */
import VideoBg from "./VideoBg.astro";
import Arrow from "./Arrow.astro";
import Social from "./Social.astro";
import { imageSize } from "../lib/imageSize";
import { relPrefix } from "../lib/relPrefix";
const path = Astro.url.pathname;
const rel = relPrefix(path);

/* One footer sitewide, so the bridge line points wherever the reader is not.
   On a Live Band page it points home to the LWS blog; everywhere else it
   points musicians at theirs. Jon 2026-09-15. */
const onBand = path.includes("/live-band-web-studios");

/* /ai/start hides the newsletter box: on a page whose whole job is one form,
   a second email field reads as the thing to fill in. Jon 2026-10-12. */
const { hideSubscribe = false } = Astro.props as { hideSubscribe?: boolean };

// Exact Mailchimp endpoint from the live newsletter page.
const MAILCHIMP_ACTION =
  "https://livewebstudios.us18.list-manage.com/subscribe/post?u=612de0c3a91b0bcc090cd2337&id=30b288c666&f_id=00d229e7f0";

const cols: { h: string; href?: string; links: string[][] }[] = [
  {
    h: "Pages",
    links: [
      ["Home", "index.html"],
      ["Work", "work.html"],
      ["About", "about.html"],
      ["Blog", "blog.html"],
      ["FAQ", "faq.html"],
      ["Newsletter", "newsletter.html"],
      ["Contact", "contact.html"],
    ],
  },
  {
    h: "Services",
    links: [
      ["Website Design", "services/website-design.html"],
      ["AI Platform", "services/ai-platform.html"],
      ["Hosting", "services/hosting.html"],
      ["SEO & Marketing", "services/seo.html"],
      ["E-Commerce", "services/ecommerce.html"],
      ["Branding", "services/branding.html"],
      ["Expert Witness", "services/expert-witness.html"],
      ["Email Writing", "services/email-writing.html"],
      ["AI Studio", "ai.html"],
      ["All Services", "services.html"],
    ],
  },
  {
    /* Jon 2026-09-26: Industries left the main nav, so this column carries
       all 10 verticals and the heading itself links to the hub (which is
       why "All Industries" is gone). */
    h: "Industries",
    href: "industries.html",
    links: [
      ["Healthcare", "industries/healthcare.html"],
      ["Law Firms", "industries/law-firm.html"],
      ["Financial Services", "industries/financial-services.html"],
      ["Construction", "industries/construction.html"],
      ["Real Estate", "industries/real-estate.html"],
      ["Manufacturing", "industries/manufacturing.html"],
      ["Dental", "industries/dental.html"],
      ["Nonprofit", "industries/nonprofit.html"],
      ["B2B", "industries/b2b.html"],
      ["Insurance", "industries/insurance.html"],
    ],
  },
  /* Jon 2026-09-26: the family in this order, then an INSIGHTS group with the
     three blogs on the site under it in the same column.
     Jon 2026-10-10: the four studios render as logos, not text links (third
     item is the logo path; the label becomes its alt text). The crooked
     "Musicians/Bands" sign is retired from the footer with it. */
  {
    h: "Studios",
    links: [
      ["Live Web Studios", "index.html", "images/logoRGB.png"],
      ["Live AI Studios", "ai.html", "images/studios/live-ai-studios.png"],
      ["Live Web Photos", "https://livewebphotos.com", "images/studios/live-web-photos.png"],
      ["Live Band Web Studios", "live-band-web-studios.html", "images/studios/live-band-web-studios.png"],
    ],
    sub: {
      h: "Insights",
      links: [
        ["Live Web Blog", "blog.html"],
        ["Live Band Blog", "live-band-web-studios/blog.html"],
        ["Live AI Blog", "ai/blog.html"],
      ],
    },
  },
];
---

<footer class="has-videobg">
  <VideoBg src="bg-blue-fog.mp4" scrim="strong" />
  <div class="wrap">
    <div class="foot-cols">
      <div class="foot-brand">
        <div class="foot-logo">
          <img src={`${rel}images/logoRGB.png`} alt="Live Web Studios" width="800" height="245" loading="lazy" decoding="async" />
        </div>
        <p class="foot-tag">Custom, AI-platformed websites for small business. Built in North Jersey since 2004.</p>

        {!hideSubscribe && (
          <>
            <span class="foot-loop">STAY IN THE LOOP</span>
            <form class="foot-sub" action={MAILCHIMP_ACTION} method="post" target="_blank">
              <input type="email" name="EMAIL" required autocomplete="email" placeholder="your@email.com" aria-label="Email address" />
              <div class="foot-honeypot" aria-hidden="true">
                <input type="text" name="b_612de0c3a91b0bcc090cd2337_30b288c666" tabindex="-1" value="" />
              </div>
              <input type="hidden" name="tags" value="2524065" />
              <button type="submit" class="btn btn-primary">Subscribe</button>
            </form>
          </>
        )}

        <div class="foot-contactline">
          <span>732.801.9611</span>
          <span>jonwolf@livewebstudios.com</span>
        </div>

        {/* Jon 2026-09-15: Facebook and Instagram, here and on the contact
            page. Closing the contact block, so the phone, the email and the
            two accounts read as one "how to reach us" group. */}
        <Social class="foot-social" />
        {/* Jon 2026-09-15: the Jon avatar closes the brand column, under the
            email address. Decorative: the name is already in the line above. */}
        <img class="foot-face" src={`${rel}images/lwsface.png`} alt="" width="300" height="304" loading="lazy" decoding="async" />
      </div>

      {/* The footer's own h2, so its column h3s always follow an h2 and never
          sit directly under the page h1. The 2026-09-14 pass moved the columns
          from h4 to h3, which fixed the 72 pages whose last body heading is an
          h2 but left every THIN page broken: a thank-you, the newsletter page
          or a form has no body h2 at all, so h1 -> h3 skipped a level there
          (11 pages, launch audit 2026-09-15). Anchoring the level inside the
          footer fixes it for any page, including ones not written yet.
          Hidden visually because the columns are self-evident on screen; a
          screen reader gets the landmark name it was missing. */}
      <h2 class="visually-hidden">Site navigation</h2>

      {cols.map((c) => (
        <div class="foot-col">
          <h3>{c.href ? <a class="foot-col__h" href={`${rel}${c.href}`}>{c.h}</a> : c.h}</h3>
          <ul>
            {c.links.map(([label, href, logo]) => {
              /* Sister companies with their own domain link out in a new tab
                 (Jon 2026-09-12: Live Web Photos is livewebphotos.com, there
                 is no local page). Internal links stay relative per the path
                 rule. */
              const ext = href.startsWith("http");
              const resolvedHref = ext ? href : `${rel}${href}`;
              return (
                <li class:list={[logo && "foot-logo-row"]}>
                  <a
                    href={resolvedHref}
                    target={ext ? "_blank" : undefined}
                    rel={ext ? "noopener noreferrer" : undefined}
                  >{logo
                    ? <img src={`${rel}${logo}`} alt={label} {...imageSize(logo)} loading="lazy" decoding="async" />
                    : label}</a>
                </li>
              );
            })}
          </ul>
          {c.sub && (
            <>
              <h3 class="foot-col__sub">{c.sub.h}</h3>
              <ul>
                {c.sub.links.map(([label, href]) => (
                  <li><a href={`${rel}${href}`}>{label}</a></li>
                ))}
              </ul>
            </>
          )}
        </div>
      ))}
    </div>

    <div class="foot-bottom">
      <div class="foot-legal">
        <p>© 2026 Live Web Studios · Powered by: <a href="https://livewebstudios.com" target="_blank" rel="noopener">Live Web Studios</a> · <a href={`${rel}privacy.html`}>Privacy</a> · <a href={`${rel}terms.html`}>Terms</a></p>
        <p class="foot-agent">No AI agent was harmed in the creation of this website.</p>
      </div>
      <a
        class="badge"
        href="https://livewebstudios.com"
        aria-label="Verified &amp; Secured by Live Web Studios"
      >
        <img src={`${rel}images/verifiedsecured.png`} alt="Verified &amp; Secured by Live Web Studios" width="150" height="37" loading="lazy" decoding="async" />
      </a>
    </div>

    {onBand ? (
      <p class="footer-bridge footer-bridge--lbws">
        Run a business offstage?{" "}
        <a href={`${rel}blog.html`}>
          The Live Web Studios blog covers websites and AI for small businesses
          <Arrow dir="out" />
        </a>
      </p>
    ) : (
      <p class="footer-bridge">
        <a href={`${rel}live-band-web-studios/blog.html`}>
          Musicians: the Live Band Web Studios blog
          <Arrow dir="out" />
        </a>
      </p>
    )}
  </div>
</footer>

<style>
  /* Footer layout — scoped, existing tokens only. */
  .foot-cols {
    display: grid;
    grid-template-columns: minmax(260px, 1.4fr) repeat(4, 1fr);
    gap: 2.5rem 2rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line-2);
  }
  .foot-tag {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 30ch;
    margin: 1rem 0 1.6rem;
  }
  .foot-loop {
    display: block;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    color: var(--muted-2);
    margin-bottom: 0.6rem;
  }
  /* Matches the hero button bar (Jon 2026-08-27): one continuous rounded
     bar, split by the field/button edge. Field takes the ghost half's fill,
     Subscribe takes the primary white half. */
  .foot-sub {
    display: flex;
    max-width: 340px;
  }
  .foot-sub input[type="email"] {
    flex: 1;
    min-width: 0;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid transparent;
    border-right: 0;
    border-radius: 6px 0 0 6px;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    line-height: 1.6;
    padding: 0.72rem 1.1rem;
  }
  .foot-sub input[type="email"]:focus {
    outline: none;
    background: rgba(255, 255, 255, 0.24);
  }
  .foot-sub input[type="email"]::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }
  .foot-sub .btn {
    border-radius: 0 6px 6px 0;
    line-height: 1.6;
    padding: 0.72rem 1.35rem;
    white-space: nowrap;
  }
  .foot-honeypot {
    position: absolute;
    left: -5000px;
  }
  /* :global because .foot-social is the <ul> inside the Social component, so
     it carries Social's scope hash, not this file's. A plain `.foot-social`
     rule here compiles to .foot-social[data-astro-cid-<footer>] and matches
     nothing, which is why the previous margin-top never took. Scoped through
     .foot-brand so it stays this footer's rule rather than a global one.
     Jon 2026-09-16: air between the email address and the two social icons,
     so the phone/email lines read as their own group. */
  .foot-brand :global(.foot-social) {
    margin-top: 1.5rem;
  }
  .foot-face {
    display: block;
    /* Half the brand column, whatever that column resolves to (Jon
       2026-09-15). Square source, so height follows the width. */
    width: 50%;
    height: auto;
    /* Under 900 the footer grid stacks to one column, so "half the column"
       becomes half the page. The cap holds the avatar at the size it lands
       on at desktop instead. */
    max-width: 170px;
    margin-top: 1.25rem;
    border-radius: 50%;
  }
  .foot-contactline {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 1.6rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .foot-col h3 {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  /* Scoped past .foot-col a (0.88rem, muted) so the linked heading keeps
     the h3's mono size and matches the unlinked column heads. */
  .foot-col h3 a.foot-col__h {
    color: inherit;
    font-size: inherit;
  }
  .foot-col h3 a.foot-col__h:hover {
    color: var(--cyan-soft);
  }
  /* Badge at exact intrinsic size so it stays crisp (150x37 native, the
     canonical asset from livewebstudios.com). Jon 2026-08-27: the old local
     copy was a 168x56 re-render with white padding baked in, which is what
     made it read as a framed box on the dark footer. */
  .foot-bottom :global(.badge img) {
    width: 150px;
    height: 37px;
  }
  /* Copyright line plus the AI-agent line stacked as one flex item, so the
     badge stays on the right instead of becoming a third column. */
  .foot-legal {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  /* Same orange as the Live AI Studios logo chevron (--ai, sampled from it). */
  .foot-bottom .foot-agent {
    color: var(--ai);
  }
  .foot-bottom p a {
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }
  .foot-bottom p a:hover {
    color: var(--cyan-soft);
  }
  .foot-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Studio logos (Jon 2026-10-10). Width-capped so the wide wordmarks and
     the taller Live Band badge sit in one even stack. */
  .foot-col ul:has(.foot-logo-row) {
    gap: 1.15rem;
  }
  .foot-logo-row a {
    display: inline-block;
    transition: opacity 0.2s var(--ease);
  }
  .foot-logo-row a:hover {
    opacity: 0.75;
  }
  .foot-logo-row img {
    display: block;
    width: 170px;
    max-width: 100%;
    height: auto;
  }
  .foot-logo-row:last-child img {
    width: 150px;
  }
  /* Second heading inside the Studios column (INSIGHTS). */
  .foot-col h3.foot-col__sub {
    margin-top: 2rem;
  }
  .foot-col a {
    color: var(--muted);
    font-size: 0.88rem;
    transition: color 0.2s var(--ease);
  }
  .foot-col a:hover {
    color: var(--cyan-soft);
  }
  @media (max-width: 1100px) {
    .foot-cols {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .foot-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .foot-cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
