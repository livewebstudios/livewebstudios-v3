---
/**
 * Footer — carries the location + industry search-entry pages (footer + sitemap
 * only, NOT top nav — people land on these from Google, they don't navigate to
 * them). Plus brand, quick links, services, contact, badge, and LWS credit.
 * Slugs here are the link targets; the pages themselves are built in 2D and any
 * slug change gets a _redirects line.
 *
 * Background: bg-blue-fog looping video on every page (strong scrim keeps the
 * dense footer text and links legible). The var(--bg-2) fill stays as fallback.
 */
import VideoBg from "./VideoBg.astro";
import { relPrefix } from "../lib/relPrefix";
const rel = relPrefix(Astro.url.pathname);

/* Town pages are a later phase (per Jon 2026-08-15: skip for now). The old
 * slugs (web-design-saddle-brook.html …) 404'd, so the town directory is
 * held out of the footer until those pages exist. */
const industries = [
  ["Construction", "industries/construction.html"],
  ["Law Firms", "industries/law-firm.html"],
  ["Dental", "industries/dental.html"],
  ["Healthcare", "industries/healthcare.html"],
  ["Real Estate", "industries/real-estate.html"],
  ["Financial Services", "industries/financial-services.html"],
  ["Insurance", "industries/insurance.html"],
  ["Manufacturing", "industries/manufacturing.html"],
  ["Nonprofit", "industries/nonprofit.html"],
  ["B2B", "industries/b2b.html"],
  ["Bands & Artists", "live-band-web-studios.html"],
];
---

<footer class="has-videobg">
  <VideoBg src="bg-blue-fog.mp4" scrim="strong" />
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <div class="foot-logo">
          <img src={`${rel}images/logoRGB.png`} alt="Live Web Studios" width="800" height="257" loading="lazy" decoding="async" />
        </div>
        <p>Built in North Jersey since 2004.</p>
      </div>
      <div>
        <h4>Explore</h4>
        <ul>
          <li><a href={`${rel}index.html`}>Home</a></li>
          <li><a href={`${rel}work.html`}>Work</a></li>
          <li><a href={`${rel}services.html`}>Services</a></li>
          <li><a href={`${rel}industries.html`}>Industries</a></li>
          <li><a href={`${rel}about.html`}>About</a></li>
          <li><a href={`${rel}blog.html`}>Blog</a></li>
          <li><a href={`${rel}faq.html`}>FAQ</a></li>
          <li><a href={`${rel}newsletter.html`}>Newsletter</a></li>
          <li><a href={`${rel}contact.html`}>Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Studios</h4>
        <ul>
          <li><a href={`${rel}live-band-web-studios.html`}>Live Band Web Studios</a></li>
          <li><a href={`${rel}namesake.html`}>Namesake</a></li>
          <li><a href={`${rel}ecosystem/live-web-photos.html`}>Live Web Photos</a></li>
          <li><a href={`${rel}ecosystem/live-ai-studios.html`}>Live AI Studios</a></li>
        </ul>
        <h4 class="foot-h4-gap">Pricing</h4>
        <ul>
          <li><a href={`${rel}pricing/design-pricing.html`}>Design</a></li>
          <li><a href={`${rel}pricing/hosting-pricing.html`}>Hosting</a></li>
          <li><a href={`${rel}pricing/seo-pricing.html`}>SEO</a></li>
          <li><a href={`${rel}pricing/seo-marketing-pricing.html`}>SEO &amp; AI Marketing</a></li>
        </ul>
      </div>
      <div class="foot-contact">
        <h4>Contact</h4>
        <span>732.801.9611</span>
        <span>jonwolf@livewebstudios.com</span>
        <span>446 Saddle River Rd., Unit 2</span>
        <span>Saddle Brook, NJ 07663</span>
      </div>
    </div>

    <div class="foot-directory">
      <div>
        <h4>Web Design by Industry</h4>
        <ul class="foot-dir-list">
          {industries.map(([label, href]) => (
            <li><a href={`${rel}${href}`}>{label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Legal</h4>
        <ul class="foot-dir-list">
          <li><a href={`${rel}privacy.html`}>Privacy Policy</a></li>
          <li><a href={`${rel}terms.html`}>Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <p>© 2026 Live Web Studios · All rights reserved · Built AI Platformed</p>
      <a
        class="badge"
        href="https://livewebstudios.com"
        aria-label="Verified &amp; Secured by Live Web Studios"
      >
        <img src={`${rel}images/verifiedsecured.png`} alt="Verified &amp; Secured by Live Web Studios" width="168" height="56" loading="lazy" decoding="async" />
      </a>
    </div>
    <p class="foot-credit">
      Built by <a href="https://livewebstudios.com">Live Web Studios</a>
    </p>
  </div>
</footer>

<style>
  .foot-h4-gap {
    margin-top: 1.6rem;
  }
</style>
