---
/**
 * BandSeoCards — the three "SEO Is Baked Into Every Build" cards for Live Band
 * Web Studios.
 *
 * Jon 2026-09-15: "create images for these cards." The art already existed and
 * was already on the band home page; the same three cards on /portfolio,
 * /personal-sites, /forms and /pricing were still rendering bare unicode
 * glyphs (⟨⟩ ◎ ▤) in a plain card, because the block had been pasted into five
 * pages and only one of them got the photography. This component is the single
 * copy: the data, the art, the markup and the card styling live here and every
 * page renders the same three cards.
 *
 * The section wrapper stays with the caller. Each page runs its own VideoBg,
 * heading and closing lede around this grid, and those differ page to page.
 *
 * Art lives in public/images/band/ and is shot in the same road-case-and-
 * work-lamp language as the rest of the Live Band photography.
 */
import Glass from "./Glass.astro";
import { relPrefix } from "../lib/relPrefix";

/* Built from the page's own depth: this renders at /live-band-web-studios and
   one level down at /live-band-web-studios/portfolio, so a single literal
   would 404 on one of them. Relative either way, per the LWS path rule. */
const rel = relPrefix(Astro.url.pathname);

const seo = [
  {
    art: "seo-schema-meta.jpg",
    alt: "A hand-drawn stage diagram on a road case lid with a pencil across it",
    title: "Schema & Meta, Done Right",
    body: "Structured data (schema markup), clean meta tags, and the right title and description on every page, so search engines understand exactly who you are and where you play.",
  },
  {
    art: "seo-the-words.jpg",
    alt: "A phone face up on a road case, an empty search field glowing on its screen",
    title: "The Words People Type",
    body: "We target the real search words and key phrases fans and talent buyers actually search, your genre, your cities, your venues, woven through every page.",
  },
  {
    art: "seo-blog-articles.jpg",
    alt: "A stack of printed pages and a notebook on a road case under a work lamp",
    title: "Blog Articles Engines Love",
    body: "Fresh articles every month, show recaps, new markets, gear talk, the steady, keyword-rich content search engines reward with higher rankings.",
  },
];
---

<div class="grid-svc">
  {seo.map((s) => (
    <div class="card lbs-card reveal">
      <Glass variant="inner" innerClass="lbs-card__inner">
        <div class="lbs-card__art">
          <img src={`${rel}images/band/${s.art}`} alt={s.alt} width="900" height="900" loading="lazy" decoding="async" />
        </div>
        <div class="card-pad">
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      </Glass>
    </div>
  ))}
</div>

<style>
  /* Card shell. The art bleeds to the edge and .card-pad owns the inset, so
     the inherited 2.4rem from .card .glass-inner is cleared here: left in, it
     framed the art AND sat outside the pad, giving every card two nested
     frames and a stack of vertical dead space. Amber keyline, the Live Band
     accent. Mirrors the build and How It Works cards on the band home page. */
  .lbs-card > :global(.glass-inner) {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r-md);
    border-color: rgba(252, 211, 77, 0.2);
    padding: 0;
  }
  /* 3:2 is what the build cards and the How It Works row both run, so all
     three read as one component. Widened on a narrow single-column layout,
     where a taller banner would run the full page width and push the copy
     off the screen. */
  .lbs-card__art {
    position: relative;
    flex: none;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-bottom: 1px solid rgba(252, 211, 77, 0.18);
  }
  @media (max-width: 900px) {
    .lbs-card__art { aspect-ratio: 16 / 9; }
  }
  /* Equal columns. The default 1fr is minmax(auto,1fr), so a card with a long
     unbreakable line can set a min-content width for its column and come out
     visibly wider than its neighbours. Gated to the 3-up range on purpose:
     Astro scopes this with an attribute selector, which outranks global.css's
     plain `.grid-svc` even inside its max-width:900px media query, so ungated
     it would hold three columns at phone width. */
  @media (min-width: 901px) {
    .grid-svc {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .lbs-card__art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    /* The sources are deliberately near-black amber stage light and need
       lifting to read at card size. Brightness, not saturation: there is
       almost no colour in those shadows to boost. */
    filter: brightness(1.35) contrast(103%);
    transform: scale(1.02);
    transition: transform 2.4s var(--ease), filter 0.4s var(--ease);
  }
  .lbs-card:hover .lbs-card__art img {
    transform: scale(1.1);
    filter: brightness(1.55) contrast(105%);
  }
  /* The base .card-pad carries height:100%, written for a pad that IS the
     whole card. Under a banner in an auto-height flex column that resolves
     against a height which already includes the pad, and the card inflates.
     Let flex size it from its content. */
  .lbs-card :global(.card-pad) {
    height: auto;
    padding: 1.6rem 2.4rem 1.5rem;
  }
  .lbs-card:hover > :global(.glass-inner) {
    border-color: rgba(252, 211, 77, 0.45);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 24px 60px rgba(0, 0, 0, 0.55),
      0 0 44px rgba(252, 211, 77, 0.14);
  }
  @media (prefers-reduced-motion: reduce) {
    .lbs-card__art img { transition: none; transform: none; }
    .lbs-card:hover .lbs-card__art img { transform: none; }
  }
</style>
