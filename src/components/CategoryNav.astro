---
/**
 * CategoryNav — the blog category bar. Its own band directly under the hero on
 * every blog page, deliberately OUTSIDE the 120px .sec-pad below it so the row
 * is reachable without scrolling.
 *
 * Jon 2026-09-15: no post counts, and "I want this page to be more obvious."
 * Three things do that work: a label saying what the row is, sentence case
 * rather than all caps (an all-caps mono row reads as decoration, and strips
 * the word shapes people scan by), and a border solid enough that the chips
 * read as controls instead of faint outlines. Type matches the main nav, mono
 * and sentence case, because this row IS navigation.
 *
 * Jon 2026-09-15: one component now renders BOTH chip bars. `audience` picks
 * the category set and the base path; the markup is identical, and the LBWS
 * pages re-skin it through the .theme-live-band wrapper they already sit in.
 *
 * The last chip is the bridge to the other blog. It is a link, not a filter,
 * so it is styled apart from the topic chips (accent border, ↗ arrow) and sits
 * after them with a divider. A visitor should never mistake it for a filter.
 *
 * Every href is built from relPrefix so one component works at all depths:
 * /blog, /blog/<post>, /blog/category/<cat>, and the three LBWS equivalents.
 */
import { relPrefix } from "../lib/relPrefix";
import { byAudience, type Audience } from "../lib/categories";
import Arrow from "./Arrow.astro";

export interface Props {
  /** Slug of the archive being viewed, if any. Marks that chip current. */
  current?: string;
  /** Slugs that have at least one published post. Anything else is skipped so
      the row never links to an archive page that was not built. */
  available: string[];
  /** True on the blog index itself, where "All posts" is the current page. */
  isIndex?: boolean;
  /** Which blog this bar belongs to. */
  audience?: Audience;
}
const {
  current,
  available,
  isIndex = false,
  audience = "business",
} = Astro.props;

const rel = relPrefix(Astro.url.pathname);
const shown = byAudience(audience).filter((c) => available.includes(c.slug));

/* Base path for this blog, and the bridge pointing at the other one. */
const base = audience === "musicians" ? "live-band-web-studios/blog" : "blog";
const bridge =
  audience === "musicians"
    ? { href: `${rel}blog.html`, label: "Live Web Studios", cls: "chip--to-lws" }
    : {
        href: `${rel}live-band-web-studios/blog.html`,
        label: "For Musicians",
        cls: "chip--to-lbws",
      };
---

<section class="cat-bar">
  <div class="wrap">
    <nav class="cat-nav" aria-label="Blog categories">
      <span class="cat-bar__label" id="cat-bar-label">Browse by topic</span>
      <ul class="cat-chips" aria-labelledby="cat-bar-label">
        <li>
          <a
            class:list={["cat-chip", { "is-current": isIndex }]}
            href={`${rel}${base}.html`}
            aria-current={isIndex ? "page" : undefined}
          >
            All posts
          </a>
        </li>
        {shown.map((c) => (
          <li>
            <a
              class:list={["cat-chip", { "is-current": c.slug === current }]}
              href={`${rel}${base}/category/${c.slug}.html`}
              aria-current={c.slug === current ? "page" : undefined}
            >
              {c.short}
            </a>
          </li>
        ))}
        <li class="cat-chips__bridge">
          <a class:list={["cat-chip", "chip--bridge", bridge.cls]} href={bridge.href}>
            {bridge.label}
            <Arrow dir="out" />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</section>
