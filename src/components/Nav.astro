---
/**
 * Nav — main navigation + optional sub-brand bar.
 *
 * The main nav renders on EVERY page (Jon 2026-08-15: sub-brands must not
 * replace it). Pages under /namesake or /live-band-web-studios also get a
 * second sticky sub-menu bar directly under the main nav with that brand's
 * links (LBWS uses its own logo, ported from the old site).
 *
 * Nav text is Title Case per Jon 2026-08-15 ("first letter caps"), which
 * overrides the older ALL CAPS nav rule for this site.
 *
 * SERVICES is a real link to services.html; its mega opens on hover (desktop)
 * or via the caret button (tap/click). STUDIOS keeps a plain toggle (no hub
 * page). All links are static HTML (crawlable); JS only enhances toggles and
 * the burger.
 */
import StudiosPanel from "./StudiosPanel.astro";
import NavIcon from "./NavIcon.astro";
import { relPrefix } from "../lib/relPrefix";

const path = Astro.url.pathname;
const rel = relPrefix(path);

type Ctx = "main" | "namesake" | "band";
const ctx: Ctx = path.includes("/namesake")
  ? "namesake"
  : path.includes("/live-band-web-studios")
    ? "band"
    : "main";

/* Services mega columns — every live service page, grouped.
   Each group carries one hue rather than giving all fourteen links their own:
   at this count per-item colour reads as confetti, where a colour per column
   reads as the structure it actually is. */
const svcCols = [
  {
    label: "BUILD",
    color: "#38BDF8",
    links: [
      ["Website Design", "services/website-design.html", "monitor"],
      ["E-Commerce", "services/ecommerce.html", "cart"],
      ["Hosting", "services/hosting.html", "server"],
      ["Maintenance Plans", "services/maintenance-plans.html", "gear"],
      ["SEO & Marketing", "services/seo.html", "search"],
    ],
  },
  {
    label: "AI",
    color: "#A78BFA",
    links: [
      ["AI Platform", "services/ai-platform.html", "chip"],
      ["AI Business Services", "services/ai-business-services.html", "bot"],
      ["AI Workflow", "services/ai-workflow.html", "route"],
      ["AI Image", "services/ai-image.html", "image"],
      /* Jon 2026-09-22. Fifth AI link rather than its own column: it is an AI
         voice-system build sold to the same small businesses the other four
         serve, so it does not need the separation Expert Witness needed. */
      ["Email Writing", "services/email-writing.html", "mail"],
    ],
  },
  {
    label: "BRAND",
    color: "#FCD34D",
    links: [
      ["Branding", "services/branding.html", "compass"],
      ["Logo Design", "services/logo-design.html", "pen"],
      ["Custom Styles & Cards", "services/custom-styles-and-carousel-cards.html", "cards"],
      ["Consulting", "services/consulting.html", "chat"],
    ],
  },
  /* Jon 2026-09-22. Its own column rather than a fourth BRAND link: the
     expert witness practice sells to attorneys, not to the small businesses
     the other twelve links sell to, and burying it under BRAND would have
     read as a design service. Brass, matching the numbered steps on the
     page itself. The scales glyph is the one Law Firm already uses. */
  {
    label: "LEGAL",
    color: "#C9A55A",
    links: [
      ["Expert Witness", "services/expert-witness.html", "scales"],
    ],
  },
];

/* Industries dropdown — all 10 verticals (Jon 2026-08-15). One hue across the
   set: these are peers, so colouring them apart would imply a grouping that
   does not exist. */
const indLinks = [
  ["Healthcare", "industries/healthcare.html", "cross"],
  ["Law Firm", "industries/law-firm.html", "scales"],
  ["Financial Services", "industries/financial-services.html", "bank"],
  ["Construction", "industries/construction.html", "hardhat"],
  ["Real Estate", "industries/real-estate.html", "towers"],
  ["Manufacturing", "industries/manufacturing.html", "factory"],
  ["Dental", "industries/dental.html", "tooth"],
  ["Nonprofit", "industries/nonprofit.html", "heart"],
  ["B2B", "industries/b2b.html", "briefcase"],
  ["Insurance", "industries/insurance.html", "shield"],
];

/* Sub-brand bars. Order and labels match the live site
   (build/live-band-web-studios/index.html lines 37-56). "Forms" stays a real
   link and also opens a dropdown of the four form pages. */
const bandLinks = [
  { label: "Home", href: "live-band-web-studios.html" },
  { label: "Pricing", href: "live-band-web-studios/pricing.html" },
  {
    label: "Forms",
    href: "live-band-web-studios/forms.html",
    children: [
      ["Band Bio Form", "live-band-web-studios/forms/band-bio-form.html"],
      ["Band Member Bio Form", "live-band-web-studios/forms/band-member-bio-form.html"],
      ["Music Photo Form", "live-band-web-studios/forms/music-photo-form.html"],
      ["Music Photo Instructions", "live-band-web-studios/forms/how-to-photograph-yourself-for-ai.html"],
    ],
  },
  { label: "Personal Sites", href: "live-band-web-studios/personal-sites.html" },
  { label: "Portfolio", href: "live-band-web-studios/portfolio.html" },
  /* Jon 2026-09-15: the musician blog belongs in the sub-brand bar too. The
     Studios dropdown gets a door to it from the rest of the site, but someone
     already inside Live Band needs it here, and needs the active state on it
     while they are reading. */
  { label: "Blog", href: "live-band-web-studios/blog.html" },
];

const namesakeLinks = [
  { label: "Overview", href: "namesake.html" },
  { label: "How It Works", href: "namesake/how-it-works.html" },
  { label: "Start", href: "namesake/start.html" },
];

/* Active state. Normalise both sides to a bare site-root key so the match
   survives build.format 'file' (/x.html), Netlify's clean URL (/x) and a
   trailing slash (/x/). The section index normalises to its own key, so
   Home/Overview lights up only on that page. */
const navKey = (href: string) => {
  const s = href.replace(/^\/+/, "").replace(/\/+$/, "").replace(/\.html$/, "");
  return s === "" ? "index" : s;
};
const here = navKey(path);
const subLinks = ctx === "band" ? bandLinks : namesakeLinks;

---

<header class="nav" data-nav>
  <div class="wrap nav-in">
    <a class="nav-logo" href={`${rel}index.html`} aria-label="Live Web Studios">
      <img src={`${rel}images/logoRGB.png`} alt="Live Web Studios" width="800" height="245" decoding="async" />
    </a>

    <nav class="nav-links" id="nav-links" aria-label="Primary">
      <a href={`${rel}work.html`}>Work</a>

      {/* studios--svc does for the services panel what studios--dir does for
          the directory one: drops the wrapper to static so the panel anchors
          to header.nav instead of this trigger. With four columns the panel
          is 900px, and centred on a trigger that sits left of centre it hung
          63px off the left edge at 1100. */}
      <div class="studios studios--svc" data-dd>
        <span class="dd-pair">
          <a class="studios-trigger" href={`${rel}services.html`}>Services</a>
          <button
            type="button"
            class="dd-toggle"
            aria-label="Open services menu"
            aria-expanded="false"
            aria-controls="services-panel"
            aria-haspopup="true"
          ><span class="studios-caret" aria-hidden="true">↓</span></button>
        </span>

        <div class="mega mega--services" id="services-panel" role="region" aria-label="Services">
          <div class="mega-inner svc-inner">
            <div class="svc-cols">
              {svcCols.map((col) => (
                <div class="svc-col">
                  <span class="svc-col-label">{col.label}</span>
                  {col.links.map(([label, href, icon]) => (
                    <a class="svc-link" href={`${rel}${href}`}>
                      <NavIcon name={icon} color={col.color} />
                      <span class="svc-link__txt">{label}</span>
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="studios" data-dd>
        <span class="dd-pair">
          <a class="studios-trigger" href={`${rel}industries.html`}>Industries</a>
          <button
            type="button"
            class="dd-toggle"
            aria-label="Open industries menu"
            aria-expanded="false"
            aria-controls="industries-panel"
            aria-haspopup="true"
          ><span class="studios-caret" aria-hidden="true">↓</span></button>
        </span>

        <div class="mega mega--industries" id="industries-panel" role="region" aria-label="Industries">
          <div class="mega-inner">
            <div class="ind-cols">
              {indLinks.map(([label, href, icon]) => (
                <a class="svc-link" href={`${rel}${href}`}>
                  <NavIcon name={icon} color="#7DD3FC" />
                  <span class="svc-link__txt">{label}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="studios" data-dd>
        <span class="dd-pair">
          <a class="studios-trigger" href={`${rel}about.html`}>About</a>
          <button
            type="button"
            class="dd-toggle"
            aria-label="Open about menu"
            aria-expanded="false"
            aria-controls="about-panel"
            aria-haspopup="true"
          ><span class="studios-caret" aria-hidden="true">↓</span></button>
        </span>

        <div class="mega mega--about" id="about-panel" role="region" aria-label="About">
          <div class="mega-inner">
            <div class="mega-support">
              <a class="mega-row" href={`${rel}about.html`}>
                <NavIcon name="book" color="#38BDF8" />
                <span class="mega-row__txt">
                  <span class="mega-row-title">Our Story →</span>
                  <span class="mega-row-sub">23 years in, just getting started</span>
                </span>
              </a>
              <a class="mega-row" href={`${rel}blog.html`}>
                <NavIcon name="pen" color="#38BDF8" />
                <span class="mega-row__txt">
                  <span class="mega-row-title">Blog →</span>
                  <span class="mega-row-sub">Web design, AI, SEO, and tangents</span>
                </span>
              </a>
              <a class="mega-row" href={`${rel}faq.html`}>
                <NavIcon name="help" color="#38BDF8" />
                <span class="mega-row__txt">
                  <span class="mega-row-title">FAQ →</span>
                  <span class="mega-row-sub">Straight answers, no sales pitch</span>
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* studios--dir carries the wide directory panel. The modifier exists
          so the panel can position against the header rather than this
          trigger: at 1080px wide, anchored to a trigger sitting near the end
          of the nav, it hung 116px off the left edge of the viewport. */}
      <div class="studios studios--dir" data-dd>
        <button
          type="button"
          class="studios-trigger"
          aria-expanded="false"
          aria-controls="studios-panel"
          aria-haspopup="true"
        >Studios <span class="studios-caret" aria-hidden="true">↓</span></button>
        <StudiosPanel here={here} />
      </div>

      <a href={`${rel}contact.html`}>Contact</a>
    </nav>

    <div class="nav-cta">
      <a href={`${rel}contact.html`} class="btn btn-primary">Let's Talk</a>
      <button
        type="button"
        class="burger"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-links"
      >☰</button>
    </div>
  </div>
</header>

{ctx !== "main" && (
  <div class={`subnav subnav--${ctx}`} data-subnav>
    <div class="wrap subnav-in">
      {ctx === "band" ? (
        <a class="subnav-brand" href={`${rel}live-band-web-studios.html`} aria-label="Live Band Web Studios">
          <img src={`${rel}images/logo-live-band.png`} alt="Live Band Web Studios" width="681" height="300" decoding="async" />
        </a>
      ) : (
        <a class="subnav-brand subnav-brand--ns" href={`${rel}namesake.html`}>Namesake</a>
      )}
      <nav class="subnav-links" aria-label={ctx === "band" ? "Live Band Web Studios" : "Namesake"}>
        {subLinks.map((item) => {
          const kids = item.children ?? [];
          const selfActive = navKey(item.href) === here;
          const kidActive = kids.some(([, kh]) => navKey(kh) === here);
          const active = selfActive || kidActive;
          const panelId = `subnav-${navKey(item.href).split("/").pop()}-panel`;

          return kids.length === 0 ? (
            <a
              href={`${rel}${item.href}`}
              class={active ? "is-active" : undefined}
              aria-current={selfActive ? "page" : undefined}
            >{item.label}</a>
          ) : (
            <span class="subnav-item studios" data-dd>
              <span class="dd-pair">
                <a
                  href={`${rel}${item.href}`}
                  class={active ? "is-active" : undefined}
                  aria-current={selfActive ? "page" : undefined}
                >{item.label}</a>
                <button
                  type="button"
                  class="dd-toggle"
                  aria-label={`Open ${item.label} menu`}
                  aria-expanded="false"
                  aria-controls={panelId}
                  aria-haspopup="true"
                ><span class="studios-caret" aria-hidden="true">↓</span></button>
              </span>

              <div class="mega subnav-drop" id={panelId} role="region" aria-label={item.label}>
                <div class="mega-inner">
                  {kids.map(([klabel, khref]) => (
                    <a
                      class="svc-link"
                      href={`${rel}${khref}`}
                      aria-current={navKey(khref) === here ? "page" : undefined}
                    >{klabel}</a>
                  ))}
                </div>
              </div>
            </span>
          );
        })}
      </nav>
      {ctx === "namesake" && (
        <a href={`${rel}namesake/start.html`} class="btn btn-ghost subnav-cta">Start Yours</a>
      )}
    </div>
  </div>
)}

<script is:inline>
  // Progressive enhancement: dropdown toggles ([data-dd] carets) + burger.
  // Hover-open is pure CSS; the toggle buttons serve tap/click users.
  (function () {
    var header = document.querySelector("[data-nav]");
    if (!header) return;

    // The sub-brand bar sits outside <header>, so scope the toggles to the
    // document and reuse this one system rather than adding a second.
    var dds = document.querySelectorAll("[data-dd]");
    var closeAll = function () {
      dds.forEach(function (dd) {
        dd.classList.remove("is-open");
        var t = dd.querySelector("button[aria-expanded]");
        if (t) t.setAttribute("aria-expanded", "false");
      });
    };
    dds.forEach(function (dd) {
      var toggle = dd.querySelector(".dd-toggle") || dd.querySelector("button.studios-trigger");
      if (!toggle) return;
      toggle.addEventListener("click", function (e) {
        e.stopPropagation();
        var wasOpen = dd.classList.contains("is-open");
        closeAll();
        if (!wasOpen) {
          dd.classList.add("is-open");
          toggle.setAttribute("aria-expanded", "true");
        }
      });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeAll();
    });
    document.addEventListener("click", function (e) {
      var inside = false;
      dds.forEach(function (dd) {
        if (dd.contains(e.target)) inside = true;
      });
      if (!inside) closeAll();
    });

    // --- Mobile burger menu ---
    var burger = header.querySelector(".burger");
    var closeBurger = function () {
      header.classList.remove("nav-open");
      if (burger) {
        burger.setAttribute("aria-expanded", "false");
        burger.textContent = "☰";
      }
    };
    if (burger) {
      burger.addEventListener("click", function () {
        var open = header.classList.toggle("nav-open");
        burger.setAttribute("aria-expanded", open ? "true" : "false");
        burger.textContent = open ? "✕" : "☰";
      });
    }

    // Crossing the 900px breakpoint with the drawer open left nav-open and any
    // .is-open panel set while the CSS switched back to the desktop bar, which
    // pinned a mega open with no pointer on it. Reset both on every crossing.
    var mq = window.matchMedia("(max-width: 900px)");
    var onBreakpoint = function () {
      closeBurger();
      closeAll();
    };
    if (mq.addEventListener) mq.addEventListener("change", onBreakpoint);
    else if (mq.addListener) mq.addListener(onBreakpoint);
  })();
</script>

<style>
  /* Services mega + sub-brand bar — scoped, existing tokens only. */
  .dd-pair {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
  }
  .dd-toggle {
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--muted);
    padding: 0.4rem 0.2rem;
    transition: color 0.2s var(--ease);
  }
  .dd-toggle:hover {
    color: var(--cyan-soft);
  }
  /* 900 not 720 (Jon 2026-09-22): the LEGAL column made this a 4-up grid, and
     four columns need 840px before "AI Business Services" and "Custom Styles
     & Cards" stop wrapping. .mega is centred on its trigger (left:50% +
     translateX(-50%) in global.css), so every extra 100px of panel hangs
     another 50px off the LEFT of the viewport. That is why the narrow case
     below drops the width back down instead of only changing the column
     count: a 900px panel over a 2-up grid was 127px off-screen at 960. */
  .mega--services {
    width: min(900px, 92vw);
    /* Hover bridge (Jon 2026-09-22: "sometimes the drop down closes before I
       get there"). Anchoring to header.nav moved top:100% from the trigger's
       bottom edge down to the header's, opening a 13px strip that belongs to
       neither the trigger nor the panel: cross it and .studios:hover goes
       false mid-travel. The negative margin pulls the panel's BOX back up to
       overlap the trigger while the matching padding holds the VISIBLE panel
       exactly where it was, so the pointer never leaves a hovered element. */
    margin-top: -29px;
    padding-top: 45px;
  }
  .mega--industries {
    width: min(480px, 92vw);
  }
  /* About holds three rows (Our Story, Blog, FAQ), so it sits narrower than
     the industries grid. FAQ lives here and nowhere else (Jon 2026-09-07).
     Blog joined 2026-09-15: the main row had 34px of slack at 1024px against
     the ~65px a seventh top-level item needs, so it would have collided with
     Let's Talk. A row here still puts a blog link on all 86 pages. */
  .mega--about {
    width: min(360px, 92vw);
  }
  /* .mega-support is a 2-col grid, which the Services/Industries panels use
     for their single row. About carries two, so stack them instead of
     squeezing both subtitles into 135px columns. */
  .mega--about .mega-support {
    grid-template-columns: 1fr;
  }
  .ind-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 0.5rem;
    margin-bottom: 0.4rem;
  }
  .svc-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  /* Below the panel's own max width there is no room for four, so pair them
     up rather than letting every label wrap, and bring the panel back in so
     its left edge clears the viewport. */
  @media (max-width: 980px) {
    .mega--services {
      width: min(560px, 92vw);
    }
    .svc-cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .svc-col {
    display: flex;
    flex-direction: column;
    gap: 0.08rem;
  }
  .svc-col-label {
    font-family: var(--mono);
    font-size: 0.56rem;
    letter-spacing: 0.2em;
    color: var(--cyan-soft);
    padding: 0.18rem 0.3rem 0.25rem;
  }
  .svc-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    padding: 0.21rem 0.3rem;
    border-radius: var(--r-sm);
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .svc-link__txt {
    min-width: 0;
  }
  /* The glyph sits a shade under the label at rest so the column still reads
     as a list of words, then comes up to full strength with the row. */
  .svc-link .nav-ico {
    opacity: 0.72;
    transition: opacity 0.2s var(--ease);
  }
  .svc-link:hover .nav-ico {
    opacity: 1;
  }
  .svc-link:hover {
    color: var(--ink-soft);
    background: rgba(56, 189, 248, 0.08);
  }
  /* The Forms dropdown reuses .svc-link but has no icons, so it keeps the
     original single-column text rhythm. */
  .subnav-drop .svc-link {
    display: block;
  }

  /* ---- Sub-brand bar: sticks flush under the main nav ---- */
  .subnav {
    position: sticky;
    top: var(--nav-h);
    z-index: 49;
    background: rgba(5, 7, 11, 0.66);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line-2);
  }
  .subnav-in {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.6rem;
    height: var(--subnav-h);
  }
  /* The lockup is deliberately taller than the bar (Jon 2026-09-12: bigger
     logo, same bar height). Taking it out of flow is what keeps that true —
     in flow it would simply grow the bar. It hangs DOWNWARD rather than
     sitting centred because the main nav stacks above this bar, so a
     vertically centred lockup would have its top edge clipped by it. */
  .subnav-brand {
    position: absolute;
    /* Absolute offsets resolve against .wrap's PADDING box, so left:0 would
       put the lockup hard against the viewport edge. Repeating .wrap's own
       padding-inline lines it up with the main nav's logo instead. */
    left: clamp(1.25rem, 4vw, 2.5rem);
    top: 2px;
    line-height: 0;
  }
  /* 68px -> 96px (Jon 2026-09-14: "make the live band logo larger"). The bar
     height is unchanged: the lockup is out of flow, so it just overhangs
     further into the hero below, which is the point of taking it out of flow
     in the first place. */
  .subnav-brand img {
    height: 96px;
    width: auto;
    display: block;
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.6));
  }
  /* Namesake's brand is a wordmark, not an oversized lockup, so it has
     nothing to overhang with: recentre it against the bar. */
  .subnav-brand--ns {
    top: 50%;
    transform: translateY(-50%);
    line-height: 1;
    font-family: var(--mono);
    font-size: 0.86rem;
    letter-spacing: 0.22em;
    color: var(--brass, #c9a55a);
  }
  /* Segmented control, matching the main nav's treatment: one hairline box
     with a divider between each cell. Same --line-nav token, so the two bars
     stay in step if that value ever moves. */
  .subnav-links {
    display: flex;
    align-items: stretch;
    gap: 0;
    border: 1px solid var(--line-nav);
  }
  .subnav-links > a,
  .subnav-links > .subnav-item {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.05rem;
    border-right: 1px solid var(--line-nav);
  }
  .subnav-links > :last-child {
    border-right: 0;
  }
  .subnav-links > a:hover,
  .subnav-links > .subnav-item:hover {
    background: rgb(var(--mosa-fg-rgb) / 0.07);
  }
  /* NAV TEXT RULE: every navigation link, sub-menus included, is ALL CAPS. */
  .subnav-links a,
  .subnav-drop .svc-link {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }
  .subnav-links a:hover {
    color: var(--cyan-soft);
  }
  .subnav-cta {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    padding: 0.4rem 0.9rem;
    font-size: 0.68rem;
  }

  /* Current page, in the section accent. No new colors: amber for Live Band,
     brass for Namesake, both already in the palette. */
