---
/**
 * Nav: the studio strip, then ONE nav bar for whichever studio the page is in.
 *
 * Jon 2026-11-16 (five-studio navigation). This reverses the 2026-08-15 rule
 * that sub-brands must not replace the main nav. Live Web Studios pages get
 * the main nav; a sub-site page gets that studio's nav alone, promoted to the
 * full 84px bar. There is no second stacked bar any more. The main site's
 * links stay reachable from a sub-site through the Live Web Studios tab in
 * the strip (desktop) and the boxed group at the foot of the sheet (mobile).
 *
 * Sticky at top:var(--strip-h), full size, no shrink on scroll. Jon tried the
 * floating pill and rejected it.
 *
 * Live Web Studios links are Title Case sans (Jon 2026-08-15, which overrides
 * the older ALL CAPS nav rule for this site). Sub-site links keep their mono,
 * uppercase, letter-spaced style, tinted with the studio accent.
 *
 * SERVICES is a real link to services.html and ABOUT a real link to
 * about.html; each also opens a panel on hover, or from its caret button on
 * tap, click and keyboard. Every link is static HTML (crawlable). JS only
 * enhances: the hover delay, the caret toggles, the rail swap, the burger.
 *
 * The bar is a solid colour on purpose. A backdrop-filter on the header
 * would switch off the blur on the glass panels that hang from it.
 */
import StudioStrip from "./StudioStrip.astro";
import { relPrefix } from "../lib/relPrefix";
import {
  studioFromPath,
  studioByKey,
  studioNav,
  lwsLinks,
  aboutRows,
  servicePanes,
  link,
} from "../lib/studios";

const path = Astro.url.pathname;
const rel = relPrefix(path);
const ctx = studioFromPath(path);
const nav = studioNav[ctx];
const home = studioByKey(ctx).href;

/* Active state. Normalise both sides to a bare site-root key so the match
   survives build.format 'file' (/x.html), Netlify's clean URL (/x) and a
   trailing slash (/x/). The section index normalises to its own key, so
   Home/Overview lights up only on that page. */
const navKey = (href: string) => {
  const s = href.replace(/^\/+/, "").replace(/\/+$/, "").replace(/\.html$/, "");
  return s === "" ? "index" : s;
};
const here = navKey(path);
/* A link is active on its own page, and a section index link is also active
   on the pages filed under it (Insights on /ai/blog/<slug>). Home is exempt
   so it stays lit only on the section index itself. */
const isSection = (href: string) =>
  ctx === "ai" && navKey(href) === "ai/blog" && here.startsWith("ai/blog/");

/* Column colours in the Services panel. Web Services keeps one hue per
   column (Build cyan, Brand gold, Legal brass); every other studio's pane
   runs in that studio's soft tint. */
const paneTint: Record<string, { rgb: string; cols: string[] }> = {
  lws: { rgb: "56 189 248", cols: ["#38BDF8", "#FCD34D", "#C9A55A"] },
  band: { rgb: "252 211 77", cols: ["#FCD34D"] },
  ai: { rgb: "232 101 10", cols: ["#F6A066"] },
  lwp: { rgb: "233 30 140", cols: ["#F472B6"] },
  ns: { rgb: "74 222 128", cols: ["#86EFAC"] },
};
---

<StudioStrip />

<header class={`sitenav sitenav--${ctx}`} data-nav>
  <div class="sitenav-in">
    <a class={`sn-logo sn-logo--${ctx}`} href={link(rel, home)} aria-label={nav.logo.alt}>
      <img
        src={`${rel}${nav.logo.src}`}
        alt={nav.logo.alt}
        width={nav.logo.width}
        height={nav.logo.height}
        decoding="async"
      />
    </a>

    <div class="sn-sheet" id="nav-links">
      <nav class="sn-links" aria-label={nav.label}>
        {nav.links.map((item) => {
          const mega =
            ctx !== "lws" ? null : item.label === "Services" ? "services" : item.label === "About" ? "about" : null;
          const kids = item.children ?? [];
          const selfActive = navKey(item.href) === here;
          const kidActive = kids.some(([, kh]) => navKey(kh) === here);
          const active = selfActive || kidActive || isSection(item.href);
          const current = selfActive ? "page" : active ? "true" : undefined;

          if (!mega && kids.length === 0) {
            return (
              <a class="sn-cell sn-link" href={link(rel, item.href)} aria-current={current}>{item.label}</a>
            );
          }

          const panelId = mega ? `${mega}-panel` : `nav-${navKey(item.href).split("/").pop()}-panel`;
          return (
            <div class:list={["sn-cell", "sn-dd", `sn-dd--${mega ?? "drop"}`]} data-dd={mega ?? "drop"}>
              <span class="sn-pair">
                <a class="sn-link" href={link(rel, item.href)} aria-current={current}>{item.label}</a>
                <button
                  type="button"
                  class="sn-caret"
                  aria-label={`Open ${item.label} menu`}
                  aria-expanded="false"
                  aria-controls={panelId}
                ><span aria-hidden="true">↓</span></button>
              </span>

              {mega === "services" && (
                <div class="sn-mega sn-mega--services" id={panelId} role="region" aria-label="Services">
                  {/* Each pane sits straight after its rail row in the source,
                      so Tab walks row, that row's links, next row. The grid
                      puts the rows in column one and the live pane in column
                      two whatever the source order. */}
                  <div class="svc" data-svc>
                    <p class="svc-head">Start here</p>
                    {servicePanes.map((pane, i) => {
                      const tint = paneTint[pane.key];
                      return (
                        <>
                          <a
                            class:list={["svc-rail", i === 0 && "is-on"]}
                            href={link(rel, studioByKey(pane.key).href)}
                            data-pane={pane.key}
                            style={`--r:${tint.rgb};grid-row:${i + 2}`}
                          >{pane.rail} <span aria-hidden="true">→</span></a>
                          <div
                            class:list={["svc-pane", `svc-pane--${pane.key}`, i === 0 && "is-on"]}
                            data-pane={pane.key}
                          >
                            {pane.cols.map((col, c) => (
                              <div class="svc-col" style={`--k:${tint.cols[c] ?? tint.cols[0]}`}>
                                <p class="svc-col-head">{col.heading}</p>
                                {col.links.map(([label, href]) => (
                                  <a href={link(rel, href)}>{label}</a>
                                ))}
                              </div>
                            ))}
                          </div>
                        </>
                      );
                    })}
                  </div>
                </div>
              )}

              {mega === "about" && (
                <div class="sn-mega sn-mega--about" id={panelId} role="region" aria-label="About">
                  {aboutRows.map((row) => (
                    <a class="about-row" href={link(rel, row.href)}>
                      <span class="about-row-title">{row.title} →</span>
                      <span class="about-row-sub">{row.sub}</span>
                    </a>
                  ))}
                </div>
              )}

              {!mega && (
                <div class="sn-mega sn-mega--drop" id={panelId} role="region" aria-label={item.label}>
                  {kids.map(([klabel, khref]) => (
                    <a
                      class="drop-link"
                      href={link(rel, khref)}
                      aria-current={navKey(khref) === here ? "page" : undefined}
                    >{klabel}</a>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </nav>

      {/* Mobile sheet only: the parent site's links, boxed, on a sub-site. */}
      {ctx !== "lws" && (
        <nav class="sn-parent" aria-label="Live Web Studios">
          <span class="sn-parent-label">LIVE WEB STUDIOS</span>
          {lwsLinks.map((l) => (
            <a href={link(rel, l.href)}>{l.label} <span aria-hidden="true">→</span></a>
          ))}
        </nav>
      )}
    </div>

    <div class="sn-right">
      <a class="sn-btn" href={link(rel, nav.cta.href)}>{nav.cta.label}</a>
      <button
        type="button"
        class="sn-burger"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-links"
      >☰</button>
    </div>
  </div>
</header>

<script is:inline>
  // Progressive enhancement. Without this script the panels still open on
  // hover and on focus in CSS, and every link is a plain link.
  (function () {
    var header = document.querySelector("[data-nav]");
    if (!header) return;
    header.classList.add("is-js");

    var mq = window.matchMedia("(max-width: 980px)");
    var dds = header.querySelectorAll("[data-dd]");
    var svc = header.querySelector("[data-svc]");
    var timer;

    var showPane = function (key) {
      if (!svc) return;
      svc.querySelectorAll("[data-pane]").forEach(function (el) {
        el.classList.toggle("is-on", el.dataset.pane === key);
      });
    };
    var setOpen = function (dd, open) {
      var was = dd.classList.contains("is-open");
      if (was === open) return;
      dd.classList.toggle("is-open", open);
      var btn = dd.querySelector(".sn-caret");
      if (btn) btn.setAttribute("aria-expanded", open ? "true" : "false");
      // The Services panel always opens on Web Services.
      if (open && dd.dataset.dd === "services") showPane("lws");
    };
    var closeAll = function (except) {
      dds.forEach(function (dd) {
        if (dd !== except) setOpen(dd, false);
      });
    };

    dds.forEach(function (dd) {
      var btn = dd.querySelector(".sn-caret");
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        clearTimeout(timer);
        var was = dd.classList.contains("is-open");
        // On the bar one panel shows at a time; in the sheet they are
        // independent accordions.
        if (!mq.matches) closeAll(dd);
        setOpen(dd, !was);
      });
      // Open on hover, and stay open while the pointer is on the trigger or
      // the panel. The 180ms grace covers the trip between the two.
      dd.addEventListener("mouseenter", function () {
        if (mq.matches) return;
        clearTimeout(timer);
        closeAll(dd);
        setOpen(dd, true);
      });
      dd.addEventListener("mouseleave", function () {
        if (mq.matches) return;
        clearTimeout(timer);
        timer = setTimeout(function () { setOpen(dd, false); }, 180);
      });
      dd.addEventListener("focusout", function (e) {
        if (mq.matches) return;
        if (!dd.contains(e.relatedTarget)) setOpen(dd, false);
      });
    });

    // Services rail: hover or focus a row and the right side swaps to that
    // studio's list. A click goes to the studio home. On a touch screen the
    // first tap on a row shows its list and the second tap follows the link.
    if (svc) {
      svc.querySelectorAll(".svc-rail").forEach(function (row) {
        var key = row.dataset.pane;
        var touchSwap = false;
        row.addEventListener("pointerdown", function (e) {
          touchSwap = e.pointerType === "touch" && !row.classList.contains("is-on");
        });
        row.addEventListener("mouseenter", function () { showPane(key); });
        row.addEventListener("focus", function () { showPane(key); });
        row.addEventListener("click", function (e) {
          if (touchSwap) {
            e.preventDefault();
            showPane(key);
          }
          touchSwap = false;
        });
      });
    }

    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      dds.forEach(function (dd) {
        if (!dd.classList.contains("is-open")) return;
        // Hand focus back to the trigger before the panel hides under it.
        if (dd.contains(document.activeElement)) dd.querySelector(".sn-caret").focus();
        setOpen(dd, false);
      });
    });
    document.addEventListener("click", function (e) {
      if (mq.matches) return;
      if (!e.target.closest || !e.target.closest("[data-dd]")) closeAll();
    });

    // --- Mobile sheet ---
    var burger = header.querySelector(".sn-burger");
    var setSheet = function (open) {
      header.classList.toggle("nav-open", open);
      burger.setAttribute("aria-expanded", open ? "true" : "false");
      burger.textContent = open ? "✕" : "☰";
    };
    burger.addEventListener("click", function () {
      setSheet(!header.classList.contains("nav-open"));
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && header.classList.contains("nav-open")) {
        setSheet(false);
        burger.focus();
      }
    });

    // Crossing the breakpoint with the sheet or a panel open would carry that
    // state into a layout it was not opened in. Reset both on every crossing.
    var onBreakpoint = function () {
      clearTimeout(timer);
      setSheet(false);
      closeAll();
    };
    if (mq.addEventListener) mq.addEventListener("change", onBreakpoint);
    else if (mq.addListener) mq.addListener(onBreakpoint);
  })();
</script>

<style>
  /* ============================================================
     Bar
     ============================================================ */
  .sitenav {
    /* Height of the bordered link box inside the bar. */
    --sn-box: 56px;
    position: sticky;
    top: var(--strip-h);
    z-index: 50;
    box-sizing: border-box;
    height: var(--nav-h);
    background: #000;
    /* The hairline is an inset shadow, not a border, so the bar's content box
       is the full --nav-h and a panel at top:100% lands flush under it. */
    box-shadow: inset 0 -1px 0 rgb(var(--studio-rgb) / 0.22);
  }
  .sitenav-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 100%;
    padding-inline: clamp(1rem, 3vw, 2.5rem);
  }
  /* The logo is the one flexible item in the bar. Each studio's lockup has a
     height it wants (max-height below); when a phone is too narrow for logo,
     button and burger at full size, the logo gives up width and scales down
     in proportion instead of pushing the burger off the edge. */
  .sn-logo {
    display: flex;
    align-items: center;
    /* Full bar height, so a short lockup is still a full-size tap target. */
    align-self: stretch;
    flex: 0 1 auto;
    min-width: 0;
  }
  .sn-logo img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 50px;
  }
  .sn-logo--band img { max-height: 70px; }
  .sn-logo--ai img { max-height: 28px; }
  .sn-logo--lwp img { max-height: 44px; }
  .sn-logo--ns img { max-height: 44px; }
  .sn-logo:focus-visible,
  .sn-link:focus-visible,
  .sn-caret:focus-visible,
  .sn-btn:focus-visible,
  .sn-burger:focus-visible,
  .sn-mega a:focus-visible,
  .sn-parent a:focus-visible {
    outline: 2px solid var(--studio-soft);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* ---- Link box: one hairline frame, a divider between cells ---- */
  .sn-sheet {
    display: flex;
    flex: none;
  }
  .sn-links {
    display: flex;
    align-items: stretch;
    box-sizing: border-box;
    height: var(--sn-box);
    border: 1px solid rgb(var(--studio-rgb) / 0.34);
    border-radius: 6px;
  }
  .sn-cell {
    display: flex;
    align-items: stretch;
    border-left: 1px solid rgb(var(--studio-rgb) / 0.34);
    transition: background 0.2s var(--ease);
  }
  .sn-cell:first-child {
    border-left: 0;
    border-radius: 5px 0 0 5px;
  }
  .sn-cell:last-child {
    border-radius: 0 5px 5px 0;
  }
  .sn-cell:hover,
  .sn-dd.is-open {
    background: rgb(255 255 255 / 0.07);
  }
  .sitenav--lws .sn-links,
  .sitenav--lws .sn-cell {
    border-color: rgb(255 255 255 / 0.2);
  }
  .sn-link {
    display: flex;
    align-items: center;
    padding-inline: clamp(12px, 1.7vw, 24px);
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    color: var(--ink-soft);
    white-space: nowrap;
    /* Reserved so the current page's underline does not shift the label. */
    border-bottom: 2px solid transparent;
    transition: color 0.2s var(--ease);
  }
  /* Sub-sites: mono, uppercase, letter-spaced, as their bars always were. */
  .sitenav:not(.sitenav--lws) .sn-link {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .sn-link[aria-current] {
    color: var(--studio-soft);
    border-bottom-color: var(--studio);
  }

  /* ---- Dropdown cell: label + caret, panel hangs under the bar ---- */
  .sn-dd {
    position: relative;
  }
  /* The Services panel is as wide as the bar, so it anchors to the header
     rather than to its trigger. */
  .sn-dd--services {
    position: static;
  }
  .sn-pair {
    display: flex;
    align-items: stretch;
  }
  .sn-pair .sn-link {
    padding-right: 4px;
  }
  .sn-caret {
    display: flex;
    align-items: center;
    padding: 0 clamp(10px, 1.4vw, 18px) 0 4px;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    font-size: 13px;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .sn-caret span {
    display: inline-block;
    transition: transform 0.25s var(--ease);
  }
  .sn-dd.is-open .sn-caret span {
    transform: rotate(180deg);
  }
  .sn-pair:has(.sn-link[aria-current]) .sn-caret {
    color: var(--studio-soft);
    border-bottom-color: var(--studio);
  }

  /* ---- Button ---- */
  .sn-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }
  .sn-btn {
    display: flex;
    align-items: center;
    height: 50px;
    padding: 0 24px;
    border-radius: 6px;
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    background: #fff;
    color: #05070b;
    transition: filter 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .sitenav--band .sn-btn { background: var(--amber); color: #120c02; }
  .sitenav--ai .sn-btn { background: #f0792a; color: #120c09; }
  .sitenav--lwp .sn-btn { background: var(--lwp-soft); color: #16060f; }
  .sitenav--ns .sn-btn { background: var(--namesake-soft); color: #07140c; }
  .sn-btn:hover {
    filter: brightness(1.08);
  }
  .sitenav--lws .sn-btn:hover {
    filter: none;
    background: var(--cyan-soft);
  }
  .sn-btn:active {
    transform: translateY(1px);
  }
  .sn-burger {
    display: none;
    width: 44px;
    height: 44px;
    background: none;
    border: 1px solid rgb(var(--studio-rgb) / 0.4);
    border-radius: 6px;
    font-size: 18px;
    line-height: 1;
    color: var(--studio-soft);
    cursor: pointer;
  }
  .sn-parent {
    display: none;
  }

  /* ============================================================
     Panels. One glass style for all of them, attached flush under the
     bar with 16px bottom corners.
     ============================================================ */
  .sn-mega {
    position: absolute;
    /* From the cell's bottom edge down to the bar's: half the space the link
       box leaves in the bar, plus the box's own 1px frame. */
    top: calc(100% + (var(--nav-h) - var(--sn-box)) / 2 + 1px);
    z-index: 1;
    box-sizing: border-box;
    padding: 22px;
    border-radius: 0 0 16px 16px;
    background: rgb(8 12 20 / 0.86);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    backdrop-filter: blur(22px) saturate(150%);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-top: 0;
    box-shadow: 0 30px 70px rgb(0 0 0 / 0.55), inset 0 1px 0 rgb(255 255 255 / 0.06);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-6px);
    /* Closing: visibility waits out the fade, then drops. Opening (below): it
       flips at once, so the panel's links are focusable the instant the
       caret is pressed rather than one frame later. */
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0s linear 0.2s;
  }
  .sn-dd.is-open > .sn-mega,
  .sitenav:not(.is-js) .sn-dd:hover > .sn-mega,
  .sitenav:not(.is-js) .sn-dd:focus-within > .sn-mega {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    transition-delay: 0s;
  }
  /* Covers the strip of bar between a cell and its panel, so the pointer is
     always over something that belongs to the dropdown on the way down. */
  .sn-mega--about::before,
  .sn-mega--drop::before,
  .sitenav:not(.is-js) .sn-mega--services::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: calc((var(--nav-h) - var(--sn-box)) / 2 + 2px);
  }

  /* ---- Services: "Start here" rail + the hovered studio's list ---- */
  .sn-mega--services {
    top: 100%;
    left: 0;
    right: 0;
    width: min(1160px, calc(100% - 2rem));
    margin-inline: auto;
  }
  .svc {
    display: grid;
    grid-template-columns: 298px minmax(0, 1fr);
    grid-template-rows: auto repeat(5, auto) 1fr;
    column-gap: 22px;
    min-height: 300px;
  }
  .svc-head,
  .svc-col-head {
    margin: 0 0 8px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    line-height: 1.5;
    text-transform: uppercase;
    color: #a9b5c4;
  }
  .svc-head {
    grid-column: 1;
    grid-row: 1;
  }
  .svc-rail {
    grid-column: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 44px;
    margin-bottom: 6px;
    padding: 0 12px;
    border-radius: 8px;
    font-family: var(--sans);
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.2;
    color: #fff;
    background: linear-gradient(135deg, rgb(var(--r) / 0.16), rgb(var(--r) / 0.04));
    border: 1px solid rgb(var(--r) / 0.4);
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .svc-rail span {
    color: rgb(var(--r));
    transition: transform 0.2s var(--ease);
  }
  .svc-rail:hover {
    background: rgb(var(--r) / 0.24);
  }
  .svc-rail.is-on {
    background: rgb(var(--r) / 0.3);
    border-color: rgb(var(--r));
  }
  .svc-rail.is-on span {
    transform: translateX(3px);
  }
  .svc-pane {
    grid-column: 2;
    grid-row: 1 / -1;
    display: none;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 26px;
    align-content: start;
    padding-left: 26px;
    border-left: 1px solid rgb(255 255 255 / 0.1);
  }
  .svc-pane.is-on {
    display: grid;
    /* The list swaps under a moving pointer. A short fade reads as one panel
       changing its contents; a hard cut read as a flicker. */
    animation: svc-pane-in 0.14s var(--ease);
  }
  @keyframes svc-pane-in {
    from { opacity: 0; }
  }
  .svc-col-head {
    color: var(--k);
  }
  .svc-col a {
    display: flex;
    align-items: center;
    gap: 10px;
