---
/**
 * ServiceCard — the service card used on the home, services and industries grids.
 *
 * Extracted from services.astro (Jon 2026-08-27: "make the home cards look
 * exactly like the services cards") so both pages render from one source
 * instead of two copies drifting apart. Markup + styles travel together;
 * the styles are scoped, so nothing leaks to other card variants.
 *
 * Each line of text sits in its own translucent bubble over the art, and the
 * CTA stays bare. art="metal" tiles the weave; art="cloud" cover-fits a bitmap.
 *
 * The lens refraction overlay was removed 2026-09-07 (Jon: "delete that scan
 * line EVERYWHERE"). It existed only to bend the page scan line, so with the
 * line gone it had nothing to refract. Its markup, its .card--lens global
 * stylesheet and the ScanLines driver all went with it.
 */
import CardIcon from "./CardIcon.astro";

export interface Props {
  title: string;
  body: string;
  href: string;
  /** Relative path to the card art, e.g. "images/services/blue-clouds.jpg" */
  bg: string;
  /** Optional corner flag, e.g. "NEW" */
  tag?: string;
  /** CTA label. "Learn More" is a forbidden phrase, so the default is used. */
  cta?: string;
  /**
   * Art treatment. "cloud" is the blue-cloud default used on /services.
   * "metal" retunes the stack for the dark carbon weave the home page uses:
   * that art is already near-black, so the scrim and edge vignette have to
   * come down or the card reads as a flat black rectangle. It also paints
   * the art as a repeating tile rather than one cover-fitted bitmap - see
   * the .card-weave note below.
   */
  art?: "cloud" | "metal";
}

const { title, body, href, bg, tag, cta = "SEE DETAILS →", art = "cloud" } = Astro.props;

/* The weave is tiled from CSS, but the path has to stay relative per the
   project path rule and only the caller knows its depth. So it arrives as a
   prop and is handed to CSS as a custom property rather than hard-coded in
   a stylesheet url(), which would resolve against the bundled CSS instead. */
const isMetal = art === "metal";
---

<div
  class:list={["card", "reveal", "card--bg", `card--art-${art}`]}
  style={isMetal ? `--card-weave: url("${bg}")` : undefined}
>
  {isMetal
    ? <div class="card-weave" aria-hidden="true"></div>
    : <img class="card-bg-img" src={bg} alt="" loading="lazy" decoding="async" />}
  <div class="card-bg-scrim" aria-hidden="true"></div>
  <div class="card-pad card-bg-content">
    <h3>{title}{tag && <span class="tag-new">{tag}</span>}</h3>
    <p>{body}</p>
    <CardIcon title={title} />
    <a class="more" href={href}>{cta}</a>
  </div>
</div>

<style>
  /* Cards with generated background art: image + scrim keep text readable */
  .card--bg {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .card--bg:hover {
    border-color: rgba(56, 189, 248, 0.35);
  }
  /* Fills the whole card: max-width:none overrides the global img cap that
     left a dark band on the right edge. Base scale gives drift headroom. */
  .card-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    z-index: 0;
    opacity: 0.9;
    /* Heavy refraction: the cloud art bends and splits into colour fringes,
       as through thick glass (Jon 2026-08-27). Filter lives in Base.astro.
       Scaled up so the filter's displaced edges never expose the card. */
    filter: url(#lws-glass) saturate(150%) contrast(108%);
    transform: scale(1.12);
    transition: transform 2.5s var(--ease);
    will-change: transform;
  }
  /* Clouds zoom in slowly on hover (no pan, no mirror — Jon 2026-08-19) */
  .card--bg:hover .card-bg-img {
    transform: scale(1.3);
  }
  .card-bg-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(5, 7, 11, 0.20) 0%, rgba(5, 7, 11, 0.42) 100%);
  }

  /* Convex lens shell: specular crown up top, a second bounce at the bottom,
     a lit rim, and edge darkening — the read of a thick curved glass blank
     sitting on the art (Jon 2026-08-27). */
  .card--bg::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
    background:
      radial-gradient(130% 78% at 50% -14%, rgba(255, 255, 255, 0.17), rgba(255, 255, 255, 0.04) 46%, transparent 62%),
      radial-gradient(110% 60% at 50% 114%, rgba(255, 255, 255, 0.09), transparent 58%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      inset 0 0 70px rgba(0, 0, 0, 0.55);
  }

  .card-bg-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Each line of card text sits in its own translucent bubble over the
     cloud art (Jon 2026-08-27, MOSA reference). SEE DETAILS stays bare. */
  .card-bg-content > h3,
  .card-bg-content > p {
    width: fit-content;
    max-width: 100%;
    background: rgba(5, 7, 11, 0.78);
    backdrop-filter: blur(10px) saturate(130%);
    -webkit-backdrop-filter: blur(10px) saturate(130%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 0.55rem 0.8rem;
  }
  .card-bg-content > h3 { margin-bottom: 0.7rem; }

  /* Card titles in the mono face (Jon 2026-09-15: "wasn't this a techie font
     before? I liked that"). The v3 skin set every card heading in Geist sans;
     these go back to the mono the rest of the system uses for labels and nav.
     Mono glyphs are wider, so the size steps down to keep the same wrap count
     and the same block of type inside the bubble.

     Scoped to this component, so it reaches the card grids on the home,
     services and industries pages and nothing else. Specificity beats the
     skin's `.card h3` sans rule without !important. */
  .card-bg-content > h3 {
    font-family: var(--mono);
    font-size: clamp(0.95rem, 1.15vw, 1.08rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.42;
  }

  /* ---- Metal variant (home page, 2026-09-02) --------------------
     The carbon weave is near-black and greyscale, so:
     1. Lift it. saturate() does nothing on a greyscale texture, so it is
        dropped for brightness, which is what this art actually needs.
     2. Pull the black back. Scrim and the ::after edge vignette were
        tuned against bright cloud art; over near-black they just fill
        the card in. Text bubbles still carry readability.

     Scale: first pass ran 1.9/2.15 to guard against moire. Jon 2026-09-02
     wants the weave tighter, so it sits on the base 1.12/1.3 instead,
     which is as small as this art can go. object-fit:cover means 1.0 is
     the floor (below that the image stops covering), and the base 1.12
     is the headroom the #lws-glass displacement needs so its bent edges
     never expose the card corner. Going tighter than this meant giving up
     on cover-fitting one bitmap and tiling instead, which is what the
     .card-weave block below now does. This rule is the cloud path only. */
  /* Tiled weave (Jon 2026-09-07: "that grain texture is too large... show
     more of the texture in each box so the grain is tighter").

     There was no zooming out to be had: metal-bg.jpg is 2048 square in a
     ~420px card, so object-fit:cover was already showing essentially the
     whole frame. The only way to get more weave into the box is to repeat
     it, and that file will not repeat - it carries a lit centre, so tiling
     it printed a grid of bright spots. metal-weave.jpg is the same texture
     with the lighting divided out and the seam rolled to the interior and
     healed, so it repeats cleanly.

     336px tile shown at 168px: an exact 2:1 downscale at 1x DPR and native
     at 2x, so the weave never lands on a fractional sample and moires. Size
     is fixed in px rather than a percentage so the grain stays constant
     instead of stretching with the card at different breakpoints.

     #lws-glass is deliberately absent. That displacement filter was tuned to
     bend big soft cloud forms; run over a 4px weave it just smears it. */
  .card-weave {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--card-weave);
    background-repeat: repeat;
    background-size: var(--card-weave-size, 168px) var(--card-weave-size, 168px);
    filter: brightness(1.45) contrast(112%);
    transform: scale(1.12);
    transition: transform 2.5s var(--ease);
    will-change: transform;
  }
  .card--art-metal:hover .card-weave {
    transform: scale(1.3);
  }
  /* Flattening the art for tiling also removed the soft centre glow that
     gave the card its depth, so it comes back once at card scale instead of
     once per tile. Alpha is the dial if this wants to be stronger. */
  .card--art-metal .card-bg-scrim {
    background:
      radial-gradient(ellipse 82% 70% at 50% 40%, rgba(168, 178, 192, 0.10) 0%, rgba(168, 178, 192, 0) 70%),
      linear-gradient(180deg, rgba(5, 7, 11, 0) 0%, rgba(5, 7, 11, 0.22) 100%);
  }
  .card--art-metal::after {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      inset 0 0 45px rgba(0, 0, 0, 0.35);
  }

  /* ---- Over an Aurora section background ----------------------------
     Jon 2026-09-07: "make the cards have a glass refraction translucency
     with the new section background glowing through."

     Gated on :global(.has-aurora) so it only fires where an aurora is
     actually behind the grid. Cards on every other section keep the solid
     art they have. The ancestor is wrapped in :global() because .has-aurora
     lives on the page's <section>, outside this component, so Astro must not
     rewrite it into this component's scope.

     backdrop-filter is what does the refracting, and it only reaches what is
     BEHIND the card, so the aurora gets bent while the weave, a child, stays
     crisp on top of it. That is the whole effect: texture on glass, colour
     moving underneath. */
  :global(.has-aurora) .card--bg {
    background: rgba(11, 18, 32, 0.34);
    backdrop-filter: blur(14px) saturate(150%);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
  }
  /* The weave has to stop being opaque or there is nothing to glow through.
     It reads as a texture ON the glass rather than a filled panel. */
  :global(.has-aurora) .card-weave {
    opacity: 0.42;
  }
  /* Scrim exists to keep text legible over bright art. The aurora is already
     darkened by its own vignette, so the linear ramp comes down: at full
     strength it flattened the colour back out of the card. */
  :global(.has-aurora) .card--art-metal .card-bg-scrim {
    background:
      radial-gradient(ellipse 82% 70% at 50% 40%, rgba(168, 178, 192, 0.07) 0%, rgba(168, 178, 192, 0) 70%),
      linear-gradient(180deg, rgba(5, 7, 11, 0) 0%, rgba(5, 7, 11, 0.12) 100%);
  }
  /* Icon placement (size/centering) lives in CardIcon.astro */
</style>
