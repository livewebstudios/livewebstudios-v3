---
/**
 * ServiceCard — the cloud-art service card used on /services and the home page.
 *
 * Extracted from services.astro (Jon 2026-08-27: "make the home cards look
 * exactly like the services cards") so both pages render from one source
 * instead of two copies drifting apart. Markup + styles travel together;
 * the styles are scoped, so nothing leaks to other card variants.
 *
 * Card art is one shared blue-cloud image; each line of text sits in its own
 * translucent bubble over it, and the CTA stays bare.
 *
 * lens={true} adds the convex-lens refraction overlay: an SVG copy of the
 * page scan line, bent by the y(p) model in ScanLines.astro. The old fixed
 * profile bar (.card-scanwell / .card-scanbar / #lws-glass-line) moved but
 * never changed shape, which was the complaint; this replaces it.
 */
import CardIcon from "./CardIcon.astro";

export interface Props {
  title: string;
  body: string;
  href: string;
  /** Relative path to the card art, e.g. "images/services/blue-clouds.jpg" */
  bg: string;
  /** Optional corner flag, e.g. "NEW" */
  tag?: string;
  /** CTA label. "Learn More" is a forbidden phrase, so the default is used. */
  cta?: string;
  /** Draw the refracted scan line inside the card. Needs <ScanLines lens />. */
  lens?: boolean;
  /**
   * Art treatment. "cloud" is the blue-cloud default used on /services.
   * "metal" retunes the stack for the dark carbon weave the home page uses:
   * that art is already near-black, so the scrim and edge vignette have to
   * come down or the card reads as a flat black rectangle.
   */
  art?: "cloud" | "metal";
}

const { title, body, href, bg, tag, cta = "SEE DETAILS →", lens = false, art = "cloud" } = Astro.props;
---

<div class:list={["card", "reveal", "card--bg", `card--art-${art}`, lens && "card--lens"]}>
  {lens && <div class="card-occluder" aria-hidden="true"></div>}
  <img class="card-bg-img" src={bg} alt="" loading="lazy" decoding="async" />
  <div class="card-bg-scrim" aria-hidden="true"></div>
  {lens && (
    <svg class="lens-svg" aria-hidden="true" focusable="false" preserveAspectRatio="none" viewBox="0 0 100 100">
      {/* 6 — glow bleed, beneath the band, widened to the band's thickness */}
      <path class="lens-glow" fill="none" />
      {/* 4 — caustic bloom at the focus plane: cyan core, amber tint over it */}
      <ellipse class="lens-caustic" cx="50%" cy="50%" rx="37.5%" ry="11%" opacity="0" />
      <ellipse class="lens-caustic-amber" cx="50%" cy="50%" rx="37.5%" ry="11%" opacity="0" />
      {/* The refracted BAND. A bowed band cannot take a correct across-thickness
          gradient from a single filled path plus a linearGradient: the bow makes
          the shape's bounding box much taller than the band, so the ramp smears
          diagonally instead of running edge-to-edge. Built instead as stacked
          sub-bands, each following y(p) at its own vertical offset, each flat-
          coloured from the ramp. Same construction, evaluated per slice, and the
          gradient tracks the curve exactly. */}
      <g class="lens-band">
        {Array.from({ length: 14 }).map(() => <path class="lens-slice" fill="none" />)}
      </g>
    </svg>
  )}
  {lens && <div class="card-rim" aria-hidden="true"></div>}
  <div class="card-pad card-bg-content">
    <h3>{title}{tag && <span class="tag-new">{tag}</span>}</h3>
    <p>{body}</p>
    <CardIcon title={title} />
    <a class="more" href={href}>{cta}</a>
  </div>
</div>

<style>
  /* Cards with generated background art: image + scrim keep text readable */
  .card--bg {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .card--bg:hover {
    border-color: rgba(56, 189, 248, 0.35);
  }
  /* Fills the whole card: max-width:none overrides the global img cap that
     left a dark band on the right edge. Base scale gives drift headroom. */
  .card-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    z-index: 0;
    opacity: 0.9;
    /* Heavy refraction: the cloud art bends and splits into colour fringes,
       as through thick glass (Jon 2026-08-27). Filter lives in Base.astro.
       Scaled up so the filter's displaced edges never expose the card. */
    filter: url(#lws-glass) saturate(150%) contrast(108%);
    transform: scale(1.12);
    transition: transform 2.5s var(--ease);
    will-change: transform;
  }
  /* Clouds zoom in slowly on hover (no pan, no mirror — Jon 2026-08-19) */
  .card--bg:hover .card-bg-img {
    transform: scale(1.3);
  }
  .card-bg-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(5, 7, 11, 0.20) 0%, rgba(5, 7, 11, 0.42) 100%);
  }

  /* Convex lens shell: specular crown up top, a second bounce at the bottom,
     a lit rim, and edge darkening — the read of a thick curved glass blank
     sitting on the art (Jon 2026-08-27). */
  .card--bg::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
    background:
      radial-gradient(130% 78% at 50% -14%, rgba(255, 255, 255, 0.17), rgba(255, 255, 255, 0.04) 46%, transparent 62%),
      radial-gradient(110% 60% at 50% 114%, rgba(255, 255, 255, 0.09), transparent 58%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      inset 0 0 70px rgba(0, 0, 0, 0.55);
  }

  .card-bg-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Each line of card text sits in its own translucent bubble over the
     cloud art (Jon 2026-08-27, MOSA reference). SEE DETAILS stays bare. */
  .card-bg-content > h3,
  .card-bg-content > p {
    width: fit-content;
    max-width: 100%;
    background: rgba(5, 7, 11, 0.78);
    backdrop-filter: blur(10px) saturate(130%);
    -webkit-backdrop-filter: blur(10px) saturate(130%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 0.55rem 0.8rem;
  }
  .card-bg-content > h3 { margin-bottom: 0.7rem; }

  /* ---- Metal variant (home page, 2026-09-02) --------------------
     The carbon weave is near-black and greyscale, so:
     1. Lift it. saturate() does nothing on a greyscale texture, so it is
        dropped for brightness, which is what this art actually needs.
     2. Pull the black back. Scrim and the ::after edge vignette were
        tuned against bright cloud art; over near-black they just fill
        the card in. Text bubbles still carry readability.

     Scale: first pass ran 1.9/2.15 to guard against moire. Jon 2026-09-02
     wants the weave tighter, so it sits on the base 1.12/1.3 instead,
     which is as small as this art can go. object-fit:cover means 1.0 is
     the floor (below that the image stops covering), and the base 1.12
     is the headroom the #lws-glass displacement needs so its bent edges
     never expose the card corner. Going tighter than this would mean
     tiling with background-repeat, which this file will not take: it
     carries a lit centre and darkened corners, so a repeat would show a
     visible grid of bright spots. */
  .card--art-metal .card-bg-img {
    opacity: 1;
    filter: url(#lws-glass) brightness(1.45) contrast(112%);
    transform: scale(1.12);
  }
  .card--art-metal:hover .card-bg-img {
    transform: scale(1.3);
  }
  .card--art-metal .card-bg-scrim {
    background: linear-gradient(180deg, rgba(5, 7, 11, 0) 0%, rgba(5, 7, 11, 0.22) 100%);
  }
  .card--art-metal::after {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      inset 0 0 45px rgba(0, 0, 0, 0.35);
  }

  /* Icon placement (size/centering) lives in CardIcon.astro */
</style>

<!-- Lens refraction. Global rather than scoped: the markup lives inside
     {lens && ...}, and Astro's scoped-CSS pass drops selectors it cannot match
     statically against the template, which left the overlay unstyled (the SVG
     fell into normal flow and stretched the card). Every selector is nested
     under .card--lens, so nothing reaches a non-lens card. -->
<style is:global>
  /* Masks the real .scan-bar where this card covers it. The art sits at
     opacity .9 over a transparent card, so without this an unrefracted 10%
     ghost of the straight line crosses the glass alongside the arc.

     Both layers are the page background colour, identical to what already
     sits behind the card, so neither changes how the card reads. The fill on
     the card itself covers the border box: overflow:hidden clips children to
     the PADDING box, so the occluder alone leaves the 1px translucent border
     unmasked and the real line shows as a travelling dash along the rim. */
  .card--lens {
    background: var(--bg);
  }
  .card--lens > .card-occluder {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--bg);
  }

  /* The refracted line. Clipped to the glass by the card's overflow:hidden
     and its border-radius. Paths are written by the ScanLines controller. */
  .card--lens > .lens-svg {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    border-radius: inherit;
    overflow: hidden;
  }
  /* Slices butt against each other; round caps or joins would scallop the
     band's ends. Colour, width, offset and alpha all come from the controller. */
  .card--lens .lens-slice {
    stroke-linecap: butt;
  }
  /* Softens the seams between slices into a continuous ramp. */
  .card--lens .lens-band {
    filter: blur(1.5px);
  }
  .card--lens .lens-glow {
    stroke: var(--scan-cyan);
    stroke-linecap: round;
    opacity: 0.25;
    filter: blur(6px);
  }
  .card--lens .lens-caustic {
    fill: var(--scan-cyan);
    filter: blur(10px);
  }
  .card--lens .lens-caustic-amber {
    fill: var(--scan-amber);
    filter: blur(14px);
  }

  /* 7 — rim specular. Amounts come from the controller as --rim-t/--rim-b. */
  .card--lens > .card-rim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
    box-shadow:
      inset 0 2px 0 color-mix(in srgb, var(--scan-cyan) calc(var(--rim-t, 0) * 100%), transparent),
      inset 0 -2px 0 color-mix(in srgb, var(--scan-cyan) calc(var(--rim-b, 0) * 100%), transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .card--lens > .lens-svg { opacity: 1; }
  }
</style>
