---
/**
 * PhotoBg — one systemized still-photo section background, the counterpart to
 * VideoBg (Jon 2026-09-14, for the bluestage shot across the Live Band sub
 * pages).
 *
 * Same contract as VideoBg on purpose: drop it inside a section carrying
 * `has-videobg` (that class sets position/overflow so the art clips to the
 * section and content sits above it), pass a filename from public/images/,
 * pick a scrim strength. Swapping a section between video and photo is then a
 * one-line change either way.
 *
 * Why a component rather than a url() in a stylesheet: build.inlineStylesheets
 * is 'always', so CSS is inlined into every page and a relative url() would
 * resolve against whichever page it landed in. These sub pages sit at two
 * different depths (/live-band-web-studios/forms and
 * /live-band-web-studios/forms/band-bio-form), so one hardcoded path is wrong
 * for at least one of them. Building the URL from relPrefix here keeps the LWS
 * path rule intact at any depth.
 *
 * Eager by nature: a still frame is one request and it IS the hero, so unlike
 * VideoBg there is nothing to lazy-load and nothing to pause. A photo behind a
 * section band further down the page passes `lazy` instead.
 *
 * Studio scenes (Jon 2026-11-16, five-studio navigation, handoff section 3):
 * the five after-hours studio photos in public/images/bg/ (lws-bg-desk, -rack,
 * -keys, -proofs, -room) replace the abstract video loops on Live Web Studios
 * pages. They run through this component with three additions:
 *   - srcset. When a `<name>-800.jpg` sits beside the file, phones get it.
 *   - scrim="studio". Hero treatment: dark on the copy side, clear on the
 *     other, and a short fade into the page ground at the foot. The photo
 *     itself is never blurred.
 *   - drift. Hero only: 46 seconds, scale 1 to 1.05 with a 1% pan, back and
 *     forth. Bands below the hero stay still. Off under reduced motion.
 */
import { existsSync } from "node:fs";
import { join } from "node:path";
import { relPrefix } from "../lib/relPrefix";
import { imageSize } from "../lib/imageSize";

interface Props {
  /** Filename in public/images/. */
  src: string;
  /** Readability overlay strength. Matches VideoBg's three levels, plus
      "studio" for a hero that carries one of the studio scenes. */
  scrim?: "hero" | "default" | "strong" | "studio";
  /** Focal point, as a CSS object-position. The bluestage shot carries its
      subject low-centre, so heroes that crop tall want something below 50%. */
  position?: string;
  /** Decorative by default. Pass alt text only if the photo carries meaning
      the copy does not already state. */
  alt?: string;
  /** The file's intrinsic pixel size. CSS sizes this image either way, so the
      attributes are only there to give the browser the aspect ratio before the
      bytes arrive. Optional: left off, the size is read from the file itself,
      which is what every caller should do. Pass them only to override. */
  width?: number;
  height?: number;
  /** CSS brightness multiplier for a photo that is darker than the hero
      needs, e.g. 1.4. Leaves the file untouched (Jon 2026-09-26, the roadcase
      shot on Contact). */
  brightness?: number;
  /** Slow hero drift. Heroes only; a band below the hero stays still. */
  drift?: boolean;
  /** For a photo behind a band below the fold: load it when it nears view. */
  lazy?: boolean;
}
const {
  src, scrim = "hero", position = "50% 60%", alt, width, height, brightness,
  drift = false, lazy = false,
} = Astro.props;
const rel = relPrefix(Astro.url.pathname);

/* Read the real size off the file when the caller did not state one. Hand-typed
   dimensions were the old contract and nine of the ten callers simply omitted
   them, which is how eight bluestage heroes shipped with no aspect ratio at
   all (launch audit, 2026-09-15). Reading the header cannot be forgotten and
   cannot disagree with the file. */
const dim = imageSize(`images/${src}`);
const w = width ?? dim?.width;
const h = height ?? dim?.height;

/* Phone-size sibling. Looked up on disk at build time so a photo without one
   renders exactly as before, and adding one later needs no call-site edit. */
const small = src.replace(/\.(jpe?g|png|webp)$/i, "-800.$1");
const hasSmall = small !== src && existsSync(join("public", "images", small));
const srcset =
  hasSmall && w ? `${rel}images/${small} 800w, ${rel}images/${src} ${w}w` : undefined;
---

<div
  class:list={["photobg", `videobg--${scrim}`, scrim === "studio" && "photobg--studio", drift && "photobg--drift"]}
  aria-hidden={alt ? undefined : "true"}
>
  <img
    class="photobg__img"
    src={`${rel}images/${src}`}
    srcset={srcset}
    sizes={srcset ? "100vw" : undefined}
    alt={alt ?? ""}
    width={w}
    height={h}
    loading={lazy ? "lazy" : "eager"}
    fetchpriority={lazy ? undefined : "high"}
    decoding="async"
    style={`object-position:${position}${brightness ? `;filter:brightness(${brightness})` : ""}`}
  />
  <div class="videobg__scrim"></div>
</div>

<style>
  /* Mirrors .videobg so the two are interchangeable inside .has-videobg.
     The scrim classes themselves are shared from global.css rather than
     duplicated: one place to retune readability for both. */
  .photobg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .photobg__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Studio hero scrim. The copy sits on the left in every Live Web Studios
     hero, so the dark runs left to right; the short ramp at the foot lands on
     the page ground so the photo does not end on a hard line. */
  .photobg--studio :global(.videobg__scrim) {
    background:
      linear-gradient(90deg, rgb(3 6 12 / .62) 0%, rgb(3 6 12 / .34) 46%, rgb(3 6 12 / .16) 100%),
      linear-gradient(0deg, rgb(var(--mosa-bg-rgb, 5 7 11) / .92) 0%, rgb(var(--mosa-bg-rgb, 5 7 11) / 0) 30%);
  }
  /* Stacked layouts: the panel spans the frame, so the ramp goes flat. */
  @media (max-width: 900px) {
    .photobg--studio :global(.videobg__scrim) {
      background:
        linear-gradient(0deg, rgb(var(--mosa-bg-rgb, 5 7 11) / .92) 0%, rgb(var(--mosa-bg-rgb, 5 7 11) / 0) 30%),
        rgb(3 6 12 / .42);
    }
  }

  /* Barely moving. The image only ever grows from its own box, so no edge
     can show at any point of the pan. */
  .photobg--drift .photobg__img {
    animation: photobg-drift 46s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes photobg-drift {
    from { transform: scale(1) translate3d(0, 0, 0); }
    to { transform: scale(1.05) translate3d(-1%, -.6%, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .photobg--drift .photobg__img { animation: none; will-change: auto; }
  }
</style>
