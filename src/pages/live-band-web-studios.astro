---
/**
 * Live Band Web Studios — the first STUDIOS mega-panel headliner.
 * Sites built for professional, touring bands and artists: tour dates,
 * setlists, press kits / EPKs, and booking. The differentiator from core
 * LWS (business sites) and Namesake (solo personal brand) is the working
 * band: a group that gigs, tours, and gets booked.
 *
 * Canonical URL is /live-band-web-studios (built as
 * live-band-web-studios.html). Reversed 2026-07-04 per Jon's decision (was
 * /live-band, which is now the fold-in 301): nav, footer, and the STUDIOS
 * mega-panel all link straight here; /live-band 301s in for old bookmarks.
 *
 * Reuses the whole LWS system (Base, Nav, Footer, Glass) and re-themes the
 * accent cyan -> amber (#FCD34D, the sanctioned Live Band token already in
 * global.css) by overriding the accent custom properties on the
 * .theme-live-band wrapper. Same scoping pattern 2C used for .theme-namesake,
 * so no component is forked. The hero uses the live site's drum-start clip
 * and leads with the LBWS logo (Jon 2026-09-12).
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Glass from "../components/Glass.astro";
import BandSeoCards from "../components/BandSeoCards.astro";
import VideoBg from "../components/VideoBg.astro";
import { relPrefix } from "../lib/relPrefix";

const rel = relPrefix(Astro.url.pathname);

// What We Build — ported from live (3 cards).
/* "More Info" popups (Jon 2026-09-14) for the two cards whose value is hard
   to explain in a card-sized paragraph. Keyed by card title; a card only gets
   the button if there is an entry here. */
const modals: Record<string, {
  id: string;
  heading: string;
  body: string;
  figures: { art: string; alt: string; cap: string }[];
  /** Optional numbered breakdown, used by the four How It Works steps. */
  steps?: string[];
}> = {
  "EPK Pages": {
    id: "epk",
    heading: "Why the EPK Earns Its Own Page",
    body: "The sound tech reading your rider at four o'clock decides how your show sounds at nine. One link carrying the stage plot, the input list and the booking contact means the agent, the venue owner and the engineer all work from the same page, instead of three forwarded emails and a screenshot of a screenshot.",
    figures: [
      {
        art: "epk-tech-rider.jpg",
        alt: "A multi-page printed technical rider fanned out on a road case under a work lamp",
        cap: "THE TECH RIDER",
      },
      {
        art: "epk-stage-plot.jpg",
        alt: "A pencil stage plot on paper showing the drum kit, amplifiers, wedge monitors and mic positions",
        cap: "THE STAGE PLOT",
      },
    ],
  },
  "Personal Sites": {
    id: "personal",
    heading: "The Band Has a Site. You Need One Too.",
    body: "The agent booking a fill-in, the producer checking your credits and the person who caught your name from the stage are all searching for you, not the band. A site on your own name is the one result you control, and it outlives whichever project you happen to be in this year.",
    figures: [
      {
        art: "personal-site-laptop.jpg",
        alt: "A musician's personal site open on a laptop resting on a road case backstage",
        cap: "YOUR NAME, YOUR DOMAIN",
      },
    ],
  },

  /* The four How It Works steps, broken out (Jon 2026-09-14). The card keeps
     its one-line version; the popup carries what actually happens. */
  "The Call": {
    id: "call",
    heading: "What Happens on the Call",
    body: "No intake form, no ticket number, no account manager reading from a script.",
    figures: [{ art: "step-call-ill.jpg", alt: "Line illustration of a telephone handset with sound waves resolving into a waveform", cap: "STEP ONE" }],
    steps: [
      "You call, or send one short message. Jon picks up, or calls back the same day.",
      "He asks about the band: the circuit you play, where the gigs come from, what the current site is costing you.",
      "You get a straight answer on scope, price and timeline before anyone asks you for a deposit.",
    ],
  },
  "The Build": {
    id: "build",
    heading: "What Happens During the Build",
    body: "Design starts from your band, not from a template library with your logo dropped in.",
    figures: [{ art: "step-build-ill.jpg", alt: "Line illustration of a browser frame with its header, hero, gallery and date list drawn together in layers", cap: "STEP TWO" }],
    steps: [
      "Design comes first: your photos, your colours, the way your name is set.",
      "It goes up on a staging link right away, so you watch it get built instead of waiting for a reveal.",
      "Content goes in: gig dates, EPK, galleries, and the member forms as they come back.",
      "Revisions until it is right. There is no revision counter.",
    ],
  },
  "The Launch": {
    id: "launch",
    heading: "What Happens at Launch",
    body: "Nothing goes live until you have seen it and said yes.",
    figures: [{ art: "step-launch-ill.jpg", alt: "Line illustration of a stage with curtains drawn back and a lighting truss aimed at a browser window centre stage", cap: "STEP THREE" }],
    steps: [
      "A full pass on staging: speed, mobile, every link, every form, schema, and search settings.",
      "You approve it. That is the gate, and it does not move without you.",
      "Domain and hosting move across, usually inside the hour, with the old site kept until the new one is confirmed.",
      "A live walk-through so the band can update the site without calling anyone.",
    ],
  },
  "The Ongoing": {
    id: "ongoing",
    heading: "What Happens After Launch",
    body: "The part most shops skip. Launch is where the work starts paying off, not where it stops.",
    figures: [{ art: "step-ongoing-ill.jpg", alt: "Line illustration of a calendar and a rising graph joined by a looping arrow", cap: "STEP FOUR" }],
    steps: [
      "A monthly SEO and traffic report in plain language, not a dashboard export.",
      "Fresh articles and show recaps every month, so the site keeps giving search engines something new.",
      "Gig calendar, galleries and set lists updated whenever you send them over.",
      "Backups, updates, uptime and security handled quietly in the background.",
    ],
  },
};

const build = [
  {
    art: "build-full-band-sites.jpg",
    alt: "A lit stage viewed from the wings, instruments set and waiting",
    title: "Full Band Sites",
    body: "Gig pages. Photo galleries. Video embeds. EPK. Set list management. Everything a touring band needs, and nothing they don't. Updated by the band via CMS, maintained by Jon.",
    href: "live-band-web-studios/portfolio.html",
    cta: "See full band sites we've built →",
  },
  {
    art: "build-epk-pages.jpg",
    alt: "A press kit laid out on a road case under a work lamp",
    title: "EPK Pages",
    body: "The document that gets you the gig. Bio, tech rider, stage plot, input list, booking contact, all in one page, formatted for talent buyers and FOH engineers who've seen a hundred of these.",
  },
  {
    art: "build-personal-sites.jpg",
    alt: "A solo vocalist alone in a spotlight",
    title: "Personal Sites",
    body: "Your name. Your domain. Your story. Individual musician sites with bio, touring history, media, photos, and merch. Built for the working musician who's more than just a band member.",
  },
];

// How It Works — ported from live (4 steps).
const steps = [
  { art: "step-the-call.jpg", alt: "A telephone handset off the hook on a road case, lit by a work lamp", title: "The Call", body: "We talk. Jon listens. No intake forms, no auto-replies. You get Jon." },
  { art: "step-the-build.jpg", alt: "Wireframe sketches spread across a desk", title: "The Build", body: "Custom design starts after the call. No guessing. No mockups from a template library." },
  { art: "step-the-launch.jpg", alt: "An empty stage washed in light just before doors", title: "The Launch", body: "Staging review, your approval, then live. You get a walk-through. Not a PDF." },
  { art: "step-the-ongoing.jpg", alt: "A tour calendar open on a desk beside a laptop", title: "The Ongoing", body: "Monthly SEO reports. Blog posts. Gig calendar updates. Jon doesn't disappear after launch." },
];

---

<Base
  title="Live Band Web Studios | Websites for Touring Bands & Artists"
  description="Websites for working bands and artists: tour dates, press kits and EPKs, setlists, music, and booking. A studio of Live Web Studios."
  canonical="https://livewebstudios.com/live-band-web-studios"
  ogImage="images/og-live-band.jpg"
>
  <Nav />

  <main class="theme-live-band">
    <!-- HERO — matches the live Live Band hero (Jon 2026-09-12): the drum-start
         clip behind a centred lockup with the LBWS logo as the focus, not a
         headline. This is a brand inside the brand, so the LWS header and main
         menu above it are untouched.

         The h1 carries the page's real heading for search and screen readers
         while the logo does the visual work, the way the live page does it.
         Centred with no glass panel, matching that reference. -->
    <section class="hero hero--bare lbs-hero">
      <VideoBg src="bg-drumstart-1080.mp4" scrim="hero" once />
      <div class="wrap hero-in lbs-hero-in">
        <h1 class="visually-hidden">Live Band Web Studios, custom websites for bands and musicians</h1>
        <span class="eyebrow lbs-eyebrow">A SERVICE OF LIVE WEB STUDIOS</span>
        <img
          class="lbs-hero-logo"
          src={`${rel}images/logo-live-band.png`}
          alt="Live Band Web Studios"
          width="681"
          height="300"
          fetchpriority="high"
          decoding="async"
        />
        <p class="lbs-hero-tagline">Your band deserves a website as serious as your rider.</p>
        <p class="lbs-hero-sub">Hand-built. Custom. No templates. No page builders. Built by a musician who's been on every side of that stage.</p>
        <div class="hero-btns lbs-hero-btns">
          <a href="contact.html" class="btn btn-primary">Let's talk. →</a>
          <a href="live-band-web-studios/portfolio.html" class="btn btn-ghost">See the work →</a>
        </div>
        <div class="telemetry lbs-telemetry">
          <span>HAND-BUILT <b>MADE TO LAST</b></span>
          <span>BUILT BY A <b>MUSICIAN</b></span>
          <span>YOUR BAND <b>YOUR SITE</b></span>
        </div>
      </div>
    </section>

    <!-- POSITIONING — copy left, subject photo right (Jon 2026-09-12). The
         image is a real element rather than a background so it keeps its alt
         text and its own aspect ratio; it stacks under the copy on phones. -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="feature lbs-split">
          <div class="lbs-split-copy">
            <span class="eyebrow mb-md">WHY NOT A TEMPLATE</span>
            <h2>They give you a template. We build you a website.</h2>
            <p>The drag-and-drop site builders all start from the same place: a template someone else designed for someone else's band. Every site we build starts from scratch. Your colors. Your vibe. Your music. Fast load times. Nothing breaks, nothing needs babysitting, and there's never a surprise bill to keep it running.</p>
          </div>
          <figure class="lbs-split-art">
            <img
              src={`${rel}images/band/why-not-a-template.jpg`}
              alt="A custom band website open on a laptop sitting on a road case backstage, lit by amber stage light"
              width="900"
              height="900"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </Glass>
      </div>
    </section>

    <!-- WHAT WE BUILD (ported from live) -->
    <section id="kit" class="sec-pad is-alt">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">FOR BANDS · FOR SOLO ARTISTS · FOR THE WHOLE CIRCUIT</span>
          <h2>What We Build</h2>
        </div>
        <div class="grid-svc">
          {build.map((b) => (
            <div class="card lbs-card reveal">
              <Glass variant="inner" innerClass="lbs-card__inner">
                <div class="lbs-card__art">
                  <img src={`${rel}images/band/${b.art}`} alt={b.alt} width="900" height="900" loading="lazy" decoding="async" />
                </div>
                <div class="card-pad">
                  <h3>{b.title}</h3>
                  <p>{b.body}</p>
                  {b.href && <a class="btn btn-primary card-cta" href={b.href}>{b.cta}</a>}
                  {modals[b.title] && (
                    <button type="button" class="btn btn-primary card-cta" data-modal-open={modals[b.title].id}>
                      More Info →
                    </button>
                  )}
                </div>
              </Glass>
            </div>
          ))}
        </div>
        <p class="page-lede is-center mt-lg reveal">Want to see the full band sites we've built? <a href="live-band-web-studios/portfolio.html">Take a look at the work</a>.</p>
      </div>
    </section>

    <!-- HOW IT WORKS (ported from live) -->
    <section class="sec-pad">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">THE PROCESS</span>
          <h2>How It Works</h2>
        </div>
        <div class="grid-svc grid-svc--steps">
          {steps.map((s) => (
            <div class="card lbs-card reveal">
              <Glass variant="inner" innerClass="lbs-card__inner">
                <div class="lbs-card__art">
                  <img src={`${rel}images/band/${s.art}`} alt={s.alt} width="900" height="900" loading="lazy" decoding="async" />
                </div>
                <div class="card-pad">
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                  {modals[s.title] && (
                    <button type="button" class="btn btn-primary card-cta" data-modal-open={modals[s.title].id}>
                      More Info →
                    </button>
                  )}
                </div>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SEO (ported from live) -->
    <section class="sec-pad has-videobg">
      <VideoBg src="bg-color-tv.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <!-- em-dash: "Found on Google — Not Just Built" → comma -->
          <span class="eyebrow">FOUND ON GOOGLE, NOT JUST BUILT</span>
          <h2>SEO Is Baked Into Every Build</h2>
        </div>
        <!-- em-dash: "core part of what we do — every site is engineered" → comma -->
        <p class="page-lede is-center mb-lg reveal">A website nobody finds is a poster in a locked room. Getting you found is a core part of what we do, every site is engineered to rank, and we keep working it after launch.</p>
        <BandSeoCards />
        <!-- em-dash: "Google didn't tweak the rules — it rewrote them" → comma -->
        <p class="page-lede is-center mt-lg reveal"><strong>Built on the Live Web Studios AI Platform.</strong> Google didn't tweak the rules, it rewrote them. The old SEO playbook doesn't work anymore. We build for how search works now, and adjust the moment it changes again.</p>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad is-alt" style={`--lbs-art:url('${rel}images/band/cta-social-web.jpg')`}>
      <div class="wrap">
        <Glass class="reveal" innerClass="cta lbs-cta-art">
          <h2>Ready to Stop Sending People to Your Facebook Page?</h2>
          <p>Let's build the site your live show actually deserves.</p>
          <div class="hero-btns">
            <a href="contact.html" class="btn btn-primary">Get in Touch →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </Glass>
      </div>
    </section>
    {/* Popups for the cards above. Native <dialog>: the browser supplies the
        backdrop, the top layer, focus trapping and Esc-to-close, so the only
        script needed is open, and a close on any click (Jon 2026-09-14:
        "closes upon click on the pop or outside"). */}
    {Object.values(modals).map((m) => (
      <dialog class="lbs-modal" id={`modal-${m.id}`} aria-labelledby={`modal-${m.id}-h`}>
        <div class="lbs-modal__inner">
          <button type="button" class="lbs-modal__close" aria-label="Close">×</button>
          <h3 id={`modal-${m.id}-h`}>{m.heading}</h3>
          <div class:list={["lbs-modal__figs", m.figures.length === 1 && "is-single"]}>
            {m.figures.map((f) => (
              <figure>
                <img src={`${rel}images/band/${f.art}`} alt={f.alt} width="1000" height="750" loading="lazy" decoding="async" />
                <figcaption>{f.cap}</figcaption>
              </figure>
            ))}
          </div>
          <p>{m.body}</p>
          {m.steps && (
            <ol class="lbs-modal__steps">
              {m.steps.map((st) => <li>{st}</li>)}
            </ol>
          )}
          <span class="lbs-modal__hint">Click anywhere to close</span>
        </div>
      </dialog>
    ))}
  </main>

  <Footer />

  <script is:inline>
    // "More Info" popups. Native <dialog> does the heavy lifting (backdrop,
    // top layer, focus handling, Esc), so this only wires the open button and
    // closes on any click - on the panel or outside it, per Jon 2026-09-14.
    (function () {
      var dialogs = document.querySelectorAll("dialog.lbs-modal");
      if (!dialogs.length) return;

      document.querySelectorAll("[data-modal-open]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var d = document.getElementById("modal-" + btn.dataset.modalOpen);
          if (!d) return;
          // showModal gives the backdrop and the inert page behind it. Older
          // engines without it fall back to a plain open dialog.
          if (d.showModal) d.showModal();
          else d.setAttribute("open", "");
        });
      });

      dialogs.forEach(function (d) {
        d.addEventListener("click", function () {
          if (d.close) d.close();
          else d.removeAttribute("open");
        });
      });
    })();
  </script>
</Base>

<style>
  /* Amber sub-brand theming. Overriding the accent custom properties on the
     wrapper re-themes every descendant that reads them (buttons, eyebrows,
     glass borders, hero em, telemetry) with zero component forks. Same
     naming/scoping as 2C's .theme-namesake. */
  .theme-live-band {
    --cyan: #fcd34d;          /* amber base — buttons, dots, eyebrow rule */
    --cyan-soft: #fde68a;     /* light amber — eyebrow text, hero em, telemetry */
    --cyan-2: #f59e0b;        /* deep amber — button gradient base */
    --cyan-deep: #4a3a08;
    --on-accent: #1a1400;     /* dark ink on amber surfaces (~12:1) */
    --line: rgba(252, 211, 77, 0.16);
    --line-2: rgba(252, 211, 77, 0.08);
  }

  /* Hero fallback poster hardcodes cyan rgba and lives inside the React
     island, so custom-property inheritance can't reach it — retheme amber. */
  .theme-live-band :global(.hero-fallback) {
    background:
      radial-gradient(46% 38% at 50% 46%, rgba(252, 211, 77, 0.14), transparent 62%),
      radial-gradient(78% 58% at 50% 48%, rgba(252, 211, 77, 0.06), transparent 72%),
      var(--bg);
  }

  .card-cta {
    margin-top: 1rem;
    align-self: flex-start;
    font-size: 0.68rem;
    /* .btn is white-space:nowrap, which pushed the longest label ("See full
       band sites we've built") 9px past its card at 1280. Harmless while
       these were ghost buttons; obvious the moment they carry a solid amber
       fill, so let the long one wrap instead of clipping. */
    white-space: normal;
    max-width: 100%;
    text-align: center;
  }

  /* Jon 2026-09-14: "make these buttons yellow branded color background with
     dark text (reverse)". Solid amber, dark ink, the inverse of the ghost
     treatment they carried before.

     Both colors have to be restated rather than inherited. mosa-skin.css
     re-skins .btn-primary site-wide to flat white on near-black
     (rgb(var(--mosa-fg-rgb))), which lands AFTER global.css and ignores
     --cyan, so the .theme-live-band amber above never reaches the button on
     its own. The values still come from the theme's own tokens, so this
     stays one accent, not a fourth yellow.

     The shadow is restated for the same reason it is on .hero-fallback:
     .btn-primary's glow is a hardcoded cyan rgba, not a custom property. */
  .card-cta.btn-primary {
    background: var(--cyan);
    color: var(--on-accent);
    border-color: transparent;
    font-weight: 600;
    box-shadow:
      0 8px 24px rgba(252, 211, 77, 0.26),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }
  .card-cta.btn-primary:hover {
    background: var(--cyan-soft);
    color: var(--on-accent);
    transform: translateY(-2px);
    box-shadow:
      0 14px 34px rgba(252, 211, 77, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  /* ---- Card art (Jon 2026-09-12; reworked 2026-09-14) -----------------
     Jon 2026-09-14: "instead of icons, i want a photo in the cards on top.
     put the images in the top half of the card. words should not go over the
     image. just put words under the cards."

     So the photo is no longer a BACKGROUND with the copy floating over it.
     It is a banner occupying the top of the card, and every word sits below
     it on flat panel colour. That retires the whole scrim/text-shadow/
     contrast-tuning apparatus the old treatment needed: nothing is over the
     art any more, so there is nothing to protect.

     The art is a ratio BOX with the image absolutely filling it, not an <img>
     carrying its own aspect-ratio: as a flex child a replaced element ignores
     aspect-ratio and sizes to its height attribute. 4:3 rather than 16:9
     because the sources are square, and a widescreen crop threw most of each
     frame away. The glyph icons are gone with the icons themselves. */
  .lbs-card > :global(.glass-inner) {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r-md);
    border-color: rgba(252, 211, 77, 0.2);
    /* Jon 2026-09-15: "the cards on this page are ALL too large... just make
       the cards less height." The inherited 2.4rem from .card .glass-inner was
       framing the art AND sitting outside .card-pad, so each card carried two
       nested frames and ~77px of pure vertical dead space. Zero here, art bled
       to the edge, .card-pad owns the inset. Matches the Namesake value cards,
       which is the other half of the ask. */
    padding: 0;
  }
  /* 1:1, because the source frames are square: any wider ratio throws away
     the top and bottom of every one of them. It also lands the banner at
     roughly half the card, which is what Jon asked for. Widened on a narrow
     single-column layout, where a square banner would run the full page
     width and push the copy off the screen. */
  .lbs-card__art {
    position: relative;
    flex: none;
    width: 100%;
    /* Was 1/1. Square art alone was 305px of a 682px card at 1440. 3:2 is what
       the How It Works cards below and the Namesake value cards both run, so
       all three now read as one component. */
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-bottom: 1px solid rgba(252, 211, 77, 0.18);
  }
  @media (max-width: 900px) {
    .lbs-card__art { aspect-ratio: 16 / 9; }
  }
  /* The four How It Works cards carry two lines of copy against the build
     cards' full paragraph (Jon 2026-09-14: "make these 4 cards less heights").
     They were already 3:2 while the build cards were square; the build cards
     have since joined them, so this now only restates the shared ratio and is
     kept as the explicit anchor for the steps row. */
  .grid-svc--steps .lbs-card__art { aspect-ratio: 3 / 2; }
  .grid-svc--steps .lbs-card :global(.card-pad) { padding: 1.4rem 2.4rem 1.4rem; }
  .grid-svc--steps .lbs-card :global(.card-cta) { margin-top: 0.9rem; padding: 0.6rem 1rem; }
  /* Equal columns. The default 1fr is minmax(auto,1fr), so the one card
     carrying a long CTA ("See full band sites we've built") set a min-content
     width for its column and took 357px against its neighbours' 280 - which
     made its banner visibly bigger than the other two in the same row.
     Gated to the 3-up range on purpose: Astro scopes this with an attribute
     selector, which outranks global.css's plain `.grid-svc` even inside its
     max-width:900px media query, so ungated it would hold three columns at
     phone width and crush each card to 36px. */
  @media (min-width: 901px) {
    .grid-svc {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .lbs-card__art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    /* The sources are deliberately near-black amber stage light and need
       lifting to read at card size. Brightness, not saturation: there is
       almost no colour in those shadows to boost. Less lift than the old
       background treatment used, because the art no longer has a scrim
       sitting on it. */
    filter: brightness(1.35) contrast(103%);
    transform: scale(1.02);
    transition: transform 2.4s var(--ease), filter 0.4s var(--ease);
  }
  .lbs-card:hover .lbs-card__art img {
    transform: scale(1.1);
    filter: brightness(1.55) contrast(105%);
  }
  /* The base .card-pad carries height:100%, written for a pad that IS the
     whole card. Under a banner in an auto-height flex column that resolves
     against a height which already includes the pad, and the card inflates.
     Let flex size it from its content. */
  .lbs-card :global(.card-pad) {
