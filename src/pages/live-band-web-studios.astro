---
/**
 * Live Band Web Studios — the first STUDIOS mega-panel headliner.
 * Sites built for professional, touring bands and artists: tour dates,
 * setlists, press kits / EPKs, and booking. The differentiator from core
 * LWS (business sites) and Namesake (solo personal brand) is the working
 * band: a group that gigs, tours, and gets booked.
 *
 * Canonical URL is /live-band-web-studios (built as
 * live-band-web-studios.html). Reversed 2026-07-04 per Jon's decision (was
 * /live-band, which is now the fold-in 301): nav, footer, and the STUDIOS
 * mega-panel all link straight here; /live-band 301s in for old bookmarks.
 *
 * Reuses the whole LWS system (Base, Nav, Footer, Glass) and re-themes the
 * accent cyan -> amber (#FCD34D, the sanctioned Live Band token already in
 * global.css) by overriding the accent custom properties on the
 * .theme-live-band wrapper. Same scoping pattern 2C used for .theme-namesake,
 * so no component is forked. The hero uses the orange-beam looping video.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Glass from "../components/Glass.astro";
import VideoBg from "../components/VideoBg.astro";

// What We Build — ported from live (3 cards).
const build = [
  {
    ico: "▦",
    title: "Full Band Sites",
    body: "Gig pages. Photo galleries. Video embeds. EPK. Set list management. Everything a touring band needs, and nothing they don't. Updated by the band via CMS, maintained by Jon.",
  },
  {
    ico: "✦",
    title: "EPK Pages",
    body: "The document that gets you the gig. Bio, tech rider, stage plot, input list, booking contact, all in one page, formatted for talent buyers and FOH engineers who've seen a hundred of these.",
  },
  {
    ico: "◉",
    title: "Personal Sites",
    body: "Your name. Your domain. Your story. Individual musician sites with bio, touring history, media, photos, and merch. Built for the working musician who's more than just a band member.",
  },
];

// How It Works — ported from live (4 steps).
const steps = [
  { ico: "☎", title: "The Call", body: "We talk. Jon listens. No intake forms, no auto-replies. You get Jon." },
  { ico: "✎", title: "The Build", body: "Custom design starts after the call. No guessing. No mockups from a template library." },
  { ico: "▲", title: "The Launch", body: "Staging review, your approval, then live. You get a walk-through. Not a PDF." },
  { ico: "◫", title: "The Ongoing", body: "Monthly SEO reports. Blog posts. Gig calendar updates. Jon doesn't disappear after launch." },
];

// SEO section — ported from live (3 cards).
const seo = [
  { ico: "⟨⟩", title: "Schema & Meta, Done Right", body: "Structured data (schema markup), clean meta tags, and the right title and description on every page, so search engines understand exactly who you are and where you play." },
  { ico: "◎", title: "The Words People Type", body: "We target the real search words and key phrases fans and talent buyers actually search, your genre, your cities, your venues, woven through every page." },
  { ico: "▤", title: "Blog Articles Engines Love", body: "Fresh articles every month, show recaps, new markets, gear talk, the steady, keyword-rich content search engines reward with higher rankings." },
];
---

<Base
  title="Live Band Web Studios | Websites for Touring Bands & Artists"
  description="Live Band Web Studios builds websites for professional touring bands and artists: tour dates, press kits and EPKs, setlists, music, and booking. A studio of Live Web Studios."
  canonical="https://livewebstudios.com/live-band-web-studios"
>
  <Nav />

  <main class="theme-live-band">
    <!-- HERO -->
    <section class="hero">
      <VideoBg src="bg-orange-beam-noaudio.mp4" scrim="hero" />
      <div class="wrap hero-in">
        <div class="chip"><span class="dot"></span> A SERVICE OF LIVE WEB STUDIOS</div>
        <p class="eyebrow is-center mb-lg">TOURING BANDS · ARTISTS · LIVE ACTS</p>
        <h1 class="hero-h1">Your band deserves a website as serious as your <em>rider</em>.</h1>
        <p class="hero-sub">Hand-built. Custom. No templates. No page builders. Built by a musician who's been on every side of that stage.</p>
        <div class="hero-btns">
          <a href="contact.html" class="btn btn-primary">Let's talk. →</a>
          <a href="#kit" class="btn btn-ghost">See what we build ↓</a>
        </div>
        <div class="telemetry">
          <span>HAND-BUILT <b>MADE TO LAST</b></span>
          <span>BUILT BY A <b>MUSICIAN</b></span>
          <span>YOUR BAND <b>YOUR SITE</b></span>
        </div>
      </div>
    </section>

    <!-- POSITIONING -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="feature">
          <span class="eyebrow is-center mb-md">WHY NOT A TEMPLATE</span>
          <h2>They give you a template. We build you a website.</h2>
          <p>The drag-and-drop site builders all start from the same place: a template someone else designed for someone else's band. Every site we build starts from scratch. Your colors. Your vibe. Your music. Fast load times. Nothing breaks, nothing needs babysitting, and there's never a surprise bill to keep it running.</p>
        </Glass>
      </div>
    </section>

    <!-- WHAT WE BUILD (ported from live) -->
    <section id="kit" class="sec-pad is-alt">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">FOR BANDS · FOR SOLO ARTISTS · FOR THE WHOLE CIRCUIT</span>
          <h2>What We Build</h2>
        </div>
        <div class="grid-svc">
          {build.map((b) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <div class="ico">{b.ico}</div>
                <h3>{b.title}</h3>
                <p>{b.body}</p>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS (ported from live) -->
    <section class="sec-pad">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">THE PROCESS</span>
          <h2>How It Works</h2>
        </div>
        <div class="grid-svc">
          {steps.map((s) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <div class="ico">{s.ico}</div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SEO (ported from live) -->
    <section class="sec-pad has-videobg">
      <VideoBg src="bg-color-tv.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <!-- em-dash: "Found on Google — Not Just Built" → comma -->
          <span class="eyebrow">FOUND ON GOOGLE, NOT JUST BUILT</span>
          <h2>SEO Is Baked Into Every Build</h2>
        </div>
        <!-- em-dash: "core part of what we do — every site is engineered" → comma -->
        <p class="page-lede is-center mb-lg reveal">A website nobody finds is a poster in a locked room. Getting you found is a core part of what we do, every site is engineered to rank, and we keep working it after launch.</p>
        <div class="grid-svc">
          {seo.map((s) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <div class="ico">{s.ico}</div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </Glass>
            </div>
          ))}
        </div>
        <!-- em-dash: "Google didn't tweak the rules — it rewrote them" → comma -->
        <p class="page-lede is-center mt-lg reveal"><strong>Built on the Live Web Studios AI Platform.</strong> Google didn't tweak the rules, it rewrote them. The old SEO playbook doesn't work anymore. We build for how search works now, and adjust the moment it changes again.</p>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad is-alt">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta">
          <h2>Ready to Stop Sending People to Your Facebook Page?</h2>
          <p>Let's build the site your live show actually deserves.</p>
          <div class="hero-btns">
            <a href="contact.html" class="btn btn-primary">Get in Touch →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* Amber sub-brand theming. Overriding the accent custom properties on the
     wrapper re-themes every descendant that reads them (buttons, eyebrows,
     glass borders, hero em, telemetry) with zero component forks. Same
     naming/scoping as 2C's .theme-namesake. */
  .theme-live-band {
    --cyan: #fcd34d;          /* amber base — buttons, dots, eyebrow rule */
    --cyan-soft: #fde68a;     /* light amber — eyebrow text, hero em, telemetry */
    --cyan-2: #f59e0b;        /* deep amber — button gradient base */
    --cyan-deep: #4a3a08;
    --on-accent: #1a1400;     /* dark ink on amber surfaces (~12:1) */
    --line: rgba(252, 211, 77, 0.16);
    --line-2: rgba(252, 211, 77, 0.08);
  }

  /* Hero fallback poster hardcodes cyan rgba and lives inside the React
     island, so custom-property inheritance can't reach it — retheme amber. */
  .theme-live-band :global(.hero-fallback) {
    background:
      radial-gradient(46% 38% at 50% 46%, rgba(252, 211, 77, 0.14), transparent 62%),
      radial-gradient(78% 58% at 50% 48%, rgba(252, 211, 77, 0.06), transparent 72%),
      var(--bg);
  }

  /* Two-up card grid (system default grid-svc is 3-up). Mirrors the
     grid-svc--2 pattern 2C introduced for Namesake. */
  .grid-svc--2 {
    grid-template-columns: repeat(2, 1fr);
  }

  /* Portrait mark — amber glyph instead of the JW block. */
  .lb-mark {
    color: rgba(252, 211, 77, 0.16);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .grid-svc--2 {
      grid-template-columns: 1fr;
    }
  }
</style>
