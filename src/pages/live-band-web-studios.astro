---
/**
 * Live Band Web Studios: the first STUDIOS mega-panel headliner.
 * Sites built for professional, touring bands and artists: tour dates,
 * setlists, press kits / EPKs, and booking.
 *
 * Canonical URL is /live-band-web-studios (built as
 * live-band-web-studios.html). Reversed 2026-07-04 per Jon's decision (was
 * /live-band, which is now the fold-in 301): nav, footer, and the STUDIOS
 * mega-panel all link straight here; /live-band 301s in for old bookmarks.
 *
 * Gold Rack redesign (2026-11-15): every block is a piece of studio gear
 * bolted into a rack. LiveBandLayout wraps the page in <main class="lbws-gold">
 * and loads the scoped stylesheet, fonts and motion script; the header, nav,
 * sub-nav and footer are untouched. The drum-start hero clip and the SEO fog
 * video stay exactly as they were; only what sits on top of them changed.
 * Copy, links and the overlay content are the page's own.
 */
import LiveBandLayout from "../layouts/LiveBandLayout.astro";
import VideoBg from "../components/VideoBg.astro";
import HeroRack from "../components/lbws/HeroRack.astro";
import SectionHead from "../components/lbws/SectionHead.astro";
import PictureFrame from "../components/lbws/PictureFrame.astro";
import MiniCard from "../components/lbws/MiniCard.astro";
import SignalChain from "../components/lbws/SignalChain.astro";
import SeoRack from "../components/lbws/SeoRack.astro";
import CtaPlate from "../components/lbws/CtaPlate.astro";
import Screws from "../components/lbws/Screws.astro";
import { relPrefix } from "../lib/relPrefix";

const rel = relPrefix(Astro.url.pathname);

// What We Build — ported from live (3 cards).
/* "More Info" popups (Jon 2026-09-14) for the two cards whose value is hard
   to explain in a card-sized paragraph. Keyed by card title; a card only gets
   the button if there is an entry here. */
const modals: Record<string, {
  id: string;
  heading: string;
  body: string;
  figures: { art: string; alt: string; cap: string }[];
  /** Optional numbered breakdown, used by the four How It Works steps. */
  steps?: string[];
}> = {
  "EPK Pages": {
    id: "epk",
    heading: "Why the EPK Earns Its Own Page",
    body: "The sound tech reading your rider at four o'clock decides how your show sounds at nine. One link carrying the stage plot, the input list and the booking contact means the agent, the venue owner and the engineer all work from the same page, instead of three forwarded emails and a screenshot of a screenshot.",
    figures: [
      {
        art: "epk-tech-rider.jpg",
        alt: "A multi-page printed technical rider fanned out on a road case under a work lamp",
        cap: "THE TECH RIDER",
      },
      {
        art: "epk-stage-plot.jpg",
        alt: "A pencil stage plot on paper showing the drum kit, amplifiers, wedge monitors and mic positions",
        cap: "THE STAGE PLOT",
      },
    ],
  },
  "Personal Sites": {
    id: "personal",
    heading: "The Band Has a Site. You Need One Too.",
    body: "The agent booking a fill-in, the producer checking your credits and the person who caught your name from the stage are all searching for you, not the band. A site on your own name is the one result you control, and it outlives whichever project you happen to be in this year.",
    figures: [
      {
        art: "personal-site-laptop.jpg",
        alt: "A musician's personal site open on a laptop resting on a road case backstage",
        cap: "YOUR NAME, YOUR DOMAIN",
      },
    ],
  },

  /* The four How It Works steps, broken out (Jon 2026-09-14). The card keeps
     its one-line version; the popup carries what actually happens. */
  "The Call": {
    id: "call",
    heading: "What Happens on the Call",
    body: "No intake form, no ticket number, no account manager reading from a script.",
    figures: [{ art: "step-call-ill.jpg", alt: "Line illustration of a telephone handset with sound waves resolving into a waveform", cap: "STEP ONE" }],
    steps: [
      "You call, or send one short message. Jon picks up, or calls back the same day.",
      "He asks about the band: the circuit you play, where the gigs come from, what the current site is costing you.",
      "You get a straight answer on scope, price and timeline before anyone asks you for a deposit.",
    ],
  },
  "The Build": {
    id: "build",
    heading: "What Happens During the Build",
    body: "Design starts from your band, not from a template library with your logo dropped in.",
    figures: [{ art: "step-build-ill.jpg", alt: "Line illustration of a browser frame with its header, hero, gallery and date list drawn together in layers", cap: "STEP TWO" }],
    steps: [
      "Design comes first: your photos, your colours, the way your name is set.",
      "It goes up on a staging link right away, so you watch it get built instead of waiting for a reveal.",
      "Content goes in: gig dates, EPK, galleries, and the member forms as they come back.",
      "Revisions until it is right. There is no revision counter.",
    ],
  },
  "The Launch": {
    id: "launch",
    heading: "What Happens at Launch",
    body: "Nothing goes live until you have seen it and said yes.",
    figures: [{ art: "step-launch-ill.jpg", alt: "Line illustration of a stage with curtains drawn back and a lighting truss aimed at a browser window centre stage", cap: "STEP THREE" }],
    steps: [
      "A full pass on staging: speed, mobile, every link, every form, schema, and search settings.",
      "You approve it. That is the gate, and it does not move without you.",
      "Domain and hosting move across, usually inside the hour, with the old site kept until the new one is confirmed.",
      "A live walk-through so the band can update the site without calling anyone.",
    ],
  },
  "The Ongoing": {
    id: "ongoing",
    heading: "What Happens After Launch",
    body: "The part most shops skip. Launch is where the work starts paying off, not where it stops.",
    figures: [{ art: "step-ongoing-ill.jpg", alt: "Line illustration of a calendar and a rising graph joined by a looping arrow", cap: "STEP FOUR" }],
    steps: [
      "A monthly SEO and traffic report in plain language, not a dashboard export.",
      "Fresh articles and show recaps every month, so the site keeps giving search engines something new.",
      "Gig calendar, galleries and set lists updated whenever you send them over.",
      "Backups, updates, uptime and security handled quietly in the background.",
    ],
  },
};

const build = [
  {
    art: "build-full-band-sites.jpg",
    alt: "A lit stage viewed from the wings, instruments set and waiting",
    title: "Full Band Sites",
    body: "Gig pages. Photo galleries. Video embeds. EPK. Set list management. Everything a touring band needs, and nothing they don't. Updated by the band via CMS, maintained by Jon.",
    href: "live-band-web-studios/portfolio.html",
    cta: "See full band sites we've built →",
  },
  {
    art: "build-epk-pages.jpg",
    alt: "A press kit laid out on a road case under a work lamp",
    title: "EPK Pages",
    body: "The document that gets you the gig. Bio, tech rider, stage plot, input list, booking contact, all in one page, formatted for talent buyers and FOH engineers who've seen a hundred of these.",
  },
  {
    art: "build-personal-sites.jpg",
    alt: "A solo vocalist alone in a spotlight",
    title: "Personal Sites",
    body: "Your name. Your domain. Your story. Individual musician sites with bio, touring history, media, photos, and merch. Built for the working musician who's more than just a band member.",
  },
];

// How It Works — ported from live (4 steps).
const steps = [
  { art: "step-the-call.jpg", alt: "A telephone handset off the hook on a road case, lit by a work lamp", title: "The Call", body: "We talk. Jon listens. No intake forms, no auto-replies. You get Jon." },
  { art: "step-the-build.jpg", alt: "Wireframe sketches spread across a desk", title: "The Build", body: "Custom design starts after the call. No guessing. No mockups from a template library." },
  { art: "step-the-launch.jpg", alt: "An empty stage washed in light just before doors", title: "The Launch", body: "Staging review, your approval, then live. You get a walk-through. Not a PDF." },
  { art: "step-the-ongoing.jpg", alt: "A tour calendar open on a desk beside a laptop", title: "The Ongoing", body: "Monthly SEO reports. Blog posts. Gig calendar updates. Jon doesn't disappear after launch." },
];

/* Gold Rack hero feats (2026-11-15). New copy, pending Jon's sign-off. */
const featsLeft = [
  { title: "FULL BAND SITES", line: "Gig pages, galleries, video and set lists.", href: "#kit", icon: "screen" as const },
  { title: "EPK PAGES", line: "Tech rider and stage plot on one link.", href: "#kit", icon: "doc" as const },
  { title: "PERSONAL SITES", line: "Your name, your domain.", href: `${rel}live-band-web-studios/personal-sites.html`, icon: "person" as const },
];
const featsRight = [
  { title: "SEO BUILT IN", line: "Built to rank. Worked on after launch.", href: "#seo", icon: "search" as const },
  { title: "YOU CAN EDIT IT", line: "Update gig dates without calling Jon.", href: `${rel}live-band-web-studios/pricing.html`, icon: "pen" as const },
  { title: "THE CALL", line: "You talk to Jon. No intake forms.", href: "#process", icon: "phone" as const },
];

/* Button and card labels drop the trailing arrow glyph: the Gold Rack draws
   its own arrow chip, and the labels are set in mono caps by CSS. */
const bare = (s: string) => s.replace(/\s*→\s*$/, "");
---

<LiveBandLayout
  title="Live Band Web Studios | Websites for Touring Bands & Artists"
  description="Websites for working bands and artists: tour dates, press kits and EPKs, setlists, music, and booking. A studio of Live Web Studios."
  canonical="https://livewebstudios.com/live-band-web-studios"
  ogImage="images/og-live-band.jpg"
>
  <HeroRack
    logo={`${rel}images/logo-live-band-gold.png`}
    eyebrow="A SERVICE OF LIVE WEB STUDIOS"
    lines={["Your band deserves a website", "as serious as your rider."]}
    h1="Live Band Web Studios, custom websites for bands and musicians"
    sub="Hand-built. Custom. No templates. No page builders. Built by a musician who's been on every side of that stage."
    ctas={[
      { label: "Let's talk.", href: `${rel}contact.html` },
      { label: "See the work", href: `${rel}live-band-web-studios/portfolio.html` },
    ]}
    featsLeft={featsLeft}
    featsRight={featsRight}
    readout={["HAND-BUILT", "MADE TO LAST", "BUILT BY A MUSICIAN", "YOUR BAND", "YOUR SITE"]}
  >
    <VideoBg slot="media" src="bg-drumstart-1080.mp4" scrim="hero" once />
  </HeroRack>

  <!-- POSITIONING: copy left, photo right. Stacks photo-first on phones. -->
  <section class="lb-section" aria-labelledby="why-h">
    <div class="lb-container lb-why">
      <div class="lb-why__copy">
        <SectionHead nameplate="WHY NOT A TEMPLATE" id="why-h">
          They give you a template. We build you a <span class="lb-gold">website.</span>
        </SectionHead>
        <p class="lb-lead" data-reveal>The drag-and-drop site builders all start from the same place: a template someone else designed for someone else's band. Every site we build starts from scratch. Your colors. Your vibe. Your music. Fast load times. Nothing breaks, nothing needs babysitting, and there's never a surprise bill to keep it running.</p>
      </div>
      <div class="lb-why__art" data-reveal>
        <PictureFrame
          src={`${rel}images/band/why-not-a-template.jpg`}
          alt="A custom band website open on a laptop sitting on a road case backstage, lit by amber stage light"
          parallax
        />
      </div>
    </div>
  </section>

  <!-- WHAT WE BUILD -->
  <section id="kit" class="lb-section" aria-labelledby="kit-h">
    <div class="lb-container">
      <SectionHead nameplate="FOR BANDS · FOR SOLO ARTISTS · FOR THE WHOLE CIRCUIT" id="kit-h">
        What We <span class="lb-gold">Build</span>
      </SectionHead>
      <ul role="list" class="lb-grid-3">
        {build.map((b, i) => (
          <MiniCard
            stack
            num={String(i + 1).padStart(2, "0")}
            title={b.title}
            line={b.body}
            image={{ src: `${rel}images/band/${b.art}`, alt: b.alt }}
            href={b.href ? `${rel}${b.href}` : undefined}
            modal={!b.href ? modals[b.title]?.id : undefined}
            more={b.cta ? bare(b.cta) : modals[b.title] ? "More Info" : undefined}
          />
        ))}
      </ul>
      <p class="lb-section-foot" data-reveal>Want to see the full band sites we've built? <a class="lb-textlink lb-textlink--inline" href={`${rel}live-band-web-studios/portfolio.html`}>Take a look at the work</a>.</p>
    </div>
  </section>

  <!-- HOW IT WORKS: the signal chain. Each title opens its overlay. -->
  <section id="process" class="lb-section" aria-labelledby="process-h">
    <div class="lb-container">
      <SectionHead nameplate="THE PROCESS" id="process-h">How It Works</SectionHead>
      <SignalChain rel={rel} steps={steps.map((s) => ({ ...s, modal: modals[s.title]?.id }))} />
    </div>
  </section>

  <SeoRack />

  <CtaPlate />

  {/* Overlays for the cards above. Native <dialog>: the browser supplies the
      backdrop, the top layer, focus trapping and Esc-to-close, so the only
      script needed is open, and a close on any click (Jon 2026-09-14:
      "closes upon click on the pop or outside"). Gold Rack: each one is a
      charcoal plate with screws. */}
  {Object.values(modals).map((m) => (
    <dialog class="lbs-modal" id={`modal-${m.id}`} aria-labelledby={`modal-${m.id}-h`}>
      <div class="lbs-modal__inner">
        <Screws />
        <button type="button" class="lbs-modal__close" aria-label="Close">×</button>
        <h3 id={`modal-${m.id}-h`}>{m.heading}</h3>
        <div class:list={["lbs-modal__figs", m.figures.length === 1 && "is-single"]}>
          {m.figures.map((f) => (
            <figure>
              <img src={`${rel}images/band/${f.art}`} alt={f.alt} width="1000" height="750" loading="lazy" decoding="async" />
              <figcaption>{f.cap}</figcaption>
            </figure>
          ))}
        </div>
        <p>{m.body}</p>
        {m.steps && (
          <ol class="lbs-modal__steps">
            {m.steps.map((st) => <li>{st}</li>)}
          </ol>
        )}
        <span class="lbs-modal__hint">Click anywhere to close</span>
      </div>
    </dialog>
  ))}

  <script is:inline>
    // Overlays. Native <dialog> does the heavy lifting (backdrop, top layer,
    // focus handling, Esc), so this only wires the open buttons and closes on
    // any click, on the panel or outside it, per Jon 2026-09-14.
    (function () {
      var dialogs = document.querySelectorAll("dialog.lbs-modal");
      if (!dialogs.length) return;

      document.querySelectorAll("[data-modal-open]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var d = document.getElementById("modal-" + btn.dataset.modalOpen);
          if (!d) return;
          if (d.showModal) d.showModal();
          else d.setAttribute("open", "");
        });
      });

      dialogs.forEach(function (d) {
        d.addEventListener("click", function () {
          if (d.close) d.close();
          else d.removeAttribute("open");
        });
      });
    })();
  </script>
</LiveBandLayout>

<style>
  /* ---- Positioning split: copy left, framed photo right --------------- */
  .lb-why {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--lb-s-10);
    align-items: center;
  }
  .lb-why .lb-section-head { margin-bottom: var(--lb-s-6); }
  .lb-why__art { order: -1; }
  @media (min-width: 900px) {
    .lb-why { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: var(--lb-s-16); }
    .lb-why__art { order: 0; }
  }

  /* A textlink inside a sentence reads as a link, not a button-height row. */
  .lb-textlink--inline { display: inline; min-height: 0; }

  /* ---- Overlays: a charcoal plate with screws ------------------------- */
  .lbs-modal {
    width: min(760px, calc(100vw - 2rem));
    max-height: calc(100vh - 3rem);
    /* global.css's *{margin:0} beats the UA centring; restore it. */
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--lb-r-panel);
    background: var(--lb-charcoal);
    color: var(--lb-cream);
    box-shadow: var(--lb-shadow-inset), inset 0 2px 0 var(--lb-edge-light), 0 40px 120px rgba(0, 0, 0, 0.7);
    overflow: auto;
  }
  .lbs-modal::backdrop {
    background: rgba(14, 12, 10, 0.8);
    backdrop-filter: blur(6px);
  }
  .lbs-modal__inner {
    position: relative;
    padding: 2.2rem 2.2rem 1.8rem;
    cursor: pointer;
  }
  .lbs-modal__close {
    position: absolute;
    top: 1.1rem;
    right: 1.4rem;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--lb-brass) 55%, transparent);
    background: transparent;
    color: var(--lb-brass);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
  }
  .lbs-modal__close:hover { color: var(--lb-brass-bright); border-color: var(--lb-brass-bright); }
  .lbs-modal h3 {
    font-size: var(--lb-fs-h3);
    margin: 0 3rem 1.2rem 0;
  }
  .lbs-modal__figs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
    margin-bottom: 1.2rem;
  }
  .lbs-modal__figs.is-single { grid-template-columns: 1fr; }
  .lbs-modal__figs figure { margin: 0; }
  .lbs-modal__figs img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--lb-r-2);
    box-shadow: inset 0 0 0 1px var(--lb-hairline-soft);
  }
  .lbs-modal__figs figcaption {
    margin-top: 0.5rem;
    font: 500 var(--lb-fs-mono-sm) / 1.3 var(--lb-font-mono);
    letter-spacing: var(--lb-tracking-mono);
    color: var(--lb-brass);
  }
  .lbs-modal p {
    color: var(--lb-parchment);
    margin: 0 0 1.1rem;
  }
  .lbs-modal__steps {
    list-style: none;
    counter-reset: lbs-step;
    margin: 0 0 1.2rem;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .lbs-modal__steps li {
    counter-increment: lbs-step;
    position: relative;
    padding-left: 2.2rem;
    color: var(--lb-parchment);
    line-height: 1.5;
    max-width: 62ch;
  }
  .lbs-modal__steps li::before {
    content: counter(lbs-step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.12rem;
    font: 500 var(--lb-fs-mono-sm) / 1.4 var(--lb-font-mono);
    letter-spacing: 0.1em;
    color: var(--lb-brass);
  }
  .lbs-modal__hint {
    display: block;
    font: 400 var(--lb-fs-mono-sm) / 1.4 var(--lb-font-mono);
    letter-spacing: var(--lb-tracking-mono);
    text-transform: uppercase;
    color: var(--lb-steel);
  }
  @media (max-width: 640px) {
    .lbs-modal__figs { grid-template-columns: 1fr; }
    .lbs-modal__inner { padding: 1.8rem 1.3rem 1.4rem; }
  }
</style>
