---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Glass from "../components/Glass.astro";
import VideoBg from "../components/VideoBg.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Aurora from "../components/Aurora.jsx";
import Marquee from "../components/Marquee.astro";
import HeroActions from "../components/HeroActions.astro";

/* Home service cards — same six topics, same shared ServiceCard.
   "LEARN MORE" was a forbidden phrase; CTA reads SEE DETAILS.
   2026-09-02: home now runs the dark carbon art via art="metal", so it
   no longer matches /services (which keeps the blue clouds). That was
   Jon's call and it overrides the 2026-08-27 "make them match" note. */
const cardArt = "images/bg/metal-weave.jpg";
const homeServices = [
  { title: "Website Design & Development", body: "Built from scratch. No templates, no page builders.", href: "services.html#web-design" },
  { title: "Web Hosting & Maintenance", body: "Dedicated infrastructure. Jon watches it so you don't have to.", href: "services.html#hosting" },
  { title: "AI Platformed Websites", tag: "NEW", body: "Next-gen static sites built with AI. Faster. Cleaner. Lower maintenance.", href: "services.html#ai-platformed" },
  { title: "SEO & Local Search", body: "Real businesses. Real searches. North Jersey and beyond.", href: "services.html#seo" },
  { title: "AI Workflow Consulting", body: "Finding where AI tools save you actual time and money.", href: "services.html#ai-consulting" },
  { title: "Monthly Site Care", body: "Ongoing partner. Not a one-time vendor.", href: "services.html#site-care" },
];


/* Home-page schema: LocalBusiness, matching the node the live site carries.
   Every other page falls back to Base's WebPage default. */
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Live Web Studios",
  url: "https://livewebstudios.com",
  telephone: "732-801-9611",
  email: "jonwolf@livewebstudios.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "446 Saddle River Rd., Unit 2",
    addressLocality: "Saddle Brook",
    addressRegion: "NJ",
    postalCode: "07663",
    addressCountry: "US",
  },
  areaServed: "US",
  foundingDate: "2004",
  founder: { "@type": "Person", name: "Jon Wolf" },
};
---

<Base jsonld={localBusiness}>
  <Nav />

  <main>

  <!-- HERO -->
  <!-- hero--bare: no glass panel on the home hero (Jon 2026-09-12). Every
       other hero, Live Band included, keeps it. -->
  <section class="hero hero--bare">
    <VideoBg src="bg-looping-waves.mp4" scrim="hero" />
    <div class="wrap hero-in">
      <div class="chip"><span class="dot"></span> LIVE · TAKING NEW PROJECTS</div>
      <p class="eyebrow is-center mb-lg">NORTH JERSEY · WEB DESIGN · AI BUILDS · SINCE 2004</p>
      <h1 class="hero-h1">Web design. Hosting. <em>AI-powered</em> builds.</h1>
      <p class="hero-sub">Real work. Real results. One call.</p>
      <HeroActions links />
      <div class="telemetry">
        <span>ESTABLISHED <b>2004</b></span>
        <span>SITES SHIPPED <b>200+</b></span>
        <span>RESPONSE <b>ONE CALL</b></span>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <Marquee />

  <!-- SERVICES -->
  <section id="services" class="sec-pad has-aurora sec-grid">
    <Aurora className="aurora--bg" base="#04060c" />
    <div class="wrap">
      <div class="sec-head center reveal">
        <span class="eyebrow">WHAT WE BUILD</span>
        <h2>Everything your business needs online.</h2>
      </div>
      <div class="grid-svc">
        {homeServices.map((c) => (
          <ServiceCard title={c.title} body={c.body} href={c.href} bg={cardArt} art="metal" tag={c.tag} />
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="sec-pad is-alt sec-photobg" style="--sec-photo:url('images/jon-desk.jpg')">
    <div class="wrap split">
      <div class="copy reveal">
        <span class="eyebrow">WHO YOU'RE WORKING WITH</span>
        <div class="sec-head is-flush"><h2>I'm a web guy.</h2></div>
        <p>Not an agency of 40. Not a platform. Just me, Jon Wolf, building and maintaining websites for North Jersey businesses since 2004.</p>
        <p>I started in IT. Wore a tie. Hated it. A plumber friend needed a website, I built it, and things kind of snowballed from there.</p>
        <p>These days I'm deep into AI-built sites. Fast, clean HTML that Google rewards and clients actually understand. No plugin nightmares. No security drama. Just sites that work.</p>
        <p class="kick">My number's on the website. I pick up.</p>
        <div class="mt-lg"><a href="about.html" class="btn btn-ghost">More About Me →</a></div>
      </div>
    </div>
  </section>

  {/* FEATURE + CTA
      The standalone "Ready to talk about your site?" section was dropped
      (Jon 2026-09-02) and its button pair moved in here, so the page ends
      on one panel instead of two stacked glass boxes. id="contact" comes
      along with the buttons: nothing currently links to it, but it was the
      page's contact anchor and moving it keeps any external or bookmarked
      #contact link landing on the buttons rather than on nothing.
      Astro comment, not HTML, so the removed copy does not ship. */}
  <section id="contact" class="sec-pad has-videobg">
    <VideoBg src="bg-color-tv.mp4" scrim="default" />
    <div class="wrap">
      <Glass class="reveal" innerClass="feature glass-refract">
        <span class="eyebrow is-center mb-md">THE LWS WAY</span>
        <h2>Every site we launch is opening night.</h2>
        <p>We don't deliver half-finished work. When a site goes live, it's ready. Tested, reviewed, approved, and yours. No soft launches. No "we'll fix it after." The curtain goes up when the show is ready.</p>
        <div class="hero-btns">
          <a href="contact.html" class="btn btn-primary">Let's Talk →</a>
          <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
        </div>
      </Glass>
    </div>
  </section>

  </main>

  <Footer />

  <!-- Netlify Identity: required on the site's main page so Decap CMS invite
       links resolve (the widget detects the #invite_token) and post-login
       hands off to the admin. Relative 'admin/' redirect per the path rule. -->
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script is:inline>
    (function () {
      if (!window.netlifyIdentity) return;
      window.netlifyIdentity.on("init", function (user) {
        if (!user) {
          window.netlifyIdentity.on("login", function () {
            document.location.href = "admin/";
          });
        }
      });
    })();
  </script>
</Base>

<style>
  /* Scanline stage for the services band (Jon 2026-08-27). The overlay
     paints at z-index 0; the content wrapper rides above it. */
</style>
