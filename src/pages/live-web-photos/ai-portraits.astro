    <!-- Lightbox for portfolio gallery -->
    <div class="lightbox" id="portfolio-lightbox" role="dialog" aria-label="Portfolio image" aria-hidden="true">
      <button class="lightbox-close" aria-label="Close lightbox">&times;</button>
      <button class="lightbox-nav lightbox-prev" aria-label="Previous image">&lsaquo;</button>
      <img decoding="async" alt="">
      <button class="lightbox-nav lightbox-next" aria-label="Next image">&rsaquo;</button>
    </div>

    <script is:inline>
    (function(){
      // Each gallery (Jon's hero set and each sample-portfolio grid) is its own
      // group: arrows step through the clicked gallery only.
      var galleries = document.querySelectorAll('#portfolio-gallery, .portfolio-grid');
      var lightbox = document.getElementById('portfolio-lightbox');
      if (!galleries.length || !lightbox) return;
      var lightboxImg = lightbox.querySelector('img');
      var closeBtn = lightbox.querySelector('.lightbox-close');
      var prevBtn = lightbox.querySelector('.lightbox-prev');
      var nextBtn = lightbox.querySelector('.lightbox-next');
      var thumbs = [];
      var currentIndex = 0;

      function setImage(i) {
        lightboxImg.setAttribute('src', thumbs[i].getAttribute('src'));
        lightboxImg.setAttribute('alt', thumbs[i].getAttribute('alt') || '');
      }
      function open(i) {
        currentIndex = i;
        setImage(i);
        lightbox.classList.remove('swapping');
        // Force reflow so the scale(0.94)+opacity(0) state is committed
        // before the .open class transitions us to scale(1)+opacity(1)
        void lightboxImg.offsetWidth;
        lightbox.classList.add('open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      function close() {
        lightbox.classList.remove('open');
        lightbox.classList.remove('swapping');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
      function show(delta) {
        var n = thumbs.length;
        currentIndex = (currentIndex + delta + n) % n;
        // If reduced motion is preferred, swap instantly
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          setImage(currentIndex);
          return;
        }
        // Brief fade-out, swap src mid-dip, fade back in
        lightbox.classList.add('swapping');
        setTimeout(function() {
          setImage(currentIndex);
          var done = function() { lightbox.classList.remove('swapping'); };
          if (lightboxImg.complete && lightboxImg.naturalWidth) {
            done();
          } else {
            lightboxImg.addEventListener('load', done, { once: true });
          }
        }, 180);
      }

      Array.prototype.forEach.call(galleries, function(gallery){
        var group = gallery.querySelectorAll('.photo-frame img');
        Array.prototype.forEach.call(group, function(img, i){
          img.addEventListener('click', function(){
            thumbs = group;
            lightbox.classList.toggle('single', group.length < 2);
            open(i);
          });
        });
      });

      lightbox.addEventListener('click', function(e){
        if (e.target === lightbox) close();
      });
      lightboxImg.addEventListener('click', function(e){ e.stopPropagation(); });
      closeBtn.addEventListener('click', function(e){ e.stopPropagation(); close(); });
      prevBtn.addEventListener('click', function(e){ e.stopPropagation(); show(-1); });
      nextBtn.addEventListener('click', function(e){ e.stopPropagation(); show(1); });

      document.addEventListener('keydown', function(e){
        if (!lightbox.classList.contains('open')) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') show(1);
        else if (e.key === 'ArrowLeft') show(-1);
      });
    })();
    </script>
  </main>

  <Footer />
  <LwpScripts />
</Base>
