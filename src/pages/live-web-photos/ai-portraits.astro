        <div class="photo-frame"><img loading="lazy" decoding="async" src="../images/lwp/pro-portfolio/jon-cafe.jpg" alt="AI professional portrait — lifestyle café setting" style="width:100%;aspect-ratio:3/4;object-fit:cover;cursor:zoom-in;" width="1067" height="800"></div>
        <div class="photo-frame"><img loading="lazy" decoding="async" src="../images/lwp/pro-portfolio/jon-park-bench.jpg" alt="AI professional portrait — outdoor urban street" style="width:100%;aspect-ratio:3/4;object-fit:cover;cursor:zoom-in;" width="1067" height="800"></div>
        <div class="photo-frame"><img loading="lazy" decoding="async" src="../images/lwp/pro-portfolio/jon-teaching.jpg" alt="AI professional portrait — candid walking shot" style="width:100%;aspect-ratio:3/4;object-fit:cover;cursor:zoom-in;" width="1067" height="800"></div>
        <div class="photo-frame"><img loading="lazy" decoding="async" src="../images/lwp/pro-portfolio/jon-studio.jpg" alt="AI professional portrait — studio look" style="width:100%;aspect-ratio:3/4;object-fit:cover;cursor:zoom-in;" width="1152" height="1536"></div>
