<Base
  title={"AI Professional Portfolio Photos — No Photographer Needed | Live Web Photos"}
  description={"Send us 20 phone photos. We generate a complete professional portrait portfolio using AI — office, lifestyle, editorial, social. Starting at $149. 48-hour delivery."}
  canonical="https://livewebstudios.com/live-web-photos/ai-portraits"
  ogImage="images/lwp/og-home.jpg"
