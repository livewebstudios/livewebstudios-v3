---
/**
 * /live-web-photos/services. Live Web Photos, the fourth studio.
 *
 * Ported on 2026-11-16 from livewebphotos.com/services.html (five-studio
 * navigation, handoff section 5). The copy is carried over as written; Jon
 * edits it later. What changed is the frame around it: the studio strip, the
 * Live Web Photos nav, the ticker and the footer come from this site, asset
 * and link paths are relative to this address, and six class names that
 * collide with this site's own carry an lwp- prefix. Styles: src/styles/lwp.css.
 * Sliders, FAQ and scroll reveal: src/components/LwpScripts.astro.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Marquee from "../../components/Marquee.astro";
import LwpScripts from "../../components/LwpScripts.astro";
import "../../styles/lwp.css";
---

<Base
  title={"AI Image Enhancement Services | Live Web Photos"}
  description={"Virtual staging, e-commerce product enhancement, architectural visualization, AI professional portfolios, and floral photography — all delivered in 48 hours."}
  canonical="https://livewebstudios.com/live-web-photos/services"
  ogImage="images/lwp/og-home.jpg"
  ogTitle={"AI Image Services | Live Web Photos"}
  ogDescription={"Studio-quality AI image editing at scale. 48-hour delivery. Free sample edit."}
>
  <Nav />

  <main class="theme-lwp">
    <div class="page-hero">
      <div class="container">
        <span class="section-label">What We Do</span>
        <h1>AI Image Enhancement Services</h1>
        <p>Every service we offer starts with a simple premise: your visuals should work as hard as you do. We make that happen at a fraction of traditional costs — and a fraction of the wait.</p>
      </div>
      <Marquee />
    </div>

    <!-- SERVICES DETAIL -->
    <section class="section">
      <div class="container">

        <!-- Virtual Staging -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;padding-bottom:80px;border-bottom:1px solid var(--color-border);margin-bottom:80px;;overflow:visible">
          <div>
            <span class="section-label">Service 01</span>
            <h2>Virtual Staging</h2>
            <p style="color:var(--color-mid);margin:16px 0;line-height:1.8;">Empty rooms don't sell. We fill them — with photorealistic AI-generated furniture, finishes, and atmosphere that makes buyers picture themselves living there.</p>
            <p style="color:var(--color-mid);line-height:1.8;">Faster than physical staging. Dramatically cheaper than rental furniture. Indistinguishable from the real thing when done right.</p>
            <ul style="margin:24px 0;color:var(--color-mid);font-size:0.9rem;">
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Living rooms, bedrooms, kitchens, dining areas</li>
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Multiple style options (modern, traditional, transitional)</li>
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Starting at $25/room</li>
              <li style="padding:8px 0;">→ 48-hour delivery standard</li>
            </ul>
            <a href="case-studies/real-estate.html" class="lwp-btn lwp-btn-outline">SEE CASE STUDY</a>
          </div>
          <div>
            <div style="text-align:center;margin-bottom:14px;">
              <a href="case-studies/real-estate.html" style="font-size:0.68rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:var(--color-mid);text-decoration:none;">See More Examples →</a>
            </div>
            <div class="photo-frame"><img loading="lazy" decoding="async" src="../images/lwp/service-staging1-after.jpg" alt="Virtual staging before and after — empty room to furnished" style="width:100%;aspect-ratio:4/3;object-fit:contain;background:var(--color-bg-card);" width="1200" height="896"></div>
          </div>
        </div>

        <!-- E-Commerce -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;padding-bottom:80px;border-bottom:1px solid var(--color-border);margin-bottom:80px;;overflow:visible">
          <div>
            <div style="text-align:center;margin-bottom:14px;">
              <a href="case-studies/ecommerce.html" style="font-size:0.68rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:var(--color-mid);text-decoration:none;">See More Examples →</a>
            </div>
            <div class="photo-frame"><img loading="lazy" decoding="async" src="../images/lwp/service-commerce1after.jpg" alt="E-commerce product photo enhancement before and after" style="width:100%;aspect-ratio:4/3;object-fit:contain;background:var(--color-bg-card);" width="1200" height="896"></div>
          </div>
          <div>
            <span class="section-label">Service 02</span>
            <h2>E-Commerce Product Enhancement</h2>
            <p style="color:var(--color-mid);margin:16px 0;line-height:1.8;">Your product photos are doing the selling. If they look like smartphone snapshots, that's what people assume about your product. We fix that at catalog scale.</p>
            <p style="color:var(--color-mid);line-height:1.8;">Background removal, studio lighting simulation, color correction, lifestyle scene placement — processed in bulk with consistent quality across every SKU.</p>
            <ul style="margin:24px 0;color:var(--color-mid);font-size:0.9rem;">
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Background removal and replacement</li>
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Lifestyle context and scene placement</li>
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Starting at $8/image (volume pricing available)</li>
              <li style="padding:8px 0;">→ Bulk orders processed in batches</li>
            </ul>
            <a href="case-studies/ecommerce.html" class="lwp-btn lwp-btn-outline">SEE CASE STUDY</a>
          </div>
        </div>

        <!-- Architectural -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;padding-bottom:80px;border-bottom:1px solid var(--color-border);margin-bottom:80px;;overflow:visible">
          <div>
            <span class="section-label">Service 03</span>
            <h2>Architectural Visualization</h2>
            <p style="color:var(--color-mid);margin:16px 0;line-height:1.8;">Renderings without people look like blueprints. Construction photos without context look like job sites. We add life, scale, and atmosphere to architectural visuals so they tell the actual story.</p>
            <p style="color:var(--color-mid);line-height:1.8;">People, landscaping, sky replacement, interior furnishing, activated lighting — all of it AI-generated to photorealistic standard.</p>
            <ul style="margin:24px 0;color:var(--color-mid);font-size:0.9rem;">
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Sky replacement and weather conditions</li>
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ People, vehicles, and landscaping added</li>
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Interior furnishing and lighting activation</li>
              <li style="padding:8px 0;">→ Starting at $35/image</li>
            </ul>
            <a href="case-studies/architecture.html" class="lwp-btn lwp-btn-outline">SEE CASE STUDY</a>
          </div>
          <div>
            <div style="text-align:center;margin-bottom:14px;">
              <a href="case-studies/architecture.html" style="font-size:0.68rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:var(--color-mid);text-decoration:none;">See More Examples →</a>
            </div>
            <div class="photo-frame"><img loading="lazy" decoding="async" src="../images/lwp/service-architect1-after.jpg" alt="Architectural visualization enhancement before and after" style="width:100%;aspect-ratio:4/3;object-fit:contain;background:var(--color-bg-card);" width="1264" height="848"></div>
          </div>
        </div>

        <!-- AI Portraits -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;padding-bottom:80px;border-bottom:1px solid var(--color-border);margin-bottom:80px;;overflow:visible">
          <div>
            <div style="text-align:center;margin-bottom:14px;">
              <a href="ai-portraits.html" style="font-size:0.68rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:var(--color-mid);text-decoration:none;">See More Examples →</a>
            </div>
            <div class="photo-frame"><img loading="lazy" decoding="async" src="../images/lwp/pro-portfolio/jon-studio.jpg" alt="AI professional portrait — photography quality result" style="width:100%;aspect-ratio:4/3;object-fit:contain;background:var(--color-bg-card);" width="1152" height="1536"></div>
          </div>
          <div>
            <span class="section-label spark">Service 04 — Featured</span>
            <h2>AI Professional Portfolios</h2>
            <p style="color:var(--color-mid);margin:16px 0;line-height:1.8;">Twenty phone photos in. A complete professional portfolio out. Office, café, city street, park, candid lifestyle — every scene generated at photography quality.</p>
            <p style="color:var(--color-mid);line-height:1.8;">The world runs on professional imagery. LinkedIn matters. Your website headshot matters. Your press kit matters. A photographer doesn't have to.</p>
            <ul style="margin:24px 0;color:var(--color-mid);font-size:0.9rem;">
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ 15–20 final portfolio images delivered</li>
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Multiple scenes and settings</li>
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Print-ready and web-optimized versions</li>
              <li style="padding:8px 0;">→ Starting at $149/person</li>
            </ul>
            <a href="ai-portraits.html" class="lwp-btn">LEARN MORE</a>
          </div>
        </div>

        <!-- Floral -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;;overflow:visible">
          <div>
            <span class="section-label">Service 05</span>
            <h2>Floral & Specialty Retail</h2>
            <p style="color:var(--color-mid);margin:16px 0;line-height:1.8;">Flower shops live or die by their visual presence. A stunning arrangement photographed under fluorescent shop lights doesn't do the work justice. We fix that.</p>
            <p style="color:var(--color-mid);line-height:1.8;">Background replacement, color vibrancy enhancement, studio lighting simulation — for florists, specialty food retailers, boutique product businesses.</p>
            <ul style="margin:24px 0;color:var(--color-mid);font-size:0.9rem;">
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Background replacement (white, contextual, editorial)</li>
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Color enhancement and saturation correction</li>
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Starting at $12/image</li>
              <li style="padding:8px 0;">→ Seasonal catalog packages available</li>
            </ul>
            <a href="case-studies/floral.html" class="lwp-btn lwp-btn-outline">SEE CASE STUDY</a>
          </div>
          <div>
            <div style="text-align:center;margin-bottom:14px;">
              <a href="case-studies/floral.html" style="font-size:0.68rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:var(--color-mid);text-decoration:none;">See More Examples →</a>
            </div>
            <div class="photo-frame"><img loading="lazy" decoding="async" src="../images/lwp/service-floral1-after.jpg" alt="Floral arrangement photo enhancement before and after" style="width:100%;aspect-ratio:4/3;object-fit:contain;background:var(--color-bg-card);" width="1200" height="896"></div>
          </div>
        </div>

      </div>
    </section>

    <!-- PRICING LINK -->
    <section style="background:var(--color-accent-fill);padding:60px 0;text-align:center;">
      <div class="container">
        <h2 style="color:#fff;margin-bottom:12px;">Simple, Transparent Pricing</h2>
        <p style="color:rgba(255,255,255,0.8);max-width:480px;margin:0 auto 28px;">No quotes on request, no surprise invoices. See exactly what each service costs before you submit a single image.</p>
        <a href="pricing.html" class="lwp-btn lwp-btn--onfill">VIEW PRICING</a>
      </div>
    </section>
  </main>

  <Footer />
  <LwpScripts />
</Base>
