---
/**
 * /live-web-photos/case-studies/real-estate. Live Web Photos, the fourth studio.
 *
 * Ported on 2026-11-16 from livewebphotos.com/case-studies/real-estate.html (five-studio
 * navigation, handoff section 5). The copy is carried over as written; Jon
 * edits it later. What changed is the frame around it: the studio strip, the
 * Live Web Photos nav, the ticker and the footer come from this site, asset
 * and link paths are relative to this address, and six class names that
 * collide with this site's own carry an lwp- prefix. Styles: src/styles/lwp.css.
 * Sliders, FAQ and scroll reveal: src/components/LwpScripts.astro.
 */
import Base from "../../../layouts/Base.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import Marquee from "../../../components/Marquee.astro";
import LwpScripts from "../../../components/LwpScripts.astro";
import "../../../styles/lwp.css";
---

<Base
  title={"Virtual Staging Case Study — Real Estate | Live Web Photos"}
  description={"How AI virtual staging cut average days-on-market from 32 to 11 for a North Jersey real estate brokerage. Before/after pairs across living rooms, bedrooms, and kitchens."}
  canonical="https://livewebstudios.com/live-web-photos/case-studies/real-estate"
  ogImage="images/lwp/og-home.jpg"
  ogTitle={"Virtual Staging Case Study | Live Web Photos"}
  ogDescription={"Empty rooms staged digitally — listings move 3× faster."}
>
  <Nav />

  <main class="theme-lwp">
    <div class="page-hero">
      <div class="container">
        <span class="section-label">Case Study — Real Estate</span>
        <h1>Empty Rooms Sell Slowly. Staged Rooms Sell Fast.</h1>
        <p>How AI virtual staging cut average days-on-market from 32 to 11 across a 40-listing brokerage portfolio in Northern New Jersey.</p>
      </div>
      <Marquee />
    </div>

    <!-- BEFORE/AFTER GRID -->
    <section class="section-alt">
      <div class="container">
        <span class="section-label">Before / After</span>
        <h2 class="section-title">Drag to Compare</h2>
        <p class="section-intro">Each pair below is a real listing photo we staged for a working realtor. The before is the actual MLS shot. The after went live the same week.</p>
      </div>
      <div class="slider-gallery cs-stack" style="margin-top:40px;">

        <div class="gallery-slider-item">
          <div class="slider-frame"><div class="slider-wrap" id="cs-real-1">
            <img loading="lazy" decoding="async" src="../../images/lwp/service-staging1-after.jpg" alt="After virtual staging — furnished living room" width="1200" height="896">
            <div class="slider-before" style="width:50%;"><img loading="lazy" decoding="async" src="../../images/lwp/service-staging1-before.jpg" alt="Before staging — empty living room" width="1200" height="896"></div>
            <div class="slider-divider" style="left:50%;"><div class="slider-handle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l-6-6 6-6M15 6l6 6-6 6"/></svg></div></div>
            <span class="slider-label label-before">BEFORE</span>
            <span class="slider-label label-after">AFTER</span>
          </div></div>
          <div class="slider-category">Living Room — Modern Transitional</div>
        </div>

        <div class="gallery-slider-item">
          <div class="slider-frame"><div class="slider-wrap" id="cs-real-2">
            <img loading="lazy" decoding="async" src="../../images/lwp/service-staging2-after.jpg" alt="After virtual staging — staged bedroom" width="1200" height="896">
            <div class="slider-before" style="width:50%;"><img loading="lazy" decoding="async" src="../../images/lwp/service-staging2-before.jpg" alt="Before staging — empty bedroom" width="1200" height="896"></div>
            <div class="slider-divider" style="left:50%;"><div class="slider-handle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l-6-6 6-6M15 6l6 6-6 6"/></svg></div></div>
            <span class="slider-label label-before">BEFORE</span>
            <span class="slider-label label-after">AFTER</span>
          </div></div>
          <div class="slider-category">Bedroom — Warm Contemporary</div>
        </div>

        <div class="gallery-slider-item">
          <div class="slider-frame"><div class="slider-wrap" id="cs-real-3">
            <img loading="lazy" decoding="async" src="../../images/lwp/service-staging3-after.jpg" alt="After virtual staging — staged kitchen and dining" width="1200" height="896">
            <div class="slider-before" style="width:50%;"><img loading="lazy" decoding="async" src="../../images/lwp/service-staging3-before.jpg" alt="Before staging — empty kitchen" width="1200" height="896"></div>
            <div class="slider-divider" style="left:50%;"><div class="slider-handle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l-6-6 6-6M15 6l6 6-6 6"/></svg></div></div>
            <span class="slider-label label-before">BEFORE</span>
            <span class="slider-label label-after">AFTER</span>
          </div></div>
          <div class="slider-category">Kitchen / Dining — Open Plan</div>
        </div>

        <div class="gallery-slider-item">
          <div class="slider-frame"><div class="slider-wrap" id="cs-real-4">
            <img loading="lazy" decoding="async" src="../../images/lwp/service-staging4-after.jpg" alt="After virtual staging — staged secondary room" width="1200" height="896">
            <div class="slider-before" style="width:50%;"><img loading="lazy" decoding="async" src="../../images/lwp/service-staging4-before.jpg" alt="Before staging — empty room" width="1200" height="896"></div>
            <div class="slider-divider" style="left:50%;"><div class="slider-handle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l-6-6 6-6M15 6l6 6-6 6"/></svg></div></div>
            <span class="slider-label label-before">BEFORE</span>
            <span class="slider-label label-after">AFTER</span>
          </div></div>
          <div class="slider-category">Secondary Room — Home Office</div>
        </div>

      </div>
    </section>

    <!-- RESULTS -->
    <section class="section">
      <div class="container">
        <span class="section-label spark">The Numbers</span>
        <h2 class="section-title">What Changed After Staging</h2>
        <p class="section-intro">Tracked across 40 staged listings against 40 paired control listings of similar price band, square footage, and location.</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px;margin-top:60px;">
          <div style="background:var(--color-bg-card);padding:36px 28px;border-radius:var(--radius-card);box-shadow:var(--shadow-glow);text-align:center;">
            <div style="font-family:var(--font-display);font-size:3.2rem;font-weight:700;color:var(--color-accent);line-height:1;margin-bottom:10px;">11</div>
            <div style="font-size:0.78rem;color:var(--color-white);text-transform:uppercase;letter-spacing:0.12em;font-weight:600;">Avg Days on Market</div>
            <div style="font-size:0.78rem;color:var(--color-mid);margin-top:6px;">down from 32 unstaged</div>
          </div>
          <div style="background:var(--color-bg-card);padding:36px 28px;border-radius:var(--radius-card);box-shadow:var(--shadow-glow);text-align:center;">
            <div style="font-family:var(--font-display);font-size:3.2rem;font-weight:700;color:var(--color-accent);line-height:1;margin-bottom:10px;">3.4×</div>
            <div style="font-size:0.78rem;color:var(--color-white);text-transform:uppercase;letter-spacing:0.12em;font-weight:600;">More Showing Requests</div>
            <div style="font-size:0.78rem;color:var(--color-mid);margin-top:6px;">first 14 days vs. control</div>
          </div>
          <div style="background:var(--color-bg-card);padding:36px 28px;border-radius:var(--radius-card);box-shadow:var(--shadow-glow);text-align:center;">
            <div style="font-family:var(--font-display);font-size:3.2rem;font-weight:700;color:var(--color-accent);line-height:1;margin-bottom:10px;">$25</div>
            <div style="font-size:0.78rem;color:var(--color-white);text-transform:uppercase;letter-spacing:0.12em;font-weight:600;">Avg Cost per Room</div>
            <div style="font-size:0.78rem;color:var(--color-mid);margin-top:6px;">vs. $300+ physical staging</div>
          </div>
          <div style="background:var(--color-bg-card);padding:36px 28px;border-radius:var(--radius-card);box-shadow:var(--shadow-glow);text-align:center;">
            <div style="font-family:var(--font-display);font-size:3.2rem;font-weight:700;color:var(--color-accent);line-height:1;margin-bottom:10px;">96%</div>
            <div style="font-size:0.78rem;color:var(--color-white);text-transform:uppercase;letter-spacing:0.12em;font-weight:600;">Realtor Retention</div>
            <div style="font-size:0.78rem;color:var(--color-mid);margin-top:6px;">re-orders within 6 months</div>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICE SUMMARY + PRICING -->
    <section class="section-alt">
      <div class="container">
        <div style="display:grid;grid-template-columns:1.2fr 1fr;gap:60px;align-items:center;">
          <div>
            <span class="section-label">The Service</span>
            <h2>Virtual Staging Built for Listings That Need to Move.</h2>
            <p style="color:var(--color-mid);margin:16px 0;line-height:1.8;">Send us your empty-room listing photos. We return them staged with photorealistic AI-generated furniture, finishes, and styling — chosen to match the home's price point and target buyer.</p>
            <p style="color:var(--color-mid);line-height:1.8;">Multiple style options per room. 48-hour turnaround on standard orders. One round of revisions included. No subscription, no minimum, no contract.</p>
            <ul style="margin:24px 0;color:var(--color-mid);font-size:0.9rem;">
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Modern, traditional, transitional, coastal, farmhouse styles</li>
              <li style="padding:8px 0;border-bottom:1px solid var(--color-border);">→ Living rooms, bedrooms, kitchens, dining, home offices</li>
              <li style="padding:8px 0;">→ Pricing scales with room volume — see pricing for tiers</li>
            </ul>
            <a href="../contact.html" class="lwp-btn">GET A FREE SAMPLE</a>
          </div>
          <div style="background:var(--color-bg-card);border-radius:var(--radius-card);box-shadow:var(--shadow-glow);padding:40px;">
            <div style="font-size:0.68rem;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:var(--color-accent);margin-bottom:14px;">Starting At</div>
            <div style="font-family:var(--font-display);font-size:3.2rem;font-weight:700;color:var(--color-white);line-height:1;">$25</div>
            <div style="font-size:0.85rem;color:var(--color-mid);margin:6px 0 22px;">per room — volume discounts at 10+</div>
            <div style="border-top:1px solid var(--color-border);padding-top:20px;font-size:0.85rem;color:var(--color-mid);line-height:1.7;">Standard 48-hour delivery included. Rush 24-hour delivery available at +50%.</div>
            <a href="../pricing.html" class="lwp-btn lwp-btn-outline" style="margin-top:24px;display:inline-block;">SEE FULL PRICING</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section style="background:var(--color-accent-fill);padding:80px 0;text-align:center;">
      <div class="container">
        <h2 style="color:#fff;margin-bottom:14px;">See What Your Listing Could Look Like.</h2>
        <p style="color:rgba(255,255,255,0.85);max-width:540px;margin:0 auto 30px;font-size:1.05rem;">Send us one empty-room photo. We'll stage it free, watermarked, and return it in 24 hours. No commitment, no card required.</p>
        <a href="../contact.html" class="lwp-btn lwp-btn--onfill">GET A FREE SAMPLE</a>
      </div>
    </section>
  </main>

  <Footer />
  <LwpScripts />
</Base>
