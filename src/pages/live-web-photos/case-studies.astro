---
/**
 * /live-web-photos/case-studies. Live Web Photos, the fourth studio.
 *
 * Ported on 2026-11-16 from livewebphotos.com/case-studies.html (five-studio
 * navigation, handoff section 5). The copy is carried over as written; Jon
 * edits it later. What changed is the frame around it: the studio strip, the
 * Live Web Photos nav, the ticker and the footer come from this site, asset
 * and link paths are relative to this address, and six class names that
 * collide with this site's own carry an lwp- prefix. Styles: src/styles/lwp.css.
 * Sliders, FAQ and scroll reveal: src/components/LwpScripts.astro.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Marquee from "../../components/Marquee.astro";
import LwpScripts from "../../components/LwpScripts.astro";
import "../../styles/lwp.css";
---

<Base
  title={"AI Image Enhancement Case Studies | Live Web Photos"}
  description={"Real before/after results across virtual staging, e-commerce product photography, architectural visualization, floral, and AI professional portraits."}
  canonical="https://livewebstudios.com/live-web-photos/case-studies"
  ogImage="images/lwp/og-home.jpg"
>
  <Nav />

  <main class="theme-lwp">
    <div class="page-hero">
      <div class="container">
        <span class="section-label">Proof of Work</span>
        <h1>Case Studies</h1>
        <p>Real projects. Real before/after results. Every image in this section is actual output from our pipeline — not stock photos, not mockups.</p>
      </div>
      <Marquee />
    </div>

    <section class="section section-bg-arch" style="--lwp-bg:url('../images/lwp/bg-arch-texture.jpg')">
      <div class="container">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:24px;">

          <a href="case-studies/real-estate.html" style="background:var(--color-bg-card);display:block;text-decoration:none;color:inherit;transition:background 0.2s;" onmouseover="this.style.background='#1c1c1c'" onmouseout="this.style.background='var(--color-bg-card)'">
            <img loading="lazy" decoding="async" src="../images/lwp/service-staging1-after.jpg" alt="Virtual staging case study — real estate" style="width:100%;aspect-ratio:16/9;object-fit:cover;" width="1200" height="896">
            <div style="padding:32px;">
              <div style="font-size:0.68rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-accent);margin-bottom:8px;">Real Estate</div>
              <h3 style="margin-bottom:8px;">Virtual Staging</h3>
              <p style="color:var(--color-mid);font-size:0.88rem;margin:0;">Empty rooms furnished, styled, and lit to photorealistic standard. Before/after pairs across living rooms, bedrooms, and kitchens.</p>
            </div>
          </a>

          <a href="case-studies/ecommerce.html" style="background:var(--color-bg-card);display:block;text-decoration:none;color:inherit;transition:background 0.2s;" onmouseover="this.style.background='#1c1c1c'" onmouseout="this.style.background='var(--color-bg-card)'">
            <img loading="lazy" decoding="async" src="../images/lwp/service-commerce1after.jpg" alt="E-commerce product photo enhancement case study" style="width:100%;aspect-ratio:16/9;object-fit:cover;" width="1200" height="896">
            <div style="padding:32px;">
              <div style="font-size:0.68rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-accent);margin-bottom:8px;">E-Commerce</div>
              <h3 style="margin-bottom:8px;">Product Photography Enhancement</h3>
              <p style="color:var(--color-mid);font-size:0.88rem;margin:0;">Raw product shots transformed to studio quality. Background removal, lighting correction, lifestyle context placement.</p>
            </div>
          </a>

          <a href="case-studies/architecture.html" style="background:var(--color-bg-card);display:block;text-decoration:none;color:inherit;transition:background 0.2s;" onmouseover="this.style.background='#1c1c1c'" onmouseout="this.style.background='var(--color-bg-card)'">
            <img loading="lazy" decoding="async" src="../images/lwp/service-architect1-after.jpg" alt="Architectural visualization case study" style="width:100%;aspect-ratio:16/9;object-fit:cover;" width="1264" height="848">
            <div style="padding:32px;">
              <div style="font-size:0.68rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-accent);margin-bottom:8px;">Architecture</div>
              <h3 style="margin-bottom:8px;">Architectural Visualization</h3>
              <p style="color:var(--color-mid);font-size:0.88rem;margin:0;">Commercial and residential renders brought to life with people, landscaping, sky replacement, and activated lighting.</p>
            </div>
          </a>

          <a href="case-studies/interior-design.html" style="background:var(--color-bg-card);display:block;text-decoration:none;color:inherit;transition:background 0.2s;" onmouseover="this.style.background='#1c1c1c'" onmouseout="this.style.background='var(--color-bg-card)'">
            <img loading="lazy" decoding="async" src="../images/lwp/service-staging2-after.jpg" alt="Interior design visualization case study" style="width:100%;aspect-ratio:16/9;object-fit:cover;" width="1200" height="896">
            <div style="padding:32px;">
              <div style="font-size:0.68rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-accent);margin-bottom:8px;">Interior Design</div>
              <h3 style="margin-bottom:8px;">Interior Design Visualization</h3>
              <p style="color:var(--color-mid);font-size:0.88rem;margin:0;">Concept boards and sketches rendered into photorealistic room visualizations. Helping designers present concepts before a single piece of furniture ships.</p>
            </div>
          </a>

          <a href="case-studies/floral.html" style="background:var(--color-bg-card);display:block;text-decoration:none;color:inherit;transition:background 0.2s;" onmouseover="this.style.background='#1c1c1c'" onmouseout="this.style.background='var(--color-bg-card)'">
            <img loading="lazy" decoding="async" src="../images/lwp/service-floral1-after.jpg" alt="Floral photography enhancement case study" style="width:100%;aspect-ratio:16/9;object-fit:cover;" width="1200" height="896">
            <div style="padding:32px;">
              <div style="font-size:0.68rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-accent);margin-bottom:8px;">Floral & Specialty</div>
              <h3 style="margin-bottom:8px;">Floral Photography Enhancement</h3>
              <p style="color:var(--color-mid);font-size:0.88rem;margin:0;">Shop photos at catalog quality. $12 per image. 47% lift in online order rate measured on a North Jersey florist.</p>
            </div>
          </a>

        </div>
      </div>
    </section>

    <section style="background:var(--color-accent-fill);padding:60px 0;text-align:center;">
      <div class="container">
        <h2 style="color:#fff;margin-bottom:12px;">Send One Photo. See What Comes Back.</h2>
        <p style="color:rgba(255,255,255,0.85);max-width:440px;margin:0 auto 28px;">Submit one image. Free sample edit. No obligation.</p>
        <a href="contact.html" class="lwp-btn lwp-btn--onfill">GET A FREE SAMPLE</a>
      </div>
    </section>
  </main>

  <Footer />
  <LwpScripts />
</Base>
