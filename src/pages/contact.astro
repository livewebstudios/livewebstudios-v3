---
/**
 * /contact — ported from the live site (livewebstudios.com/contact).
 * Real Formspree endpoint (mbdqyrwg) and live field set + copy brought over,
 * rebuilt on v3 layouts/components. Keeps the v3 honeypot (_gotcha). Formspree
 * redirects to /thank-you on success, matching the live site; the old ?sent=1
 * in-page banner went with it. EM DASH BAN applied to ported copy.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Glass from "../components/Glass.astro";
import VideoBg from "../components/VideoBg.astro";
import Marquee from "../components/Marquee.astro";
import HeroActions from "../components/HeroActions.astro";
---

<Base
  title="Contact | Live Web Studios"
  description="Reach Jon Wolf directly, no account managers, no phone trees. Web design, hosting, SEO, and AI services for North Jersey businesses and beyond."
  canonical="https://livewebstudios.com/contact"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-orange-beam-noaudio.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">CONTACT</span>
        <h1 class="page-h1">Let's Build <em>Something</em>.</h1>
        <p class="page-lede">Or just ask a question. We answer those too.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- CONTACT -->
    <section class="sec-pad has-videobg">
      <VideoBg src="bg-corner.mp4" scrim="strong" />
      <div class="wrap contact-grid">
        <!-- FORM -->
        <Glass class="reveal" innerClass="form-pad">
          <!-- Real live Formspree endpoint, ported from the live contact page -->
          <form
            id="contact-form"
            action="https://formspree.io/f/mbdqyrwg"
            method="POST"
          >
            <!-- Absolute success redirect (Formspree posts from its own domain) -->
            <input type="hidden" name="_next" value="https://livewebstudios.com/thank-you" />
            <input type="hidden" name="_subject" value="New LWS Inquiry" />
            <!-- Honeypot: real users never see or fill this -->
            <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="form-row">
              <div class="field">
                <label for="name">Name</label>
                <input type="text" id="name" name="name" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="business">Business <span class="opt">(optional)</span></label>
                <input type="text" id="business" name="business" autocomplete="organization" />
              </div>
            </div>

            <div class="form-row">
              <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" autocomplete="email" required />
              </div>
              <div class="field">
                <label for="phone">Phone <span class="opt">(optional)</span></label>
                <input type="tel" id="phone" name="phone" autocomplete="tel" />
              </div>
            </div>

            <div class="field full">
              <label for="service">Service interested in</label>
              <select id="service" name="service">
                <option value="" selected>Service Interested In…</option>
                <option>Website Design</option>
                <option>AI Platform</option>
                <option>Hosting</option>
                <option>SEO</option>
                <option>AI Business Services</option>
                <option>AI Workflow</option>
                <option>Branding</option>
                <option>E-Commerce</option>
                <option>Audit</option>
                <option>Not Sure Yet</option>
              </select>
            </div>

            <div class="field full">
              <label for="message">Tell us about your project</label>
              <textarea id="message" name="message" required></textarea>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Send It →</button>
            </div>
          </form>
        </Glass>

        <!-- DETAILS -->
        <aside class="contact-aside reveal">
          <span class="label">DIRECT LINE</span>
          <h3>Talk to Jon.</h3>
          <p>You work directly with the founder. No account managers. No phone trees.</p>
          <div class="contact-line">
            <span class="k">Name</span>
            <span>Jon Wolf · President</span>
          </div>
          <div class="contact-line">
            <span class="k">Email</span>
            <a href="mailto:jonwolf@livewebstudios.com">jonwolf@livewebstudios.com</a>
          </div>
          <div class="contact-line">
            <span class="k">Phone</span>
            <a href="tel:7328019611">732.801.9611</a>
          </div>
          <div class="contact-line">
            <!-- em-dash: "Saddle Brook, NJ — Serving..." → period -->
            <span class="k">Area</span>
            <span>Saddle Brook, NJ. Serving North Jersey and Nationwide.</span>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Base>
