---
/**
 * /contact — ported from the live site (livewebstudios.com/contact).
 * Real Formspree endpoint (mbdqyrwg) and live field set + copy brought over,
 * rebuilt on v3 layouts/components. Keeps the v3 honeypot (_gotcha). Formspree
 * redirects to /thank-you on success, matching the live site; the old ?sent=1
 * in-page banner went with it. EM DASH BAN applied to ported copy.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Social from "../components/Social.astro";
import Glass from "../components/Glass.astro";
import VideoBg from "../components/VideoBg.astro";
import PhotoBg from "../components/PhotoBg.astro";
import Marquee from "../components/Marquee.astro";
import HeroActions from "../components/HeroActions.astro";
---

<Base
  title="Contact | Live Web Studios"
  description="Reach Jon Wolf directly, no account managers, no phone trees. Web design, hosting, SEO, and AI services for North Jersey businesses and beyond."
  canonical="https://livewebstudios.com/contact"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass page-head--bare has-videobg">
      <PhotoBg src="roadcase-bg.jpg" scrim="hero" position="50% 55%" brightness={1.45} />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">CONTACT</span>
        <h1 class="page-h1">Let's Build <em>Something</em>.</h1>
        <p class="page-lede">Or just ask a question. We answer those too.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- CONTACT -->
    <section class="sec-pad has-videobg">
      <VideoBg src="bg-corner.mp4" scrim="strong" />
      <div class="wrap contact-grid">
        <!-- FORM -->
        <Glass class="reveal" innerClass="form-pad">
          <!-- Real live Formspree endpoint, ported from the live contact page -->
          <form
            id="contact-form"
            action="https://formspree.io/f/mbdqyrwg"
            method="POST"
          >
            {/* Formspree redirects from ITS server, so _next has to be an
                absolute URL: a bare relative path would resolve against
                formspree.io and 404. The script at the foot of this page
                rewrites it to whatever host the page is actually served from,
                so a test submit on localhost or a Netlify preview returns
                there instead of bouncing to production. The literal below is
                only the no-JS fallback, and it carries .html to match
                astro.config's build format: 'file'. Same pattern as
                /namesake/start. */}
            <input type="hidden" name="_next" value="https://livewebstudios.com/thank-you.html" />
            <input type="hidden" name="_subject" value="New LWS Inquiry" />
            {/* Filled by the reader script below when the visitor arrives from
                a Live Band page (/contact?source=live-band), so a band enquiry
                lands in Formspree already tagged. Empty otherwise. */}
            <input type="hidden" name="source" id="contact-source" value="" />
            <!-- Honeypot: real users never see or fill this -->
            <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="form-row">
              <div class="field">
                <label for="name">Name</label>
                <input type="text" id="name" name="name" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="business">Business <span class="opt">(optional)</span></label>
                <input type="text" id="business" name="business" autocomplete="organization" />
              </div>
            </div>

            <div class="form-row">
              <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" autocomplete="email" required />
              </div>
              <div class="field">
                <label for="phone">Phone <span class="opt">(optional)</span></label>
                <input type="tel" id="phone" name="phone" autocomplete="tel" />
              </div>
            </div>

            <div class="field full">
              <label for="service">Service interested in</label>
              <select id="service" name="service">
                <option value="" selected>Service Interested In…</option>
                <option>Website Design</option>
                <option>Band / Musician Website</option>
                <option>AI Platform</option>
                <option>Hosting</option>
                <option>SEO</option>
                <option>AI Business Services</option>
                <option>AI Workflow</option>
                <option>Branding</option>
                <option>E-Commerce</option>
                <option>Audit</option>
                <option>Not Sure Yet</option>
              </select>
            </div>

            <div class="field full">
              <label for="message">Tell us about your project</label>
              <textarea id="message" name="message" required></textarea>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Send It →</button>
            </div>
          </form>
        </Glass>

        <!-- DETAILS -->
        <aside class="contact-aside reveal">
          <!-- Jon 2026-09-15: the Jon avatar heads the column, beside the
               label and heading, so the "direct line" has a face on it. -->
          <div class="contact-who">
            <img class="contact-face" src="images/lwsface.png" alt="" width="300" height="304" loading="lazy" decoding="async" />
            <div>
              <span class="label">DIRECT LINE</span>
              {/* h2, not h3: this is the only heading between the page h1
                  and the footer, so an h3 here skipped a level (launch
                  audit 2026-09-15). Its three style rules now match either. */}
              <h2>Talk to Jon.</h2>
            </div>
          </div>
          <p>You work directly with the founder. No account managers. No phone trees.</p>
          <div class="contact-line">
            <span class="k">Name</span>
            <span>Jon Wolf · President</span>
          </div>
          <div class="contact-line">
            <span class="k">Email</span>
            jonwolf@livewebstudios.com
          </div>
          <div class="contact-line">
            <span class="k">Phone</span>
            <a href="tel:7328019611">732.801.9611</a>
          </div>
          <div class="contact-line">
            <!-- em-dash: "Saddle Brook, NJ — Serving..." → period -->
            <span class="k">Area</span>
            <span>Saddle Brook, NJ. Serving North Jersey and Nationwide.</span>
          </div>
          {/* Jon 2026-09-15: the two accounts, same as the footer. Last in
              the aside so it closes the direct-line column. */}
          <div class="contact-line contact-line--social">
            <span class="k">Social</span>
            <Social />
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    /* Tag the enquiry when the visitor came in from a Live Band page.
       ?source=live-band preselects the band option and writes the value into
       the hidden field, so the tag survives even if someone changes the
       dropdown afterwards. Anything else in the param is ignored: only values
       this map knows about are ever written. */
    const SOURCES: Record<string, string> = {
      "live-band": "Band / Musician Website",
    };
    const source = new URLSearchParams(window.location.search).get("source");
    const service = source ? SOURCES[source] : undefined;

    if (source && service) {
      const hidden = document.getElementById("contact-source");
      if (hidden instanceof HTMLInputElement) hidden.value = source;

      const select = document.getElementById("service");
      if (select instanceof HTMLSelectElement) {
        const match = Array.from(select.options).find((o) => o.text === service);
        if (match) select.value = match.value || match.text;
      }
    }
  </script>

  {/* Point the Formspree return at this host, not a hardcoded domain. See the
      note on the _next input above. thank-you.html is a sibling of this page,
      so any trailing slash is stripped before resolving against it. */}
  <script is:inline>
    (function () {
      var f = document.getElementById("contact-form");
      if (!f) return;
      var n = f.querySelector('input[name="_next"]');
      if (!n) return;
      try {
        var base = window.location.href.split("#")[0].split("?")[0].replace(/\/+$/, "");
        n.value = new URL("thank-you.html", base).href;
      } catch (e) {
        /* Leave the built-in fallback in place. */
      }
    })();
  </script>
</Base>

<style>
  /* Avatar + label/heading row at the top of the details column. */
  .contact-who {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .contact-face {
    flex: none;
    width: 84px;
    height: 84px;
    border-radius: 50%;
  }
  .contact-who .label {
    margin-bottom: 0.45rem;
  }
  .contact-who :is(h2, h3) {
    margin-bottom: 0;
  }
</style>
