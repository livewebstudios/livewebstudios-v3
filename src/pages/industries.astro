---
/**
 * /industries — the Industries hub, ported from live industries/index.html.
 * Intro + a grid of all 10 industry verticals + CTA, rebuilt on v3
 * layouts/components. Root-level page, so imports go ONE dot up and in-page
 * links to an industry are "industries/<name>.html".
 * COPY RULES APPLIED: em dashes converted per the ban (marked <!-- em-dash -->);
 * bare "Learn More" (forbidden) → "SEE DETAILS →". Live hero illustration and
 * Clutch badge images dropped (no <img> in v3 ports). Marquee strip dropped.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Glass from "../components/Glass.astro";
import VideoBg from "../components/VideoBg.astro";
import CardIcon from "../components/CardIcon.astro";
import Marquee from "../components/Marquee.astro";
import HeroActions from "../components/HeroActions.astro";
import ScanLines from "../components/ScanLines.astro";

const industries = [
  { ico: "◎", title: "Healthcare", body: "HIPAA-aware websites for medical practices, clinics, and health organizations.", slug: "healthcare" },
  { ico: "❖", title: "Law Firm", body: "Professional websites for law firms. Practice area pages, intake forms, local SEO.", slug: "law-firm" },
  { ico: "◈", title: "Financial Services", body: "Websites for financial advisors, CPAs, and wealth management firms.", slug: "financial-services" },
  { ico: "⛭", title: "Construction", body: "Project showcase sites for contractors, builders, and construction companies.", slug: "construction" },
  { ico: "◧", title: "Real Estate", body: "Listing-ready websites for brokers, agents, and property management.", slug: "real-estate" },
  { ico: "▦", title: "Manufacturing", body: "Catalog and capability sites for manufacturers and industrial businesses.", slug: "manufacturing" },
  { ico: "✦", title: "Dental", body: "Patient-focused websites for dental practices with online booking integration.", slug: "dental" },
  { ico: "✧", title: "Nonprofit", body: "Mission-driven websites for nonprofits, schools, and community organizations.", slug: "nonprofit" },
  { ico: "⬡", title: "B2B", body: "Lead-generation websites for B2B companies and professional services.", slug: "b2b" },
  { ico: "◉", title: "Insurance", body: "Quote-ready websites for insurance agencies and brokers.", slug: "insurance" },
];

---

<Base
  title="Industries We Serve | Live Web Studios"
  description="Web design, SEO, and AI services tailored for healthcare, legal, finance, construction, real estate, and more."
  canonical="https://livewebstudios.com/industries"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-color-tv.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">INDUSTRIES</span>
        <h1 class="page-h1">Built for <em>Your Industry.</em></h1>
        <!-- em-dash: "unique requirements — compliance" → "unique requirements: compliance" -->
        <p class="page-lede">We don't do generic. Every industry has unique requirements: compliance, terminology, audience expectations. We build for yours.</p>
        <HeroActions />
      </div>
    </section>

    <Marquee />

    <!-- INDUSTRY GRID -->
    <section class="sec-pad has-scan">
      <ScanLines />
      <div class="wrap">
        <p class="page-lede is-center mb-lg">Pick your field. Every build is shaped around how your customers actually search, decide, and convert.</p>
        <div class="grid-svc">
          {industries.map((i) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{i.title}</h3>
                <p>{i.body}</p>
                <CardIcon title={i.title} />
                <a class="more" href={`industries/${i.slug}.html`}>SEE DETAILS →</a>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta">
          <h2>Don't See Your Industry?</h2>
          <p>We've built for dozens of verticals. Let's talk about yours.</p>
          <div class="hero-btns">
            <a href="contact.html" class="btn btn-primary">Get a Proposal →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
</style>
