---
/**
 * /industries — the Industries hub, ported from live industries/index.html.
 * Intro + a grid of all 10 industry verticals + CTA, rebuilt on v3
 * layouts/components. The FAQ block was removed 2026-09-14 (Jon: FAQ
 * belongs only on /faq), along with its data and accordion styles.
 * layouts/components. Root-level page, so imports go ONE dot up and in-page
 * links to an industry are "industries/<name>.html".
 * COPY RULES APPLIED: em dashes converted per the ban (marked <!-- em-dash -->);
 * bare "Learn More" (forbidden) → "SEE DETAILS →". Live hero illustration and
 * Clutch badge images dropped (no <img> in v3 ports). Marquee strip dropped.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Glass from "../components/Glass.astro";
import ServiceRows from "../components/ServiceRows.astro";
import Aurora from "../components/Aurora.jsx";
import Marquee from "../components/Marquee.astro";
import VideoBg from "../components/VideoBg.astro";
import HeroActions from "../components/HeroActions.astro";

const industries = [
  { ico: "◎", title: "Healthcare", body: "HIPAA-aware websites for medical practices, clinics, and health organizations.", slug: "healthcare", points: ["Insurance accepted, stated plainly", "A page per specialty and location", "Paperwork done before the visit"] },
  { ico: "❖", title: "Law Firm", body: "Professional websites for law firms. Practice area pages, intake forms, local SEO.", slug: "law-firm", points: ["A real page per practice area", "Attorney bios that read like people", "Intake routed so nothing sits over a weekend"] },
  { ico: "◈", title: "Financial Services", body: "Websites for financial advisors, CPAs, and wealth management firms.", slug: "financial-services", points: ["Credentials and registrations visible", "A page per service and town", "Never collects account or ID numbers"] },
  { ico: "⛭", title: "Construction", body: "Project showcase sites for contractors, builders, and construction companies.", slug: "construction", points: ["Galleries sorted by project type", "License and insurance shown up front", "Photo upload so you can quote faster"] },
  { ico: "◧", title: "Real Estate", body: "Listing-ready websites for brokers, agents, and property management.", slug: "real-estate", points: ["Sold results and reviews up front", "A page per town you actually work", "Leads reach your phone immediately"] },
  { ico: "▦", title: "Manufacturing", body: "Catalog and capability sites for manufacturers and industrial businesses.", slug: "manufacturing", points: ["Capabilities and tolerances stated", "Certifications shown up front", "Drawing and file upload on every quote"] },
  { ico: "✦", title: "Dental", body: "Patient-focused websites for dental practices with online booking integration.", slug: "dental", points: ["Insurance answered before they call", "A page per procedure you want more of", "New patient forms filled out before arrival"] },
  { ico: "✧", title: "Nonprofit", body: "Mission-driven websites for nonprofits, schools, and community organizations.", slug: "nonprofit", points: ["Get help and give help, both obvious", "Accessible for real, not just claimed", "Donations in as few taps as possible"] },
  { ico: "⬡", title: "B2B", body: "Lead-generation websites for B2B companies and professional services.", slug: "b2b", points: ["Built for a long buying cycle", "Case studies where buyers will find them", "Forms that ask less early, more later"] },
  { ico: "◉", title: "Insurance", body: "Quote-ready websites for insurance agencies and brokers.", slug: "insurance", points: ["Lines of coverage split clearly", "Commercial kept separate from personal", "Forms short enough that people finish"] },
];

---

<Base
  title="Industries We Serve | Live Web Studios"
  description="Web design, SEO, and AI services tailored for healthcare, legal, finance, construction, real estate, and more."
  canonical="https://livewebstudios.com/industries"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass page-head--bare has-videobg">
      <VideoBg src="bg-town-holo.mp4" scrim="hero" position="66% 50%" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">INDUSTRIES</span>
        <h1 class="page-h1">Built for <em>Your Industry.</em></h1>
        <!-- em-dash: "unique requirements — compliance" → "unique requirements: compliance" -->
        <p class="page-lede">We don't do generic. Every industry has unique requirements: compliance, terminology, audience expectations. We build for yours.</p>
        <HeroActions links clear />
      </div>
    </section>

    <Marquee />

    <!-- INDUSTRY GRID -->
    <section class="sec-pad has-aurora sec-grid">
      <Aurora className="aurora--bg" base="#04060c" />
      <div class="wrap">
        <p class="page-lede is-center mb-lg">Pick your field. Every build is shaped around how your customers actually search, decide, and convert.</p>
        {/* Structural only: the cards below are h3s with nothing between them
            and the page h1 (launch audit 2026-09-15). Hidden so the page
            gains no new visible copy. */}
        <h2 class="visually-hidden">Industries we build for</h2>
        {/* Scannable-UI pass 2026-09-28: the 10-card metal grid became the
            same blue row list /services runs (ServiceRows). Hubs blue,
            detail pages purple. */}
        <ServiceRows items={industries.map((i) => ({ title: i.title, body: i.body, points: i.points, href: `industries/${i.slug}.html` }))} />
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta">
          <h2>Don't See Your Industry?</h2>
          <p>We've built for dozens of verticals. Let's talk about yours.</p>
          <div class="hero-btns">
            <a href="contact.html" class="btn btn-primary">Get a Proposal →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
