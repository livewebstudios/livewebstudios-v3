---
/**
 * /work — portfolio (canonical URL; /portfolio 301s here per _redirects).
 * Originally ported from the live site (livewebstudios.com/portfolio), rebuilt
 * on v3's work-card grid. The list is shared with /ai/proof (12 projects).
 * Thumbnails live at images/portfolio/*.jpg (copied from the live site);
 * each card links out to the live client site.
 * EM DASH BAN applied to descriptions.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import VideoBg from "../components/VideoBg.astro";
import Marquee from "../components/Marquee.astro";
import HeroActions from "../components/HeroActions.astro";
import { imageSize } from "../lib/imageSize";
import { REBUILDS } from "../lib/aiStudio";

/* Same list as /ai/proof (src/lib/aiStudio.ts REBUILDS). No href = this
   site, which links home in the same tab. */
const projects = REBUILDS.map((r) => ({
  cat: r.industry,
  title: r.name,
  img: `images/portfolio/${r.img}.jpg`,
  href: r.href ?? "index.html",
  external: Boolean(r.href),
  body: r.body,
}));
---

<Base
  title="Portfolio | Live Web Studios, Web Design & Development NJ"
  description="Websites designed and built by Live Web Studios. From construction firms to logistics companies, we build fast, good-looking sites that rank."
  canonical="https://livewebstudios.com/work"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass page-head--bare has-videobg">
      <VideoBg src="quote-webdesk.mp4" scrim="hero" position="70% 50%" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">PORTFOLIO</span>
        <h1 class="page-h1">Real Work. Real <em>Results</em>.</h1>
        <p class="page-lede">A selection of sites built, rebuilt, and ranked by Live Web Studios.</p>
        <HeroActions links stacked story />
      </div>
    </section>

    <Marquee />

    <!-- PORTFOLIO GRID -->
    <section class="sec-pad has-videobg">
      <VideoBg src="bg-color-tv.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">OUR WORK</span>
          <h2>A selection of websites designed, built, and maintained by Live Web Studios.</h2>
        </div>
        <div class="work-grid">
          {projects.map((p) => (
            <article class="work-card reveal">
              <a class="work-thumb work-thumb--img" href={p.href} {...(p.external ? { target: "_blank", rel: "noopener noreferrer" } : {})} aria-label={`Visit ${p.title}`}>
                <img src={p.img} alt={`${p.title} website`} {...imageSize(p.img)} loading="lazy" decoding="async" />
              </a>
              <div class="work-meta">
                <span class="work-cat">{p.cat}</span>
                <h2 class="work-title">{p.title}</h2>
                <p>{p.body}</p>
                <a class="more" href={p.href} {...(p.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{p.external ? "VIEW SITE →" : "YOU ARE HERE →"}</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <!-- Photo URL is set inline, not in the stylesheet: styles are inlined into
         every page at every depth, so a url() written in global.css would
         resolve against whichever page it landed in and break on nested ones.
         Keeping it here keeps this page's own relative path correct. -->
    <section class="sec-pad is-alt sec-photobg sec-photobg--left sec-photobg--copy-right" style="--sec-photo:url('images/jon-left-desk-pixels.jpg')">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">WANT TO BE NEXT?</span>
          <h2>If you like what you see, let's talk.</h2>
        </div>
        <div class="hero-btns reveal">
          <a href="contact.html" class="btn btn-primary">Start a Project →</a>
          <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* Four across on desktop, same rhythm as the /ai/proof grid (Jon
     2026-10-10). auto-fill steps down to 3, 2, then 1 on its own. */
  .work-grid {
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }
  /* Real thumbnails in the work grid; global .work-thumb stays the CSS
     placeholder for cards without imagery. Scoped here, not in global.css. */
  .work-thumb--img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.4s var(--ease);
  }
  .work-card:hover .work-thumb--img img {
    transform: scale(1.04);
  }
</style>
