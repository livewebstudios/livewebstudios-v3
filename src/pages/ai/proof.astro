---
/**
 * /ai/proof: the showcase. Real, named work only. Industry and one-liners come
 * from each client site's own published description; external links appear
 * only where the site is live. Where the handoff has a number it is used,
 * where it does not the work is described without one. No client-confidential
 * detail, no invented metrics.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import AiVideoBg from "../../components/AiVideoBg.astro";
import ServiceRows from "../../components/ServiceRows.astro";
import { REBUILDS, SYSTEMS, MEDIA, SITE } from "../../lib/aiStudio";
import { relPrefix } from "../../lib/relPrefix";
import { imageSize } from "../../lib/imageSize";
import "../../styles/ai.css";

const rel = relPrefix(Astro.url.pathname);
---

<Base
  title="Proof: 12 AI-Built Sites and Systems | Live AI Studios"
  description="1,258 projects in seven months. 12 sites rebuilt end to end and office systems that run themselves. Named work, no invented results."
  canonical={`${SITE}/ai/proof`}
  ogImage="images/og-ai.jpg"
>
  <Nav />

  <main class="theme-live-ai">
    <section class="page-head page-head--glass page-head--bare has-videobg">
      <AiVideoBg name="ai-proof" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">PROOF</span>
        <h1 class="page-h1">Proof, <em>not promises</em>.</h1>
        <p class="page-lede">1,258 projects in seven months. Here's what came out of them, by name.</p>
      </div>
    </section>

    <!-- REBUILT END TO END -->
    <section class="sec-pad" id="rebuilt">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">REBUILT END TO END</span>
          <h2>{REBUILDS.length} websites, built start to finish with AI.</h2>
          <p>A person reviewed and approved every page. Different industries, one way of working.</p>
        </div>
        <ul class="ai-rebuilds">
          {REBUILDS.map((r) => (
            <li class="ai-rebuild reveal">
              <a class="ai-rebuild__thumb" href={r.href ?? `${rel}index.html`} {...(r.href ? { target: "_blank", rel: "noopener" } : {})} aria-label={`Visit ${r.name}`} tabindex="-1">
                <img src={`${rel}images/portfolio/${r.img}.jpg`} alt={`${r.name} website`} {...imageSize(`images/portfolio/${r.img}.jpg`)} loading="lazy" decoding="async" />
              </a>
              <span class="ai-card__label">{r.industry}</span>
              <h3>{r.name}</h3>
              <p>{r.line}</p>
              {r.href ? (
                <a href={r.href} target="_blank" rel="noopener">Visit the site ↗</a>
              ) : (
                <a href={`${rel}index.html`}>You are here →</a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- SYSTEMS -->
    <section class="sec-pad is-alt" id="systems">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">SYSTEMS THAT RUN THEMSELVES</span>
          <h2>Built once. Running since.</h2>
          <p>The office work nobody should be doing by hand, handed to systems that do it the same way every time and flag the exceptions.</p>
        </div>
        <ServiceRows theme="ai" items={SYSTEMS.map((s) => ({ title: s.name, body: s.body }))} />
      </div>
    </section>

    <!-- MEDIA -->
    <section class="sec-pad" id="media">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">VIDEO AND PHOTOS, MADE WITH AI</span>
          <h2>Described in words. Delivered as video.</h2>
        </div>
        <ServiceRows theme="ai" items={MEDIA.map((m) => ({ title: m.name, body: m.body }))} />
      </div>
    </section>

    <!-- CLOSE -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta cta--art ai-close">
          <div class="cta-art">
            <img
              class="ai-close__img"
              src={`${rel}images/ai/ai-proof-ledger.jpg`}
              alt="An open ledger on a dark desk at night, every finished entry ticked in orange and the next empty line lit, a fountain pen resting across it"
              width="896"
              height="1120"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="cta-copy">
            <span class="eyebrow mb-md">NEXT</span>
            <h2>Your business could be the next line on this page.</h2>
            <div class="hero-btns">
              <a href={`${rel}ai/start.html`} class="btn btn-primary">Start with AI →</a>
              <a href={`${rel}ai/services.html`} class="btn btn-ghost">See the services →</a>
            </div>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  section[id] {
    scroll-margin-top: calc(var(--nav-h) + var(--subnav-h) + 2rem);
  }
</style>
