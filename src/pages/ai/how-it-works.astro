---
/**
 * /ai/how-it-works: the AI-staffed model, explained. Five steps, what stays
 * human, and six straight answers.
 *
 * The FAQ uses native <details>/<summary> rather than the button accordion on
 * /faq: same look, but it opens with no JavaScript at all. The FAQPage JSON-LD
 * is generated from the SAME array the markup renders, so the schema and the
 * visible answers are verbatim-matched by construction.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import AiVideoBg from "../../components/AiVideoBg.astro";
import { SITE } from "../../lib/aiStudio";
import { relPrefix } from "../../lib/relPrefix";
import "../../styles/ai.css";

const rel = relPrefix(Astro.url.pathname);

const steps = [
  { n: "01", title: "Listen", body: "What your business actually does, how the work moves through it, and where the week goes. We ask before we build." },
  { n: "02", title: "Map", body: "Where AI earns its keep, and where it does not. You get a short list of moves in the order they pay off." },
  { n: "03", title: "Build", body: "The systems, the site, the content. Built on the tools you already run wherever that makes sense." },
  { n: "04", title: "Direct", body: "Human judgment on every output. Nothing reaches your customers until a person has read it and signed off." },
  { n: "05", title: "Run", body: "It keeps working. We keep watch, read the exceptions, and tune it as the business changes." },
];

const human = [
  ["The brief.", "What gets built, for whom, and why. AI does not decide what your business needs."],
  ["The sign-off.", "Every page, email, image and report is read by a person before it goes out."],
  ["The relationship.", "You talk to a human who knows your business, not a ticket queue."],
  ["The judgment calls.", "Pricing, tone, anything legal, anything sensitive. Those stay with people."],
];

const faq = [
  { q: "What does it cost?", a: "It depends on scope, and we say so up front. We look at what you need, then quote it in writing before any work starts. A single automation and a full site rebuild are very different jobs, and the quote tells you which one you are buying." },
  { q: "Do you replace my staff?", a: "No. We take the repetitive work off their desks: the copying, the chasing, the reformatting. Your people keep the judgment calls and the customer relationships, which is where they were most valuable anyway." },
  { q: "What tools do you use?", a: "Current AI models for writing, code and design, generative video tools for media, and proven plumbing underneath: Google Apps Script, Zoho, DataForSEO, Search Console, GitHub and Netlify. Where your business already runs on a tool, we build on it instead of replacing it." },
  { q: "How fast is it?", a: "Small automations are usually running within days. A full site rebuild is measured in weeks, not months. The quote comes with a timeline, so you know which before anything starts." },
  { q: "What about my data?", a: "It stays in your accounts wherever possible, under your control. Before anything is connected we tell you exactly which services will touch it, and client-confidential material gets a written plan before it is handled at all." },
  { q: "Where do we start?", a: "With a short form. Tell us what the business does and what you wish would run itself. We read it, come back with questions, and propose the first move." },
];

const jsonld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  url: `${SITE}/ai/how-it-works`,
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base
  title="How It Works: The AI-Staffed Model | Live AI Studios"
  description="How an AI-staffed studio works: listen, map, build, direct, run. What AI does, what stays human, and straight answers on cost, speed, tools and your data."
  canonical={`${SITE}/ai/how-it-works`}
  ogImage="images/og-ai.jpg"
  jsonld={jsonld}
>
  <Nav />

  <main class="theme-live-ai">
    <section class="page-head page-head--glass has-videobg">
      <AiVideoBg name="ai-how" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">HOW IT WORKS</span>
        <h1 class="page-h1">AI does the work. <em>We direct it.</em></h1>
        <p class="page-lede">An AI-staffed studio is not a chatbot bolted onto an agency. It is a working system with a human at the wheel. Here is how it runs.</p>
      </div>
    </section>

    <!-- FIVE STEPS -->
    <section class="sec-pad">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">THE MODEL</span>
          <h2>Five steps, every engagement.</h2>
        </div>
        <ol class="grid-svc ai-steps">
          {steps.map((s) => (
            <li class="card reveal">
              <Glass variant="inner" innerClass="card-pad ai-card">
                <span class="step-num">{s.n}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </Glass>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- WHAT STAYS HUMAN -->
    <section class="sec-pad is-alt">
      <div class="wrap">
        <div class="copy copy--points ai-human reveal">
          <span class="eyebrow">WHAT STAYS HUMAN</span>
          <div class="sec-head is-flush"><h2>The parts that should never be automated.</h2></div>
          <p>AI is fast, tireless and wrong often enough that nothing it makes should reach a customer unread. So the model keeps four things in human hands, on purpose.</p>
          <ul class="copy-points">
            {human.map(([k, v]) => (
              <li><strong>{k}</strong> {v}</li>
            ))}
          </ul>
          <p class="copy-kicker">That is not a limitation of the model. It is the model.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sec-pad">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">STRAIGHT ANSWERS</span>
          <h2>Questions we get every week.</h2>
        </div>
        <div class="ai-faq reveal">
          {faq.map((f) => (
            <details>
              <summary><h3>{f.q}</h3></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="sec-pad is-alt">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta ai-close">
          <span class="eyebrow is-center mb-md">STEP ONE</span>
          <h2>Listening comes first. Tell us about the business.</h2>
          <div class="hero-btns">
            <a href={`${rel}ai/start.html`} class="btn btn-primary">Start with AI →</a>
            <a href={`${rel}ai/proof.html`} class="btn btn-ghost">See the proof →</a>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .ai-human {
    max-width: 760px;
    margin-inline: auto;
  }
  .ai-human > p {
    color: var(--muted);
    margin-top: 1.1rem;
  }
  .ai-human .copy-points {
    margin-top: 1.1rem;
  }
  .ai-human .copy-kicker {
    margin-top: 1.4rem;
  }
</style>
