---
/**
 * /services — ported from the live site (livewebstudios.com/services).
 * The live services hub: 4 category groups (13 services) + FAQ + CTA, rebuilt
 * on v3 layouts/components. NOTE: the 13 cards deep-link to services/*.html
 * subpages that DON'T EXIST in v3 yet (part of the ~30 missing pages) — links
 * are relative so they resolve once those subpages are ported.
 * COPY RULES APPLIED: em dashes converted per the ban; bare "Learn More"
 * (forbidden) → "See details →"; the live "Get a Free Consultation" CTA
 * (brushes the "free consultation" ban) → "Let's talk." Flagged for Jon.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Glass from "../components/Glass.astro";
import VideoBg from "../components/VideoBg.astro";
import CardIcon from "../components/CardIcon.astro";

/* Cloud card art — 3 source images cycled across all 13 cards (Jon: every
   services card gets the cloud background). `flip` mirrors the art so
   neighbors reusing the same file don't read as duplicates. */
const bgW = "images/services/card-website-design.png";
const bgL = "images/services/card-logo-design.png";
const bgE = "images/services/card-ecommerce.png";

const groups = [
  {
    label: "WEBSITES & HOSTING",
    cards: [
      { ico: "◧", title: "Website Design & Development", body: "Hand-coded, mobile-first, SEO-structured, fast.", href: "services/website-design.html", bg: bgW },
      { ico: "✦", title: "AI-Powered Website Platform", tag: "NEW", body: "Our AI-assisted build pipeline. Faster, smarter, better.", href: "services/ai-platform.html", bg: bgL, flip: true },
      { ico: "⛭", title: "Web Hosting & Maintenance", body: "Managed VPS, daily backups, monitoring, support.", href: "services/hosting.html", bg: bgE, flip: true },
      { ico: "◈", title: "Monthly Maintenance Plans", tag: "NEW", body: "Tiered plans from $79/mo. Set it. Don't forget it.", href: "services/maintenance-plans.html", bg: bgW, flip: true },
    ],
  },
  {
    label: "GROWTH & VISIBILITY",
    cards: [
      { ico: "◎", title: "SEO & Digital Marketing", body: "Technical SEO, content, local visibility, monthly reporting.", href: "services/seo.html", bg: bgE },
      { ico: "▤", title: "Website Audits & Consulting", tag: "NEW", body: "Find out why your site isn't working. Written report + call.", href: "services/consulting.html", bg: bgL },
    ],
  },
  {
    label: "AI & AUTOMATION",
    cards: [
      { ico: "⟐", title: "AI Business Services", tag: "NEW", body: "AI strategy, training, tool selection, custom workflows.", href: "services/ai-business-services.html", bg: bgW, flip: true },
      { ico: "⬡", title: "AI Workflow Automation", tag: "NEW", body: "Automate repetitive tasks. Scale without adding headcount.", href: "services/ai-workflow.html", bg: bgE, flip: true },
      { ico: "▦", title: "AI Image Manipulation", tag: "NEW", body: "Bulk product photos, virtual staging, AI headshots.", href: "services/ai-image.html", bg: bgL, flip: true },
    ],
  },
  {
    label: "BRAND & COMMERCE",
    cards: [
      { ico: "❖", title: "Branding & Corporate Identity", body: "Logos, color, typography, brand systems that last.", href: "services/branding.html", bg: bgE, flip: true },
      { ico: "✧", title: "Logo Design & Graphics", body: "Marks that work at 16px and 16 feet. All file formats.", href: "services/logo-design.html", bg: bgL },
      { ico: "⬢", title: "E-Commerce Solutions", body: "WooCommerce, Shopify, custom storefronts. Built to convert.", href: "services/ecommerce.html", bg: bgE },
      { ico: "✷", title: "Custom Styles & Carousel Cards", tag: "NEW", body: "Archie, Mid-Century American & Pop-Art graphic sets for hero panels, carousels, and feature cards.", href: "services/custom-styles-and-carousel-cards.html", bg: bgW },
    ],
  },
];

// FAQ — ported verbatim (em dashes converted, numeric ranges hyphenated).
const faqs = [
  {
    q: "How long does it take to build a website?",
    a: "Most brochure and service sites take 2-4 weeks from kickoff to launch. Larger projects with custom functionality, e-commerce, or CMS integration typically run 4-8 weeks. We set a clear timeline at the start and stick to it.",
  },
  {
    q: "Do I own my website when it's done?",
    // em-dash: "every image — yours" → "every image, yours"
    a: "100%. Every file, every line of code, every image, yours. We don't hold sites hostage behind proprietary platforms or monthly \"rental\" fees. You can host it anywhere and hand it to any developer if you ever need to.",
  },
  {
    q: "Will my site work on mobile and tablets?",
    // em-dash: "by design — not an afterthought" → "by design, not an afterthought"
    a: "Every site we build is mobile-first by design, not an afterthought. We test across devices and screen sizes before anything goes live.",
  },
  {
    q: "Can I update the site myself after it launches?",
    a: "Yes. For sites with a blog or content that changes regularly, we set up a simple CMS so you can make updates without touching code. For structural changes, we handle those for you.",
  },
  {
    q: "Do you offer ongoing support after launch?",
    // em-dash: "your business — we keep" → "your business. We keep"
    a: "Absolutely. We offer monthly hosting and maintenance plans that cover updates, security monitoring, backups, and priority support. You focus on your business. We keep the site running.",
  },
];
---

<Base
  title="Services | Live Web Studios"
  description="Full-service digital agency: web design, AI platform, hosting, SEO, AI business services, branding, e-commerce, and more."
  canonical="https://livewebstudios.com/services"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head has-videobg">
      <VideoBg src="bg-color-tv.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">SERVICES</span>
        <h1 class="page-h1">Everything Your Business Needs <em>Online</em>.</h1>
        <p class="page-lede">And some things you didn't know you needed yet.</p>
      </div>
    </section>

    <!-- SERVICE GROUPS -->
    <section class="sec-pad">
      <div class="wrap">
        <!-- em-dash: "by category below—everything" → "by category below. Everything" -->
        <p class="page-lede is-center mb-lg">Most clients start with <a href="services/website-design.html">custom website design</a>, <a href="services/ai-platform.html">our AI-assisted platform build</a>, or <a href="services/hosting.html">managed hosting</a>. Skim by category below. Everything ties back to a faster, clearer site.</p>

        {groups.map((g) => (
          <div class="svc-group">
            <div class="sec-head reveal"><span class="eyebrow">{g.label}</span></div>
            <div class="grid-svc grid-svc--4">
              {g.cards.map((c) => (
                <div class="card reveal card--bg">
                  <img class={`card-bg-img${c.flip ? " is-flip" : ""}`} src={c.bg} alt="" loading="lazy" decoding="async" />
                  <div class="card-bg-scrim" aria-hidden="true"></div>
                  <div class="card-pad card-bg-content">
                    <h3>{c.title}{c.tag && <span class="tag-new">{c.tag}</span>}</h3>
                    <p>{c.body}</p>
                    <CardIcon title={c.title} />
                    <a class="more" href={c.href}>SEE DETAILS →</a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="sec-pad is-alt">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">FAQ</span>
          <h2>Frequently asked questions</h2>
        </div>
        <div class="faq reveal">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta">
          <h2>Not Sure Which Service Fits?</h2>
          <p>Let's figure it out together. No pressure, no pitch.</p>
          <div class="hero-btns">
            <a href="contact.html" class="btn btn-primary">Let's talk. →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* Category-group spacing for the services hub. */
  .svc-group { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .svc-group:first-of-type { margin-top: 0; }
  .svc-group .sec-head { margin-bottom: 1.5rem; }

  /* FAQ accordion — native <details>, styled with system tokens. */
  .faq { max-width: 760px; margin-inline: auto; }
  .faq-item {
    border: 1px solid var(--line);
    border-radius: var(--r-md, 12px);
    background: rgba(255, 255, 255, 0.015);
    margin-top: 0.9rem;
    overflow: hidden;
  }
  .faq-item > summary {
    cursor: pointer;
    list-style: none;
    padding: 1.1rem 1.3rem;
    font-weight: 600;
    color: var(--ink-soft);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .faq-item > summary::-webkit-details-marker { display: none; }
  .faq-item > summary::after {
    content: "+";
    font-family: var(--mono);
    color: var(--cyan-soft);
    font-size: 1.2rem;
    line-height: 1;
    transition: transform 0.25s var(--ease, ease);
  }
  .faq-item[open] > summary::after { transform: rotate(45deg); }
  .faq-item > p {
    padding: 0 1.3rem 1.2rem;
    color: var(--muted);
    max-width: 68ch;
  }

  /* 4 columns on large screens (Jon 2026-08-15) */
  @media (min-width: 1100px) {
    .grid-svc--4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  /* Cards with generated background art: image + scrim keep text readable */
  .card--bg {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .card--bg:hover {
    border-color: rgba(56, 189, 248, 0.35);
  }
  /* Fills the whole card: max-width:none overrides the global img cap that
     left a dark band on the right edge. Base scale gives drift headroom. */
  .card-bg-img {
    --sx: 1; /* is-flip mirrors reused art so neighbors don't match */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    z-index: 0;
    transform: scaleX(var(--sx)) scale(1.08);
    transition: transform 3.2s var(--ease);
    will-change: transform;
  }
  .card-bg-img.is-flip { --sx: -1; }
  /* Clouds drift on hover (slow pan + deeper zoom, 2x duration) */
  .card--bg:hover .card-bg-img {
    transform: scaleX(var(--sx)) scale(1.16) translate3d(-2%, -1.5%, 0);
  }
  .card-bg-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(5, 7, 11, 0.30) 0%, rgba(5, 7, 11, 0.55) 100%);
  }
  .card-bg-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  /* Icon placement (size/centering) lives in CardIcon.astro */
</style>
