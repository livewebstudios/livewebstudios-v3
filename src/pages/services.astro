---
/**
 * /services — ported from the live site (livewebstudios.com/services).
 * The live services hub: 4 category groups (13 services) + CTA, rebuilt
 * on v3 layouts/components. NOTE: the 13 cards deep-link to services/*.html
 * subpages that DON'T EXIST in v3 yet (part of the ~30 missing pages) — links
 * are relative so they resolve once those subpages are ported.
 * COPY RULES APPLIED: em dashes converted per the ban; bare "Learn More"
 * (forbidden) → "See details →"; the live "Get a Free Consultation" CTA
 * (brushes the "free consultation" ban) → "Let's talk." Flagged for Jon.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Glass from "../components/Glass.astro";
import VideoBg from "../components/VideoBg.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ScanLines from "../components/ScanLines.astro";
import Marquee from "../components/Marquee.astro";
import HeroActions from "../components/HeroActions.astro";

/* Card art. Was one shared blue-cloud image; Jon 2026-09-03 wants these
   reading as the home page's cards, so they run the same carbon weave and
   the same art="metal" tuning (brightness up, scrim down, solid text
   bubbles). Same file the home page uses, one source for both. */
const cardArt = "images/bg/metal-bg.jpg";

const groups = [
  {
    label: "WEBSITES & HOSTING",
    cards: [
      { ico: "◧", title: "Website Design & Development", body: "Hand-coded, mobile-first, SEO-structured, fast.", href: "services/website-design.html", bg: cardArt },
      { ico: "✦", title: "AI-Powered Website Platform", tag: "NEW", body: "Our AI-assisted build pipeline. Faster, smarter, better.", href: "services/ai-platform.html", bg: cardArt },
      { ico: "⛭", title: "Web Hosting & Maintenance", body: "Managed VPS, daily backups, monitoring, support.", href: "services/hosting.html", bg: cardArt },
      { ico: "◈", title: "Monthly Maintenance Plans", tag: "NEW", body: "Updates, backups, monitoring. Set it. Don't forget it.", href: "services/maintenance-plans.html", bg: cardArt },
    ],
  },
  {
    label: "GROWTH & VISIBILITY",
    cards: [
      { ico: "◎", title: "SEO & Digital Marketing", body: "Technical SEO, content, local visibility, monthly reporting.", href: "services/seo.html", bg: cardArt },
      { ico: "▤", title: "Website Audits & Consulting", tag: "NEW", body: "Find out why your site isn't working. Written report + call.", href: "services/consulting.html", bg: cardArt },
    ],
  },
  {
    label: "AI & AUTOMATION",
    cards: [
      { ico: "⟐", title: "AI Business Services", tag: "NEW", body: "AI strategy, training, tool selection, custom workflows.", href: "services/ai-business-services.html", bg: cardArt },
      { ico: "⬡", title: "AI Workflow Automation", tag: "NEW", body: "Automate repetitive tasks. Scale without adding headcount.", href: "services/ai-workflow.html", bg: cardArt },
      { ico: "▦", title: "AI Image Manipulation", tag: "NEW", body: "Bulk product photos, virtual staging, AI headshots.", href: "services/ai-image.html", bg: cardArt },
    ],
  },
  {
    label: "BRAND & COMMERCE",
    cards: [
      { ico: "❖", title: "Branding & Corporate Identity", body: "Logos, color, typography, brand systems that last.", href: "services/branding.html", bg: cardArt },
      { ico: "✧", title: "Logo Design & Graphics", body: "Marks that work at 16px and 16 feet. All file formats.", href: "services/logo-design.html", bg: cardArt },
      { ico: "⬢", title: "E-Commerce Solutions", body: "WooCommerce, Shopify, custom storefronts. Built to convert.", href: "services/ecommerce.html", bg: cardArt },
      { ico: "✷", title: "Custom Styles & Carousel Cards", tag: "NEW", body: "Archie, Mid-Century American & Pop-Art graphic sets for hero panels, carousels, and feature cards.", href: "services/custom-styles-and-carousel-cards.html", bg: cardArt },
    ],
  },
];

---

<Base
  title="Services | Live Web Studios"
  description="Full-service digital agency: web design, AI platform, hosting, SEO, AI business services, branding, e-commerce, and more."
  canonical="https://livewebstudios.com/services"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-color-tv.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">SERVICES</span>
        <h1 class="page-h1">Everything Your Business Needs <em>Online</em>.</h1>
        <p class="page-lede">And some things you didn't know you needed yet.</p>
        <HeroActions />
      </div>
    </section>

    <Marquee />

    <!-- SERVICE GROUPS -->
    <section class="sec-pad has-scan">
      <ScanLines />
      <div class="wrap">
        <!-- em-dash: "by category below—everything" → "by category below. Everything" -->
        <p class="page-lede is-center mb-lg">Most clients start with <a href="services/website-design.html">custom website design</a>, <a href="services/ai-platform.html">our AI-assisted platform build</a>, or <a href="services/hosting.html">managed hosting</a>. Skim by category below. Everything ties back to a faster, clearer site.</p>

        {groups.map((g) => (
          <div class="svc-group">
            <div class="sec-head reveal"><span class="eyebrow">{g.label}</span></div>
            <div class="grid-svc grid-svc--4">
              {g.cards.map((c) => (
                <ServiceCard title={c.title} body={c.body} href={c.href} bg={c.bg} art="metal" tag={c.tag} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta">
          <h2>Not Sure Which Service Fits?</h2>
          <p>Let's figure it out together. No pressure, no pitch.</p>
          <div class="hero-btns">
            <a href="contact.html" class="btn btn-primary">Let's talk. →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* Scanline stage for the services band (Jon 2026-08-27). The overlay
     paints at z-index 0; the content wrapper rides above it. */

  /* Category-group spacing for the services hub. */
  .svc-group { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .svc-group:first-of-type { margin-top: 0; }
  .svc-group .sec-head { margin-bottom: 1.5rem; }
  /* Category labels: a step up in size, light blue a shade under the logo
     cyan so they read as headings without competing with the cards. */
  .svc-group .sec-head .eyebrow {
    font-size: 0.86rem;
    color: #2BA6E0;
  }

  /* 4 columns on large screens (Jon 2026-08-15) */
  @media (min-width: 1100px) {
    .grid-svc--4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
