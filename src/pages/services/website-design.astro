---
/**
 * /services/website-design — ported from the live site
 * (livewebstudios.com/services/website-design). Rebuilt on v3
 * layouts/components. Hero illustration + split photo dropped per the
 * no-image rule (Glass portrait placeholder stands in for the split).
 * EM DASH BAN applied to body copy (spots marked <!-- em-dash -->).
 * FORBIDDEN PHRASE: live CTA subhead led with "Free consultation." — dropped.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const included = [
  { ico: "✎", title: "Custom Design", body: "No templates. Built around your brand.",
    points: ["Layout starts from your content, not a theme", "Your competitor cannot buy the same design"] },
  { ico: "▤", title: "Mobile Responsive", body: "Looks right on every screen. Most of your visitors are holding a phone, so that is the layout I draw first and scale up from.",
    points: ["Tap targets sized for thumbs", "Tested on real devices, not just a resized window"] },
  { ico: "◎", title: "On-Page SEO", body: "Title tags, schema, meta, H-hierarchy. Built in as the page goes together, not bolted on by a plugin afterward.",
    points: ["One H1 per page, headings in real order", "Schema markup for your business type", "Image alt text written, not auto-filled"] },
  { ico: "▦", title: "Contact Form", body: "Formspree integration. Messages land in your inbox with spam filtering already on. No plugin, no database, nothing to keep patched.",
    points: ["Replies come straight to your email", "Nothing stored on the site to breach"] },
  { ico: "◈", title: "Google Analytics 4", body: "Real data. No black box. The property is yours and so is the login, so you can see where people came from and what they actually clicked.",
    points: ["You own the account, not me", "Set up to track form sends and calls"] },
  { ico: "⛭", title: "SSL + Security", body: "Certificate and hardening included. It renews itself, so there is nothing on your calendar and no browser warning waiting to scare people off.",
    points: ["Auto-renewing certificate", "HTTPS forced on every page"] },
];

/* Schema: the WebPage node Base would emit by default, plus a Service node
   for the offering this page describes (project rule: every page carries
   schema; the live site has it on 61 pages). */
const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Website Design & Development | Live Web Studios",
    description: "Custom hand-coded websites built for speed, SEO, and longevity. No templates, no page builders. Based in Saddle Brook, NJ, serving businesses nationwide.",
    url: "https://livewebstudios.com/services/website-design",
    isPartOf: { "@type": "WebSite", name: "Live Web Studios", url: "https://livewebstudios.com" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Website Design & Development | Live Web Studios",
    description: "Custom hand-coded websites built for speed, SEO, and longevity. No templates, no page builders. Based in Saddle Brook, NJ, serving businesses nationwide.",
    url: "https://livewebstudios.com/services/website-design",
    areaServed: "US",
    provider: {
      "@type": "LocalBusiness",
      name: "Live Web Studios",
      url: "https://livewebstudios.com",
      telephone: "732-801-9611",
      email: "jonwolf@livewebstudios.com",
    },
  },
];
---

<Base
  title="Website Design & Development | Live Web Studios"
  description="Custom hand-coded websites built for speed, SEO, and longevity. No templates, no page builders. Based in Saddle Brook, NJ, serving businesses nationwide."
  canonical="https://livewebstudios.com/services/website-design"
  jsonld={pageSchema}
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-color-tv.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">WEBSITE DESIGN</span>
        <h1 class="page-h1">Sites That Make People Stop <em>Scrolling</em>.</h1>
        <p class="page-lede">Hand-coded, mobile-first, built to rank.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- OUR APPROACH -->
    <section class="sec-pad">
      <div class="wrap split">
        <Glass class="reveal" innerClass="portrait portrait--img portrait--sq portrait--anchor-right">
          <img
            src="../images/lbws_neon-website-icons-hero-16x9.jpg"
            alt="Neon line illustration of a website layout ringed by media, messaging, and sharing icons"
            width="1072"
            height="600"
            loading="lazy"
            decoding="async"
          />
          <div class="frame-lines"></div>
          <div class="mark">Custom Web Design</div>
        </Glass>
        <div class="copy reveal">
          <span class="eyebrow">OUR APPROACH</span>
          <div class="sec-head is-flush"><h2>Hand-Coded. Mobile-First. Built to Rank.</h2></div>
          <p>We build websites the right way: semantically structured for SEO, fast enough to make Google happy, and clean enough to maintain for years.</p>
          <p>No page builders. No bloated themes. Production-grade HTML, CSS, and vanilla JavaScript that loads in under 2 seconds.</p>
        </div>
      </div>
    </section>

    <!-- WHY IT MATTERS -->
    <section class="sec-pad is-alt">
      <div class="wrap split split--copy-first">
        <div class="copy copy--points reveal">
          <span class="eyebrow">WHY IT MATTERS</span>
          <div class="sec-head is-flush"><h2>Most Websites Fail Before Anyone Reads Them</h2></div>
          <!-- Restructured from four prose blocks to lede + bullets
               (Jon 2026-09-14: "too wall of text"). Same claims, same numbers,
               broken to the points a skimming visitor actually stops on. -->
          <p>A visitor decides whether to stay inside about 3 seconds. Slow load, a design that looks like 2015, or no straight answer to what you do, and they are already at a competitor.</p>
          <p>So we build static HTML. Not WordPress, not Wix, not Squarespace:</p>
          <ul class="copy-points">
            <li><strong>3 to 5 times faster</strong> than a database-driven site, because there is no database to wait on.</li>
            <li><strong>No plugins to break.</strong> Nothing to auto-update at 2am and take the site down with it.</li>
            <li><strong>Nothing to hack.</strong> No database, no login, almost no attack surface.</li>
            <li><strong>No monthly platform fees.</strong> You own the files.</li>
          </ul>
          <p>Every build ships with the fundamentals in place:</p>
          <ul class="copy-points">
            <li>Mobile-first and fully responsive, tested on real screens.</li>
            <li>On-page SEO from day one: title tags, meta descriptions, schema markup, proper heading structure.</li>
            <li>Semantic HTML that Google can actually read.</li>
          </ul>
          <p class="copy-kicker">A beautiful website nobody can find is just expensive art.</p>
          <p>Pair your new site with our <a href="seo.html">SEO services →</a> to start ranking from day one. Looking for a complete brand? See our <a href="branding.html">Branding &amp; Identity services →</a>.</p>
        </div>
        <Glass class="reveal" innerClass="portrait portrait--img portrait--tall">
          <img
            src="../images/jon-thinking.jpg"
            alt="Pop-art comic panel of Jon Wolf in a black beret, hand on chin, thinking"
            width="1045"
            height="1400"
            loading="lazy"
            decoding="async"
          />
          <div class="frame-lines"></div>
        </Glass>
      </div>
    </section>

    <!-- EVERY BUILD COMES WITH -->
    <section class="sec-pad has-videobg has-scan">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">INCLUDED</span>
          <h2>Every Build Comes With</h2>
        </div>
        <div class="grid-svc">
          {included.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <!-- Photo URL is set inline, not in the stylesheet: styles are inlined into
         every page at every depth, so a url() written in global.css would
         resolve against whichever page it landed in and break on nested ones.
         Keeping it here keeps this page's own relative path correct. -->
    <section class="sec-pad sec-photobg sec-photobg--light" style="--sec-photo:url('../images/pen-squares.jpg')">
      <div class="wrap">
        <div class="cta cta--bare reveal">
          <h2>Let's Talk About Your Site.</h2>
          <!-- forbidden: dropped leading "Free consultation." -->
          <p>We'll review what you have and recommend what fits.</p>
          <div class="hero-btns">
            <a href="../contact.html" class="btn btn-primary">Get a Quote →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
