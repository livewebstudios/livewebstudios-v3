---
/**
 * /services/hosting — ported from the live site
 * (livewebstudios.com/services/hosting). Rebuilt on v3 layouts/components.
 * Hero illustration dropped per no-image rule. EM DASH BAN applied.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const features = [
  { ico: "⬡", title: "Managed VPS", body: "Your own environment. Not a shared box with four hundred strangers on it, where somebody else getting hacked becomes your problem.",
    points: ["Resources are yours, not split with neighbors", "I handle the server patching"] },
  { ico: "✦", title: "LiteSpeed", body: "Fast. Period. It is the web server itself doing the work, so pages are quick before a single caching plugin gets involved.",
    points: ["Faster than stock Apache on the same hardware", "Nothing for you to configure"] },
  { ico: "⛭", title: "Free SSL", body: "Encrypted by default, and it renews on its own. Expired certificates are one of the most common ways a good site suddenly starts scaring visitors away.",
    points: ["Included, not an add-on line item", "Renews without anyone remembering to"] },
  { ico: "◎", title: "Daily Backups", body: "Offsite on Backblaze, so a backup is never sitting on the same machine as the thing it is meant to save. Restores are a phone call.",
    points: ["Kept off the server on purpose", "30 days of history to roll back to"] },
  { ico: "❖", title: "Security", body: "Hidden logins and brute force protection. Most attacks are bots hammering the same handful of URLs, so those URLs are not where anyone expects them.",
    points: ["Login moved off the default address", "Repeat offenders blocked at the server"] },
  { ico: "▦", title: "Monthly Reports", body: "Uptime and SEO performance, in plain language. You get told what moved and whether it needs anything from you.",
    points: ["Sent to your inbox, no dashboard to log into", "Written so it reads like a person wrote it"] },
];

/* Schema: the WebPage node Base would emit by default, plus a Service node
   for the offering this page describes (project rule: every page carries
   schema; the live site has it on 61 pages). */
const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Hosting & Maintenance | Live Web Studios",
    description: "Managed VPS hosting with LiteSpeed, daily backups, SSL, and security hardening. Expert website maintenance from Live Web Studios, Saddle Brook, NJ.",
    url: "https://livewebstudios.com/services/hosting",
    isPartOf: { "@type": "WebSite", name: "Live Web Studios", url: "https://livewebstudios.com" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Hosting & Maintenance | Live Web Studios",
    description: "Managed VPS hosting with LiteSpeed, daily backups, SSL, and security hardening. Expert website maintenance from Live Web Studios, Saddle Brook, NJ.",
    url: "https://livewebstudios.com/services/hosting",
    areaServed: "US",
    provider: {
      "@type": "LocalBusiness",
      name: "Live Web Studios",
      url: "https://livewebstudios.com",
      telephone: "732-801-9611",
      email: "jonwolf@livewebstudios.com",
    },
  },
];
---

<Base
  title="Hosting & Maintenance | Live Web Studios"
  description="Managed VPS hosting with LiteSpeed, daily backups, SSL, and security hardening. Expert website maintenance from Live Web Studios, Saddle Brook, NJ."
  canonical="https://livewebstudios.com/services/hosting"
  jsonld={pageSchema}
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-blue-fog.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">HOSTING</span>
        <h1 class="page-h1">Your Site. Up. <em>Always</em>.</h1>
        <p class="page-lede">Managed hosting &amp; maintenance.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- WHY HOSTING MATTERS -->
    <section class="sec-pad">
      <div class="wrap split split--copy-first">
        <div class="copy copy--points reveal">
          <span class="eyebrow">WHY HOSTING MATTERS</span>
          <div class="sec-head is-flush"><h2>Your Hosting Is Either Working for You or Against You</h2></div>
          <!-- Restructured from four prose blocks to lede + points
               (Jon 2026-09-14: "too wall of text"). Nothing dropped: the two
               long paragraphs were each carrying a list in sentence form,
               which is what made them unreadable. -->
          <!-- em-dash: "your visitors — it actively hurts" → "your visitors, it actively hurts" -->
          <p>Hosting is the foundation your site sits on. Cheap shared hosting puts you on a server with hundreds of other sites, and their problems become yours:</p>
          <ul class="copy-points">
            <li><strong>Their traffic spike slows your site.</strong> You are all competing for the same resources.</li>
            <li><strong>Their breach puts you at risk.</strong> One compromised site on the box, one compromised server.</li>
            <li><strong>Slow hosting costs you rankings.</strong> Page speed is a direct Google ranking factor, so it does not just frustrate visitors, it actively hurts your SEO.</li>
          </ul>
          <!-- em-dash: "through KnownHost — one of the most" → "through KnownHost, one of the most" -->
          <p>We host client sites on a managed VPS (Virtual Private Server) through KnownHost, one of the most reliable providers in the industry. Your site gets:</p>
          <ul class="copy-points">
            <li><strong>Its own dedicated resources,</strong> not a slice of someone else's.</li>
            <li><strong>LiteSpeed web server</strong> technology.</li>
            <li><strong>Daily backups</strong> stored offsite on Backblaze.</li>
            <li><strong>SSL encryption</strong> and active security hardening.</li>
            <li><strong>Uptime monitored around the clock,</strong> with all technical maintenance handled so you never think about it.</li>
          </ul>
          <p class="copy-kicker">A monthly report lands either way: uptime, security scans, SEO performance.</p>
          <p>Every hosted site also benefits from regular <a href="seo.html">SEO monitoring →</a>, included in our Standard and Premium maintenance plans.</p>
        </div>
        <Glass class="reveal" innerClass="portrait portrait--img portrait--tall">
          <img
            src="../images/hosting-vps.jpg"
            alt="A single server rack glowing cyan, standing apart from rows of dim unlit racks behind it"
            width="880"
            height="1168"
            loading="lazy"
            decoding="async"
          />
          <div class="frame-lines"></div>
        </Glass>
      </div>
    </section>

    <!-- PRODUCTION-GRADE HOSTING -->
    <section class="sec-pad is-alt has-videobg has-scan">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">INCLUDED</span>
          <h2>Production-Grade Hosting</h2>
        </div>
        <div class="grid-svc">
          {features.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap split split--art-first">
        <Glass class="reveal" innerClass="portrait portrait--img portrait--tall">
          <img
            src="../images/puzzle-fit.jpg"
            alt="Dark jigsaw puzzle pieces with one glowing cyan piece locking into the final slot"
            width="880"
            height="1168"
            loading="lazy"
            decoding="async"
          />
          <div class="frame-lines"></div>
        </Glass>
        <div class="cta cta--bare reveal">
          <h2>Done With Hosting Headaches?</h2>
          <p>We handle the tech. You run your business.</p>
          <div class="hero-btns">
            <a href="../contact.html" class="btn btn-primary">Move to LWS →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
