---
/**
 * /services/ecommerce — ported from the live site
 * (livewebstudios.com/services/ecommerce). Rebuilt on v3 layouts/components.
 * Hero illustration dropped per no-image rule. No em dashes in body copy.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const cards = [
  { ico: "⬢", title: "WooCommerce", body: "For complex catalogs and real inventory. When you need variants, tiered pricing, and stock that talks to something else, this is usually the right call.",
    points: ["Handles variants and deep categories", "Connects to your existing inventory"] },
  { ico: "✦", title: "Custom Static", body: "For a smaller catalog where speed is the whole point. No database to query means pages come back fast, and there is far less to keep patched.",
    points: ["Fastest option for a short SKU list", "Almost nothing to maintain"] },
  { ico: "❖", title: "Shopify", body: "Setup and customization when you would rather rent the plumbing than own it. Somebody else handles the servers, you pay monthly for that.",
    points: ["Payments and hosting handled for you", "Theme customized so it is not stock"] },
  { ico: "▤", title: "Mobile-First", body: "Most carts get abandoned on a phone, usually at checkout. So the phone layout is the one that gets designed first and tested hardest.",
    points: ["Checkout built for one thumb", "Tested on real devices"] },
  { ico: "⛭", title: "Secure Checkout", body: "SSL and a proper payment gateway. Card details go to the processor, never to your server, which keeps the scary part off your plate.",
    points: ["Card data never touches your site", "PCI handled by the gateway"] },
  { ico: "◎", title: "SEO Product Pages", body: "Product schema and category structure, so listings can show price and stock right in the search result. That is free real estate most stores never claim.",
    points: ["Price and availability in search results", "Categories built to rank, not just to sort"] },
];

/* Schema: the WebPage node Base would emit by default, plus a Service node
   for the offering this page describes (project rule: every page carries
   schema; the live site has it on 61 pages). */
const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "E-Commerce Solutions | Live Web Studios",
    description: "WooCommerce, Shopify, and custom static storefronts, speed-optimized and built to sell. E-commerce development from Live Web Studios, Saddle Brook, NJ.",
    url: "https://livewebstudios.com/services/ecommerce",
    isPartOf: { "@type": "WebSite", name: "Live Web Studios", url: "https://livewebstudios.com" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "E-Commerce Solutions | Live Web Studios",
    description: "WooCommerce, Shopify, and custom static storefronts, speed-optimized and built to sell. E-commerce development from Live Web Studios, Saddle Brook, NJ.",
    url: "https://livewebstudios.com/services/ecommerce",
    areaServed: "US",
    provider: {
      "@type": "LocalBusiness",
      name: "Live Web Studios",
      url: "https://livewebstudios.com",
      telephone: "732-801-9611",
      email: "jonwolf@livewebstudios.com",
    },
  },
];
---

<Base
  title="E-Commerce Solutions | Live Web Studios"
  description="WooCommerce, Shopify, and custom static storefronts, speed-optimized and built to sell. E-commerce development from Live Web Studios, Saddle Brook, NJ."
  canonical="https://livewebstudios.com/services/ecommerce"
  jsonld={pageSchema}
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-blue-fog.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">E-COMMERCE</span>
        <h1 class="page-h1">Sell Online. Actually Make <em>Money</em>.</h1>
        <p class="page-lede">E-commerce design &amp; development.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- ECOMMERCE CARDS -->
    <section class="sec-pad has-videobg has-scan">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="grid-svc">
          {cards.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap split split--art-first">
        <Glass class="reveal" innerClass="portrait portrait--img portrait--tall">
          <img
            src="../images/store-build.jpg"
            alt="Glowing cyan wireframe of a storefront assembling itself from floating blocks, with a product grid and cart"
            width="880"
            height="1168"
            loading="lazy"
            decoding="async"
          />
          <div class="frame-lines"></div>
        </Glass>
        <div class="cta cta--bare reveal">
          <h2>Let's Build Your Store.</h2>
          <div class="hero-btns">
            <a href="../contact.html" class="btn btn-primary">Get a Quote →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
