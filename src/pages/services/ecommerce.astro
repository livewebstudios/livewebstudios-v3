---
/**
 * /services/ecommerce — ported from the live site
 * (livewebstudios.com/services/ecommerce). Rebuilt on v3 layouts/components.
 * Hero illustration dropped per no-image rule. No em dashes in body copy.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const cards = [
  { ico: "⬢", title: "WooCommerce", body: "Complex catalogs and inventories." },
  { ico: "✦", title: "Custom Static", body: "Simpler SKUs, max speed." },
  { ico: "❖", title: "Shopify", body: "Setup and customization." },
  { ico: "▤", title: "Mobile-First", body: "Responsive on every device." },
  { ico: "⛭", title: "Secure Checkout", body: "SSL + payment gateway." },
  { ico: "◎", title: "SEO Product Pages", body: "Schema + category optimization." },
];
---

<Base
  title="E-Commerce Solutions | Live Web Studios"
  description="WooCommerce, Shopify, and custom static storefronts, speed-optimized and built to sell. E-commerce development from Live Web Studios, Saddle Brook, NJ."
  canonical="https://livewebstudios.com/services/ecommerce"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head has-videobg">
      <VideoBg src="bg-blue-fog.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">E-COMMERCE</span>
        <h1 class="page-h1">Sell Online. Actually Make <em>Money</em>.</h1>
        <p class="page-lede">E-commerce design &amp; development.</p>
        <HeroActions />
      </div>
    </section>

    <Marquee />

    <!-- ECOMMERCE CARDS -->
    <section class="sec-pad has-videobg">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="grid-svc">
          {cards.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta">
          <h2>Let's Build Your Store.</h2>
          <div class="hero-btns">
            <a href="../contact.html" class="btn btn-primary">Get a Quote →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
