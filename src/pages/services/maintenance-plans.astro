---
/**
 * /services/maintenance-plans — ported from the live site
 * (livewebstudios.com/services/maintenance-plans). Rebuilt on v3
 * layouts/components. Hero illustration dropped per no-image rule.
 * EM DASH BAN applied throughout the feature bodies + plan copy.
 * Live hero had no CTA button (only a Clutch badge), so the page-head
 * keeps a single primary CTA for parity with the other service pages.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const included = [
  {
    ico: "⬡",
    title: "Managed Hosting",
    body: "Your site lives on our managed VPS server, LiteSpeed-powered, fully isolated, and optimized for speed. No shared servers, no noisy neighbors, no downtime from someone else's problems.",
  },
  {
    ico: "◎",
    title: "Daily Backups",
    // em-dash: "goes wrong — whether it's ... error — we restore" → commas
    body: "Your site is backed up every day and stored offsite on Backblaze. If anything ever goes wrong, whether it's a hack, a bad update, or human error, we restore it. Fast. No data loss, no panic.",
  },
  {
    ico: "❖",
    title: "Security Monitoring",
    // em-dash: "applied proactively — not after" → "applied proactively, not after"
    body: "We actively monitor your site for malware, unauthorized access, SSL certificate status, and known vulnerabilities. Security patches and hardening updates are applied proactively, not after something breaks.",
  },
  {
    ico: "▦",
    title: "Monthly SEO Report",
    body: "Every month you receive a branded performance report covering uptime statistics, security scan results, traffic overview, and keyword ranking updates. You stay informed without having to ask.",
  },
  {
    ico: "✎",
    title: "Content Edits",
    // em-dash: "part of your plan — no hourly billing" → "part of your plan, no hourly billing"
    body: "Need to update a phone number, swap an image, add a new service, or change business hours? We handle small content edits as part of your plan, no hourly billing, no tickets, no waiting.",
  },
  {
    ico: "✦",
    title: "Priority Support",
    body: "Maintenance clients go to the front of the line. If something breaks, you hear from us first. Most issues are resolved within the same business day, often within hours.",
  },
];

/* Schema: the WebPage node Base would emit by default, plus a Service node
   for the offering this page describes (project rule: every page carries
   schema; the live site has it on 61 pages). */
const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Monthly Maintenance Plans | Live Web Studios",
    description: "Website hosting, security, backups, and monthly reporting. Custom maintenance plans for small business from Live Web Studios, Saddle Brook, NJ.",
    url: "https://livewebstudios.com/services/maintenance-plans",
    isPartOf: { "@type": "WebSite", name: "Live Web Studios", url: "https://livewebstudios.com" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Monthly Maintenance Plans | Live Web Studios",
    description: "Website hosting, security, backups, and monthly reporting. Custom maintenance plans for small business from Live Web Studios, Saddle Brook, NJ.",
    url: "https://livewebstudios.com/services/maintenance-plans",
    areaServed: "US",
    provider: {
      "@type": "LocalBusiness",
      name: "Live Web Studios",
      url: "https://livewebstudios.com",
      telephone: "732-801-9611",
      email: "jonwolf@livewebstudios.com",
    },
  },
];
---

<Base
  title="Monthly Maintenance Plans | Live Web Studios"
  description="Website hosting, security, backups, and monthly reporting. Custom maintenance plans for small business from Live Web Studios, Saddle Brook, NJ."
  canonical="https://livewebstudios.com/services/maintenance-plans"
  jsonld={pageSchema}
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-blue-fog.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">MAINTENANCE PLANS</span>
        <h1 class="page-h1">Set It. <em>Don't Forget It.</em></h1>
        <p class="page-lede">Monthly website maintenance plans.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- WHAT'S INCLUDED -->
    <section class="sec-pad has-videobg has-scan">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">WHAT'S INCLUDED</span>
          <h2>Everything Your Website Needs. Nothing You Have to Think About.</h2>
          <!-- em-dash: "every single month — without you" → "every single month, without you" -->
          <p>A maintenance plan means your site is monitored, protected, backed up, and reported on every single month, without you lifting a finger.</p>
        </div>
        <div class="grid-svc">
          {included.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PLANS -->
    <section class="sec-pad is-alt">
      <div class="wrap split split--copy-first">
        <div class="copy copy--points reveal">
          <span class="eyebrow">PLANS</span>
          <div class="sec-head is-flush"><h2>Custom Plans for Every Size Business</h2></div>
          <!-- Restructured from prose blocks to lede + points
               (Jon 2026-09-14: less wall of text, readable by a
               non-technical visitor). Claims and search terms kept. -->
          <p>We do not believe in one-size-fits-all maintenance. A 5-page brochure site has different needs than a 50-page e-commerce store with weekly inventory updates. We build the plan around what your site actually needs, not a menu of tiers designed to upsell you on things you never use.</p>
          <p>Every plan includes:</p>
          <ul class="copy-points">
            <li><strong>Hosting.</strong></li>
            <li><strong>Daily backups.</strong></li>
            <li><strong>Security monitoring.</strong></li>
            <li><strong>Monthly reporting.</strong></li>
            <li><strong>Content edits.</strong></li>
          </ul>
          <p>Larger plans add:</p>
          <ul class="copy-points">
            <li><strong>Faster response times.</strong></li>
            <li><strong>Additional edit hours.</strong></li>
            <li><strong>Quarterly strategy calls.</strong></li>
            <li><strong>Enhanced SEO reporting.</strong></li>
          </ul>
          <p class="copy-kicker">You pay for what your site needs. Nothing else.</p>
        </div>
        <Glass class="reveal" innerClass="portrait portrait--img portrait--tall">
          <img
            src="../images/svc-maintenance-plans.jpg"
            alt="Glowing cyan shield containing a gear, encircled by recurring cycle arrows with a calendar and backup disc"
            width="880"
            height="1168"
            loading="lazy"
            decoding="async"
          />
          <div class="frame-lines"></div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
