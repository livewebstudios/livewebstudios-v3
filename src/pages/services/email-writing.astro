---
/**
 * /services/email-writing: AI email voice systems.
 * Structure mirrored from services/expert-witness.astro (Base, Nav, Footer,
 * page-head with a background, sec-pad sections alternating is-alt and
 * has-scan, Glass variant="inner" cards, sec-head with eyebrow + h2, numbered
 * steps as an <ol class="grid-svc steps">, page-scoped FAQ accordion, CTA in
 * a Glass innerClass="cta").
 *
 * NO FAQPage NODE HERE ON PURPOSE. /faq owns the only FAQPage node on the
 * site; a second one competes with it for the same rich result. The accordion
 * below is presentational only, so the faqs array feeds the markup and
 * nothing else.
 *
 * Copy ported verbatim from Section 2 of the 2026-09-22 handoff.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import { relPrefix } from "../../lib/relPrefix";

const rel = relPrefix(Astro.url.pathname);

/* Six voice glyphs, one per card. Same drawing rules as src/lib/navIcons.ts
   (24x24 grid, stroke only, 1.6 weight, round caps and joins, nothing finer
   than ~2px) so they sit in the same family as the nav set, but kept page-local
   because navIcons.ts is the nav dropdown's set and nothing else uses these.
   Shared head in profile, per-voice emission: the differentiator is what comes
   out of the mouth. Verified legible down to 30px. */
const HEAD =
  '<path d="M9 3.2c2.6 0 4.6 2 4.6 4.5 0 .9-.1 1.4-.3 1.9l1.5 1.6c.2.2.1.6-.2.7l-1.1.4v1.5c0 .7-.6 1.3-1.3 1.3h-1.9v2.3"/>' +
  '<path d="M9 3.2C6.2 3.2 4.4 5.4 4.4 8.4c0 2.2.5 4 1.6 5.2.5.6.8 1 .8 1.8v1.9"/>';
const VOICE_ICONS: Record<string, string> = {
  /* two graduated waves: a nudge, not a shout */
  nudge: '<path d="M16.8 9.4a3.6 3.6 0 0 1 0 5.2"/><path d="M19.4 7.2a7 7 0 0 1 0 9.6"/>',
  /* one wave stopped by a bar: the line you do not cross */
  line: '<path d="M16.8 9.6a3.4 3.4 0 0 1 0 4.8"/><path d="M20.4 7.4v9.2"/>',
  /* no curve at all, straight out: the straight answer */
  answer: '<path d="M16.4 12h5"/><path d="M19.2 9.6 21.6 12l-2.4 2.4"/>',
  /* forward arrow: passed along to somebody else */
  handoff: '<path d="M16.4 14.8h3.4a2.2 2.2 0 0 0 2.2-2.2V9.4"/><path d="M20.2 11.2 22 9.4l1.8 1.8"/>',
  /* wave plus a +: the same ask, once more */
  second: '<path d="M16.4 9.8a3.2 3.2 0 0 1 0 4.4"/><path d="M21.6 10v4M19.6 12h4"/>',
  /* three waves reaching furthest: first contact */
  opener: '<path d="M15.8 10.2a2.2 2.2 0 0 1 0 3.2"/><path d="M18 8.4a5 5 0 0 1 0 6.8"/><path d="M20.2 6.6a7.8 7.8 0 0 1 0 10.4"/>',
};

/* The six voices. `before` is what people actually send, `after` is what the
   voice produces. Rendered as a labelled pair inside each card. */
const voices = [
  {
    title: "The Nudge",
    icon: "nudge",
    job: "Getting paid without torching the relationship.",
    before: "Hi, just following up on invoice 1042, please let me know. Thanks!",
    after: "Ken, invoice 1042 is at 41 days. I figure it got buried. Can you get it into this week's run?",
  },
  {
    title: "The Line",
    icon: "line",
    job: "Saying no to “can you just” without losing the client.",
    before: "Sure, I can probably squeeze that in!",
    after: "That is a real piece of work, not a tweak. Let me price it separately. If the number works, we do it next.",
  },
  {
    title: "The Straight Answer",
    icon: "answer",
    job: "Bad news, delivered before they find out on their own.",
    before: "Unfortunately there have been some unforeseen delays...",
    after: "The site is going to miss Friday. New date is Wednesday the 14th, and I am not moving it again.",
  },
  {
    title: "The Handoff",
    icon: "handoff",
    job: "Referral intros that actually get replied to.",
    before: "Hi both, connecting you two! I will let you take it from here.",
    after: "Dana, this is Mike. He runs the plumbing outfit and will need your help in about four months. Mike, Dana is who I send people to. I am stepping out of the thread.",
  },
  {
    title: "The Second Ask",
    icon: "second",
    job: "Proposal sent, then silence. Day five.",
    before: "Just wanted to bump this to the top of your inbox!",
    after: "You have had the proposal a week. Wrong number, wrong timing, or it fell off the desk? Any of those is fine. I just need to know whether to hold the slot.",
  },
  {
    title: "The Opener",
    icon: "opener",
    job: "First contact that does not read like a template.",
    before: "I hope this email finds you well! I came across your website and...",
    after: "Your contact form has been broken since June. I filled it out twice and nothing came back. Get it fixed, you are losing calls.",
  },
];

const steps = [
  {
    n: "01",
    art: "email-step-1-sent.jpg",
    alt: "Dark-mode email application open to the sent folder on a laptop in a dim room, a long list of sent messages down the screen",
    title: "I read your sent folder.",
    body: "Two hundred emails you actually wrote, not a questionnaire about how you think you write. The voice comes out of the evidence.",
  },
  {
    n: "02",
    art: "email-step-2-pick.jpg",
    alt: "Six dark email draft panels floating in a grid, each tagged with a different coloured label chip",
    title: "We pick the six.",
    body: "Every business has different emails it dreads. A contractor needs a change-order voice. A therapist needs a boundary voice. Yours will not be my six.",
  },
  {
    n: "03",
    art: "email-step-3-build.jpg",
    alt: "A dark-mode email compose window on a desk, the body part written with a cursor sitting mid-paragraph and two lines marked for revision",
    title: "I build and you break them.",
    body: "You get the voices loaded and ready. You run real situations through them for a week and tell me where they sound wrong. They get tuned until they do not.",
  },
  {
    n: "04",
    art: "email-step-4-keep.jpg",
    alt: "A laptop and a phone side by side on a desk under a warm lamp, both open to the same dark-mode inbox with six saved labels in the sidebar",
    title: "You keep them.",
    body: "They live in your tool, not mine. No subscription to me, no rewriting them next quarter, nothing to renew. If your business changes enough that the voices stop fitting, you call me.",
  },
];

/* Presentational only. Deliberately NOT mirrored into a FAQPage node: see the
   header comment. */
const faqs = [
  {
    q: "Does this mean AI writes my emails?",
    a: "It means AI writes the first draft in a voice built from your own sent mail. You read it, you change what you want, you send it. Nothing goes out that you did not look at.",
  },
  {
    q: "Will people know?",
    a: "They will know it sounds like you, because it does. The voices are built from how you already write, which is the entire point of reading your sent folder instead of handing you a template.",
  },
  {
    q: "What tool does this run in?",
    a: "Whatever you already use. If you use nothing yet, I will set you up on one and show you how it works. There is nothing proprietary here that only I can service.",
  },
  {
    q: "What if I hate one of the voices?",
    a: "That is what the break-it week is for. They get tuned until they sound right or that voice gets scrapped and replaced with one you will actually use.",
  },
  {
    q: "Can you just write my emails instead?",
    a: "Sometimes, for a specific thing, yes. But it is the worse deal. Paying me per email means you are still waiting on me at 9pm when the invoice needs chasing.",
  },
];

const CANONICAL = "https://livewebstudios.com/services/email-writing";
/* 140 chars. Google truncates a description around 155-160, and the previous
   one ran 172, so its tail was being cut. It also led on "the emails you
   dread" and "bad news", the framing Jon pulled out of the hero, and named
   sections the page no longer has. This mirrors the hero's three jobs. */
const DESCRIPTION =
  "Six AI email voices built from your own sent mail: proposals, invoice follow-up, introductions. Built once, yours to keep. Saddle Brook, NJ.";
const TITLE = "Email Writing & AI Voice Systems | Live Web Studios";

/* WebPage + Service, the same pair the other thirteen service pages carry.
   No FAQPage node: /faq keeps the only one on the site. */
const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: TITLE,
    description: DESCRIPTION,
    url: CANONICAL,
    isPartOf: { "@type": "WebSite", name: "Live Web Studios", url: "https://livewebstudios.com" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: TITLE,
    serviceType: "Email Writing and AI Voice Systems",
    description: DESCRIPTION,
    url: CANONICAL,
    areaServed: "US",
    provider: {
      "@type": "LocalBusiness",
      name: "Live Web Studios",
      url: "https://livewebstudios.com",
      telephone: "732-801-9611",
      email: "jonwolf@livewebstudios.com",
    },
  },
];
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  canonical={CANONICAL}
  ogImage="images/og-email-writing.jpg"
  jsonld={pageSchema}
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="jon-webdesk.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">EMAIL WRITING</span>
        <h1 class="page-h1">I Do Not Write Emails Anymore. <em>Neither Should You</em>.</h1>
        <p class="page-lede">I built myself a set of email voices. One for proposals, one for checking in on an invoice, one for making an introduction. I tell the machine which voice and what happened, and the email comes out sounding like me on a good day. I will build you the same thing.</p>
        <div class="hero-btns">
          <a class="btn btn-primary" href={`${rel}contact.html`}>Let's talk. →</a>
          <a class="btn btn-ghost" href="#voices">The Six Voices ↓</a>
        </div>
      </div>
    </section>

    <Marquee />

    <!-- THE PROBLEM -->
    {/* Jon 2026-09-22: the envelope drift was scrapped ("they look terrible,
        different route"). This is the photo bed from the OUR STORY section of
        /about, which is the frame Jon pointed at. Base .sec-photobg, not the
        --left variant: jon-desk.jpg is dark on the left and carries Jon and
        the monitor on the RIGHT, so the base ramp (near-solid left, opening up
        across the right) is the one built for it. The url is inline because it
        is a per-page relative path, same reason work.astro and about.astro
        give at their own call sites. */}
    <section
      class="sec-pad sec-photobg"
      id="problem"
      style={`--sec-photo:url('${rel}images/jon-desk.jpg')`}
    >
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">THE PROBLEM</span>
          <h2>The Email You Are Avoiding Is Costing You Money</h2>
        </div>
        <div class="em-prose reveal">
          <p>Every small business owner has a folder of emails they have not sent.</p>
          <ul class="copy-points">
            <li><strong>The invoice</strong> that is forty days out.</li>
            <li><strong>The client</strong> who keeps adding one more thing.</li>
            <li><strong>The job that slipped</strong> and somebody has to be told.</li>
          </ul>
          <p>They do not go unsent because they are hard to write. They go unsent because writing them badly has a cost, so you wait for the energy to write them well. That energy shows up about once a month.</p>
          <p class="copy-kicker">A voice system takes the energy out of it. The tone gets decided once. After that you are describing a situation, not composing a letter.</p>
        </div>
      </div>
    </section>

    <!-- THE SIX VOICES -->
    <section class="sec-pad has-videobg" id="voices">
      {/* Jon 2026-09-22: "an appropriate non-annoying animated background,
          not too techy". bg-blue-fog is a slow gradient haze with no imagery
          in it at all, and six opaque glass cards sit over most of it, so the
          drift only reads in the gutters. */}
      <VideoBg src="bg-blue-fog.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">WHAT YOU GET</span>
          <h2>Six Voices, Built Once, Used Forever</h2>
        </div>
        <div class="grid-svc">
          {voices.map((v) => (
            <article class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <div class="em-head">
                  <h3>{v.title}</h3>
                  <svg
                    class="em-ico"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={HEAD + VOICE_ICONS[v.icon]}
                  />
                </div>
                <p class="em-job">{v.job}</p>
                <div class="em-ba">
                  <p class="em-before">
                    <span class="em-label">Before</span>
                    {v.before}
                  </p>
                  <p class="em-after">
                    <span class="em-label em-label--after">After</span>
                    {v.after}
                  </p>
                </div>
              </Glass>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- HOW IT RUNS -->
    <section class="sec-pad has-scan" id="build">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">THE BUILD</span>
          <h2>Four Steps, About Two Weeks</h2>
        </div>
        <ol class="grid-svc steps em-steps">
          {steps.map((st) => (
            <li class="card em-card reveal">
              <Glass variant="inner">
                <span class="em-card__art">
                  <img
                    src={`${rel}images/${st.art}`}
                    alt={st.alt}
                    width="900"
                    height="604"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="step-num">{st.n}</span>
                </span>
                <span class="card-pad">
                  <h3>{st.title}</h3>
                  <p>{st.body}</p>
                </span>
              </Glass>
            </li>
          ))}
        </ol>
      </div>
    </section>


    <!-- FAQ -->
    {/* The photo bed from the /work CTA. sec-photobg--left is purpose-built
        for this exact image: the subject is hard against the left edge and
        dissolves to black across the middle, so the variant mirrors the base
        ramp and puts its heaviest veil under the CENTRED copy, which is where
        the 780px accordion sits. No --copy-right here, unlike work.astro:
        that modifier only shifts .sec-head and .hero-btns, so it would push
        the heading right and leave .faq-list centred. The url is inline
        because it is a per-page relative path, same reason work.astro gives. */}
    <section
      class="sec-pad is-alt sec-photobg sec-photobg--left"
      id="faq"
      style={`--sec-photo:url('${rel}images/jon-left-desk-pixels.jpg')`}
    >
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">QUESTIONS</span>
          <h2>What People Ask</h2>
        </div>
        {/* Same accordion as /faq and /services/expert-witness: markup, styles
            and the toggle script are page-scoped on all three rather than
            extracted, which is the convention faq.astro set. h3 here, under
            this section's h2. Keep the three in sync. */}
        <div class="faq-list reveal">
          {faqs.map((f, i) => (
            <div class:list={["faq-item", i === 0 && "is-open"]} data-faq-item>
              <button
                class="faq-q-btn"
                type="button"
                aria-expanded={i === 0 ? "true" : "false"}
                aria-controls={`faq-panel-${i}`}
              >
                <h3 class="faq-q">{f.q}</h3>
                <span class="faq-icon" aria-hidden="true">+</span>
              </button>
              <div class="faq-panel" id={`faq-panel-${i}`}>
                <div class="faq-panel-inner">
                  <p class="faq-a">{f.a}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad is-alt">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta cta--art">
          <div class="cta-art">
            <img
              src={`${rel}images/email-cta-draft.jpg`}
              alt="A laptop on a dark desk showing an empty email draft with the cursor waiting, a cold mug of coffee beside it"
              width="900"
              height="604"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="cta-copy">
            <h2>Tell me which email you are avoiding.</h2>
            <p>That is usually the first voice we build.</p>
            <div class="hero-btns">
              <a class="btn btn-primary" href={`${rel}contact.html`}>Let's talk. →</a>
              <a class="btn btn-ghost" href="tel:+17328019611">732.801.9611</a>
            </div>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---------- prose column ----------
     THE PROBLEM is three paragraphs with no list and no art, and there is no
     existing standalone prose class: .copy only gets its type treatment
     inside .split. Page-scoped measure helper, same precedent as .ew-card on
     expert-witness.astro. */
  .em-prose {
    max-width: 680px;
    margin-inline: auto;
  }
  .em-prose p {
    color: var(--muted);
    line-height: 1.75;
  }
  .em-prose p + p {
    margin-top: 1.2rem;
  }
  /* .copy-points caps itself at 46ch for the narrower split column; this one
     is a centred prose measure, so let it use the width it has. */
  .em-prose .copy-points {
    max-width: none;
    margin: 1.4rem 0;
  }
  .em-prose .copy-kicker {
    margin-top: 1.4rem;
  }

  /* ---------- step card art ----------
     Same construction as .ew-card on expert-witness.astro: the banner bleeds
     to the card edge and .card-pad owns the inset, so glass-inner's padding is
     cleared here. Without that the art sits inside a frame AND outside the
     pad, which gives every card two nested frames. */
  .em-card > :global(.glass-inner) {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
  }
  .em-card__art {
    position: relative;
    display: block;
    flex: none;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-bottom: 1px solid rgba(56, 189, 248, 0.18);
  }
  .em-card__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease);
  }
  .em-card:hover .em-card__art img {
    transform: scale(1.04);
  }
  /* .card-pad carries height:100%, written for a pad that IS the whole card.
     Under a banner that resolves against a height already containing the pad
     and the card inflates, so it goes back to auto here. */
  .em-card :global(.card-pad) {
    height: auto;
    flex: 1 1 auto;
  }
  .em-card__art .step-num {
    position: absolute;
    left: 0.9rem;
    bottom: 0.7rem;
    margin: 0;
    padding: 0.18rem 0.5rem;
    border-radius: 4px;
    background: rgba(5, 7, 11, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  /* Four steps, not the five expert-witness runs, so the base .grid-svc 3-up
     would strand one card alone on a second row. Four across, then two, then
     one. The 900px rule restates the collapse because the scoped selector
     outranks global.css's .grid-svc and would otherwise hold 2-up on a phone. */
  .em-steps {
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 1180px) {
    .em-steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 900px) {
    .em-steps {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- CTA art ---------- */
  .cta-art img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
  }

  @media (prefers-reduced-motion: reduce) {
    .em-card__art img,
    .em-card:hover .em-card__art img {
      transition: none;
      transform: none;
    }
  }

  /* ---------- voice cards ---------- */
  /* Title hard left, glyph hard right (Jon 2026-09-22). The h3 also moved
     ahead of the svg in the markup rather than being pushed over with `order`,
     so reading order matches visual order and the heading still comes first
     for a screen reader. The glyph is aria-hidden either way. */
  .em-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem;
  }
  /* Title goes brass with the glyph, so the whole header row of the card is
     one mark instead of a gold icon bolted onto a white heading (Jon
     2026-09-22). mosa-skin.css sets .card h3 to --ink-soft at (0,1,1); this
     scoped selector is (0,2,1) and wins without !important. At the 22px
     .card h3 size brass is large text needing 3:1, and it measures 8.9:1. */
  .em-head h3 {
    margin: 0;
    color: var(--brass);
  }
  /* Brass, the site's gold (Namesake, the Legal nav column, the expert-witness
     step numbers). Jon's call, 2026-09-22, after an AI-violet pass he rejected.
     It is the right one of the three golds here because THIS PAGE ALREADY RUNS
     IT: .step-num on the four build cards is var(--brass), so gold reads as a
     second deliberate accent down the page rather than a one-off on the voice
     cards. --amber was out because it means Live Band Web Studios site-wide,
     and --cat-gold because it means a blog category.
     It also gets the icons off cyan, which was already carrying the job line,
     the AFTER rule, the BEFORE/AFTER labels, the bullet markers and the whole
     FAQ accordion: a ninth cyan element read as more of the same rather than
     as the mark on the card. Measured 8.9:1 on the rendered card ground,
     against the 3:1 WCAG 1.4.11 asks of a graphic. */
  .em-ico {
    --voice-ico: var(--brass);
    flex: none;
    width: 30px;
    height: 30px;
    color: var(--voice-ico);
  }
  .em-job {
    color: var(--cyan-soft);
    font-size: 0.95rem;
    line-height: 1.45;
    margin-top: 0.4rem;
  }
  .em-ba {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .em-ba p {
    margin: 0;
    padding-left: 0.9rem;
    border-left: 2px solid var(--line);
    line-height: 1.6;
    font-size: 0.95rem;
  }
  /* The "before" takes --muted-2, the site's secondary text token, against the
     "after" on --ink. Measured on the rendered card ground (rgb(3,3,3) once
     the glass composites): --muted-2 is 6.9:1 and --ink is 14.6:1, so the
     hierarchy is visible and the de-emphasised half still clears WCAG AA for
     body text with room. Note that mosa-skin.css redefines these four tokens
     as white-alpha (--ink .85, --muted .74, --muted-2 .58), so the hex values
     in global.css's :root are NOT what ships; measure against the skin. */
  .em-before {
    color: var(--muted-2);
  }
  .em-after {
    color: var(--ink);
    border-left-color: var(--cyan-soft);
  }
  .em-label {
    display: block;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-bottom: 0.3rem;
  }
  .em-label--after {
    color: var(--cyan-soft);
  }


  /* ---------- FAQ accordion ----------
     Ported from faq.astro via expert-witness.astro. Scoped here rather than
     added to global.css, which is the convention those two set. */
  .faq-list {
    max-width: 780px;
    margin-inline: auto;
  }
  .faq-item {
    border: 1px solid rgb(var(--mosa-fg-rgb) / 0.18);
    border-radius: var(--r-lg);
    background: rgba(7, 11, 20, 0.88);
    backdrop-filter: blur(22px) saturate(165%);
    -webkit-backdrop-filter: blur(22px) saturate(165%);
    box-shadow:
      inset 0 1px 0 rgb(var(--mosa-fg-rgb) / 0.14),
      0 10px 30px rgba(0, 0, 0, 0.28);
    margin-bottom: 0.7rem;
    overflow: hidden;
    transition: border-color 0.35s var(--ease), background 0.35s var(--ease);
  }
  @supports not (backdrop-filter: blur(1px)) {
    .faq-item {
      background: rgba(7, 11, 20, 0.95);
    }
  }
  .faq-item:hover {
    border-color: rgba(56, 189, 248, 0.42);
  }
  .faq-item.is-open {
    border-color: rgba(56, 189, 248, 0.4);
    background:
      linear-gradient(rgba(56, 189, 248, 0.06), rgba(56, 189, 248, 0.06)),
      rgba(7, 11, 20, 0.93);
  }
  .faq-q-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 1.1rem 1.3rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
  }
  .faq-q-btn:focus-visible {
    outline: 2px solid var(--cyan-soft);
    outline-offset: -2px;
  }
  .faq-q {
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.35;
  }
  .faq-icon {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    color: var(--cyan-soft);
    font-family: var(--mono);
    font-size: 1.2rem;
    line-height: 1;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      background 0.3s var(--ease), color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .faq-item.is-open .faq-icon {
    transform: rotate(135deg);
    background: var(--cyan-soft);
    color: var(--on-accent);
    border-color: var(--cyan-soft);
  }
