---
/**
 * /services/ai-workflow — ported from the live site
 * (livewebstudios.com/services/ai-workflow). Rebuilt on v3 layouts/components.
 * Hero illustration dropped per no-image rule. No em dashes in body copy.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import BotTalk from "../../components/BotTalk.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const cards = [
  { ico: "▤", title: "Content Pipelines", body: "Blog posts, social, product descriptions. The draft gets written for you so the job becomes editing instead of staring at an empty page.",
    points: ["Drafts in your voice, not generic filler", "A person still approves before anything ships"] },
  { ico: "✦", title: "Customer Comms", body: "Templates, triage, and first-pass responses. The routine questions get answered fast and the ones that need you actually reach you.",
    points: ["Common questions handled automatically", "Anything unusual routed to a human"] },
  { ico: "▦", title: "Reporting", body: "Weekly and monthly summaries pulled together without anyone rebuilding a spreadsheet. It arrives written up, not as a pile of numbers to interpret.",
    points: ["Same report, same day, every time", "Written in plain language"] },
  { ico: "❖", title: "Lead Qualification", body: "Scoring and follow-up sequences, so the leads worth calling rise to the top. Nobody good sits in an inbox for three days going cold.",
    points: ["Ranked by how likely they are to buy", "Follow-up fires whether or not anyone remembers"] },
  { ico: "◈", title: "Image Processing", body: "Bulk editing and background work. What used to be an afternoon in Photoshop runs while you do something else.",
    points: ["Whole folders at once", "Consistent output across the batch"] },
  { ico: "◎", title: "SEO Monitoring", body: "Position tracking with alerts that fire when something moves. A ranking drop found in week one is a fix. Found in month six it is a rebuild.",
    points: ["Watched daily, not when someone remembers", "You hear about drops early"] },
];

/* Schema: the WebPage node Base would emit by default, plus a Service node
   for the offering this page describes (project rule: every page carries
   schema; the live site has it on 61 pages). */
const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "AI Workflow Automation | Live Web Studios",
    description: "Automate content, communications, reporting, and lead qualification with AI workflows built for SMBs. AI automation from Live Web Studios, Saddle Brook, NJ.",
    url: "https://livewebstudios.com/services/ai-workflow",
    isPartOf: { "@type": "WebSite", name: "Live Web Studios", url: "https://livewebstudios.com" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "AI Workflow Automation | Live Web Studios",
    description: "Automate content, communications, reporting, and lead qualification with AI workflows built for SMBs. AI automation from Live Web Studios, Saddle Brook, NJ.",
    url: "https://livewebstudios.com/services/ai-workflow",
    areaServed: "US",
    provider: {
      "@type": "LocalBusiness",
      name: "Live Web Studios",
      url: "https://livewebstudios.com",
      telephone: "732-801-9611",
      email: "jonwolf@livewebstudios.com",
    },
  },
];
---

<Base
  title="AI Workflow Automation | Live Web Studios"
  description="Automate content, communications, reporting, and lead qualification with AI workflows built for SMBs. AI automation from Live Web Studios, Saddle Brook, NJ."
  canonical="https://livewebstudios.com/services/ai-workflow"
  jsonld={pageSchema}
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-color-tv.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">NEW IN 2026</span>
        <h1 class="page-h1">Stop Doing Things AI Can Do <em>Better</em>.</h1>
        <p class="page-lede">AI workflow automation for SMBs.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- WORKFLOW CARDS -->
    <section class="sec-pad has-videobg has-scan">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="grid-svc">
          {cards.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta cta--art">
          <div class="cta-art"><BotTalk /></div>
          <div class="cta-copy">
            <h2>Ready to Get Time Back?</h2>
            <div class="hero-btns">
              <a href="../contact.html" class="btn btn-primary">Talk Workflows →</a>
              <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
            </div>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
