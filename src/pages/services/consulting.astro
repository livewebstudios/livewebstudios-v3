---
/**
 * /services/consulting — ported from the live site
 * (livewebstudios.com/services/consulting). Rebuilt on v3 layouts/components.
 * Hero illustration dropped per no-image rule. No em dashes in body copy.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const cards = [
  { ico: "◎", title: "Technical SEO", body: "Speed, mobile, crawlability. If Google is having trouble reading the site, nothing else on this list matters yet.",
    points: ["Real page speed numbers, not a grade", "Anything blocking indexing, found and named"] },
  { ico: "▤", title: "Content Analysis", body: "Tags, headings, keywords. Usually this turns up pages competing with each other for the same term without anyone realizing it.",
    points: ["Pages ranked by what they could win", "Duplicate and cannibalized pages flagged"] },
  { ico: "✦", title: "Keyword Gaps", body: "What you should rank for and do not. This is normally the shortest section of the report and the one that makes the most money.",
    points: ["Searches your buyers use that you miss", "Sorted by what is realistic to win"] },
  { ico: "◈", title: "Local SEO", body: "Google Business Profile, citations, reviews. For a service-area business this is often the difference between a busy phone and a quiet one.",
    points: ["Listings checked for wrong addresses and numbers", "What to fix first, in order"] },
  { ico: "❖", title: "UX & Conversion", body: "What stops visitors from calling. Plenty of sites get decent traffic and still lose almost everyone at the same spot on the page.",
    points: ["Where people drop off and why", "Fixes ranked by effort against payoff"] },
  { ico: "⬡", title: "Competition", body: "How you stack up against the shops you actually lose work to. Not a national list, the ones bidding the same jobs.",
    points: ["What they rank for that you do not", "Where you are already ahead"] },
];

/* Schema: the WebPage node Base would emit by default, plus a Service node
   for the offering this page describes (project rule: every page carries
   schema; the live site has it on 61 pages). */
const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Website Audits & Consulting | Live Web Studios",
    description: "Technical SEO and UX website audits with written report and 1-hour walkthrough. Live Web Studios, Saddle Brook, NJ.",
    url: "https://livewebstudios.com/services/consulting",
    isPartOf: { "@type": "WebSite", name: "Live Web Studios", url: "https://livewebstudios.com" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Website Audits & Consulting | Live Web Studios",
    description: "Technical SEO and UX website audits with written report and 1-hour walkthrough. Live Web Studios, Saddle Brook, NJ.",
    url: "https://livewebstudios.com/services/consulting",
    areaServed: "US",
    provider: {
      "@type": "LocalBusiness",
      name: "Live Web Studios",
      url: "https://livewebstudios.com",
      telephone: "732-801-9611",
      email: "jonwolf@livewebstudios.com",
    },
  },
];
---

<Base
  title="Website Audits & Consulting | Live Web Studios"
  description="Technical SEO and UX website audits with written report and 1-hour walkthrough. Live Web Studios, Saddle Brook, NJ."
  canonical="https://livewebstudios.com/services/consulting"
  jsonld={pageSchema}
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-looping-waves.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">AUDITS &amp; CONSULTING</span>
        <h1 class="page-h1">Find Out Why Your Site <em>Isn't Working</em>.</h1>
        <p class="page-lede">Website audit &amp; consulting.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- AUDIT CARDS -->
    <section class="sec-pad has-videobg has-scan">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="grid-svc">
          {cards.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- DELIVERABLE -->
    <section class="sec-pad is-alt">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta">
          <span class="eyebrow">DELIVERABLE</span>
          <h2>Written Report + 1-Hour Walkthrough</h2>
          <p>You own the report. Implement yourself or hire us.</p>
          <div class="hero-btns">
            <a href="../contact.html" class="btn btn-primary">Order Your Audit →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
