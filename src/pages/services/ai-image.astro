---
/**
 * /services/ai-image — ported from the live site
 * (livewebstudios.com/services/ai-image). Rebuilt on v3 layouts/components.
 * Hero illustration dropped per no-image rule. No em dashes in body copy.
 * The closing CTA links straight out to livewebphotos.com (Jon 2026-09-12);
 * the former local /ecosystem page is gone. Previously noted as not yet
 * ported to v3 (flagged in the port report).
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import BotTalk from "../../components/BotTalk.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const cards = [
  { ico: "⬢", title: "For E-Commerce", body: "Bulk background removal and product staging with lighting that matches across the whole catalog. A grid of products shot on six different days stops looking like it.",
    points: ["Hundreds of SKUs in one pass", "Consistent look across the catalog"] },
  { ico: "✦", title: "For Real Estate", body: "Virtual staging, sky replacement, and mood work. An empty room is hard to sell and a grey-sky exterior is worse, so neither has to be what the listing shows.",
    points: ["Furnish an empty room without renting furniture", "Fix the weather you got stuck with"] },
  { ico: "❖", title: "For Professionals", body: "AI headshots from one sitting. You get a set that works on the site, on LinkedIn, and in a proposal, without booking a photographer every time somebody joins.",
    points: ["Multiple looks from a single session", "Matched so a whole team looks like a team"] },
  { ico: "✎", title: "For Designers", body: "Scene composition, mood adjustment, palette matching. For when the shot is nearly right and the schedule has no room for another shoot.",
    points: ["Match a photo to an existing palette", "Composite elements that were never in one frame"] },
];

/* Schema: the WebPage node Base would emit by default, plus a Service node
   for the offering this page describes (project rule: every page carries
   schema; the live site has it on 61 pages). */
const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "AI Image Manipulation | Live Web Studios",
    description: "Bulk product photos, virtual staging, and AI headshots, studio-quality at scale. AI image services from Live Web Studios, Saddle Brook, NJ.",
    url: "https://livewebstudios.com/services/ai-image",
    isPartOf: { "@type": "WebSite", name: "Live Web Studios", url: "https://livewebstudios.com" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "AI Image Manipulation | Live Web Studios",
    description: "Bulk product photos, virtual staging, and AI headshots, studio-quality at scale. AI image services from Live Web Studios, Saddle Brook, NJ.",
    url: "https://livewebstudios.com/services/ai-image",
    areaServed: "US",
    provider: {
      "@type": "LocalBusiness",
      name: "Live Web Studios",
      url: "https://livewebstudios.com",
      telephone: "732-801-9611",
      email: "jonwolf@livewebstudios.com",
    },
  },
];
---

<Base
  title="AI Image Manipulation | Live Web Studios"
  description="Bulk product photos, virtual staging, and AI headshots, studio-quality at scale. AI image services from Live Web Studios, Saddle Brook, NJ."
  canonical="https://livewebstudios.com/services/ai-image"
  jsonld={pageSchema}
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-orange-beam-noaudio.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">NEW IN 2026</span>
        <h1 class="page-h1">Studio-Quality Photos. <em>Without a Studio.</em></h1>
        <p class="page-lede">AI image manipulation &amp; bulk production.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- USE-CASE CARDS -->
    <section class="sec-pad has-videobg has-scan">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        {/* Structural only. These cards are h3s and this page has no other
            heading between them and the h1, which skipped a level on every
            service detail page (launch audit 2026-09-15). Hidden rather than
            visible so no new copy lands on seven pages without Jon seeing it;
            swap the class off to show it. */}
        <h2 class="visually-hidden">What AI image creation includes</h2>
        <div class="grid-svc">
          {cards.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta cta--art">
          <div class="cta-art"><BotTalk /></div>
          <div class="cta-copy">
            <h2>Need Photos at Scale?</h2>
            <p>Visit our sister company Live Web Photos.</p>
            <div class="hero-btns">
              <a href="https://livewebphotos.com" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Visit livewebphotos.com →</a>
              <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
            </div>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
