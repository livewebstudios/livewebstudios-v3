---
/**
 * /services/seo — ported from the live site (livewebstudios.com/services/seo).
 * Rebuilt on v3 layouts/components. Hero illustration dropped per no-image rule.
 * EM DASH BAN applied to body + tier bullets; numeric ranges hyphenated.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const services = [
  { ico: "◎", title: "Technical Audit", body: "Speed, mobile, structure. This is the part that usually explains why a site nobody can find looks perfectly fine to its owner.",
    points: ["Find what is actually blocking rankings", "Written up in plain English, not a tool export"] },
  { ico: "✦", title: "Keyword Research", body: "Local and service-specific. I would rather own the searches your buyers type than rank for a big term that never turns into a phone call.",
    points: ["Built around what people near you search", "Intent first, volume second"] },
  { ico: "▤", title: "On-Page Optimization", body: "Tags, meta, schema. Done on the pages that can actually move, so the work goes where it pays.",
    points: ["Titles written for humans and for Google", "Schema that matches your business type"] },
  { ico: "◈", title: "Google Business Profile", body: "Setup and optimization. For a local business this is often worth more than the website itself, and it is the thing most people leave half-filled.",
    points: ["Categories and service areas set properly", "Photos, hours, and Q and A filled in"] },
  { ico: "▦", title: "Content Creation", body: "Blog posts and service pages that answer what people are already asking. Every page has a job or it does not get written.",
    points: ["Pages built around real searches", "No filler posted to hit a quota"] },
  { ico: "◧", title: "Monthly Reporting", body: "Real data. Real insights. You get what moved, what it means, and what I am doing about it next month.",
    points: ["Rankings, traffic, and calls in one place", "A short read, not a 40-page PDF"] },
];

const tiers = [
  {
    name: "Basic",
    featured: false,
    blurb: "Essential SEO for getting started. Best for businesses that need a solid local foundation.",
    items: [
      "Website audit (speed, mobile, broken links)",
      "Keyword research: 5-10 local keywords",
      "On-page optimization (title tags, meta, headers)",
      "URL structure recommendations",
      "Google Business Profile setup or update",
      "Google Analytics & Search Console setup",
      "Monthly traffic and ranking report",
    ],
  },
  {
    name: "Standard",
    featured: true,
    blurb: "Advanced strategies to grow your reach. Best for businesses ready to compete seriously in local search.",
    items: [
      "Everything in Basic, plus:",
      "Expanded research: 15-20 keywords including competitor terms",
      "Two optimized blog posts per month",
      "Service page optimization",
      "Local directory optimization + citation building",
      "Technical SEO: broken links, site structure, page speed",
      "Reputation management: review monitoring and response",
      "Competitor rankings and backlink audit",
      "Enhanced monthly report with keyword tracking and competitor comparisons",
    ],
  },
  {
    name: "Premium",
    featured: false,
    blurb: "Everything in Growth, plus content and competitive work. Best for competitive markets and multi-service businesses.",
    items: [
      "Everything in Standard, plus:",
      "Advanced research: 30+ keywords with long-tail variations",
      "Four blog posts or content resources per month",
      "Infographics, guides, or case studies",
      "Hyper-local targeting for surrounding neighborhoods and cities",
      "Citations across 50+ directories",
      "Link building: outreach for quality backlinks",
      "Schema markup for service areas and reviews",
      "Advanced crawlability and structured data optimization",
      "Social media post-sharing (Facebook, Instagram, LinkedIn)",
      "ROI analysis, conversion tracking, heatmaps, and insights",
    ],
  },
];

/* Schema: the WebPage node Base would emit by default, plus a Service node
   for the offering this page describes (project rule: every page carries
   schema; the live site has it on 61 pages). */
const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "SEO & Digital Marketing | Live Web Studios",
    description: "Expert SEO services for small business, Saddle Brook, NJ. Local SEO, keyword research, content, technical audits. 23 years experience.",
    url: "https://livewebstudios.com/services/seo",
    isPartOf: { "@type": "WebSite", name: "Live Web Studios", url: "https://livewebstudios.com" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "SEO & Digital Marketing | Live Web Studios",
    description: "Expert SEO services for small business, Saddle Brook, NJ. Local SEO, keyword research, content, technical audits. 23 years experience.",
    url: "https://livewebstudios.com/services/seo",
    areaServed: "US",
    provider: {
      "@type": "LocalBusiness",
      name: "Live Web Studios",
      url: "https://livewebstudios.com",
      telephone: "732-801-9611",
      email: "jonwolf@livewebstudios.com",
    },
  },
];
---

<Base
  title="SEO & Digital Marketing | Live Web Studios"
  description="Expert SEO services for small business, Saddle Brook, NJ. Local SEO, keyword research, content, technical audits. 23 years experience."
  canonical="https://livewebstudios.com/services/seo"
  jsonld={pageSchema}
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-looping-waves.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">SEO &amp; MARKETING</span>
        <h1 class="page-h1">Rank Higher. Get Found. <em>Grow</em>.</h1>
        <p class="page-lede">SEO for small business, 23 years of search experience, North Jersey and nationwide.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- WHAT'S INCLUDED -->
    <section class="sec-pad has-videobg has-scan">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="grid-svc">
          {services.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WHAT IS SEO -->
    <section class="sec-pad is-alt">
      <div class="wrap split split--copy-first">
        <div class="copy copy--points reveal">
          <span class="eyebrow">SEO</span>
          <div class="sec-head is-flush"><h2>Your Customers Are Searching. The Question Is Whether They Find You.</h2></div>
          <!-- Restructured from prose blocks to lede + points
               (Jon 2026-09-14: less wall of text, readable by a
               non-technical visitor). Claims and search terms kept. -->
          <p>SEO, or Search Engine Optimization, is how your website shows up when people search for what you offer. Someone types "plumber near me" or "NJ divorce attorney" or "best Italian restaurant in Saddle Brook," and Google decides which sites to show first. SEO is how you get to the top of that list, and stay there.</p>
          <p>Why it is worth the investment:</p>
          <ul class="copy-points">
            <li><strong>It compounds.</strong> Paid ads stop the moment you stop paying. SEO builds value over time.</li>
            <li><strong>One good page can pay for years,</strong> driving traffic and leads with no additional spend.</li>
            <li><strong>It is the highest-ROI marketing move</strong> most small businesses can make.</li>
          </ul>
          <p>Why us:</p>
          <ul class="copy-points">
            <li><strong>23 years doing this.</strong> We have watched Google evolve through algorithm after algorithm.</li>
            <li><strong>We have stayed ahead of every shift.</strong></li>
            <li><strong>No tricks, no shortcuts.</strong> We build sites and content Google trusts, the right way.</li>
          </ul>
          <p class="copy-kicker">Get to the top of the list, and stay there.</p>
          <p>SEO works best on a fast, well-structured site. See how our <a href="website-design.html">Website Design process →</a> sets you up for search success.</p>
          <p>Track your results with our <a href="hosting.html">Hosting &amp; Maintenance plans →</a> that include monthly SEO reports.</p>
        </div>
        <Glass class="reveal" innerClass="portrait portrait--img portrait--tall">
          <img
            src="../images/svc-seo.jpg"
            alt="Glowing cyan search bar above rising ranking bars climbing toward the top position"
            width="880"
            height="1168"
            loading="lazy"
            decoding="async"
          />
          <div class="frame-lines"></div>
        </Glass>
      </div>
    </section>

    <!-- SEO PLANS -->
    <section class="sec-pad has-scan">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">SEO PLANS</span>
          <h2>Three Levels of SEO. No Contracts.</h2>
          <p>Three tiers designed for different stages of growth. All plans include a monthly performance report.</p>
        </div>
        <div class="grid-svc trio">
          {tiers.map((t) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                {t.featured && <span class="tag-new">MOST POPULAR</span>}
                <h3>{t.name}</h3>
                <p>{t.blurb}</p>
                <ul>
                  {t.items.map((i) => <li>{i}</li>)}
                </ul>
                <a class="more" href="../contact.html">GET STARTED →</a>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
