---
/**
 * /services/branding — ported from the live site
 * (livewebstudios.com/services/branding). Rebuilt on v3 layouts/components.
 * Hero illustration dropped per no-image rule. No em dashes in body copy.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const cards = [
  { ico: "✎", title: "Logo Systems", body: "Primary, secondary, horizontal, stacked, icon-only. One logo is not enough the first time it has to fit a square avatar or the side of a truck.",
    points: ["A version for every place it has to go", "Works at 16px and at 16 feet"] },
  { ico: "◈", title: "Color & Type", body: "A palette and typefaces with rules for using them. Written down, so the next person who touches your material does not quietly invent a second brand.",
    points: ["Exact values for print and screen", "Web fonts licensed and ready to install"] },
  { ico: "▤", title: "Print Collateral", body: "Cards, letterhead, envelopes. Set up properly for a printer, with bleeds and real CMYK, so nothing comes back the wrong color.",
    points: ["Press-ready files, not screen exports", "Send straight to any printer"] },
  { ico: "❖", title: "Digital Assets", body: "Email signatures and social profiles, sized for each platform. The places people see you most often are usually the ones nobody gets around to updating.",
    points: ["Cropped correctly per platform", "Signature that survives Outlook and Gmail"] },
  { ico: "▦", title: "Style Guide", body: "A branded PDF with everything documented. Hand it to a printer, a new hire, or another agency and they can match what already exists.",
    points: ["Spacing, sizing, and what not to do", "Written to be handed to someone else"] },
  { ico: "⬡", title: "Source Files", body: "AI, EPS, SVG, PDF, PNG, WebP. You own all of it. If we stop working together tomorrow, nothing about your brand is locked in my drawer.",
    points: ["Editable originals, not just flat exports", "Yours to keep, no strings"] },
];
---

<Base
  title="Branding & Corporate Identity | Live Web Studios"
  description="Logo systems, color palettes, typography, and brand guidelines for businesses nationwide. Corporate identity packages from Live Web Studios, Saddle Brook, NJ."
  canonical="https://livewebstudios.com/services/branding"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-orange-beam-noaudio.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">BRANDING</span>
        <h1 class="page-h1">Your Brand. Built to <em>Last</em>.</h1>
        <p class="page-lede">Branding &amp; corporate identity design.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- BRAND CARDS -->
    <section class="sec-pad has-videobg has-scan">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="grid-svc">
          {cards.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta">
          <h2>Ready to Re-Brand?</h2>
          <div class="hero-btns">
            <a href="../contact.html" class="btn btn-primary">Get a Brand Quote →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
