---
/**
 * /services/custom-styles-and-carousel-cards — the real style library, brought
 * over from the live site (Jon 2026-09-12: "bring over the cards and the
 * styles, make it a filtered portfolio page with those 5 styles").
 *
 * An earlier v3 session dropped all 88 images and rebuilt this as text cards
 * under a no-image rule. That is reversed here: every original photo, every
 * branded carousel card and the three Golden Gate motion clips are back, and
 * the tabbed gallery is now a filter. Filenames are regular
 * (<style>-NN.jpg and cards/<style>-card-<cat>-N.jpg), so the grids are
 * generated rather than hand-listed.
 *
 * Filtering and the lightbox are progressive enhancement: with JS off every
 * panel renders in sequence and every image is a plain link to itself.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import VideoBg from "../../components/VideoBg.astro";
import HeroActions from "../../components/HeroActions.astro";
import { relPrefix } from "../../lib/relPrefix";
/* Real pixel dimensions for all 88 files, generated from the images
   themselves. They are not one uniform ratio (1194x1600, 1600x1600,
   1600x893, 1073x1600, 1600x1194), so width/height cannot be hardcoded.
   The tile controls layout; these attributes just keep the markup honest. */
import MEDIA from "../../data/style-media.json";

const rel = relPrefix(Astro.url.pathname);

/* Card categories, in the live page's order. The slug is the filename stem. */
const CATS = [
  { slug: "show", title: "Show Concept" },
  { slug: "credentials", title: "Band Credentials" },
  { slug: "setlist", title: "Setlist / Name-Drops" },
  { slug: "audience", title: "Audience / Emotion" },
  { slug: "fan", title: "Fan Engagement" },
];

const styles = [
  { key: "archie", label: "Archie", photos: 6, note: "Bold, comic-inspired ink and halftone." },
  {
    key: "golden-gate",
    label: "Golden Gate",
    photos: 8,
    note: "Warm, sun-washed West Coast poster art.",
    motion: [
      { file: "flowing-hair.mp4", alt: "Golden Gate style looping animation, flowing hair" },
      { file: "ButterflyFINAL.mp4", alt: "Golden Gate style looping animation, butterfly" },
      { file: "HeadphonesFINAL.mp4", alt: "Golden Gate style looping animation, headphones" },
    ],
  },
  { key: "pop-art", label: "Pop-Art", photos: 8, note: "High-saturation, screen-print energy." },
  { key: "mid-century-american", label: "Mid-Century American", photos: 8, note: "Clean retro type and muted palettes." },
  { key: "owsley", label: "Owsley", photos: 8, note: "Psychedelic, liquid-light concert graphics." },
];

const pad = (n: number) => String(n).padStart(2, "0");
const dim = (path: string): [number, number] =>
  (MEDIA as Record<string, [number, number]>)[path] ?? [1194, 1600];
const photoList = (s: typeof styles[number]) =>
  Array.from({ length: s.photos }, (_, i) => {
    const path = `images/styles/${s.key}/${s.key}-${pad(i + 1)}.jpg`;
    const [w, h] = dim(path);
    return { src: `${rel}${path}`, alt: `${s.label} style band photo ${i + 1}`, w, h };
  });
const cardList = (s: typeof styles[number], cat: typeof CATS[number]) =>
  [1, 2].map((n) => {
    const path = `images/styles/${s.key}/cards/${s.key}-card-${cat.slug}-${n}.jpg`;
    const [w, h] = dim(path);
    return { src: `${rel}${path}`, alt: `${s.label} style, ${cat.title} card`, w, h };
  });

const TITLE = "Custom Styles & Carousel Cards | Live Web Studios";
const DESC =
  "Five hand-crafted graphic style sets, Archie, Mid-Century, Pop-Art, Golden Gate & Owsley, for website heroes, carousels, and feature cards.";
const URL = "https://livewebstudios.com/services/custom-styles-and-carousel-cards";

const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: TITLE,
    description: DESC,
    url: URL,
    isPartOf: { "@type": "WebSite", name: "Live Web Studios", url: "https://livewebstudios.com" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: TITLE,
    description: DESC,
    url: URL,
    areaServed: "US",
    provider: {
      "@type": "LocalBusiness",
      name: "Live Web Studios",
      url: "https://livewebstudios.com",
      telephone: "732-801-9611",
      email: "jonwolf@livewebstudios.com",
    },
  },
];
---

<Base title={TITLE} description={DESC} canonical={URL} jsonld={pageSchema}>
  <Nav />

  <main>
    <!-- HERO -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-corner.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">STYLE LIBRARY</span>
        <h1 class="page-h1">Custom Styles &amp; <em>Carousel Cards</em>.</h1>
        <p class="page-lede">Five hand-built looks. Original photography, then branded cards with the copy painted into the art.</p>
        <HeroActions links />
      </div>
    </section>

    <!-- GALLERY -->
    <section class="sec-pad" id="gallery">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">PICK A STYLE</span>
          <h2>Pick a Style. We Build the Cards Around It.</h2>
        </div>
        <!-- em-dash: "hand-tuned look — not a stock filter" -> comma;
             "mix categories — request a custom palette" -> comma -->
        <p class="page-lede is-center reveal">Every set below is a real, hand-tuned look, not a stock filter. Pick a style to see its original photos, then the branded cards where the band name, tour dates, and taglines are painted right into the artwork. We'll produce a matched run of hero images, carousel slides, and feature-card art. Mix categories, request a custom palette, or hand us a moodboard and we'll build something entirely yours. Sample content is from our build for <a href="https://www.britishinvasionyears.com/" target="_blank" rel="noopener">The British Invasion Years</a>. Tap any image to open it full-size.</p>

        <!-- FILTER -->
        <div class="style-tabs reveal" role="tablist" aria-label="Style collections" data-style-tabs>
          {styles.map((s, i) => (
            <button
              type="button"
              class:list={["style-tab", i === 0 && "is-active"]}
              role="tab"
              id={`tab-${s.key}`}
              aria-controls={`panel-${s.key}`}
              aria-selected={i === 0 ? "true" : "false"}
              data-style={s.key}
            >{s.label}</button>
          ))}
        </div>

        {styles.map((s, i) => (
          <div
            class:list={["style-panel", i === 0 && "is-active"]}
            id={`panel-${s.key}`}
            role="tabpanel"
            aria-labelledby={`tab-${s.key}`}
            data-panel={s.key}
          >
            <p class="style-note">{s.note}</p>

            <h3 class="panel-sec"><span class="panel-sec__num">01</span> Photos <span class="panel-sec__hint">{s.photos} originals · tap to enlarge</span></h3>
            <div class="shot-grid shot-grid--photos">
              {photoList(s).map((p) => (
                <a class="lb-shot" href={p.src} data-lb>
                  <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" />
                </a>
              ))}
            </div>

            <h3 class="panel-sec"><span class="panel-sec__num">02</span> Carousel Cards <span class="panel-sec__hint">copy fused into the art</span></h3>
            {CATS.map((cat) => (
              <div class="cards-cat">
                <h4 class="cards-cat-title">{cat.title}</h4>
                <div class="shot-grid shot-grid--cards">
                  {cardList(s, cat).map((c) => (
                    <a class="lb-shot" href={c.src} data-lb>
                      <img src={c.src} alt={c.alt} width={c.w} height={c.h} loading="lazy" decoding="async" />
                    </a>
                  ))}
                </div>
              </div>
            ))}

            {s.motion && (
              <>
                <h3 class="panel-sec"><span class="panel-sec__num">03</span> Motion <span class="panel-sec__hint">looping animations · play on load</span></h3>
                <div class="shot-grid shot-grid--motion">
                  {s.motion.map((v) => (
                    <video
                      class="style-motion"
                      muted
                      loop
                      playsinline
                      preload="none"
                      controls
                      aria-label={v.alt}
                      data-motion-src={`${rel}video/services-videos/${v.file}`}
                    ></video>
                  ))}
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- CLOSING CTA -->
    <section class="sec-pad is-alt">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">YOUR BRAND, YOUR SET</span>
          <h2>Want a Set Built for Your Brand?</h2>
        </div>
        <!-- em-dash: "Tell me the vibe — I'll mock up cards" -> period -->
        <p class="page-lede is-center reveal">Tell me the vibe. I'll mock up cards in the style that fits. Mix any of these, or invent something new.</p>
        <p class="is-center reveal"><a class="btn btn-primary" href={`${rel}contact.html`}>Let's talk. →</a></p>
      </div>
    </section>
  </main>

  <!-- LIGHTBOX -->
  <div class="lb" id="lb" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Full-size image">
    <button type="button" class="lb-close" data-lb-close aria-label="Close">&times;</button>
    <button type="button" class="lb-prev" data-lb-prev aria-label="Previous image">&#8249;</button>
    <img class="lb-img" id="lb-img" alt="" />
    <button type="button" class="lb-next" data-lb-next aria-label="Next image">&#8250;</button>
  </div>

  <Footer />
</Base>

<script is:inline>
  // Style filter + lightbox. Both are enhancement only: with JS off every
  // panel is visible (see .style-panel in the stylesheet below) and every
  // thumbnail is a plain link to the full-size file.
  (function () {
    var tabsWrap = document.querySelector("[data-style-tabs]");
    if (!tabsWrap) return;
    var tabs = [].slice.call(tabsWrap.querySelectorAll(".style-tab"));
    var panels = [].slice.call(document.querySelectorAll("[data-panel]"));
    document.documentElement.classList.add("has-style-filter");

    function playMotion(panel) {
      [].forEach.call(panel.querySelectorAll("video[data-motion-src]"), function (v) {
        if (!v.getAttribute("src")) {
          // Fetch metadata once attached so a first frame paints even where
          // autoplay is refused; without it the tile stays an empty box.
          v.preload = "metadata";
          v.setAttribute("src", v.dataset.motionSrc);
          v.load();
        }
        var p = v.play();
        if (p && p.catch) p.catch(function () {});
      });
    }
    function show(key) {
      tabs.forEach(function (t) {
        var on = t.dataset.style === key;
        t.classList.toggle("is-active", on);
        t.setAttribute("aria-selected", on ? "true" : "false");
      });
      panels.forEach(function (p) {
        var on = p.dataset.panel === key;
        p.classList.toggle("is-active", on);
        if (on) {
          playMotion(p);
        } else {
          [].forEach.call(p.querySelectorAll("video"), function (v) { v.pause(); });
        }
      });
      // Newly shown content has never been observed, so reveal it now.
      if (window.LWS && window.LWS.observe) {
        panels.forEach(function (p) {
          [].forEach.call(p.querySelectorAll(".reveal:not(.in)"), window.LWS.observe);
        });
      }
    }
    tabs.forEach(function (t) {
      t.addEventListener("click", function () { show(t.dataset.style); });
      t.addEventListener("keydown", function (e) {
        var i = tabs.indexOf(t);
        if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
          e.preventDefault();
          var n = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
          n.focus();
          show(n.dataset.style);
        }
      });
    });
    show(tabs[0].dataset.style);

    // ---- Lightbox ----
    var lb = document.getElementById("lb");
    var lbImg = document.getElementById("lb-img");
    var shots = [];
    var idx = 0;

    function currentShots() {
      var panel = document.querySelector("[data-panel].is-active") || document;
      return [].slice.call(panel.querySelectorAll("[data-lb]"));
    }
    function open(i) {
      shots = currentShots();
      idx = i;
      render();
      lb.hidden = false;
      lb.classList.add("is-open");
      lb.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }
    function close() {
      lb.hidden = true;
      lb.classList.remove("is-open");
      lb.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }
    function render() {
      var a = shots[idx];
      if (!a) return;
      lbImg.src = a.getAttribute("href");
      lbImg.alt = a.querySelector("img") ? a.querySelector("img").alt : "";
    }
    function step(d) {
      if (!shots.length) return;
      idx = (idx + d + shots.length) % shots.length;
      render();
    }

    document.addEventListener("click", function (e) {
      var a = e.target.closest ? e.target.closest("[data-lb]") : null;
      if (a) {
        e.preventDefault();
        open(currentShots().indexOf(a));
        return;
      }
      if (e.target.closest && e.target.closest("[data-lb-close]")) return close();
      if (e.target.closest && e.target.closest("[data-lb-prev]")) return step(-1);
      if (e.target.closest && e.target.closest("[data-lb-next]")) return step(1);
      if (!lb.hidden && e.target === lb) close();
    });
    document.addEventListener("keydown", function (e) {
      if (lb.hidden) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });
  })();
</script>

<style>
  /* ---- Filter chips ---- */
  .style-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin: 2rem 0 2.4rem;
  }
  .style-tab {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.6rem 1.15rem;
    cursor: pointer;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .style-tab:hover { color: var(--ink); border-color: var(--cyan); }
  .style-tab.is-active {
    color: var(--on-accent);
    background: var(--cyan);
    border-color: var(--cyan);
  }

  /* No-JS: every panel is visible and stacked. The script adds
     .has-style-filter to <html>, which is what turns filtering on. */
  .style-panel + .style-panel { margin-top: 3rem; }
  :global(html.has-style-filter) .style-panel { display: none; }
  :global(html.has-style-filter) .style-panel.is-active { display: block; margin-top: 0; }

  .style-note {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--cyan-soft);
    margin-bottom: 1.6rem;
    text-align: center;
  }

  /* ---- Section headings inside a panel ---- */
  .panel-sec {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 1.05rem;
    margin: 2.4rem 0 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line-2);
  }
  .panel-sec__num { font-family: var(--mono); font-size: 0.72rem; color: var(--cyan); }
  .panel-sec__hint {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--muted-2);
    margin-left: auto;
  }

  .cards-cat { margin-top: 1.6rem; }
  .cards-cat-title {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.7rem;
  }

  /* ---- Grids ---- */
  .shot-grid {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }
  .shot-grid--cards { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .shot-grid--motion { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }

  .lb-shot {
    display: block;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line-2);
    background: var(--panel);
    cursor: zoom-in;
    transition: transform 0.28s var(--ease), border-color 0.28s var(--ease), box-shadow 0.28s var(--ease);
  }
  /* The source files are five different shapes, so the TILE sets the ratio
     and the image covers it. Uniform grid, no cropping surprises mid-row. */
  .lb-shot { aspect-ratio: 3 / 4; }
  .lb-shot img, .style-motion {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lb-shot:hover, .lb-shot:focus-visible {
    transform: translateY(-3px);
    border-color: var(--cyan);
    box-shadow: var(--shadow-high);
  }
  .style-motion {
    aspect-ratio: 3 / 4;
    border-radius: var(--r-md);
    border: 1px solid var(--line-2);
    background: var(--panel);
  }

  /* ---- Lightbox ---- */
  /* Closed by default and opened by .is-open. Driving this off the [hidden]
     attribute instead does not work here: .lb's own display rule outranks the
     UA's [hidden]{display:none}, and the override gets scoped away. */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: clamp(1rem, 4vw, 3rem);
    background: rgba(5, 7, 11, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .lb.is-open {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
  }
  .lb-img {
    grid-column: 2;
    max-width: 100%;
    max-height: 88vh;
    margin: 0 auto;
    display: block;
    border-radius: var(--r-md);
  }
  .lb-close, .lb-prev, .lb-next {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--line);
    color: var(--ink);
    border-radius: 999px;
    width: 44px;
    height: 44px;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .lb-close:hover, .lb-prev:hover, .lb-next:hover {
    background: rgba(56, 189, 248, 0.16);
    border-color: var(--cyan);
  }
  .lb-close { position: absolute; top: 1rem; right: 1rem; }
  .lb-prev { grid-column: 1; }
  .lb-next { grid-column: 3; }

  @media (max-width: 700px) {
    .shot-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
    .shot-grid--cards, .shot-grid--motion { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
    .panel-sec__hint { margin-left: 0; width: 100%; }
  }
</style>
