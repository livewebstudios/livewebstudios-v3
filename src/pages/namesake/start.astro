---
/**
 * /namesake/start — ported from the live site (livewebstudios.com/namesake/start).
 * One folder deep (two dots up on imports). Wrapped in .theme-namesake for the
 * brass accent. No <img>: the live floating-portrait hero is dropped; the live
 * name-preview interaction is kept (pure JS, no backend). The intake FORM keeps
 * the EXACT live Formspree action, method, hidden fields, and every field
 * name= attribute, rebuilt on v3 form classes (form-pad Glass, form-row, field,
 * full, opt, form-actions). A v3-style honeypot (_gotcha) is added for spam
 * protection. EM DASH BAN applied to all ported copy.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import VideoBg from "../../components/VideoBg.astro";
import NamesakePreview from "../../components/NamesakePreview.tsx";
import { relPrefix } from "../../lib/relPrefix";

/* The island builds every font URL from this, so the preview keeps the LWS
   path rule at any depth. */
const rel = relPrefix(Astro.url.pathname);

// Live examples — ported from live "See it live" block (em dashes converted).
const examples = [
  {
    name: "jonwolfstudios.com",
    body: "Jon Wolf, developer, musician, and the builder behind Namesake. A spare, architectural personal site that carries his creative and technical worlds in one place.",
    href: "https://jonwolfstudios.com",
    go: "Visit the site →",
  },
  {
    name: "drrozcohen.com",
    body: "Dr. Roz Cohen of Socius Strategies, a warm, credible home for a speaker and consultant. Built to carry her voice on culture, belonging, and inclusion.",
    href: "https://drrozcohen.com",
    go: "Visit the site →",
  },
  {
    name: "Your site here",
    body: "Another name, another one-of-a-kind build. Watch this space.",
    href: null,
    go: "More coming soon",
  },
];
---

<Base
  title="Start Your Site | Namesake by Live Web Studios"
  description="Tell Namesake about you and get a personal site that's entirely your own. Start with your name."
  canonical="https://livewebstudios.com/namesake/start"
  ogImage="images/og-namesake.jpg"
>
  <Nav />

  <main class="theme-namesake">
    <!-- NAME-PREVIEW HERO -->
    <section class="page-head page-head--glass has-videobg ns-hero">
      <VideoBg src="bg-orange-beam-noaudio.mp4" scrim="hero" />
      <div class="wrap">
        {/* Two columns: the card on the left (headline, then the island's
            name field and style chips), the live preview on the right where
            the light streaks used to be. The island root is display:contents
            so its two regions become grid items here from one mount point.
            Stacks to one column at 900. */}
        <div class="ns-hero-grid">
          <div class="ns-hero-copy">
            <div class="chip"><span class="dot"></span> NAMESAKE · START HERE</div>
            <h1 class="page-h1">Start with your <em>name</em>.</h1>
            <p class="page-lede ns-micro">This is just a taste. Yours will be one of a kind.</p>
          </div>
          <NamesakePreview client:load base={rel} />
        </div>
      </div>
    </section>

    <!-- THE INTAKE FORM -->
    <section class="sec-pad">
      <div class="wrap ns-form-wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">THE INTAKE</span>
          <h2>Tell Namesake about you.</h2>
          <!-- em-dash: "an email — skip anything you want" → comma -->
          <p class="page-lede is-center">Nothing's required but a name and an email, skip anything you want. The more Namesake knows, the sharper the first draft. No wrong answers here.</p>
        </div>

        <Glass class="reveal" innerClass="form-pad">
          <!-- Live Formspree endpoint + hidden fields kept EXACT -->
          <form id="start-form" action="https://formspree.io/f/mlgkoqjl" method="POST">
            <input type="hidden" name="_subject" value="New Namesake inquiry" />
            {/* Carried from the preview generator above: which style the
                visitor landed on and the name they typed into it. The island
                keeps both current; it no-ops if they are ever removed. */}
            <input type="hidden" name="preview_style" value="" />
            <input type="hidden" name="preview_name" value="" />
            <input type="hidden" name="_next" value="https://livewebstudios.com/namesake/thank-you" />
            <!-- v3 honeypot: real users never see or fill this -->
            <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="field full">
              <label for="form-name">First, your name.</label>
              <input class="ns-input" id="form-name" name="name" type="text" autocomplete="name" required />
            </div>

            <div class="form-row">
              <div class="field">
                <label for="form-email">Email</label>
                <input class="ns-input" id="form-email" name="email" type="email" autocomplete="email" required />
              </div>
              <div class="field">
                <label for="form-phone">Phone <span class="opt">(optional)</span></label>
                <input class="ns-input" id="form-phone" name="phone" type="tel" autocomplete="tel" />
              </div>
            </div>

            <div class="field full">
              <label for="form-role">What do you do, and where? <span class="opt">(optional)</span></label>
              <input class="ns-input" id="form-role" name="title_company" type="text" placeholder="Founder at Acme · Partner at Smith &amp; Co · lead singer of…" />
            </div>

            <div class="field full">
              <span class="ns-legend">Which sounds most like you? <span class="opt">(optional)</span></span>
              <div class="ns-choices">
                <label class="ns-choice"><input type="radio" name="identity" value="Executive" /> Executive</label>
                <label class="ns-choice"><input type="radio" name="identity" value="Professional" /> Professional</label>
                <label class="ns-choice"><input type="radio" name="identity" value="Musician / Performer" /> Musician / Performer</label>
                <label class="ns-choice"><input type="radio" name="identity" value="Entrepreneur" /> Entrepreneur</label>
                <label class="ns-choice"><input type="radio" name="identity" value="Other" /> Other</label>
              </div>
            </div>

            <div class="field full">
              <label for="form-bio">Give Namesake the short version of who you are. <span class="opt">(optional)</span></label>
              <textarea class="ns-textarea" id="form-bio" name="short_bio"></textarea>
            </div>

            <div class="field full">
              <label for="form-outside">What lights you up outside the work? <span class="opt">(optional)</span></label>
              <input class="ns-input" id="form-outside" name="outside_work" type="text" />
            </div>

            <div class="field full">
              <!-- em-dash: "What drives you — the why behind it?" → comma -->
              <label for="form-why">What drives you, the why behind it? <span class="opt">(optional)</span></label>
              <textarea class="ns-textarea" id="form-why" name="why"></textarea>
            </div>

            <div class="field full">
              <!-- em-dash: "What's next — the longer view" → comma -->
              <label for="form-toward">What are you building toward? <span class="opt">What's next, the longer view (optional)</span></label>
              <textarea class="ns-textarea" id="form-toward" name="building_toward"></textarea>
            </div>

            <div class="field full">
              <label for="form-goal">What should this site do for you? <span class="opt">(optional)</span></label>
              <textarea class="ns-textarea" id="form-goal" name="site_goal"></textarea>
            </div>

            <div class="field full">
              <label for="form-inspo">Sites you love the look of. <span class="opt">Paste a few links (optional)</span></label>
              <textarea class="ns-textarea" id="form-inspo" name="inspiration"></textarea>
            </div>

            <div class="field full">
              <label for="form-social">Where can people find you? <span class="opt">Social links (optional)</span></label>
              <textarea class="ns-textarea" id="form-social" name="social_links"></textarea>
            </div>

            <div class="field full">
              <span class="ns-legend">Photos? <span class="opt">(optional)</span></span>
              <div class="ns-choices">
                <label class="ns-choice"><input type="radio" name="photos" value="I have professional photos" /> I have professional photos</label>
                <label class="ns-choice"><input type="radio" name="photos" value="I'll need help with imagery" /> I'll need help with imagery</label>
              </div>
            </div>

            <div class="field full">
              <span class="ns-legend">Do you already own a domain? <span class="opt">(optional)</span></span>
              <div class="ns-choices">
                <label class="ns-choice"><input type="radio" name="has_domain" value="Yes" /> Yes</label>
                <label class="ns-choice"><input type="radio" name="has_domain" value="Not yet" /> Not yet</label>
              </div>
              <label for="form-domain" class="opt ns-domain-label">If yes, what is it?</label>
              <input class="ns-input" id="form-domain" name="domain_name" type="text" placeholder="yourname.com" />
            </div>

            <div class="field full">
              <label for="form-else">Anything else? <span class="opt">Your vision, must-haves, ideas (optional)</span></label>
              <textarea class="ns-textarea" id="form-else" name="anything_else"></textarea>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Send it over →</button>
            </div>
            <!-- em-dash: "straight to Jon — and his number's on the site" → comma -->
            <p class="ns-form-note">No spam, ever. It goes straight to Jon, and his number's on the site if you'd rather just call.</p>
          </form>
        </Glass>
      </div>
    </section>

    <!-- EXAMPLES -->
    <section class="sec-pad is-alt">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">THE PROOF</span>
          <h2>See it live.</h2>
        </div>
        <div class="trio">
          {examples.map((e) => (
            e.href ? (
              <a class="glass-inner card-pad reveal" href={e.href} target="_blank" rel="noopener noreferrer">
                <h3>{e.name}</h3>
                <p>{e.body}</p>
                <span class="more">{e.go}</span>
              </a>
            ) : (
              <div class="glass-inner card-pad reveal">
                <h3>{e.name}</h3>
                <p>{e.body}</p>
                <span class="more">{e.go}</span>
              </div>
            )
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />

  {/* The old big-type echo and its inline script are gone: NamesakePreview
      owns that region of the hero now and renders a whole page instead of a
      line of type. */}
</Base>

<style>
  /* Brass sub-brand theming — token override reproduced from namesake.astro. */
  .theme-namesake {
    --cyan: #c9a55a;
    --cyan-soft: #e3cb8b;
    --cyan-2: #a9863c;
    --cyan-deep: #4a3a12;
    --on-accent: #1a1206;
    --line: rgba(201, 165, 90, 0.16);
    --line-2: rgba(201, 165, 90, 0.08);
    /* global.css ships --line-field as the 3:1 token for anything you type
       into, but leaves it blue. The sub-brand overrides --line without it,
       so the form was inheriting a cyan-tinted field border into a brass
       page. Restated in brass at the same weight, so the contrast rule and
       the accent agree instead of one undoing the other. */
    --line-field: rgba(216, 184, 114, 0.46);
  }

  /* ---- Two-column preview hero -------------------------------------
     .page-head is centred and .page-head--glass shrinks its .wrap to
     fit-content, both of which are right for a hero that is a block of
     copy and wrong for one that is a card beside a 16:10 preview. Both
     are overridden here only, scoped to .ns-hero, so every other
     page-head on the site is untouched. */
  .ns-hero > .wrap {
    width: min(100%, var(--wrap));
  }

  .ns-hero-grid {
    display: grid;
    grid-template-columns: minmax(300px, 400px) minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 1.5rem 2.75rem;
    align-items: start;
    text-align: left;
  }

  /* The island is display:contents, so these two become grid items here.
     Two things to know about the selectors:
       1. React output carries no Astro scope attribute, so they need :global.
       2. They must be DESCENDANT, not child, selectors. display:contents
          removes .nsp-root's box from layout but leaves it in the DOM tree,
          so it is still the direct child and `>` matches nothing. Written
          with `>` these silently no-op and the three items auto-place into
          the wrong cells. */
  .ns-hero-grid > .ns-hero-copy { grid-column: 1; grid-row: 1; }
  .ns-hero-grid :global(.nsp-controls) { grid-column: 1; grid-row: 2; }
  .ns-hero-grid :global(.nsp-stage) { grid-column: 2; grid-row: 1 / span 2; }

  /* .page-h1 and .page-lede centre themselves with auto side margins. */
  .ns-hero-grid :global(h1.page-h1) { margin-inline: 0; }
  .ns-hero-copy .page-lede { margin-inline: 0; }
  .ns-micro { margin-top: 1rem; }

  @media (max-width: 900px) {
    .ns-hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .ns-hero-grid > .ns-hero-copy,
    .ns-hero-grid :global(.nsp-controls),
    .ns-hero-grid :global(.nsp-stage) {
      grid-column: 1;
      grid-row: auto;
    }
  }

  /* ---- Intake form ----------------------------------------------------
     Jon 2026-09-14: "give the form a bit more contrast, some color,
     professional."

     The fields were reading as empty space. This rule used to set
     `border: 1px solid var(--line)`, and --line is the DECORATIVE hairline
     (brass at .16 alpha, about 1.2:1). global.css is explicit that form
     controls take --line-field instead, at 3:1, for exactly this reason,
     and the page was overriding that back down. The well was also lighter
     than the page, which flattened it; a recessed dark well with a lit edge
     reads as something you type into. */
  .ns-form-wrap { max-width: 820px; margin-inline: auto; }

  /* A brass rule across the head of the panel: the color Jon asked for, in
     the one place it does not compete with the fields. */
  .ns-form-wrap :global(.form-pad) {
    border-top: 2px solid var(--cyan);
  }

  .ns-input,
  .ns-textarea {
    width: 100%;
    background: rgba(4, 6, 10, 0.66);
    border: 1px solid var(--line-field);
    border-radius: var(--r-md, 12px);
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 0.98rem;
    padding: 0.8rem 0.95rem;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease),
      background 0.2s var(--ease);
  }
  .ns-textarea { resize: vertical; min-height: 130px; }
  .ns-input::placeholder,
  .ns-textarea::placeholder { color: var(--muted-2); opacity: 1; }
  .ns-input:hover,
  .ns-textarea:hover { border-color: rgba(216, 184, 114, 0.68); }
  .ns-input:focus,
  .ns-textarea:focus {
    outline: none;
    border-color: var(--cyan);
    background: rgba(4, 6, 10, 0.85);
    box-shadow: 0 0 0 3px rgba(201, 165, 90, 0.2);
  }

  /* Labels carried --muted, which is tuned for body copy, not for the one
     word telling you what a field wants. */
  .ns-form-wrap :global(.field label) { color: var(--ink); }

  /* Radio choice groups (live used fieldset/legend). */
  .ns-legend {
    display: block;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 0.7rem;
  }
  .ns-choices { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .ns-choice {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--line-field);
    border-radius: 999px;
    background: rgba(4, 6, 10, 0.5);
    color: var(--ink);
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .ns-choice:hover {
    border-color: var(--cyan);
    background: rgba(201, 165, 90, 0.08);
  }
  /* The chosen one should be obvious at a glance, not a filled dot you have
     to hunt for. Brass fill, same accent as the rest of the sub-brand. */
  .ns-choice:has(input:checked) {
    border-color: var(--cyan);
    background: rgba(201, 165, 90, 0.16);
    color: var(--ink-soft);
  }
  .ns-choice:focus-within {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }
  .ns-choice input { accent-color: var(--cyan); }
  .ns-domain-label { display: block; margin-top: 0.9rem; margin-bottom: 0.4rem; }
  .ns-form-note { color: var(--muted-2); font-size: 0.88rem; margin-top: 1rem; }

  /* Honeypot: visually hidden, off-screen. */
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
</style>
