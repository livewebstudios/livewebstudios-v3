---
/**
 * /blog — blog index, statically rendered from the blog content collection
 * (src/content/blog). Replaces the old client-side blog.js/JSON approach,
 * which was the reason posts weren't getting indexed: Google saw an empty
 * shell. Now every card is real HTML at build time, and Decap writes new
 * posts straight into the collection folder.
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import VideoBg from "../components/VideoBg.astro";
import BlogHero from "../components/BlogHero.astro";
import CategoryNav from "../components/CategoryNav.astro";
import Glass from "../components/Glass.astro";
import { CATEGORIES, resolve, has } from "../lib/categories";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Only offer a chip for a category that actually has a page built behind it.
const available = CATEGORIES.filter((c) =>
  posts.some((p) => has(p.data.categories, c.name)),
).map((c) => c.slug);

const cards = posts.map((post) => {
  const slug = post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "");
  const rawImage = post.data.image ?? post.data.thumbnail ?? "";
  return {
    slug,
    title: post.data.title,
    summary: post.data.description ?? post.data.excerpt ?? "",
    cats: resolve(post.data.categories),
    image: rawImage.replace(/^\//, ""),
    dateLabel: post.data.date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      timeZone: "UTC",
    }),
  };
});
---

<Base
  title="Blog | Live Web Studios, North Jersey Web Design & AI Builds"
  description="Notes on web design, hosting, local SEO, and AI-platformed builds from Jon Wolf at Live Web Studios in North Jersey."
  canonical="https://livewebstudios.com/blog"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <BlogHero title="Ideas, Insights, and Occasionally Opinions." standing />


    <CategoryNav available={available} isIndex />

    <!-- POSTS -->
    <section class="sec-pad">
      <div class="wrap">

        <div class="blog-grid">
          {cards.map((c) => (
            <a class="blog-card" href={`blog/${c.slug}.html`}>
              {c.image ? (
                <div class="blog-thumb">
                  <img src={c.image} alt={c.title} loading="lazy" />
                </div>
              ) : (
                <div class="blog-thumb--empty"><span>LWS</span></div>
              )}
              <div class="blog-meta">
                <span class="blog-date">{c.dateLabel}</span>
                <h2 class="blog-title">{c.title}</h2>
                <p class="blog-sum">{c.summary}</p>
                <span class="blog-cats">
                  {c.cats.map((k) => <span class="blog-cat">{k.name}</span>)}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad is-alt has-videobg">
      <VideoBg src="bg-orange-beam-noaudio.mp4" scrim="default" />
      <div class="wrap">
        <Glass class="reveal" innerClass="cta glass-refract">
          <span class="eyebrow is-center mb-md">GOT A PROJECT?</span>
          <h2>Less reading, more building.</h2>
          <div class="hero-btns">
            <a href="contact.html" class="btn btn-primary">Let's talk. →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
