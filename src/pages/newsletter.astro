---
/**
 * /newsletter — ported from livewebstudios.com/newsletter. EM DASH BAN applied.
 *
 * 2026-10-13: no longer posts to Mailchimp directly. Bots were posting to the
 * list-manage.com URL in the page source, so the form now goes to the Netlify
 * subscribe function (Turnstile check, then Mailchimp double opt-in). The
 * submit script lives in Footer.astro and handles every form carrying
 * data-newsletter. data-turnstile-eager loads Turnstile on page load here,
 * since this page exists to be signed up on; the footer form waits for focus.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Glass from "../components/Glass.astro";
import VideoBg from "../components/VideoBg.astro";
import Marquee from "../components/Marquee.astro";
import HeroActions from "../components/HeroActions.astro";
import { relPrefix } from "../lib/relPrefix";
import { TURNSTILE_SITE_KEY, subscribeAction } from "../lib/newsletter";

const rel = relPrefix(Astro.url.pathname);
---

<Base
  title="Sign Up for Our Newsletter | Live Web Studios"
  description="Get web, AI, and workflow tips from Live Web Studios, straight to your inbox. Sign up in a few seconds."
  canonical="https://livewebstudios.com/newsletter"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-looping-waves.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">NEWSLETTER</span>
        <h1 class="page-h1">Get the <em>Newsletter</em>.</h1>
        <p class="page-lede">Web, AI, and the occasional music-tech tangent. No spam, no nonsense, unsubscribe whenever.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- SIGNUP -->
    <section class="sec-pad has-videobg">
      <VideoBg src="bg-corner.mp4" scrim="strong" />
      <div class="wrap">
        <Glass class="reveal" innerClass="form-pad">
          <span class="eyebrow is-center mb-md">JOIN THE NEWSLETTER</span>

          <form
            id="newsletterForm"
            action={subscribeAction(rel)}
            method="post"
            novalidate
            data-newsletter
            data-turnstile-eager
          >
            <div class="field full">
              <label for="mce-FNAME">First name <span class="opt">(optional)</span></label>
              <input id="mce-FNAME" type="text" name="FNAME" autocomplete="given-name" placeholder="First name" />
            </div>

            <div class="field full">
              <label for="mce-EMAIL">Email address</label>
              <input id="mce-EMAIL" type="email" name="EMAIL" required autocomplete="email" placeholder="you@yourcompany.com" />
            </div>

            <!-- Bot trap, checked by the subscribe function. Off-screen, never display:none. -->
            <div class="hp" aria-hidden="true">
              <input type="text" name="website" tabindex="-1" autocomplete="off" value="" />
            </div>

            <div class="nl-challenge" data-sitekey={TURNSTILE_SITE_KEY}></div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary" id="newsletterSubmit">Sign Me Up →</button>
            </div>

            <p class="nl-error" role="alert" hidden></p>
            <p class="opt" style="margin-top:1rem">We'll never sell or share your email. One click to unsubscribe, always.</p>

            <template data-done>
              <div class="nl-done" tabindex="-1">
                <strong>One more step. Check your inbox.</strong>
                <p>We just sent you a confirmation email. Click the link in it and you're on the list. Nothing else arrives until you do.</p>
                <p>Not there in a few minutes? Look in spam or promotions for an email from Live Web Studios.</p>
              </div>
            </template>
          </form>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
