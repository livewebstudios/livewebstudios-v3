---
/**
 * /pricing/seo-pricing — ported from livewebstudios.com. Content verbatim.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import VideoBg from "../../components/VideoBg.astro";

const tiers = [
  {
    name: "Basic",
    price: "$525",
    unit: " /mo",
    featured: false,
    items: ["Local keyword targeting", "Google Business Profile", "On-page tune-up", "Monthly report"],
  },
  {
    name: "Standard",
    price: "$975",
    unit: " /mo",
    featured: true,
    badge: "MOST POPULAR",
    items: ["Everything in Basic", "Expanded keywords", "Monthly content (1 piece)", "Competitor analysis", "Citations", "Priority support"],
  },
  {
    name: "Premium",
    price: "$1,525",
    unit: " /mo",
    featured: false,
    items: ["Everything in Standard", "Full content marketing", "Link building", "Conversion tracking", "Quarterly strategy"],
  },
];
---

<Base
  title="SEO Pricing | Live Web Studios"
  description="SEO plans from Live Web Studios. Basic $525/mo, Standard $975/mo, Premium $1,525/mo. Local SEO, content, and reporting. No long-term contracts."
  canonical="https://livewebstudios.com/pricing/seo-pricing"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head has-videobg">
      <VideoBg src="bg-corner.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">SEO PRICING</span>
        <h1 class="page-h1">SEO <em>Pricing</em>.</h1>
        <p class="page-lede">Honest ranges. No long-term contracts.</p>
      </div>
    </section>

    <!-- TIERS -->
    <section class="sec-pad has-videobg">
      <VideoBg src="bg-looping-waves.mp4" scrim="default" />
      <div class="wrap">
        <div class="grid-svc trio">
          {tiers.map((t) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                {t.featured && <span class="tag-new">{t.badge}</span>}
                <h3>{t.name}</h3>
                <p class="kick">{t.price}<span class="label">{t.unit}</span></p>
                <ul>
                  {t.items.map((i) => <li>{i}</li>)}
                </ul>
                <a class="more" href="../contact.html">GET STARTED →</a>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad is-alt">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">WANT THE FULL BREAKDOWN?</span>
          <h2>See what's inside every tier.</h2>
        </div>
        <div class="hero-btns reveal">
          <a href="../services/seo.html" class="btn btn-primary">SEO Plans in Detail →</a>
          <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
