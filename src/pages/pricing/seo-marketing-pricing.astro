---

<Base
  title="SEO & AI-Powered Marketing Pricing | Live Web Studios"
  description="SEO and AI-optimized marketing packages for NJ/NY small businesses. Starter $750/mo, Growth $1,500/mo, Authority $2,500/mo. AEO/GEO, content, local SEO."
  canonical="https://livewebstudios.com/pricing/seo-marketing-pricing"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head has-videobg">
      <VideoBg src="bg-looping-waves.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">PRICING</span>
        <h1 class="page-h1">SEO &amp; AI-Powered <em>Marketing</em>.</h1>
        <p class="page-lede">Boost Visibility. Drive Traffic. Dominate AI Search. Achieve Results.</p>
        <p class="page-lede">Live Web Studios delivers expert SEO and AI-optimized marketing services for small businesses across NJ and NY. From local search dominance to AI answer engine visibility, we build strategies that drive real leads, not vanity metrics.</p>
        <div class="hero-btns">
          <a href="../contact.html" class="btn btn-primary">Get Your Free Audit →</a>
          <a href="#addons" class="btn btn-ghost">View Add-Ons</a>
        </div>
      </div>
    </section>

    <!-- MONTHLY PACKAGES -->
    <section class="sec-pad has-videobg">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">MONTHLY PACKAGES</span>
          <h2>Choose Your Growth Level</h2>
          <p>All packages include a 3-month minimum commitment and a free kick-off audit.</p>
        </div>
        <div class="grid-svc trio">
          {tiers.map((t) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                {t.featured && <span class="tag-new">MOST POPULAR</span>}
                <h3>{t.name}</h3>
                <p class="kick">{t.price}<span class="label"> /mo</span></p>
                <p>{t.sub}</p>
                <ul>
                  {t.items.map((i) => <li>{i}</li>)}
                </ul>
                <a class="more" href="../contact.html">GET STARTED →</a>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ADD-ONS -->
    <section class="sec-pad is-alt" id="addons">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">ADD-ON SERVICES</span>
          <h2>Customize Your Package</h2>
          <p>Available as standalone services or paired with any monthly package.</p>
        </div>
        <div class="grid-svc">
          {addons.map((a) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{a.name}</h3>
                <p class="kick"><span class="label">{a.price}</span></p>
                <p>{a.body}</p>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WHY AI SEARCH MATTERS -->
    <section class="sec-pad has-videobg">
      <VideoBg src="bg-orange-beam-noaudio.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">THE NEW REALITY</span>
          <h2>Why AI Search Matters Now</h2>
          <p>The rules of search have changed. Here's what your business needs to know.</p>
        </div>
        <div class="grid-svc">
          {reality.map((r) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{r.h}</h3>
                <p>{r.body}</p>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad is-alt">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">LET'S TALK</span>
          <h2>Ready to grow?</h2>
          <p>Every engagement starts with a free 30-minute consultation and site audit. Let's talk about where you are and where you want to be.</p>
        </div>
        <div class="hero-btns reveal">
          <a href="../contact.html" class="btn btn-primary">Get Your Free Audit →</a>
          <a href="mailto:jonwolf@livewebstudios.com" class="btn btn-ghost">jonwolf@livewebstudios.com</a>
        </div>
        <p class="pricing-fineprint reveal">All packages require a 3-month minimum commitment. Prices effective April 2026.</p>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .pricing-fineprint {
    margin-top: 2rem;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--muted-2);
  }
</style>
