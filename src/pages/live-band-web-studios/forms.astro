---
/**
 * /live-band-web-studios/forms: the hub for the four client form pages.
 *
 * Gold Rack redesign (2026-11-15): four numbered icon MiniCards in a
 * two-column grid, the "goes to Jon" note on a small plate with an amber LED,
 * then the shared SEO rack and closing CTA plate. Copy and links unchanged.
 */
import LiveBandLayout from "../../layouts/LiveBandLayout.astro";
import PhotoBg from "../../components/PhotoBg.astro";
import PageHero from "../../components/lbws/PageHero.astro";
import MiniCard from "../../components/lbws/MiniCard.astro";
import Plate from "../../components/lbws/Plate.astro";
import Led from "../../components/lbws/Led.astro";
import SeoRack from "../../components/lbws/SeoRack.astro";
import CtaPlate from "../../components/lbws/CtaPlate.astro";

// Form cards: hub links to the four form pages (em dashes converted).
const forms = [
  {
    icon: "doc" as const,
    badge: "New Bands, Start Here",
    title: "Band Bio Form",
    body: "Fill this out before we start the build. The more detail you give us, the less back-and-forth we do over email. This goes to Jon directly. He reads every one.",
    href: "forms/band-bio-form.html",
    cta: "Fill Out the Band Bio Form",
  },
  {
    icon: "person" as const,
    badge: "Individual Members",
    title: "Band Member Bio Form",
    body: "One form per band member. Covers your gear, your history, your influences, your story. Fill in what you've got. The more you give us, the better your bio page and EPK copy will be.",
    href: "forms/band-member-bio-form.html",
    cta: "Fill Out the Member Bio Form",
  },
  {
    icon: "camera" as const,
    badge: "Photos & AI Imagery",
    title: "Music Photo Form",
    body: "Musician intake & photo guide. Tell us your visual vibe, then follow the photo guide to shoot reference shots we'll turn into press photos, EPK images, and AI-generated scenes, all in your look.",
    href: "forms/music-photo-form.html",
    cta: "Fill Out the Music Photo Form",
  },
  {
    icon: "bulb" as const,
    badge: "Before You Shoot",
    title: "Music Photo Instructions",
    body: "The companion guide to the Music Photo Form. Lighting, angles, expressions, wardrobe, and how to send your reference shots at full resolution. Read it before you pick up the phone and start shooting.",
    href: "forms/how-to-photograph-yourself-for-ai.html",
    cta: "Read the Photo Instructions",
  },
];
---

<LiveBandLayout
  title="Forms | Live Band Web Studios"
  description="Band bio form and member bio form for Live Band Web Studios clients."
  canonical="https://livewebstudios.com/live-band-web-studios/forms"
  ogImage="images/og-live-band.jpg"
  preloadHero="lbws_bluestage.jpg"
>
  <PageHero eyebrow="CLIENT FORMS" sub="Fill in what you've got. Skip what you don't. We'll figure out the rest together.">
    <PhotoBg slot="media" src="lbws_bluestage.jpg" scrim="hero" alt="An empty concert stage under teal spotlights and haze: a grand piano, a drum kit on a riser, three electric guitars on stands, and a wall of amplifiers and road cases." />
    Forms<span class="lb-gold">.</span>
    <p slot="after" class="lb-mono lb-mono--sm lb-forms__note" data-hero-in>Everything is optional. No required fields. No asterisks. No pressure.</p>
  </PageHero>

  <section class="lb-section" aria-labelledby="forms-h">
    <div class="lb-container">
      {/* Structural only: the cards below are h3s with nothing between them
          and the page h1 (launch audit 2026-09-15). Hidden so the page gains
          no new visible copy. */}
      <h2 class="lb-vh" id="forms-h">The forms</h2>
      <ul role="list" class="lb-grid-2">
        {forms.map((f, i) => (
          <MiniCard
            icon={f.icon}
            num={String(i + 1).padStart(2, "0")}
            kicker={`${String(i + 1).padStart(2, "0")} · ${f.badge}`}
            title={f.title}
            line={f.body}
            href={f.href}
            more={f.cta}
          />
        ))}
      </ul>
      <Plate class="lb-forms__jon" data-reveal>
        <Led />
        <p>Every form here goes directly to Jon Wolf at <a class="lb-inline-link" href="../contact.html">jonwolf@livewebstudios.com</a>. No auto-responder. No chatbot. A real person gets this.</p>
      </Plate>
    </div>
  </section>

  <SeoRack lede="Getting you found is a core part of what we do, every site is engineered to rank, and we keep working it after launch." />

  <CtaPlate />
</LiveBandLayout>

<style>
  .lb-forms__note { color: var(--lb-parchment); }
  .lb-container :global(.lb-forms__jon) {
    display: flex;
    align-items: baseline;
    gap: var(--lb-s-4);
    margin-top: var(--lb-s-8);
    padding: var(--lb-s-6) var(--lb-s-8);
  }
  .lb-container :global(.lb-forms__jon) p { color: var(--lb-parchment); max-width: none; }
  .lb-inline-link { color: var(--lb-brass); text-underline-offset: 0.25em; }
  .lb-inline-link:hover { color: var(--lb-brass-bright); }
</style>
