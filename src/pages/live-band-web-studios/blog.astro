---
/**
 * /live-band-web-studios/blog — the musician-marketing blog index.
 *
 * Same collection, same card markup and same chip component as /blog. The only
 * things that differ are `audience: "musicians"` and the .theme-live-band
 * wrapper that re-skins the shared chrome amber. Nothing is forked.
 *
 * One level deep, so every asset and link reference needs "../" to reach the
 * site root per the LWS path rule. The shared chrome works that out itself
 * through relPrefix.
 */
import LiveBandLayout from "../../layouts/LiveBandLayout.astro";
import BandBlogHero from "../../components/BandBlogHero.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import DayJob from "../../components/DayJob.astro";
import PostCta from "../../components/PostCta.astro";
import HoldButton from "../../components/lbws/HoldButton.astro";
import Plate from "../../components/lbws/Plate.astro";
import Led from "../../components/lbws/Led.astro";
import Arrow from "../../components/lbws/Arrow.astro";
import CtaPlate from "../../components/lbws/CtaPlate.astro";
import { byAudience, resolve, has } from "../../lib/categories";
import { getPosts, slugOf, bandImage } from "../../lib/posts";
import { relPrefix } from "../../lib/relPrefix";

const rel = relPrefix(Astro.url.pathname);

/* Musician posts only, drafts dropped, anything dated after this build
   excluded. The drip schedule lives entirely in that last rule. */
const posts = await getPosts("musicians");

const available = byAudience("musicians")
  .filter((c) => posts.some((p) => has(p.data.categories, c.name)))
  .map((c) => c.slug);

const cards = posts.map((post) => {
  const cats = resolve(post.data.categories);
  const raw = bandImage(post, cats.map((c) => c.slug));
  return {
    slug: slugOf(post),
    title: post.data.title,
    summary: post.data.description ?? post.data.excerpt ?? "",
    cats,
    image: raw ? `${rel}${raw.replace(/^\//, "")}` : "",
    imageAlt: post.data.imageAlt ?? "",
    /* Gold Rack date plate: month over day, year for screen readers. */
    month: post.data.date.toLocaleDateString("en-US", { month: "short", timeZone: "UTC" }).toUpperCase(),
    day: post.data.date.toLocaleDateString("en-US", { day: "2-digit", timeZone: "UTC" }),
    year: post.data.date.getUTCFullYear(),
    dateLabel: post.data.date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      timeZone: "UTC",
    }),
  };
});
---

<LiveBandLayout
  title="Musician Marketing Blog | Live Band Web Studios"
  description="Getting booked is a marketing job. Plain-English help with band websites, EPKs, social posts, email lists, and AI for working musicians."
  canonical="https://livewebstudios.com/live-band-web-studios/blog"
  ogImage="images/og-live-band.jpg"
>
  {/* Hero layout and the animated Jon are untouched; the Gold Rack only
      restyles the type and buttons and adds the hold button. */}
  <BandBlogHero title="Getting Booked Is a Marketing Job." gold="Marketing Job." standing video>
    <HoldButton />
  </BandBlogHero>

  <CategoryNav available={available} isIndex audience="musicians" />

  <section class="lb-section" id="posts" aria-label="Posts">
    <div class="lb-container">
      <div class="lb-grid-2">
        {cards.map((c) => (
          <a class="lb-post" href={`blog/${c.slug}.html`} data-reveal>
            <span class="lb-nameplate lb-post__date"><span>{c.month}</span><b>{c.day}</b><span class="lb-vh">, {c.year}</span></span>
            <div class="lb-post__body">
              <span class="lb-post__cat lb-mono">{c.cats.map((k) => k.name).join(" · ")}</span>
              <h2 class="lb-post__title">{c.title}</h2>
              <p class="lb-post__sum">{c.summary}</p>
              <span class="lb-mini__more lb-mono" aria-hidden="true">READ <Arrow /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Jon 2026-09-15: the index closes the way a post does. Same blocks, same
      order, now each on its own plate. */}
  <section class="lb-section lb-section--tight" aria-label="About this blog">
    <div class="lb-container">
      <Plate variant="raised" class="lb-blogplate" data-reveal>
        <Led class="lb-blogplate__led" />
        <PostCta />
      </Plate>
      <Plate class="lb-blogplate" data-reveal>
        <DayJob variant="compact" />
      </Plate>
      <Plate class="lb-blogplate" data-reveal>
        <DayJob />
      </Plate>
    </div>
  </section>

  <CtaPlate />
</LiveBandLayout>

<style>
  .lb-section--tight { padding-block: calc(var(--lb-section-y) * 0.5); }
  .lb-container :global(.lb-blogplate__led) { margin-bottom: var(--lb-s-4); }
</style>
