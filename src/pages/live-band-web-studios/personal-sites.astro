---
/**
 * /live-band-web-studios/personal-sites — ported from the live site
 * (livewebstudios.com/live-band-web-studios/personal-sites). One folder deep
 * (two dots up on imports). Wrapped in .theme-live-band for the amber accent
 * (token override reproduced in scoped <style>). No <img>: live hero video +
 * bg photos dropped for page-head + VideoBg / flat sections. Tabler icon font
 * (external CDN) dropped for glyphs. EM DASH BAN applied to all ported copy.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import VideoBg from "../../components/VideoBg.astro";
import PhotoBg from "../../components/PhotoBg.astro";

// What every personal site includes — ported from live (5 cards).
// Jon 2026-09-15: a photo fills the top of every card (Higgsfield, real-life
// live-musician shots) in place of the glyph. Files are lbws_ps-*.jpg.
const includes = [
  { img: "lbws_ps-bio.jpg", alt: "Session guitarist backstage in a theater dressing room", title: "Bio Page", body: "Your story. Where you've been. What you play. Who you've played with. Written in plain English by someone who understands what a session player's résumé actually looks like." },
  { img: "lbws_ps-touring.jpg", alt: "Musician loading gear into a van outside a theater at dusk", title: "Touring Page", body: "Past markets. Notable venues. Tour history. Booking contact. The page that tells a promoter or talent buyer exactly where you've worked and who to call." },
  { img: "lbws_ps-media.jpg", alt: "Keyboard player and drummer under stage lights", title: "Media Page", body: "YouTube embeds. Audio clips. Press photos. Your best live footage front and center, not buried three clicks deep." },
  { img: "lbws_ps-photos.jpg", alt: "Bassist and singer on stage, shot from the photo pit", title: "Photos Page", body: "High-res gallery. Press shots. Live shots. The photos a venue, promoter, or publication would actually need." },
  { img: "lbws_ps-contact.jpg", alt: "Musician backstage on a road case checking his phone", title: "Contact Page", body: "One clean contact form. Your booking email. Your management contact if applicable. No noise." },
];

// Who this is for — role pills.
const roles = [
  "Sidemen", "Session Players", "Touring Keyboardists", "Guitarists", "Drummers",
  "Bassists", "Vocalists", "Bandleaders", "Music Directors", "Producers",
  "Songwriters", "Solo Artists", "Tribute Act Members",
];

// Merch pills.
const merch = ["T-Shirts", "Hats", "Posters", "CDs", "Vinyl", "Signed Merch", "Digital Downloads"];

// SEO cards — shared Live Band SEO block (em dashes converted).
const seo = [
  { ico: "⟨⟩", title: "Schema & Meta, Done Right", body: "Structured data (schema markup), clean meta tags, and the right title and description on every page, so search engines understand exactly who you are and where you play." },
  { ico: "◎", title: "The Words People Type", body: "We target the real search words and key phrases fans and talent buyers actually search, your genre, your cities, your venues, woven through every page." },
  { ico: "▤", title: "Blog Articles Engines Love", body: "Fresh articles every month, show recaps, new markets, gear talk, the steady, keyword-rich content search engines reward with higher rankings." },
];
---

<Base
  title="Personal Musician Sites | Live Band Web Studios"
  description="Your name. Your domain. Custom websites for individual musicians, built by someone who's been on the road. Bio, touring, media, merch, and more."
  canonical="https://livewebstudios.com/live-band-web-studios/personal-sites"
  ogImage="images/og-live-band.jpg"
>
  <Nav />

  <main class="theme-live-band">
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass page-head--bare has-videobg">
      <PhotoBg src="lbws_bluestage.jpg" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">A SERVICE OF LIVE BAND WEB STUDIOS</span>
        <h1 class="page-h1">Your Name. <em>Your Site</em>.</h1>
        <p class="page-lede">Custom websites for the working musician. You're more than a band member. You've been in the circuit long enough to know that your name is a brand. A Facebook page isn't a website. A Linktree isn't a presence. We build you something that actually represents what you do, and where you've been.</p>
        <div class="hero-btns is-center mt-lg">
          <a class="btn btn-primary" href="../contact.html">Talk to Jon →</a>
        </div>
      </div>
    </section>

    <!-- WHAT EVERY PERSONAL SITE INCLUDES -->
    <section class="sec-pad">
      <div class="wrap">
        <div class="sec-head center reveal">
          <h2>What Every Personal Site Includes</h2>
        </div>
        <div class="grid-svc">
          {includes.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <div class="card-img"><img src={`../images/${c.img}`} alt={c.alt} width="1024" height="688" loading="lazy" decoding="async" /></div>
                <h3>{c.title}</h3>
                <p>{c.body}</p>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ADD-ONS -->
    <section class="sec-pad is-alt">
      <div class="wrap">
        <div class="sec-head center reveal">
          <h2>Add-Ons, Built for Working Musicians</h2>
          <p class="page-lede is-center">Pricing is consultation-based. These are the options.</p>
        </div>
        <div class="grid-svc grid-svc--2">
          <div class="card reveal">
            <Glass variant="inner" innerClass="card-pad">
              <div class="card-img"><img src="../images/lbws_ps-blog.jpg" alt="Touring musician writing in a notebook at a diner booth" width="1024" height="688" loading="lazy" decoding="async" /></div>
              <h3>Blog Articles</h3>
              <!-- em-dash: "written by Jon in your voice — tour updates" → comma -->
              <p>Monthly posts written by Jon in your voice, tour updates, gear talk, behind-the-scenes. Local SEO that gets your name in front of people searching for players in your markets. The kind of content that makes you look like you're everywhere.</p>
              <p class="addon-note">Add-on · Consultation pricing</p>
            </Glass>
          </div>
          <div class="card reveal">
            <Glass variant="inner" innerClass="card-pad">
              <div class="card-img"><img src="../images/lbws_ps-merch.jpg" alt="Band merch table in a concert venue lobby" width="1024" height="688" loading="lazy" decoding="async" /></div>
              <h3>Merch Store</h3>
              <!-- em-dash: "Whatever you're selling — we build" → comma -->
              <p>T-shirts. Hats. Posters. CDs. Vinyl. Whatever you're selling, we build a clean, functional store into your personal site. No WooCommerce sprawl. No plugin roulette. A real storefront that works on every device.</p>
              <div class="pills">
                {merch.map((m) => <span class="pill">{m}</span>)}
              </div>
              <p class="addon-note">Add-on · Consultation pricing</p>
            </Glass>
          </div>
        </div>
      </div>
    </section>

    <!-- PRICING + DOMAIN + WHO THIS IS FOR (one section, Jon 2026-09-15:
         "too wordy"). The three sections that used to run here are folded into
         one split: copy on the left, a solo-act home page demo on the right. -->
    <section class="sec-pad">
      <div class="wrap split">
        <div class="copy reveal">
          <span class="eyebrow">HOW PRICING WORKS</span>
          <div class="sec-head is-flush"><h2>Priced on a real call.</h2></div>
          <p>Every musician is different, so personal sites are priced on a 20-minute call, not from a dropdown. What never changes: hand-built HTML, KnownHost hosting on the same server that's run LWS since 2004, a custom domain like YourNameMusic.com that Jon registers and sets up for you, and Jon on the phone when something needs to happen.</p>
          <span class="label ps-who">WHO THIS IS FOR</span>
          <div class="pills">
            {roles.map((r) => <span class="pill">{r}</span>)}
          </div>
          <p class="ps-line">If you've ever had a gig you can't explain on Facebook, you need a real website.</p>
          <div class="hero-btns mt-lg">
            <a class="btn btn-primary" href="../contact.html">Start the Conversation →</a>
            <a class="btn btn-ghost" href="tel:7328019611">732.801.9611</a>
          </div>
        </div>
        <Glass class="reveal">
          <div class="ps-demo">
            <img class="ps-demo-img" src="../images/lbws_ps-demo-home.jpg" alt="Home page of a solo musician's website: nav menu, hero photo, headline, and one call to action" width="1296" height="768" loading="lazy" decoding="async" />
            <p class="ps-demo-cap"><span class="k">A SOLO ACT HOME PAGE</span>Photo, headline, nav, one call to action. The way we build them.</p>
          </div>
        </Glass>
      </div>
    </section>

    <!-- SEO / AI PLATFORM -->
    <section class="sec-pad is-alt has-videobg">
      <VideoBg src="bg-color-tv.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">FOUND ON GOOGLE, NOT JUST BUILT</span>
          <h2>SEO Is Baked Into Every Build</h2>
        </div>
        <p class="page-lede is-center mb-lg reveal">A website nobody finds is a poster in a locked room. Getting you found is a core part of what we do, every site is engineered to rank, and we keep working it after launch.</p>
        <div class="grid-svc">
          {seo.map((s) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <div class="ico">{s.ico}</div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </Glass>
            </div>
          ))}
        </div>
        <p class="page-lede is-center mt-lg reveal"><strong>Built on the Live Web Studios AI Platform.</strong> Google didn't tweak the rules, it rewrote them. The old SEO playbook doesn't work anymore. We build for how search works now, and adjust the moment it changes again.</p>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* Amber sub-brand theming — token override reproduced from live-band-web-studios.astro. */
  .theme-live-band {
    --cyan: #fcd34d;
    --cyan-soft: #fde68a;
    --cyan-2: #f59e0b;
    --cyan-deep: #4a3a08;
    --on-accent: #1a1400;
    --line: rgba(252, 211, 77, 0.16);
    --line-2: rgba(252, 211, 77, 0.08);
  }

  .grid-svc--2 { grid-template-columns: repeat(2, 1fr); }
  .ico.is-center { text-align: center; }

  .addon-note { color: var(--cyan-soft); font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; margin-top: 1rem; }

  .pills { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
  .pills--center { justify-content: center; max-width: 820px; margin-inline: auto; }
  .pill {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
    background: rgba(252, 211, 77, 0.04);
  }

  @media (max-width: 900px) {
    .grid-svc--2 { grid-template-columns: 1fr; }
  }

  /* Merged pricing section. */
  .ps-who {
    display: block;
    margin: 1.8rem 0 0.8rem;
  }
  .ps-line {
    margin-top: 1.1rem;
    color: var(--muted);
  }
  .ps-demo {
    padding: 0.75rem;
  }
  .ps-demo-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--r-lg) - 6px);
  }
  .ps-demo-cap {
    margin: 0.9rem 0.5rem 0.4rem;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .ps-demo-cap .k {
    display: block;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--cyan-soft);
    margin-bottom: 0.3rem;
  }
</style>
