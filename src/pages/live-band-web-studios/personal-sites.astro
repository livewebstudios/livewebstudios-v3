---
/**
 * /live-band-web-studios/personal-sites: ported from the live site. One folder
 * deep. Copy kept verbatim; EM DASH BAN applied.
 *
 * Gold Rack redesign (2026-11-15): five numbered photo MiniCards, two raised
 * add-on plates, pricing on the walnut owner panel with four knob rows, the
 * roles as a NameWall, the solo-act mockup in a 16x9 frame, then the shared
 * SEO rack and closing CTA plate.
 */
import LiveBandLayout from "../../layouts/LiveBandLayout.astro";
import PhotoBg from "../../components/PhotoBg.astro";
import PageHero from "../../components/lbws/PageHero.astro";
import SectionHead from "../../components/lbws/SectionHead.astro";
import MiniCard from "../../components/lbws/MiniCard.astro";
import Plate from "../../components/lbws/Plate.astro";
import PictureFrame from "../../components/lbws/PictureFrame.astro";
import Nameplate from "../../components/lbws/Nameplate.astro";
import OwnerPanel from "../../components/lbws/OwnerPanel.astro";
import KnobRow from "../../components/lbws/KnobRow.astro";
import NameWall from "../../components/lbws/NameWall.astro";
import SeoRack from "../../components/lbws/SeoRack.astro";
import CtaPlate from "../../components/lbws/CtaPlate.astro";

// What every personal site includes — ported from live (5 cards).
// Jon 2026-09-15: a photo fills the top of every card (Higgsfield, real-life
// live-musician shots) in place of the glyph. Files are lbws_ps-*.jpg.
const includes = [
  { img: "lbws_ps-bio.jpg", alt: "Session guitarist backstage in a theater dressing room", title: "Bio Page", body: "Your story. Where you've been. What you play. Who you've played with. Written in plain English by someone who understands what a session player's résumé actually looks like." },
  { img: "lbws_ps-touring.jpg", alt: "Musician loading gear into a van outside a theater at dusk", title: "Touring Page", body: "Past markets. Notable venues. Tour history. Booking contact. The page that tells a promoter or talent buyer exactly where you've worked and who to call." },
  { img: "lbws_ps-media.jpg", alt: "Keyboard player and drummer under stage lights", title: "Media Page", body: "YouTube embeds. Audio clips. Press photos. Your best live footage front and center, not buried three clicks deep." },
  { img: "lbws_ps-photos.jpg", alt: "Bassist and singer on stage, shot from the photo pit", title: "Photos Page", body: "High-res gallery. Press shots. Live shots. The photos a venue, promoter, or publication would actually need." },
  { img: "lbws_ps-contact.jpg", alt: "Musician backstage on a road case checking his phone", title: "Contact Page", body: "One clean contact form. Your booking email. Your management contact if applicable. No noise." },
];

// Who this is for — role pills.
const roles = [
  "Sidemen", "Session Players", "Touring Keyboardists", "Guitarists", "Drummers",
  "Bassists", "Vocalists", "Bandleaders", "Music Directors", "Producers",
  "Songwriters", "Solo Artists", "Tribute Act Members",
];

// Merch pills.
const merch = ["T-Shirts", "Hats", "Posters", "CDs", "Vinyl", "Signed Merch", "Digital Downloads"];
---

<LiveBandLayout
  title="Personal Musician Sites | Live Band Web Studios"
  description="Your name. Your domain. Custom websites for individual musicians, built by someone who's been on the road. Bio, touring, media, merch, and more."
  canonical="https://livewebstudios.com/live-band-web-studios/personal-sites"
  ogImage="images/og-live-band.jpg"
  preloadHero="lbws_bluestage.jpg"
>
  <PageHero
    eyebrow="A SERVICE OF LIVE BAND WEB STUDIOS"
    sub="Custom websites for the working musician. You're more than a band member. You've been in the circuit long enough to know that your name is a brand. A Facebook page isn't a website. A Linktree isn't a presence. We build you something that actually represents what you do, and where you've been."
  >
    <PhotoBg slot="media" src="lbws_bluestage.jpg" scrim="hero" alt="An empty concert stage under teal spotlights and haze: a grand piano, a drum kit on a riser, three electric guitars on stands, and a wall of amplifiers and road cases." />
    Your Name. <span class="lb-gold">Your Site.</span>
    <a slot="after" class="lb-btn lb-btn--primary" href="../contact.html" data-hero-in>Talk to Jon</a>
  </PageHero>

  <!-- WHAT EVERY PERSONAL SITE INCLUDES -->
  <section class="lb-section" aria-labelledby="includes-h">
    <div class="lb-container">
      <SectionHead id="includes-h">What Every Personal Site <span class="lb-gold">Includes</span></SectionHead>
      <ul role="list" class="lb-grid-3">
        {includes.map((c, i) => (
          <MiniCard
            stack
            num={String(i + 1).padStart(2, "0")}
            title={c.title}
            line={c.body}
            image={{ src: `../images/${c.img}`, alt: c.alt, width: 1024, height: 688 }}
          />
        ))}
      </ul>
    </div>
  </section>

  <!-- ADD-ONS -->
  <section class="lb-section lb-section--tight" aria-labelledby="addons-h">
    <div class="lb-container">
      <SectionHead id="addons-h">
        Add-Ons, Built for <span class="lb-gold">Working Musicians</span>
        <p class="lb-lead" slot="lede" data-reveal>Pricing is consultation-based. These are the options.</p>
      </SectionHead>
      <div class="lb-addons">
        <Plate variant="raised" class="lb-addon" data-reveal>
          <PictureFrame src="../images/lbws_ps-blog.jpg" alt="Touring musician writing in a notebook at a diner booth" width={1024} height={688} parallax />
          <Nameplate>ADD-ON</Nameplate>
          <h3>Blog Articles</h3>
          <p>Monthly posts written by Jon in your voice, tour updates, gear talk, behind-the-scenes. Local SEO that gets your name in front of people searching for players in your markets. The kind of content that makes you look like you're everywhere.</p>
          <p class="lb-addon__note lb-mono lb-mono--sm">Add-on · Consultation pricing</p>
        </Plate>
        <Plate variant="raised" class="lb-addon" data-reveal>
          <PictureFrame src="../images/lbws_ps-merch.jpg" alt="Band merch table in a concert venue lobby" width={1024} height={688} parallax />
          <Nameplate>ADD-ON</Nameplate>
          <h3>Merch Store</h3>
          <p>T-shirts. Hats. Posters. CDs. Vinyl. Whatever you're selling, we build a clean, functional store into your personal site. No WooCommerce sprawl. No plugin roulette. A real storefront that works on every device.</p>
          <ul role="list" class="lb-chips lb-mono lb-mono--sm">
            {merch.map((m) => <li>{m}</li>)}
          </ul>
          <p class="lb-addon__note lb-mono lb-mono--sm">Add-on · Consultation pricing</p>
        </Plate>
      </div>
    </div>
  </section>

  <!-- PRICED ON A REAL CALL -->
  <section class="lb-section lb-section--tight" aria-labelledby="pricing-h">
    <div class="lb-container">
      <OwnerPanel>
        <Nameplate>HOW PRICING WORKS</Nameplate>
        <h2 id="pricing-h">Priced on a <span class="lb-gold">real call.</span></h2>
        <p>Every musician is different, so personal sites are priced on a 20-minute call, not from a dropdown. What never changes: hand-built HTML, KnownHost hosting on the same server that's run LWS since 2004, a custom domain like YourNameMusic.com that Jon registers and sets up for you, and Jon on the phone when something needs to happen.</p>
        <div class="lb-owner__btns">
          <a class="lb-btn lb-btn--primary" href="../contact.html">Start the Conversation</a>
          <a class="lb-btn lb-btn--ghost" href="tel:7328019611">732.801.9611</a>
        </div>
        <Fragment slot="rows">
          <KnobRow>Hand-built HTML</KnobRow>
          <KnobRow>Hosting included</KnobRow>
          <KnobRow>Your domain, registered and set up by Jon</KnobRow>
          <KnobRow>Jon's direct phone number</KnobRow>
        </Fragment>
      </OwnerPanel>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="lb-section lb-section--tight" aria-labelledby="who-h">
    <div class="lb-container">
      <h2 class="lb-who__h" id="who-h" data-reveal><span class="lb-nameplate">WHO THIS IS FOR</span></h2>
      <NameWall names={roles} />
      <p class="lb-lead lb-who__line" data-reveal>If you've ever had a gig you can't explain on Facebook, you need a real website.</p>
    </div>
  </section>

  <!-- A SOLO ACT HOME PAGE -->
  <section class="lb-section lb-section--tight" aria-label="A solo act home page">
    <div class="lb-container">
      <figure class="lb-demo" data-reveal>
        <div class="lb-demo__shot">
          <PictureFrame as="div" src="../images/lbws_ps-demo-home.jpg" alt="Home page of a solo musician's website: nav menu, hero photo, headline, and one call to action" width={1296} height={768} ratio="16x9" parallax />
          <Nameplate class="lb-work__tag">A SOLO ACT HOME PAGE</Nameplate>
        </div>
        <figcaption class="lb-muted">Photo, headline, nav, one call to action. The way we build them.</figcaption>
      </figure>
    </div>
  </section>

  <SeoRack />

  <CtaPlate />
</LiveBandLayout>

<style>
  .lb-section--tight { padding-block: calc(var(--lb-section-y) * 0.5); }
  .lb-addons { display: grid; gap: var(--lb-s-6); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .lb-addons { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .lb-addons :global(.lb-addon) { display: grid; gap: var(--lb-s-4); align-content: start; padding: var(--lb-s-8); }
  .lb-addons :global(.lb-addon) p { color: var(--lb-parchment); }
  .lb-addons :global(.lb-addon) .lb-addon__note { color: var(--lb-brass); }
  .lb-chips { display: flex; flex-wrap: wrap; gap: var(--lb-s-2); margin: 0; padding: 0; list-style: none; }
  .lb-chips li { padding: 0.3rem 0.6rem; border: 1px solid var(--lb-hairline-soft); border-radius: var(--lb-r-1); color: var(--lb-parchment); }
  .lb-owner__btns { display: flex; flex-wrap: wrap; gap: var(--lb-s-3); }
  .lb-who__h { margin-bottom: var(--lb-s-6); font-size: 1rem; line-height: 1; letter-spacing: 0; }
  .lb-who__line { margin-top: var(--lb-s-8); color: var(--lb-cream); }
  .lb-demo { display: grid; gap: var(--lb-s-4); margin: 0; }
  .lb-demo__shot { position: relative; }
</style>
