---
/**
 * /live-band-web-studios/pricing: ported from the live site. One folder deep
 * (two dots up on imports). Prices kept verbatim. EM DASH BAN applied to all
 * ported copy.
 *
 * Gold Rack redesign (2026-11-15): two tier plates (Touring / Pro raised, with
 * the amber top glow), payment terms on the walnut owner panel, the Personal
 * Sites teaser as an icon MiniCard, then the shared SEO rack and closing CTA
 * plate. Jon kept his ReceiverCta buttons as the tier CTAs; the Gold Rack
 * stylesheet retints them brass. The teal stage photo stays as the hero media.
 */
import LiveBandLayout from "../../layouts/LiveBandLayout.astro";
import PhotoBg from "../../components/PhotoBg.astro";
import ReceiverCta from "../../components/ReceiverCta.astro";
import PageHero from "../../components/lbws/PageHero.astro";
import TierPlate from "../../components/lbws/TierPlate.astro";
import OwnerPanel from "../../components/lbws/OwnerPanel.astro";
import KnobRow from "../../components/lbws/KnobRow.astro";
import Led from "../../components/lbws/Led.astro";
import MiniCard from "../../components/lbws/MiniCard.astro";
import SeoRack from "../../components/lbws/SeoRack.astro";
import CtaPlate from "../../components/lbws/CtaPlate.astro";

const basicIncludes = [
  "Custom hand-built site, no pre-made templates, ever. Designed just for you",
  "Gig page with upcoming shows",
  "Photo gallery",
  "YouTube video embeds",
  "Decap CMS access. Band updates their own gig dates without calling Jon",
  "1 hour/month of updates by Jon (photos, copy, minor changes)",
  "Monthly SEO + traffic report",
  "Monthly suggestions form link included in every report",
];
const basicExcludes = ["Custom logo", "Blog posts", "EPK page", "Member bios", "Set list management"];
const proIncludes: { text: string; sub?: string[] }[] = [
  { text: "Full custom multi-page site" },
  {
    text: "Electronic Press Kit (EPK) page:",
    sub: [
      "Bio (3-5 sentences, industry-reader ready)",
      "High-res photo download links",
      "Audio/video samples (YouTube embeds + streaming)",
      "Notable venues / tour history",
      "Press quotes",
      "Tech rider summary (PA requirements, monitor setup, stage plot PDF link, input list PDF link, backline)",
      "Set list (CMS-managed, always current)",
      "Booking contact, one line",
    ],
  },
  { text: "Set list management. Band members update via Decap CMS" },
  { text: "Member bio pages, built from member bio forms; placeholders until forms arrive" },
  {
    text: "3 SEO blog posts per month written by Jon:",
    sub: [
      "Local SEO (show posts targeting city + venue + genre keywords)",
      "Gear / equipment posts (band's voice)",
      "Behind the scenes / rehearsal (band's voice)",
      "Venue recaps / press-style posts",
    ],
  },
  { text: "Monthly SEO + traffic + keyword ranking report" },
];
---

<LiveBandLayout
  title="Pricing | Live Band Web Studios"
  description="Two tiers. No templates. Custom band websites starting at $600/year. Built by a musician."
  canonical="https://livewebstudios.com/live-band-web-studios/pricing"
  ogImage="images/og-live-band.jpg"
  preloadHero="lbws_bluestage.jpg"
>
  <PageHero eyebrow="No Contracts. No Surprises. No WordPress." sub="Two tiers. Prepaid annually. Built from scratch every time.">
    <PhotoBg slot="media" src="lbws_bluestage.jpg" scrim="hero" alt="An empty concert stage under teal spotlights and haze: a grand piano, a drum kit on a riser, three electric guitars on stands, and a wall of amplifiers and road cases." />
    <span class="lb-gold">Pricing</span>
  </PageHero>

  <!-- THE TWO TIERS -->
  <section class="lb-section" aria-label="Pricing tiers">
    <div class="lb-container">
      <div class="lb-tiers">
        <TierPlate label="BASIC" name="Bar Band Special">
          <div class="lb-tier__price">
            <span class="lb-tier__amt lb-gold">$600</span>
            <span class="lb-tier__per lb-mono">/ year (prepaid annually)</span>
            <span class="lb-tier__per lb-mono lb-mono--sm lb-tier__build">Build: $625.00</span>
          </div>
          <p class="lb-tier__label lb-mono">Includes:</p>
          <ul role="list" class="lb-tier__list">
            {basicIncludes.map((t) => <li><Led />{t}</li>)}
          </ul>
          <p class="lb-tier__label lb-mono">Does not include:</p>
          <ul role="list" class="lb-tier__list lb-tier__list--off">
            {basicExcludes.map((t) => <li>{t}</li>)}
          </ul>
          <ReceiverCta href="../contact.html" label="Start With Basic →" peak={18} />
        </TierPlate>

        <TierPlate label="TOURING / PRO" name="Pro Acts & Bands" featured>
          <div class="lb-tier__price">
            <span class="lb-tier__amt lb-tier__amt--sm lb-gold">$995 build</span>
            <span class="lb-tier__per lb-mono lb-tier__plus" aria-hidden="true">+</span>
            <span class="lb-tier__amt lb-gold">$1,548</span>
            <span class="lb-tier__per lb-mono">/ year ($129.00 a month)</span>
            <span class="lb-tier__per lb-mono lb-mono--sm lb-tier__build">(prepaid annually)</span>
          </div>
          <p class="lb-tier__label lb-mono">Includes everything in Basic, plus:</p>
          <ul role="list" class="lb-tier__list">
            {proIncludes.map((it) => (
              <li>
                <Led />
                <span>
                  {it.text}
                  {it.sub && <ul role="list">{it.sub.map((s) => <li>{s}</li>)}</ul>}
                </span>
              </li>
            ))}
          </ul>
          <ReceiverCta href="../contact.html" label="Start With Touring / Pro →" featured peak={46} />
        </TierPlate>
      </div>
    </div>
  </section>

  <!-- PAYMENT TERMS -->
  <section class="lb-section lb-section--tight" aria-label="Payment terms">
    <div class="lb-container">
      <OwnerPanel>
        <p>Yearly prepaid is standard. Half up front + a payment plan can be arranged, talk to Jon. Every site is a real conversation, not a checkout flow.</p>
        <p class="lb-owner__links">
          <a class="lb-textlink" href="../contact.html">jonwolf@livewebstudios.com</a>
          <a class="lb-textlink" href="tel:7328019611">732.801.9611</a>
        </p>
        <Fragment slot="rows">
          <KnobRow>Yearly prepaid is standard</KnobRow>
          <KnobRow>Half up front and a payment plan? Talk to Jon</KnobRow>
          <KnobRow>A real conversation, not a checkout flow</KnobRow>
        </Fragment>
      </OwnerPanel>
    </div>
  </section>

  <!-- PERSONAL SITES TEASER -->
  <section class="lb-section lb-section--tight" aria-label="Personal sites">
    <div class="lb-container">
      <ul role="list" class="lb-wide-card">
        <MiniCard
          icon="person"
          kicker="PERSONAL SITES"
          title="Individual Musician? We Do That Too."
          line="Personal sites for solo artists, sidemen, studio players, and anyone who's more than just a band member. Consultation-based pricing."
          href="personal-sites.html"
          more="See Personal Sites"
        />
      </ul>
    </div>
  </section>

  <SeoRack />

  <CtaPlate />
</LiveBandLayout>

<style>
  .lb-tier__build { flex-basis: 100%; }
  .lb-tier__plus { color: var(--lb-brass); }
  .lb-tier :global(.rcta) { justify-self: stretch; }
  .lb-section--tight { padding-block: calc(var(--lb-section-y) * 0.5); }
  .lb-owner__links { display: flex; flex-wrap: wrap; gap: var(--lb-s-2) var(--lb-s-6); }
  .lb-wide-card { list-style: none; margin: 0; padding: 0; }
  .lb-wide-card :global(.lb-mini__name) { font-size: var(--lb-fs-h3); }
</style>
