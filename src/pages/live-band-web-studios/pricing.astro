---
/**
 * /live-band-web-studios/pricing — ported from the live site
 * (livewebstudios.com/live-band-web-studios/pricing). One folder deep (two dots
 * up on imports). Wrapped in .theme-live-band for the amber accent (token
 * override reproduced in scoped <style>, matching the hub). No <img>: the live
 * hero video/photo is replaced with a page-head + VideoBg. Prices kept verbatim.
 * Tabler icon font (external CDN) dropped; glyph markers used instead.
 * EM DASH BAN applied to all ported copy.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import BandSeoCards from "../../components/BandSeoCards.astro";
import VideoBg from "../../components/VideoBg.astro";
import PhotoBg from "../../components/PhotoBg.astro";

---

<Base
  title="Pricing | Live Band Web Studios"
  description="Two tiers. No templates. Custom band websites starting at $600/year. Built by a musician."
  canonical="https://livewebstudios.com/live-band-web-studios/pricing"
  ogImage="images/og-live-band.jpg"  preloadHero="lbws_bluestage.jpg"
>
  <Nav />

  <main class="theme-live-band">
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass page-head--bare has-videobg">
      <PhotoBg src="lbws_bluestage.jpg" scrim="hero" alt="An empty concert stage under teal spotlights and haze: a grand piano, a drum kit on a riser, three electric guitars on stands, and a wall of amplifiers and road cases." />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">No Contracts. No Surprises. No WordPress.</span>
        <h1 class="page-h1"><em>Pricing</em></h1>
        <p class="page-lede">Two tiers. Prepaid annually. Built from scratch every time.</p>
      </div>
    </section>

    <!-- PRICING CARDS -->
    <section class="sec-pad">
      <div class="wrap">
        <div class="grid-svc grid-svc--2">
          <!-- BASIC -->
          <div class="card reveal">
            <Glass variant="inner" innerClass="card-pad price-card">
              <span class="tier-badge tier-badge--gold">Basic (“Bar Band Special”)</span>
              <div class="price-amt">$600 <span class="price-note">/ year</span></div>
              <div class="price-note">(prepaid annually)</div>
              <div class="price-build">Build: $625.00</div>

              <p class="price-head">Includes:</p>
              <ul class="feats">
                <li>Custom hand-built site (HTML/CSS/JS, no WordPress, no page builders, no templates, ever)</li>
                <li>Gig page with upcoming shows</li>
                <li>Photo gallery</li>
                <li>YouTube video embeds</li>
                <li>Decap CMS access. Band updates their own gig dates without calling Jon</li>
                <li>1 hour/month of updates by Jon (photos, copy, minor changes)</li>
                <li>Monthly SEO + traffic report</li>
                <li>Monthly suggestions form link included in every report</li>
              </ul>

              <p class="price-head">Does not include:</p>
              <ul class="feats feats--neg">
                <li>Blog posts</li>
                <li>EPK page</li>
                <li>Member bios</li>
                <li>Set list management</li>
              </ul>

              <a class="btn btn-ghost" href="../contact.html">Start With Basic →</a>
            </Glass>
          </div>

          <!-- TOURING / PRO -->
          <div class="card reveal">
            <Glass variant="inner" innerClass="card-pad price-card">
              <span class="tier-badge tier-badge--cyan">Touring / Pro Acts &amp; Bands</span>
              <div class="price-amt-sm">$995 build</div>
              <div class="price-plus">+</div>
              <div class="price-amt">$1,548 <span class="price-note">/ year ($129.00 a month)</span></div>
              <div class="price-note">(prepaid annually)</div>

              <p class="price-head">Includes everything in Basic, plus:</p>
              <ul class="feats">
                <li>Full custom multi-page site</li>
                <li>
                  Electronic Press Kit (EPK) page:
                  <ul class="feats-sub">
                    <li>Bio (3-5 sentences, industry-reader ready)</li>
                    <li>High-res photo download links</li>
                    <li>Audio/video samples (YouTube embeds + streaming)</li>
                    <li>Notable venues / tour history</li>
                    <li>Press quotes</li>
                    <li>Tech rider summary (PA requirements, monitor setup, stage plot PDF link, input list PDF link, backline)</li>
                    <li>Set list (CMS-managed, always current)</li>
                    <li>Booking contact, one line</li>
                  </ul>
                </li>
                <li>Set list management. Band members update via Decap CMS</li>
                <li>Member bio pages, built from member bio forms; placeholders until forms arrive</li>
                <li>
                  3 SEO blog posts per month written by Jon:
                  <ul class="feats-sub">
                    <li>Local SEO (show posts targeting city + venue + genre keywords)</li>
                    <li>Gear / equipment posts (band's voice)</li>
                    <li>Behind the scenes / rehearsal (band's voice)</li>
                    <li>Venue recaps / press-style posts</li>
                  </ul>
                </li>
                <li>Monthly SEO + traffic + keyword ranking report</li>
              </ul>

              <a class="btn btn-primary" href="../contact.html">Start With Touring / Pro →</a>
            </Glass>
          </div>
        </div>
      </div>
    </section>

    <!-- PAYMENT NOTE -->
    <!-- Jon 2026-09-15: the FAQ "Call Jon directly" card clip, behind this
         card too. Same recipe as /faq: the clip fills the card, copy held to
         the left where the scrim is heavy, Jon on the right where it is light. -->
    <section class="sec-pad is-alt">
      <div class="wrap">
        <Glass class="reveal" innerClass="feature cta--video">
          <VideoBg src="jon-webdesk.mp4" scrim="default" poster="jon-webdesk-poster.jpg" />
          <!-- em-dash: "a payment plan can be arranged — talk to Jon" → comma -->
          <p>Yearly prepaid is standard. Half up front + a payment plan can be arranged, talk to Jon. Every site is a real conversation, not a checkout flow.</p>
          <p class="mt-lg"><a href="../contact.html">jonwolf@livewebstudios.com</a> · <a href="tel:7328019611">732.801.9611</a></p>
        </Glass>
      </div>
    </section>

    <!-- PERSONAL SITES TEASER -->
    <section class="sec-pad">
      <div class="wrap">
        <div class="sec-head center reveal">
          <h2>Individual Musician? We Do That Too.</h2>
          <p class="page-lede is-center">Personal sites for solo artists, sidemen, studio players, and anyone who's more than just a band member. Consultation-based pricing.</p>
          <div class="hero-btns is-center mt-lg">
            <a class="btn btn-ghost" href="personal-sites.html">See Personal Sites →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SEO / AI PLATFORM -->
    <section class="sec-pad has-videobg">
      <VideoBg src="bg-color-tv.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <!-- em-dash: "Found on Google — Not Just Built" → comma -->
          <span class="eyebrow">FOUND ON GOOGLE, NOT JUST BUILT</span>
          <h2>SEO Is Baked Into Every Build</h2>
        </div>
        <!-- em-dash: "core part of what we do — every site is engineered" → comma -->
        <p class="page-lede is-center mb-lg reveal">A website nobody finds is a poster in a locked room. Getting you found is a core part of what we do, every site is engineered to rank, and we keep working it after launch.</p>
        <BandSeoCards />
        <!-- em-dash: "Google didn't tweak the rules — it rewrote them" → comma -->
        <p class="page-lede is-center mt-lg reveal"><strong>Built on the Live Web Studios AI Platform.</strong> Google didn't tweak the rules, it rewrote them. The old SEO playbook doesn't work anymore. We build for how search works now, and adjust the moment it changes again.</p>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* Amber sub-brand theming — token override reproduced from live-band-web-studios.astro. */
  .theme-live-band {
    --cyan: #fcd34d;
    --cyan-soft: #fde68a;
    --cyan-2: #f59e0b;
    --cyan-deep: #4a3a08;
    --on-accent: #1a1400;
    --line: rgba(252, 211, 77, 0.16);
    --line-2: rgba(252, 211, 77, 0.08);
  }

  /* Two-up card grid (system default grid-svc is 3-up). */
  .grid-svc--2 { grid-template-columns: repeat(2, 1fr); }

  /* Pricing card internals. */
  .price-card { display: flex; flex-direction: column; }
  .tier-badge {
    align-self: flex-start;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    margin-bottom: 1rem;
  }
  .tier-badge--gold { color: #e3cb8b; background: rgba(201, 165, 90, 0.1); }
  .tier-badge--cyan { color: var(--cyan-soft); background: rgba(252, 211, 77, 0.1); }
  .price-amt { font-family: var(--sans); font-weight: 700; font-size: 2.2rem; color: var(--ink-soft); }
  .price-amt-sm { font-family: var(--sans); font-weight: 600; font-size: 1.2rem; color: var(--ink-soft); }
  .price-plus { color: var(--muted-2); font-size: 1.1rem; margin: 0.1rem 0; }
  .price-note { font-size: 0.9rem; color: var(--muted-2); font-weight: 400; }
  .price-build { color: var(--cyan-soft); font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.1em; margin-top: 0.6rem; }
  .price-head { font-weight: 600; color: var(--ink-soft); margin-top: 1.4rem; margin-bottom: 0.6rem; }

  .feats { list-style: none; display: grid; gap: 0.55rem; }
  .feats li { position: relative; padding-left: 1.5rem; color: var(--muted); font-size: 0.94rem; }
  .feats li::before { content: "✓"; position: absolute; left: 0; color: var(--cyan-soft); font-weight: 700; }
  .feats--neg li::before { content: "✕"; color: var(--muted-2); }
  .feats-sub { list-style: none; display: grid; gap: 0.4rem; margin-top: 0.5rem; margin-left: 0.2rem; }
  .feats-sub li { padding-left: 1.2rem; font-size: 0.9rem; }
  .feats-sub li::before { content: "•"; color: var(--muted-2); }

  .price-card .btn { margin-top: auto; align-self: flex-start; }

  @media (max-width: 900px) {
    .grid-svc--2 { grid-template-columns: 1fr; }
  }
</style>
