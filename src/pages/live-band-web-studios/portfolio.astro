---
/**
 * /live-band-web-studios/portfolio. The screenshots and copy already existed
 * in work.astro, so they are reused here rather than rewritten, keeping one
 * description per client.
 *
 * Gold Rack redesign (2026-11-15): three alternating PortfolioFrames, then
 * "The Day Job" on the walnut owner panel with four thumbnails pulled from the
 * shared REBUILDS list (the first four that are not already on this page),
 * then the shared SEO rack and closing CTA plate.
 */
import LiveBandLayout from "../../layouts/LiveBandLayout.astro";
import PhotoBg from "../../components/PhotoBg.astro";
import PageHero from "../../components/lbws/PageHero.astro";
import PictureFrame from "../../components/lbws/PictureFrame.astro";
import Nameplate from "../../components/lbws/Nameplate.astro";
import Led from "../../components/lbws/Led.astro";
import Arrow from "../../components/lbws/Arrow.astro";
import OwnerPanel from "../../components/lbws/OwnerPanel.astro";
import KnobRow from "../../components/lbws/KnobRow.astro";
import SeoRack from "../../components/lbws/SeoRack.astro";
import CtaPlate from "../../components/lbws/CtaPlate.astro";
import { REBUILDS } from "../../lib/aiStudio";
import { relPrefix } from "../../lib/relPrefix";

const rel = relPrefix(Astro.url.pathname);

// Portfolio cards — ported (placeholder bios kept; em dashes converted). Cards
// without a live URL (href null) render a non-link thumb and no VIEW SITE link.
const work = [
  {
    cat: "TOURING / PRO",
    name: "THE BRITISH INVASION YEARS",
    genre: "British Invasion Tribute · Tri-State / National",
    desc: "A live '60s British Invasion concert show touring theaters coast to coast, tour dates, video, and booking for the band fronted by LWS's own Jon Wolf.",
    img: "images/portfolio/britishinvasionyears.jpg",
    w: 640,
    h: 320,
    href: "https://britishinvasionyears.com",
  },
  {
    cat: "TOURING / PRO",
    name: "WINSLOW EAGLES TRIBUTE",
    genre: "Eagles Tribute · Northeast / Regional",
    desc: "A professional Eagles tribute band featuring tour dates, performance info, and fan resources for one of the most sought-after tribute acts on the East Coast.",
    img: "images/portfolio/winslow.jpg",
    w: 709,
    h: 709,
    href: "https://winsloweaglestribute.com",
  },
  {
    cat: "PERSONAL SITE",
    name: "JON WOLF STUDIOS",
    genre: "Personal Musician Site · North Jersey",
    desc: "The personal site of LWS founder Jon Wolf, North Jersey keyboardist, guitarist, web developer, and AI workflow consultant, built on our follow-spot animation engine.",
    img: "images/portfolio/jonwolfstudios.jpg",
    w: 640,
    h: 320,
    href: "https://jonwolfstudios.com/",
  },
];


/* The Day Job thumbnails: the first four client rebuilds from the Work page
   that are not already shown above (and not this site itself). */
const onThisPage = ["The British Invasion Years", "Jon Wolf Studios"];
const dayJob = REBUILDS.filter((r) => r.href && !onThisPage.includes(r.name)).slice(0, 4);
---

<LiveBandLayout
  title="Portfolio | Live Band Web Studios"
  description="Real band websites. Real results. See the work."
  canonical="https://livewebstudios.com/live-band-web-studios/portfolio"
  ogImage="images/og-live-band.jpg"
  preloadHero="lbws_bluestage.jpg"
>
  <PageHero eyebrow="THE WORK" sub="Every site here was built from scratch. Not from a template. Not from a page builder.">
    <PhotoBg slot="media" src="lbws_bluestage.jpg" scrim="hero" alt="An empty concert stage under teal spotlights and haze: a grand piano, a drum kit on a riser, three electric guitars on stands, and a wall of amplifiers and road cases." />
    The <span class="lb-gold">Work.</span>
  </PageHero>

  <section class="lb-section" aria-label="Band and musician sites">
    <div class="lb-container">
      <div class="lb-work">
        {work.map((w) => (
          <article class="lb-work__item" data-reveal>
            <a class="lb-work__shot" href={w.href} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${w.name}`}>
              <PictureFrame src={`${rel}${w.img}`} alt={`${w.name} website`} width={w.w} height={w.h} ratio="16x9" parallax />
              <Nameplate class="lb-work__tag">{w.cat}</Nameplate>
            </a>
            <div class="lb-work__body">
              <span class="lb-eyebrow lb-mono lb-mono--sm"><Led />{w.genre}</span>
              <h2 class="lb-work__name">{w.name}</h2>
              <p class="lb-muted">{w.desc}</p>
              <a class="lb-textlink" href={w.href} target="_blank" rel="noopener noreferrer">VIEW SITE <Arrow /></a>
            </div>
          </article>
        ))}
      </div>

      <div class="lb-work__note" data-reveal>
        <p class="lb-lead">More sites launching in 2026. Portfolio updates as each site goes live.</p>
        <a class="lb-btn lb-btn--ghost" href="../contact.html">Want to Be on This Page?</a>
      </div>
    </div>
  </section>

  <!-- THE DAY JOB (new, 2026-11-15) -->
  <section class="lb-section lb-section--tight" aria-labelledby="dayjob-h">
    <div class="lb-container">
      <OwnerPanel>
        <Nameplate>THE DAY JOB</Nameplate>
        <h2 id="dayjob-h">Three band sites. A lot more where those came from.</h2>
        <p>Live Web Studios has been building websites for North Jersey businesses since 2004. Electricians, counselors, consultants, a logistics company. Same builder, same phone number.</p>
        <a class="lb-btn lb-btn--primary lb-owner__btn" href="../work.html">See the Rest of the Work</a>
        <Fragment slot="rows">
          <KnobRow>Building websites since 2004</KnobRow>
          <KnobRow>Hand-built, same as the band sites</KnobRow>
          <KnobRow>One builder on every project</KnobRow>
        </Fragment>
        <div class="lb-thumbs" slot="after">
          {dayJob.map((r) => (
            <figure>
              <a href="../work.html" aria-label={`${r.name}, on the Work page`}>
                <PictureFrame as="div" src={`${rel}images/portfolio/${r.img}.jpg`} alt={`${r.name} website`} width={800} height={500} ratio="16x9" />
              </a>
              <figcaption class="lb-mono">{r.name}</figcaption>
            </figure>
          ))}
        </div>
      </OwnerPanel>
    </div>
  </section>

  <SeoRack />

  <CtaPlate />
</LiveBandLayout>

<style>
  .lb-work__name { font-size: clamp(1.875rem, 1.5rem + 1.6vw, 2.75rem); }
  .lb-work__note { display: grid; justify-items: center; gap: var(--lb-s-6); margin-top: var(--lb-s-16); text-align: center; }
  .lb-section--tight { padding-block: calc(var(--lb-section-y) * 0.5); }
  .lb-owner__btn { justify-self: start; }
  .lb-thumbs a { display: block; border-radius: var(--lb-r-panel); transition: transform var(--lb-t-hover) var(--lb-ease); }
  @media (hover: hover) and (pointer: fine) { .lb-thumbs a:hover { transform: translateY(-3px); } }
</style>
