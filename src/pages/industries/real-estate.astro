---
/**
 * /industries/real-estate — ported from live real-estate.html.
 * Imports TWO dots up; links "../services/*.html", "../contact.html",
 * "../industries.html". COPY RULES: em dashes converted (marked <!-- em-dash -->);
 * "Learn More" → "SEE DETAILS →"; free-consultation CTA line reworded. Images
 * dropped; Glass portrait placeholder stands in. Smart quotes normalized.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const services = [
  { ico: "◧", title: "Website Design", body: "Agent and team sites that load fast and turn referrals into calls. Most of your traffic already knows your name and is checking you out.", points: ["Built to confirm a referral fast", "Sold results front and center"], href: "../services/website-design.html" },
  { ico: "◎", title: "SEO", body: "Town and neighborhood targeting. Buyers search places, not brokerages, and sellers search what their neighbor got for their house.", points: ["A page per town you work", "Seller searches targeted too"], href: "../services/seo.html" },
  { ico: "▦", title: "AI Image Services", body: "Photo cleanup and consistency so listings present like a premium brand. Grey skies and empty rooms cost real money on a listing.", points: ["Sky replacement and virtual staging", "Consistent across every listing"], href: "../services/ai-image.html" },
];

const builds = [
  { ico: "◧", title: "Custom Design", body: "Most of your business comes from referrals who look you up before calling. The site's job is to confirm you are the real thing, fast.",
    points: ["Sold results and reviews up front", "Built around you, not the brokerage template"] },
  { ico: "◎", title: "SEO Strategy", body: "Town and neighborhood pages, because that is how people search for a home. Nobody types a brokerage name into Google when they are house hunting.",
    points: ["A page per town you actually work", "Written for sellers as well as buyers"] },
  { ico: "✦", title: "Lead Generation", body: "Home valuation requests and showing forms that ask enough to be useful. A lead with no address and no timeline is not a lead.",
    points: ["Captures address and timeline", "Reaches your phone immediately"] },
  { ico: "▤", title: "Content Strategy", body: "Neighborhood guides and market updates. This is the work that turns a site into something people forward to a friend who is moving.",
    points: ["Local knowledge you already have", "Updated as the market moves"] },
  { ico: "◉", title: "Mobile-First", body: "Buyers browse listings from the passenger seat. Photos have to load fast on cell service or they are gone before the page finishes.",
    points: ["Galleries that load on a weak signal", "Tap to call from every listing"] },
  { ico: "⛭", title: "Ongoing Support", body: "Hosting, maintenance, and monthly reporting. Listings and sold results should go up the week they happen.",
    points: ["Listing updates handled", "Sold results kept current"] },
];
---

<Base
  title="Real Estate Web Design | Live Web Studios"
  description="Listing-ready websites for brokers, agents, and property management."
  canonical="https://livewebstudios.com/industries/real-estate"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head has-videobg">
      <VideoBg src="bg-looping-waves.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">REAL ESTATE</span>
        <h1 class="page-h1">Listings That Load Fast. <em>Agents That Get Found.</em></h1>
        <!-- em-dash: "property managers — built for search" → "property managers, built for search" -->
        <p class="page-lede">High-performance websites for brokers, agents, and property managers, built for search and built to convert.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- WHY -->
    <section class="sec-pad">
      <div class="wrap split">
        <div class="copy reveal">
          <span class="eyebrow">REAL ESTATE</span>
          <div class="sec-head is-flush"><h2>Why Real Estate Businesses Choose LWS</h2></div>
          <!-- em-dash: "not days—and your site" → "not days, and your site" -->
          <p>Real estate is speed and trust. Buyers and sellers are comparing agents in minutes, not days, and your site is often the deciding factor. If it's slow, dated, or thin on proof, you look like you're not serious. And when listings are involved, performance matters even more: big images and maps can turn a site into molasses if it's built poorly.</p>
          <p>We build real estate websites that feel premium and move fast. Crisp design, mobile-first layout, clean property and service pages, and local SEO that helps you show up for the towns you actually want. Need better visuals? We can enhance and standardize your photography so every listing and every neighborhood page looks like it belongs in the same brand.</p>
          <!-- em-dash: "not magic—it's a site" → "not magic. It's a site" -->
          <p>In practice, agents and teams typically see more calls and form submissions from local search, stronger referral conversion (people sent to your site actually stay), and improved "brand confidence" that helps win listings. It's not magic. It's a site that loads quickly, tells your story clearly, and makes it easy to take the next step.</p>
        </div>
        <Glass class="reveal" innerClass="portrait">
          <div class="frame-lines"></div>
          <div class="big">◧</div>
          <div class="mark">REAL ESTATE</div>
        </Glass>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="sec-pad is-alt">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">SERVICES</span>
          <h2>Services We Provide for Real Estate</h2>
        </div>
        <p class="page-lede is-center mb-lg">Fast sites, local visibility, and imagery that makes your listings look expensive (in a good way).</p>
        <div class="grid-svc">
          {services.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
                <a class="more" href={c.href}>SEE DETAILS →</a>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WHAT WE BUILD -->
    <section class="sec-pad has-videobg">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">WHAT WE BUILD</span>
          <h2>What We Build for Real Estate</h2>
        </div>
        <div class="grid-svc">
          {builds.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta">
          <h2>Ready to Upgrade Your Real Estate Website?</h2>
          <p>Let's talk about your real estate website.</p>
          <div class="hero-btns">
            <a href="../contact.html" class="btn btn-primary">Get a Proposal →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
          <p class="more"><a href="../industries.html">← All industries</a></p>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
