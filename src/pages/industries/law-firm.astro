---
/**
 * /industries/law-firm — ported from live industries/law-firm.html.
 * Imports TWO dots up; in-page links "../services/*.html", "../contact.html",
 * "../industries.html". COPY RULES: em dashes converted (marked <!-- em-dash -->);
 * "Learn More" → "SEE DETAILS →"; free-consultation CTA line reworded to
 * "Let's talk about your law firm website." Split/hero images dropped; Glass
 * portrait placeholder stands in. Smart quotes normalized to straight.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const services = [
  { ico: "◧", title: "Website Design", body: "Practice-area structure with a layout that reads steady. Someone hiring a lawyer wants to feel like they found the adult in the room.", points: ["A real page per practice area", "Attorney bios that build trust"], href: "../services/website-design.html" },
  { ico: "◎", title: "SEO", body: "Local rankings for \"practice area + city,\" plus technical SEO that actually sticks. That phrase pattern is how legal clients search, almost without exception.", points: ["Targets the exact phrasing clients use", "Built to hold rankings, not spike"], href: "../services/seo.html" },
  { ico: "❖", title: "Branding", body: "Consistency across your site, print, and signage. A firm that looks different on a business card than on its own homepage undercuts itself.", points: ["One identity everywhere it appears", "Press-ready files included"], href: "../services/branding.html" },
];

const builds = [
  { ico: "◧", title: "Custom Design", body: "Someone hiring a lawyer is usually having a bad month. The site has to feel steady and make the next step obvious, because they are not in the mood to hunt for it.",
    points: ["Attorney bios that read like people", "Contact reachable from every page"] },
  { ico: "◎", title: "SEO Strategy", body: "A page for each practice area, targeted to the towns you actually serve. A firm doing estate planning and DUI defense cannot rank for either from one blended page.",
    points: ["Practice area plus city, page by page", "No page trying to cover two practices"] },
  { ico: "✦", title: "Lead Generation", body: "Intake forms that ask enough to triage without feeling like a deposition. Every extra field costs you people who were ready to call.",
    points: ["Short enough that people finish it", "Routed so nothing sits over a weekend"] },
  { ico: "▤", title: "Content Strategy", body: "Plain-English answers to what people search before they hire anyone. Explaining the process is how a stranger decides you are the one to call.",
    points: ["Written without the legalese", "Answers the questions asked before hiring"] },
  { ico: "◉", title: "Mobile-First", body: "A lot of your traffic arrives from a phone, sometimes from a car or a hospital. Tap-to-call has to work on the first try.",
    points: ["One tap to call from any page", "Forms usable one-handed"] },
  { ico: "⛭", title: "Ongoing Support", body: "Hosting, maintenance, and monthly reporting. Adding an attorney or a practice area should take a phone call, not a project.",
    points: ["Bio and practice updates included", "Disclaimers kept current"] },
];
---

<Base
  title="Law Firm Web Design | Live Web Studios"
  description="Professional websites for law firms. Practice area pages, intake forms, local SEO."
  canonical="https://livewebstudios.com/industries/law-firm"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-corner.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">LAW FIRM</span>
        <h1 class="page-h1">Your Website Should Work <em>as Hard as You Do.</em></h1>
        <!-- em-dash: "for law firms — built" → "for law firms, built" -->
        <p class="page-lede">Professional websites for law firms, built to rank locally, generate leads, and establish authority.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- WHY -->
    <section class="sec-pad">
      <div class="wrap split split--copy-first">
        <div class="copy copy--points reveal">
          <span class="eyebrow">LAW FIRM</span>
          <div class="sec-head is-flush"><h2>Why Law Firm Businesses Choose LWS</h2></div>
          <!-- Restructured from three prose blocks to lede + points
               (Jon 2026-09-14: less wall of text, plain enough for a
               non-technical reader). Claims, numbers and search terms
               are all carried over; the two long paragraphs were each
               a list written as a sentence. -->
          <p>Someone searching for an attorney is already stressed. They are making decisions fast, and your website is the first conversation you have with them. If it loads slowly, feels generic, or makes your practice areas hard to understand, they call the next firm on the page.</p>
          <p>What we build for you:</p>
          <ul class="copy-points">
            <li><strong>Clean, premium design</strong> that establishes authority immediately.</li>
            <li><strong>Clear practice area pages.</strong></li>
            <li><strong>Intake paths that do not bury the phone number.</strong></li>
            <li><strong>Local SEO baked in from day one.</strong></li>
            <li><strong>Awareness of legal marketing realities:</strong> reviews, disclaimers, and careful language, so your site looks sharp without crossing lines.</li>
          </ul>
          <p>What usually changes after launch:</p>
          <ul class="copy-points">
            <li><strong>Higher-quality inquiries,</strong> not just more traffic.</li>
            <li><strong>Improved Google Business Profile visibility.</strong></li>
            <li><strong>More calls from practice area plus town searches.</strong></li>
          </ul>
          <p class="copy-kicker">Not a prettier site. A site that earns trust and generates real cases.</p>
        </div>
        <Glass class="reveal" innerClass="portrait portrait--img portrait--tall">
          <img
            src="../images/industry-law-firm.jpg"
            alt="Glowing cyan wireframe scales of justice with law books behind"
            width="880"
            height="1168"
            loading="lazy"
            decoding="async"
          />
          <div class="frame-lines"></div>
        </Glass>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="sec-pad is-alt has-scan">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">SERVICES</span>
          <h2>Services We Provide for Law Firms</h2>
        </div>
        <p class="page-lede is-center mb-lg">A high-trust brand, a fast site, and search visibility that brings in the right calls.</p>
        <div class="grid-svc">
          {services.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
                <a class="more" href={c.href}>SEE DETAILS →</a>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WHAT WE BUILD -->
    <section class="sec-pad has-videobg has-scan">
      <VideoBg src="bg-color-tv.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">WHAT WE BUILD</span>
          <h2>What We Build for Law Firms</h2>
        </div>
        <div class="grid-svc">
          {builds.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta">
          <h2>Ready to Upgrade Your Law Firm Website?</h2>
          <p>Let's talk about your law firm website.</p>
          <div class="hero-btns">
            <a href="../contact.html" class="btn btn-primary">Get a Proposal →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
          <p class="more"><a href="../industries.html">← All industries</a></p>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
