---
/**
 * /industries/dental — ported from live dental.html.
 * Imports TWO dots up; links "../services/*.html", "../contact.html",
 * "../industries.html". COPY RULES: em dashes converted (marked <!-- em-dash -->);
 * "Learn More" → "SEE DETAILS →"; free-consultation CTA line reworded. Images
 * dropped; Glass portrait placeholder stands in. Smart quotes/ellipsis normalized.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const services = [
  { ico: "◧", title: "Website Design", body: "Mobile-first patient experience with clear service navigation. Built so a new patient can find hours, insurance, and the phone number without hunting.", points: ["Insurance answered before they call", "Booking reachable from any page"], href: "../services/website-design.html" },
  { ico: "◎", title: "SEO", body: "Local rankings for high-intent searches like implants, Invisalign, and emergency. Those patients are worth more and they search differently.", points: ["A page per high-value procedure", "Emergency searches targeted separately"], href: "../services/seo.html" },
  { ico: "⛭", title: "Hosting", body: "Fast, reliable hosting that supports SEO and keeps your site up. A practice site that is down during office hours is a phone that stops ringing.", points: ["Monitored so I know before you do", "Daily offsite backups"], href: "../services/hosting.html" },
];

const builds = [
  { ico: "◧", title: "Custom Design", body: "New patients and existing ones want completely different things from your site. One is deciding whether to trust you, the other just wants the phone number.",
    points: ["Insurance and payment answered up front", "Team photos, because people pick a person"] },
  { ico: "◎", title: "SEO Strategy", body: "Implants, Invisalign, and emergency each get their own page. Somebody searching for an emergency dentist at 9pm is not going to scroll a general services list.",
    points: ["A page per procedure you want more of", "Built around what patients actually type"] },
  { ico: "✦", title: "Lead Generation", body: "Booking that connects to the software your front desk already runs. A form that creates work for staff instead of saving it does not last a month.",
    points: ["Connects to your scheduling system", "New patient forms fillable before arrival"] },
  { ico: "▤", title: "Content Strategy", body: "Procedure pages that answer what it costs, whether it hurts, and how long it takes. Those are the questions people search, and most practice sites skip all three.",
    points: ["Written for patients, not other dentists", "Answers the cost question honestly"] },
  { ico: "◉", title: "Mobile-First", body: "Toothache searches happen on a phone, usually at night. Tap-to-call has to be the easiest thing on the screen.",
    points: ["Phone number tappable on every page", "Directions one tap from anywhere"] },
  { ico: "⛭", title: "Ongoing Support", body: "Hosting, maintenance, and monthly reporting. Practices add hygienists and change hours constantly, and none of that should require finding a web guy.",
    points: ["Hours and staff edits included", "One call when something needs changing"] },
];
---

<Base
  title="Dental Web Design | Live Web Studios"
  description="Patient-focused websites for dental practices with online booking integration."
  canonical="https://livewebstudios.com/industries/dental"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head has-videobg">
      <VideoBg src="bg-corner.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">DENTAL</span>
        <h1 class="page-h1">New Patients Are <em>One Search Away.</em></h1>
        <p class="page-lede">Patient-focused websites for dental practices with online booking, local SEO, and trust-building design.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- WHY -->
    <section class="sec-pad">
      <div class="wrap split">
        <div class="copy reveal">
          <span class="eyebrow">DENTAL</span>
          <div class="sec-head is-flush"><h2>Why Dental Businesses Choose LWS</h2></div>
          <!-- em-dash: "search \"dentist\" — they search" → "search \"dentist.\" They search"; ellipsis normalized -->
          <p>Dental is one of the most competitive local searches there is. People don't search "dentist." They search "dentist near me," "emergency dentist," "invisalign," "implant dentist," and they do it on a phone... usually in a hurry. If your site is slow, hard to navigate, or doesn't build trust fast, that patient is booking with someone else.</p>
          <!-- em-dash: "load fast—because page speed" → "load fast, because page speed" -->
          <p>We build dental websites that make the next step obvious: clear service pages, prominent calls, short forms, and a design that feels modern and reassuring. We structure your content so Google understands what you offer (and where), and we make sure your pages load fast, because page speed is not just UX, it's rankings.</p>
          <p>Practices typically see increased new-patient inquiries, better visibility in the map pack, and more bookings tied to high-intent searches like implants, cosmetic dentistry, and emergency services. The goal is simple: more of the right patients, more consistently.</p>
        </div>
        <Glass class="reveal" innerClass="portrait">
          <div class="frame-lines"></div>
          <div class="big">✦</div>
          <div class="mark">DENTAL</div>
        </Glass>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="sec-pad is-alt">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">SERVICES</span>
          <h2>Services We Provide for Dental Practices</h2>
        </div>
        <p class="page-lede is-center mb-lg">Local visibility, trust-first design, and performance that keeps patients from bouncing.</p>
        <div class="grid-svc">
          {services.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
                <a class="more" href={c.href}>SEE DETAILS →</a>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WHAT WE BUILD -->
    <section class="sec-pad has-videobg">
      <VideoBg src="bg-blue-fog.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">WHAT WE BUILD</span>
          <h2>What We Build for Dental</h2>
        </div>
        <div class="grid-svc">
          {builds.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta">
          <h2>Ready to Upgrade Your Dental Website?</h2>
          <p>Let's talk about your dental website.</p>
          <div class="hero-btns">
            <a href="../contact.html" class="btn btn-primary">Get a Proposal →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
          <p class="more"><a href="../industries.html">← All industries</a></p>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
