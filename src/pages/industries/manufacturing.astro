---
/**
 * /industries/manufacturing — ported from live manufacturing.html.
 * Imports TWO dots up; links "../services/*.html", "../contact.html",
 * "../industries.html". COPY RULES: em dashes converted (marked <!-- em-dash -->);
 * "Learn More" → "SEE DETAILS →"; free-consultation CTA line reworded. Images
 * dropped; Glass portrait placeholder stands in. Smart quotes normalized.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const services = [
  { ico: "◧", title: "Website Design", body: "Product and capability pages organized for engineers. They want tolerances and materials, and they want them without wading through marketing copy.", points: ["Specs reachable in one click", "Certifications listed plainly"], href: "../services/website-design.html" },
  // em-dash: "products—not just your company name" → "products, not just your company name"
  { ico: "◎", title: "SEO", body: "Rank for processes and materials, not just your company name. A buyer sourcing a part searches the process, and has never heard of your shop.", points: ["A page per process you offer", "Material-specific pages"], href: "../services/seo.html" },
  { ico: "⛭", title: "Hosting", body: "Fast hosting and maintenance so catalogs and spec sheets stay quick. Big PDF libraries are exactly where slow sites get slower.", points: ["Built to serve large documents", "Uptime monitored continuously"], href: "../services/hosting.html" },
];

const builds = [
  { ico: "◧", title: "Custom Design", body: "Engineers are looking for a spec, not a story. Give them capabilities, tolerances, and materials without three clicks of marketing first.",
    points: ["Capabilities and tolerances stated", "Certifications shown up front"] },
  { ico: "◎", title: "SEO Strategy", body: "Rank for processes and materials, not your company name. Buyers search the process they need done and have never heard of you yet.",
    points: ["A page per process and material", "Targets how buyers actually search"] },
  { ico: "✦", title: "Lead Generation", body: "RFQ forms that take a drawing or a spec file. Making an engineer describe a part in a text box is how quotes turn into email chains.",
    points: ["Drawing and file upload", "Captures volume and material up front"] },
  { ico: "▤", title: "Content Strategy", body: "Process pages, material guides, and capability detail. This is what gets you shortlisted by someone you will never speak to until the RFQ arrives.",
    points: ["Technical depth engineers trust", "Spec sheets easy to find"] },
  { ico: "◉", title: "Mobile-First", body: "Plant managers check you from the floor, not from a desk. Spec tables have to stay readable on a small screen.",
    points: ["Spec tables that work on a phone", "Documents downloadable on the go"] },
  { ico: "⛭", title: "Ongoing Support", body: "Hosting, maintenance, and monthly reporting. New equipment and certifications belong on the site the month you get them.",
    points: ["Capability and cert updates included", "Spec sheet swaps handled"] },
];
---

<Base
  title="Manufacturing Web Design | Live Web Studios"
  description="Catalog and capability sites for manufacturers and industrial businesses."
  canonical="https://livewebstudios.com/industries/manufacturing"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head has-videobg">
      <VideoBg src="bg-color-tv.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">MANUFACTURING</span>
        <h1 class="page-h1">Your Capabilities Deserve a Website <em>That Shows Them Off.</em></h1>
        <!-- em-dash: "industrial businesses — built to impress" → "industrial businesses, built to impress" -->
        <p class="page-lede">Catalog and capability sites for manufacturers and industrial businesses, built to impress buyers and rank for your products.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- WHY -->
    <section class="sec-pad">
      <div class="wrap split">
        <div class="copy reveal">
          <span class="eyebrow">MANUFACTURING</span>
          <div class="sec-head is-flush"><h2>Why Manufacturing Businesses Choose LWS</h2></div>
          <!-- em-dash: "than \"look nice\"—it has to" → "than \"look nice.\" It has to" -->
          <p>Manufacturing sites have a unique problem: the product is often complex, the buyer is technical, and the sales cycle is long. Your website needs to do more than "look nice." It has to communicate capabilities, materials, tolerances, certifications, industries served, and what makes you the right supplier. If that info is missing or buried, buyers move on to a competitor who makes it easier.</p>
          <!-- em-dash: "buyers actually search—part numbers...queries—so" → parenthetical -->
          <p>We build capability-driven websites that organize the details without overwhelming visitors. Clear navigation, structured product/service pages, fast performance, and content that supports both engineers and procurement. We also build SEO around the terms buyers actually search (part numbers, processes, materials, and "manufacturer near me" queries) so you get found for more than your brand name.</p>
          <p>Manufacturers typically see better quality inbound inquiries, more quote requests from the right industries, and stronger conversion from trade show or outreach traffic because the site answers questions that normally slow deals down. Think fewer "what do you do?" calls and more "can you quote this?" conversations.</p>
        </div>
        <Glass class="reveal" innerClass="portrait">
          <div class="frame-lines"></div>
          <div class="big">▦</div>
          <div class="mark">MANUFACTURING</div>
        </Glass>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="sec-pad is-alt">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">SERVICES</span>
          <h2>Services We Provide for Manufacturers</h2>
        </div>
        <p class="page-lede is-center mb-lg">Capability-first structure, technical SEO, and a site that makes procurement confident.</p>
        <div class="grid-svc">
          {services.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
                <a class="more" href={c.href}>SEE DETAILS →</a>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WHAT WE BUILD -->
    <section class="sec-pad has-videobg">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">WHAT WE BUILD</span>
          <h2>What We Build for Manufacturing</h2>
        </div>
        <div class="grid-svc">
          {builds.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta">
          <h2>Ready to Upgrade Your Manufacturing Website?</h2>
          <p>Let's talk about your manufacturing website.</p>
          <div class="hero-btns">
            <a href="../contact.html" class="btn btn-primary">Get a Proposal →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
          <p class="more"><a href="../industries.html">← All industries</a></p>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
