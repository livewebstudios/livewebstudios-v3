---
/**
 * /industries/nonprofit — ported from live nonprofit.html.
 * Imports TWO dots up; links "../services/*.html", "../contact.html",
 * "../industries.html". COPY RULES: em dashes converted (marked <!-- em-dash -->);
 * "Learn More" → "SEE DETAILS →"; free-consultation CTA line reworded. Images
 * dropped; Glass portrait placeholder stands in. Smart quotes normalized.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const services = [
  { ico: "◧", title: "Website Design", body: "Clear structure and real accessibility. Two audiences arrive here wanting opposite things, and both have to find their path immediately.", points: ["Get help and give help kept distinct", "Accessible for real, not just claimed"], href: "../services/website-design.html" },
  { ico: "◎", title: "SEO", body: "Local visibility for your programs. Someone who needs help searches what they need, never the name of the organization providing it.", points: ["A page per program you run", "Written for people seeking help"], href: "../services/seo.html" },
  { ico: "⛭", title: "Hosting", body: "Reliable managed hosting so the site never becomes a \"project.\" Nonprofit staff turns over, and the site should not depend on one person who left.", points: ["No single point of failure on staff", "Maintenance handled, not delegated"], href: "../services/hosting.html" },
];

const builds = [
  { ico: "◧", title: "Custom Design", body: "Two audiences, opposite needs. Someone seeking help wants the program page immediately, and a donor wants to see where the money goes.",
    points: ["Get help and give help, both obvious", "Accessible for real, not just claimed"] },
  { ico: "◎", title: "SEO Strategy", body: "Program and service pages built for the person searching at their worst moment. They are not searching your organization's name.",
    points: ["Pages for each program you run", "Written for people looking for help"] },
  { ico: "✦", title: "Lead Generation", body: "Donation and volunteer signup that works on the first try. Every extra step between an impulse to give and the giving costs you real money.",
    points: ["Donations in as few taps as possible", "Volunteer signup that reaches a person"] },
  { ico: "▤", title: "Content Strategy", body: "Impact stories and annual reporting that show the work. Donors give to results they can picture, and grant committees read the same pages.",
    points: ["Impact shown with real numbers", "Built with grant reviewers in mind"] },
  { ico: "◉", title: "Mobile-First", body: "Donors give from a phone after seeing a post. If checkout takes more than a moment, that impulse is gone.",
    points: ["Giving works fully on a phone", "Accessible to screen readers"] },
  { ico: "⛭", title: "Ongoing Support", body: "Hosting, maintenance, and monthly reporting. Nonprofit staff turns over and nobody should inherit a site they cannot get into.",
    points: ["Events and campaigns kept current", "No dependence on one staffer"] },
];
---

<Base
  title="Nonprofit Web Design | Live Web Studios"
  description="Mission-driven websites for nonprofits, schools, and community organizations."
  canonical="https://livewebstudios.com/industries/nonprofit"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-blue-fog.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">NONPROFIT</span>
        <h1 class="page-h1">Your Mission Is Too Important <em>for a Bad Website.</em></h1>
        <!-- em-dash: "community organizations — built to engage" → "community organizations, built to engage" -->
        <p class="page-lede">Mission-driven websites for nonprofits, schools, and community organizations, built to engage donors and volunteers.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- WHY -->
    <section class="sec-pad">
      <div class="wrap split">
        <div class="copy reveal">
          <span class="eyebrow">NONPROFIT</span>
          <div class="sec-head is-flush"><h2>Why Nonprofit Businesses Choose LWS</h2></div>
          <!-- em-dash: "\"information\"—it's fundraising" → "\"information.\" It's fundraising"; "struggling—even when" → "struggling, even when" -->
          <p>Nonprofits have to do more with less, and your website ends up carrying a lot of weight. It's not just "information." It's fundraising, volunteer recruitment, event promotion, and credibility all in one place. When the site is confusing, slow, or out of date, donors hesitate and volunteers bounce. They assume the organization is struggling, even when the mission is thriving.</p>
          <p>We build nonprofit websites that make the next step obvious: donate, sign up, attend, or contact. That means clear calls-to-action, pages that explain your impact without jargon, and a design that feels trustworthy and modern. We also structure your pages for search so people in your community can actually find you when they need what you provide.</p>
          <!-- em-dash: "\"look nicer\"—it helps you" → "\"look nicer.\" It helps you" -->
          <p>Organizations typically see higher donation conversion (fewer abandoned clicks), more volunteer form submissions, and better event turnout because the site removes friction. A good nonprofit site doesn't just "look nicer." It helps you raise more and do more.</p>
        </div>
        <Glass class="reveal" innerClass="portrait">
          <div class="frame-lines"></div>
          <div class="big">✧</div>
          <div class="mark">NONPROFIT</div>
        </Glass>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="sec-pad is-alt has-scan">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">SERVICES</span>
          <h2>Services We Provide for Nonprofits</h2>
        </div>
        <p class="page-lede is-center mb-lg">Clarity, credibility, and a path that turns visitors into donors and volunteers.</p>
        <div class="grid-svc">
          {services.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
                <a class="more" href={c.href}>SEE DETAILS →</a>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WHAT WE BUILD -->
    <section class="sec-pad has-videobg has-scan">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">WHAT WE BUILD</span>
          <h2>What We Build for Nonprofits</h2>
        </div>
        <div class="grid-svc">
          {builds.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta">
          <h2>Ready to Upgrade Your Nonprofit Website?</h2>
          <p>Let's talk about your nonprofit website.</p>
          <div class="hero-btns">
            <a href="../contact.html" class="btn btn-primary">Get a Proposal →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
          <p class="more"><a href="../industries.html">← All industries</a></p>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
