---
/**
 * /industries/financial-services — ported from live financial-services.html.
 * Imports TWO dots up; links "../services/*.html", "../contact.html",
 * "../industries.html". COPY RULES: em dashes converted (marked <!-- em-dash -->);
 * "Learn More" → "SEE DETAILS →"; free-consultation CTA line reworded. Images
 * dropped; Glass portrait placeholder stands in. Smart quotes normalized.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const services = [
  { ico: "◧", title: "Website Design", body: "A layout built to earn trust quickly. You are asking strangers to hand over money, and the site is usually their first read on whether you are legitimate.", points: ["Credentials and registrations visible", "Fast on every device"], href: "../services/website-design.html" },
  { ico: "◎", title: "SEO", body: "Local visibility and service pages that bring qualified inquiries. Tax prep and retirement planning are different searches and different clients.", points: ["A page per service and town", "Aimed at clients ready to talk"], href: "../services/seo.html" },
  { ico: "❖", title: "Branding", body: "Logo and identity that hold up in print and on screen. Financial clients still receive paper, and mismatched material reads as sloppy.", points: ["Press-ready files for print", "One identity across every touchpoint"], href: "../services/branding.html" },
];

const builds = [
  { ico: "◧", title: "Custom Design", body: "You are asking strangers to trust you with money. Credentials, a real address, and a clean fast site do more for that than any amount of stock photography.",
    points: ["Credentials and registrations visible", "Team shown as actual people"] },
  { ico: "◎", title: "SEO Strategy", body: "A page for each service and each town you serve. Retirement planning and tax prep attract different people and should not share a page.",
    points: ["Service plus town, page by page", "Targets what clients search before calling"] },
  { ico: "✦", title: "Lead Generation", body: "Consultation requests that ask enough to prepare for the meeting, without asking for anything sensitive over a web form.",
    points: ["Never collects account or ID numbers", "Enough context to prep the first call"] },
  { ico: "▤", title: "Content Strategy", body: "Plain answers on fees, process, and what working with you looks like. Fee transparency is still rare enough that being clear about it wins meetings.",
    points: ["How you charge, said plainly", "Compliance-safe language throughout"] },
  { ico: "◉", title: "Mobile-First", body: "People research advisors on a phone at night and call the next morning. That first read decides whether the call happens.",
    points: ["Readable on a phone at night", "Tap to call in the morning"] },
  { ico: "⛭", title: "Ongoing Support", body: "Hosting, maintenance, and monthly reporting. Disclosures and registrations have to stay current, and that is not a thing to leave to memory.",
    points: ["Disclosures kept up to date", "Advisor and credential changes handled"] },
];
---

<Base
  title="Financial Services Web Design | Live Web Studios"
  description="Websites for financial advisors, CPAs, and wealth management firms."
  canonical="https://livewebstudios.com/industries/financial-services"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-blue-fog.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">FINANCIAL SERVICES</span>
        <h1 class="page-h1">Trust Starts Online. <em>Make the First Impression Count.</em></h1>
        <p class="page-lede">Polished, credible websites for financial advisors, CPAs, and wealth management firms.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- WHY -->
    <section class="sec-pad">
      <div class="wrap split split--copy-first">
        <div class="copy copy--points reveal">
          <span class="eyebrow">FINANCIAL SERVICES</span>
          <div class="sec-head is-flush"><h2>Why Financial Services Businesses Choose LWS</h2></div>
          <!-- Restructured from three prose blocks to lede + points
               (Jon 2026-09-14: less wall of text, plain enough for a
               non-technical reader). Claims, numbers and search terms
               are all carried over; the two long paragraphs were each
               a list written as a sentence. -->
          <p>In financial services, people are not buying a product. They are buying confidence. Prospects look for signals: legitimacy, clarity, and a sense that you have your process together. A dated, confusing, or slow site creates doubt, and doubt is expensive.</p>
          <p>What we build for you:</p>
          <ul class="copy-points">
            <li><strong>Clean design and clear positioning</strong> that looks established without being stiff.</li>
            <li><strong>Service pages that answer real questions</strong> for advisors, CPAs, and firms.</li>
            <li><strong>Frictionless next steps:</strong> calls, consult requests, secure contact.</li>
            <li><strong>Pages structured for search and readability.</strong></li>
            <li><strong>Careful language,</strong> so you stay compliant and still sound human.</li>
          </ul>
          <p>What usually changes after launch:</p>
          <ul class="copy-points">
            <li><strong>Stronger conversion from referrals.</strong> People check you out and actually follow through.</li>
            <li><strong>Better visibility for local intent searches</strong> like "CPA near me" and "financial advisor NJ."</li>
            <li><strong>More qualified inquiries,</strong> because the site sets expectations up front.</li>
          </ul>
          <p class="copy-kicker">When your online presence feels credible, the conversation starts at trust, not skepticism.</p>
        </div>
        <Glass class="reveal" innerClass="portrait portrait--img portrait--tall">
          <img
            src="../images/industry-financial-services.jpg"
            alt="Glowing cyan rising growth chart passing through a classical column and security shield"
            width="880"
            height="1168"
            loading="lazy"
            decoding="async"
          />
          <div class="frame-lines"></div>
        </Glass>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="sec-pad is-alt has-scan">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">SERVICES</span>
          <h2>Services We Provide for Financial Services</h2>
        </div>
        <!-- em-dash: "credible brand—plus the SEO" → "credible brand, plus the SEO" -->
        <p class="page-lede is-center mb-lg">A clean, credible brand, plus the SEO foundation to get found by people ready to talk.</p>
        <div class="grid-svc">
          {services.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
                <a class="more" href={c.href}>SEE DETAILS →</a>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WHAT WE BUILD -->
    <section class="sec-pad has-videobg has-scan">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">WHAT WE BUILD</span>
          <h2>What We Build for Financial Services</h2>
        </div>
        <div class="grid-svc">
          {builds.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta">
          <h2>Ready to Upgrade Your Financial Services Website?</h2>
          <p>Let's talk about your financial services website.</p>
          <div class="hero-btns">
            <a href="../contact.html" class="btn btn-primary">Get a Proposal →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
          <p class="more"><a href="../industries.html">← All industries</a></p>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
