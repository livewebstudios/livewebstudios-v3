---
/**
 * /industries/insurance — ported from live insurance.html.
 * Imports TWO dots up; links "../services/*.html", "../contact.html",
 * "../industries.html". COPY RULES: em dashes converted (marked <!-- em-dash -->);
 * "Learn More" → "SEE DETAILS →"; free-consultation CTA line reworded. Images
 * dropped; Glass portrait placeholder stands in. Smart quotes/ellipsis normalized.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Glass from "../../components/Glass.astro";
import SiteUpgrade from "../../components/SiteUpgrade.astro";
import CardIcon from "../../components/CardIcon.astro";
import VideoBg from "../../components/VideoBg.astro";
import Marquee from "../../components/Marquee.astro";
import HeroActions from "../../components/HeroActions.astro";

const services = [
  { ico: "◧", title: "Website Design", body: "Clear quoting paths and forms that work on a phone. People shop insurance by comparing, so anything slow or confusing loses them to the next tab.", points: ["A path per line of coverage", "Forms short enough to finish"], href: "../services/website-design.html" },
  { ico: "◎", title: "SEO", body: "Local rankings and service-page optimization that drives quote requests. Commercial and personal lines are different searches and different pages.", points: ["Coverage type plus town", "Commercial kept separate from personal"], href: "../services/seo.html" },
  { ico: "⛭", title: "Hosting", body: "Fast hosting and maintenance so your site stays up and stays quick. Quote forms that go down are lost revenue you never find out about.", points: ["Forms monitored, not just the homepage", "Daily offsite backups"], href: "../services/hosting.html" },
];

const builds = [
  { ico: "◧", title: "Custom Design", body: "People shop insurance by comparing, and they bail the second a site feels slow or shady. Clean and quick beats clever here every time.",
    points: ["Lines of coverage split clearly", "Carriers you represent shown plainly"] },
  { ico: "◎", title: "SEO Strategy", body: "A page per line of coverage per town. Someone searching for commercial auto is a completely different customer than someone shopping renters.",
    points: ["Coverage type plus town", "Commercial and personal kept separate"] },
  { ico: "✦", title: "Lead Generation", body: "Quote forms split by coverage type, because asking a homeowner for their VIN is how you lose them. Ask only what that quote needs.",
    points: ["A different form per line of business", "Short enough that people finish"] },
  { ico: "▤", title: "Content Strategy", body: "Straight explanations of what a policy actually covers. Most people do not understand what they bought, and being the agent who explains it wins the call.",
    points: ["Plain language, no policy jargon", "Answers the questions people are embarrassed to ask"] },
  { ico: "◉", title: "Mobile-First", body: "Claims and quote checks happen on a phone, often right after something bad happened. That is the worst possible moment for a clumsy form.",
    points: ["Tap to call during a claim", "Quote forms usable one-handed"] },
  { ico: "⛭", title: "Ongoing Support", body: "Hosting, maintenance, and monthly reporting. Carriers and coverage change, and an outdated carrier list is a compliance problem, not just a stale page.",
    points: ["Carrier and coverage updates included", "Licensing info kept current"] },
];
---

<Base
  title="Insurance Web Design | Live Web Studios"
  description="Quote-ready websites for insurance agencies and brokers."
  canonical="https://livewebstudios.com/industries/insurance"
>
  <Nav />

  <main>
    <!-- PAGE HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-looping-waves.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">INSURANCE</span>
        <h1 class="page-h1">Get More Quotes. <em>Lose Fewer Leads.</em></h1>
        <!-- em-dash: "agencies and brokers — mobile-first" → "agencies and brokers, mobile-first" -->
        <p class="page-lede">Quote-ready websites for insurance agencies and brokers, mobile-first, fast, and built for local search.</p>
        <HeroActions links />
      </div>
    </section>

    <Marquee />

    <!-- WHY -->
    <section class="sec-pad">
      <div class="wrap split split--copy-first">
        <div class="copy copy--points reveal">
          <span class="eyebrow">INSURANCE</span>
          <div class="sec-head is-flush"><h2>Why Insurance Businesses Choose LWS</h2></div>
          <!-- Restructured from three prose blocks to lede + points
               (Jon 2026-09-14: less wall of text, plain enough for a
               non-technical reader). Claims, numbers and search terms
               are all carried over; the two long paragraphs were each
               a list written as a sentence. -->
          <p>Insurance shoppers do not window shop. They comparison shop, and they want answers fast: what you offer, who you cover, and how quickly they can get a quote. If your site is slow, confusing, or hides the next step, you do not just lose a lead, you lose it to whoever made it easier.</p>
          <p>What we build for you:</p>
          <ul class="copy-points">
            <li><strong>Quote-first, trust-first layout.</strong></li>
            <li><strong>Clear product and service pages</strong> for auto, home, life, and business.</li>
            <li><strong>Simple navigation and prominent contact options.</strong></li>
            <li><strong>Forms that work on mobile</strong> without making people pinch-zoom like it is 2012.</li>
            <li><strong>Local SEO</strong> so you show up for "insurance agent near me" in the towns you actually serve.</li>
          </ul>
          <p>What usually changes after launch:</p>
          <ul class="copy-points">
            <li><strong>More completed quote requests.</strong></li>
            <li><strong>Fewer abandoned forms.</strong></li>
            <li><strong>Better quality inbound,</strong> because the site qualifies prospects up front.</li>
          </ul>
          <p class="copy-kicker">Fast, clear, and built to be found. Lead volume rises, and the leads get better.</p>
        </div>
        <Glass class="reveal" innerClass="portrait portrait--img portrait--tall">
          <img
            src="../images/industry-insurance.jpg"
            alt="Glowing cyan protective shield arcing over a house and a car"
            width="880"
            height="1168"
            loading="lazy"
            decoding="async"
          />
          <div class="frame-lines"></div>
        </Glass>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="sec-pad is-alt has-scan">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">SERVICES</span>
          <h2>Services We Provide for Insurance Agencies</h2>
        </div>
        <p class="page-lede is-center mb-lg">Quote-ready UX, local visibility, and a site that builds credibility fast.</p>
        <div class="grid-svc">
          {services.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
                <a class="more" href={c.href}>SEE DETAILS →</a>
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WHAT WE BUILD -->
    <section class="sec-pad has-videobg has-scan">
      <VideoBg src="bg-corner.mp4" scrim="default" />
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">WHAT WE BUILD</span>
          <h2>What We Build for Insurance</h2>
        </div>
        <div class="grid-svc">
          {builds.map((c) => (
            <div class="card reveal">
              <Glass variant="inner" innerClass="card-pad">
                <h3>{c.title}</h3>
                <p>{c.body}</p>
                {c.points && (
                  <ul class="card-points">
                    {c.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                <CardIcon title={c.title} />
              </Glass>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad">
      <div class="wrap">
        <Glass class="reveal" innerClass="cta cta--art">
          <div class="cta-art"><SiteUpgrade /></div>
          <div class="cta-copy">
            <h2>Ready to Upgrade Your Insurance Website?</h2>
            <p>Let's talk about your insurance website.</p>
            <div class="hero-btns">
              <a href="../contact.html" class="btn btn-primary">Get a Proposal →</a>
              <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
            </div>
            <p class="more"><a href="../industries.html">← All industries</a></p>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
