---
/**
 * /blog/[slug] — individual blog post pages, rendered at build time from the
 * blog content collection (src/content/blog). Slugs strip the YYYY-MM-DD-
 * filename prefix so URLs match the live site (/blog/wordpress-slowing-you-down).
 * Frontmatter shapes normalized here: description ?? excerpt, image ?? thumbnail.
 * Post-body typography is scoped below using the existing design tokens only.
 */
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import VideoBg from "../../components/VideoBg.astro";
import HeroActions from "../../components/HeroActions.astro";
import Glass from "../../components/Glass.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const description = post.data.description ?? post.data.excerpt ?? "";
const rawImage = post.data.image ?? post.data.thumbnail ?? "";
// frontmatter stores root-relative paths (Decap convention); serve relative per path rule
const image = rawImage.replace(/^\//, "../");
const slug = post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "");
const dateLabel = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const isoDate = post.data.date.toISOString().split("T")[0];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description,
  datePublished: isoDate,
  url: `https://livewebstudios.com/blog/${slug}`,
  author: { "@type": "Person", name: "Jon Wolf" },
  publisher: { "@type": "Organization", name: "Live Web Studios" },
});
---

<Base
  title={`${post.data.title} | Live Web Studios`}
  description={description}
  canonical={`https://livewebstudios.com/blog/${slug}`}
  jsonld={null}
>
  <Nav />

  <main>
    <!-- POST HEAD -->
    <section class="page-head page-head--glass has-videobg">
      <VideoBg src="bg-corner.mp4" scrim="hero" />
      <div class="wrap">
        <span class="eyebrow is-center mb-lg">THE LWS BLOG</span>
        <h1 class="page-h1 post-h1">{post.data.title}</h1>
        <p class="post-date">{dateLabel}</p>
        <HeroActions links />
      </div>
    </section>

    <!-- POST BODY -->
    <section class="sec-pad">
      <div class="wrap">
        <article class="post-body">
          {image && (
            <div class="post-hero-img">
              <img src={image} alt={post.data.title} loading="lazy" />
            </div>
          )}
          <Content />
        </article>
      </div>
    </section>

    <!-- CTA -->
    <section class="sec-pad is-alt has-videobg">
      <VideoBg src="bg-orange-beam-noaudio.mp4" scrim="default" />
      <div class="wrap">
        <Glass class="reveal" innerClass="cta glass-refract">
          <span class="eyebrow is-center mb-md">GOT A PROJECT?</span>
          <h2>Less reading, more building.</h2>
          <div class="hero-btns">
            <a href="../contact.html" class="btn btn-primary">Let's talk. →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </Glass>
        <p class="post-back"><a href="../blog.html">← Back to all posts</a></p>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={jsonLd} is:inline />
</Base>

<style>
  /* Post typography — existing design tokens only, no changes to global CSS. */
  .post-h1 {
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    max-width: 26ch;
    margin-inline: auto;
  }
  .post-date {
    margin-top: 1.2rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan-soft);
  }
  .post-body {
    max-width: 72ch;
    margin-inline: auto;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .post-hero-img {
    margin-bottom: 2.5rem;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    overflow: hidden;
  }
  .post-hero-img img {
    display: block;
    width: 100%;
    height: auto;
  }
  .post-body :global(h2) {
    font-size: 1.5rem;
    color: var(--ink-soft);
    margin: 2.6rem 0 1rem;
    line-height: 1.3;
  }
  .post-body :global(h3) {
    font-size: 1.18rem;
    color: var(--ink-soft);
    margin: 2rem 0 0.8rem;
  }
  .post-body :global(p) {
    margin: 0 0 1.4rem;
  }
  .post-body :global(strong) {
    color: var(--ink-soft);
  }
  .post-body :global(a) {
    color: var(--cyan-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.4rem 1.4rem;
  }
  .post-body :global(li) {
    margin-bottom: 0.5rem;
  }
  .post-body :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 1.4rem;
    border-left: 2px solid var(--cyan-soft);
    color: var(--ink-soft);
  }
  .post-back {
    margin-top: 2.2rem;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }
</style>
