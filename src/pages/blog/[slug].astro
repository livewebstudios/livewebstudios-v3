---
/**
 * /blog/[slug] — individual blog post pages, rendered at build time from the
 * blog content collection (src/content/blog). Slugs strip the YYYY-MM-DD-
 * filename prefix so URLs match the live site (/blog/wordpress-slowing-you-down).
 * Frontmatter shapes normalized here: description ?? excerpt, image ?? thumbnail.
 * Post-body typography is scoped below using the existing design tokens only.
 */
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import VideoBg from "../../components/VideoBg.astro";
import Glass from "../../components/Glass.astro";
import { CATEGORIES, resolve, has } from "../../lib/categories";
import BlogHero from "../../components/BlogHero.astro";
import CategoryNav from "../../components/CategoryNav.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const description = post.data.description ?? post.data.excerpt ?? "";
const rawImage = post.data.image ?? post.data.thumbnail ?? "";
// frontmatter stores root-relative paths (Decap convention); serve relative per path rule
const image = rawImage.replace(/^\//, "../");
const slug = post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "");
const dateLabel = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const isoDate = post.data.date.toISOString().split("T")[0];

const postUrl = `https://livewebstudios.com/blog/${slug}`;
const cats = resolve(post.data.categories);
const all = await getCollection("blog", ({ data }) => !data.draft);
const available = CATEGORIES.filter((c) =>
  all.some((p) => has(p.data.categories, c.name)),
).map((c) => c.slug);

/* See also: other posts sharing a category, most overlap first, then newest.
   Sourced from the categories rather than hand-picked, so it keeps working as
   the archive fills up and never points at a draft. */
const related = all
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    shared: (p.data.categories ?? []).filter((c) =>
      (post.data.categories ?? []).includes(c),
    ).length,
  }))
  .filter((r) => r.shared > 0)
  .sort(
    (a, b) =>
      b.shared - a.shared || b.post.data.date.valueOf() - a.post.data.date.valueOf(),
  )
  .slice(0, 3)
  .map(({ post: p }) => ({
    slug: p.id.replace(/^\d{4}-\d{2}-\d{2}-/, ""),
    title: p.data.title,
    dateLabel: p.data.date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      timeZone: "UTC",
    }),
  }));

/* Share card. The 20 posts with a hero under images/blog/ are all 1376x768,
   comfortably past the 1200px floor scrapers need for a large card. The five
   older posts point at uploads/ and servicesindustries/ art that is 768-1100px
   wide, which gets demoted to a thumbnail, so those fall back to the sitewide
   1200x630 card instead. */
const ogImage = rawImage.startsWith("/images/blog/")
  ? rawImage
  : "images/og-default.jpg";

/* Google wants image, dateModified and mainEntityOfPage before it will
   consider a post for the enhanced article treatment in search. */
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description,
  image: `https://livewebstudios.com/${(rawImage || "images/og-default.jpg").replace(/^\//, "")}`,
  articleSection: cats.map((c) => c.name),
  datePublished: isoDate,
  dateModified: isoDate,
  url: postUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  author: { "@type": "Person", name: "Jon Wolf" },
  publisher: {
    "@type": "Organization",
    name: "Live Web Studios",
    logo: {
      "@type": "ImageObject",
      url: "https://livewebstudios.com/images/logoRGB.png",
      width: 800,
      height: 245,
    },
  },
});
---

<Base
  title={`${post.data.title} | Live Web Studios`}
  description={description}
  canonical={postUrl}
  ogImage={ogImage}
  jsonld={null}
>
  <Nav />

  <main>
    <!-- POST HEAD -->
    <BlogHero title={post.data.title}>
      <p class="post-date">
        {dateLabel}
        {cats.map((c, i) => (
          <>
            {i === 0 ? " · " : ", "}
            <a class="post-cat" href={`category/${c.slug}.html`}>{c.name}</a>
          </>
        ))}
      </p>
    </BlogHero>

    <!-- POST BODY -->
    <section class="sec-pad">
      <div class="wrap">
        <article class="post-body">
          {image && (
            <div class="post-hero-img">
              <img src={image} alt={post.data.title} loading="lazy" />
            </div>
          )}
          <Content />
        </article>

        {related.length > 0 && (
          <footer class="post-foot">
            <div class="post-seealso">
              <span class="post-foot__label">See also</span>
              <ul class="post-seealso__list">
                {related.map((r) => (
                  <li>
                    <a href={`${r.slug}.html`}>
                      <span class="post-seealso__title">{r.title}</span>
                      <span class="post-seealso__date">{r.dateLabel}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </footer>
        )}
      </div>
    </section>

    <CategoryNav available={available} current={cats[0]?.slug} />

    <!-- CTA -->
    <section class="sec-pad is-alt has-videobg">
      <VideoBg src="bg-orange-beam-noaudio.mp4" scrim="default" />
      <div class="wrap">
        <Glass class="reveal" innerClass="cta glass-refract">
          <span class="eyebrow is-center mb-md">GOT A PROJECT?</span>
          <h2>Less reading, more building.</h2>
          <div class="hero-btns">
            <a href="../contact.html" class="btn btn-primary">Let's talk. →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </Glass>
        <p class="post-back"><a href="../blog.html">← Back to all posts</a></p>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={jsonLd} is:inline />
</Base>

<style>
  /* Post typography — existing design tokens only, no changes to global CSS. */
  .post-h1 {
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    max-width: 26ch;
    margin-inline: auto;
  }
  .post-date {
    margin-top: 1.2rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan-soft);
  }
  .post-body {
    max-width: 72ch;
    margin-inline: auto;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .post-hero-img {
    margin-bottom: 2.5rem;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    overflow: hidden;
  }
  .post-hero-img img {
    display: block;
    width: 100%;
    height: auto;
  }
  .post-body :global(h2) {
    font-size: 1.5rem;
    color: var(--ink-soft);
    margin: 2.6rem 0 1rem;
    line-height: 1.3;
  }
  .post-body :global(h3) {
    font-size: 1.18rem;
    color: var(--ink-soft);
    margin: 2rem 0 0.8rem;
  }
  .post-body :global(p) {
    margin: 0 0 1.4rem;
  }
  .post-body :global(strong) {
    color: var(--ink-soft);
  }
  .post-body :global(a) {
    color: var(--cyan-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.4rem 1.4rem;
  }
  .post-body :global(li) {
    margin-bottom: 0.5rem;
  }
  .post-body :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 1.4rem;
    border-left: 2px solid var(--cyan-soft);
    color: var(--ink-soft);
  }
  .post-back {
    margin-top: 2.2rem;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }
</style>
