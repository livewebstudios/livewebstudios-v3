---
/**
 * /blog/category/[category] — one archive page per blog category, built at
 * build time from the blog collection. Seven categories, defined in
 * src/lib/categories.ts, each with its own title, description and H1 so the
 * page can stand on its own in search rather than reading as a duplicate of
 * /blog.
 *
 * Two levels deep, so every link here needs "../../" to reach the site root
 * per the LWS path rule. The shared chrome works this out itself via relPrefix.
 */
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import VideoBg from "../../../components/VideoBg.astro";
import BlogHero from "../../../components/BlogHero.astro";
import CategoryNav from "../../../components/CategoryNav.astro";
import Glass from "../../../components/Glass.astro";
import { CATEGORIES, bySlug, resolve, has } from "../../../lib/categories";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  // Only build a category that actually has published posts behind it. An
  // empty archive page is a thin page, and thin pages are worse than absent.
  return CATEGORIES.filter((c) =>
    posts.some((p) => has(p.data.categories, c.name)),
  ).map((c) => ({ params: { category: c.slug }, props: { slug: c.slug } }));
}

const { slug } = Astro.props;
const cat = bySlug(slug)!;

const posts = (
  await getCollection("blog", ({ data }) => !data.draft && has(data.categories, cat.name))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const all = await getCollection("blog", ({ data }) => !data.draft);
const available = CATEGORIES.filter((c) =>
  all.some((p) => has(p.data.categories, c.name)),
).map((c) => c.slug);

const cards = posts.map((post) => {
  const postSlug = post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "");
  const rawImage = post.data.image ?? post.data.thumbnail ?? "";
  return {
    slug: postSlug,
    title: post.data.title,
    summary: post.data.description ?? post.data.excerpt ?? "",
    cats: resolve(post.data.categories),
    // frontmatter keeps the Decap root-relative form; serve it relative
    image: rawImage ? `../../${rawImage.replace(/^\//, "")}` : "",
    dateLabel: post.data.date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      timeZone: "UTC",
    }),
  };
});

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: cat.name,
  description: cat.metaDescription,
  url: `https://livewebstudios.com/blog/category/${cat.slug}`,
  isPartOf: {
    "@type": "Blog",
    name: "The LWS Blog",
    url: "https://livewebstudios.com/blog",
  },
  hasPart: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    datePublished: p.data.date.toISOString().split("T")[0],
    url: `https://livewebstudios.com/blog/${p.id.replace(/^\d{4}-\d{2}-\d{2}-/, "")}`,
  })),
});
---

<Base
  title={cat.metaTitle}
  description={cat.metaDescription}
  canonical={`https://livewebstudios.com/blog/category/${cat.slug}`}
>
  <script type="application/ld+json" set:html={jsonLd} is:inline />
  <Nav />

  <main>
    <BlogHero title={cat.name} lede={cat.blurb} />

    <CategoryNav available={available} current={cat.slug} />

    <section class="sec-pad">
      <div class="wrap">

        <div class="blog-grid">
          {cards.map((c) => (
            <a class="blog-card" href={`../${c.slug}.html`}>
              {c.image ? (
                <div class="blog-thumb">
                  <img src={c.image} alt={c.title} loading="lazy" />
                </div>
              ) : (
                <div class="blog-thumb--empty"><span>LWS</span></div>
              )}
              <div class="blog-meta">
                <span class="blog-date">{c.dateLabel}</span>
                <h2 class="blog-title">{c.title}</h2>
                <p class="blog-sum">{c.summary}</p>
                <span class="blog-cats">
                  {c.cats.map((k) => <span class="blog-cat">{k.name}</span>)}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="sec-pad is-alt has-videobg">
      <VideoBg src="bg-orange-beam-noaudio.mp4" scrim="default" />
      <div class="wrap">
        <Glass class="reveal" innerClass="cta glass-refract">
          <span class="eyebrow is-center mb-md">GOT A PROJECT?</span>
          <h2>Less reading, more building.</h2>
          <div class="hero-btns">
            <a href="../../contact.html" class="btn btn-primary">Let's talk. →</a>
            <a href="tel:7328019611" class="btn btn-ghost">732.801.9611</a>
          </div>
        </Glass>
      </div>
    </section>
  </main>

  <Footer />
</Base>
